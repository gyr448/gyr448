d\overline{r} = \overline{v}\,dt,\quad \int_{\overline{r}_{0}}^{\overline{r}} d\overline{r} = \int_{0}^{t} \overline{v}\,dt = \int_{0}^{t} (\overline{v}_{0} + \overline{g}t)\,dt
\]
\[
\overrightarrow{r} - \overrightarrow{r}_{0} = \overrightarrow{v}_{0}t + \frac{1}{2}\overrightarrow{g}t^{2}
\]
\[
\overrightarrow{r} = \overrightarrow{v}_{0}t + \frac{1}{2}\overrightarrow{g}t^{2}
\]

