\section{1.4 加速度矢量}

\begin{center}
\includegraphics[max width=0.4\textwidth]{images/4_1177_641_577_583_0.jpg}
\end{center}

\textbf{1. 速度空间与加速度矢量}

\[
\overrightarrow{a} = \lim_{\Delta t \rightarrow 0}\frac{\Delta \overrightarrow{v}}{\Delta t} = \frac{d\overrightarrow{v}}{dt} = \frac{d^{2}\overrightarrow{r}}{dt^{2}}
\]

单位：米/秒$^{2}$。加速度与参考系的选择有关。

$K$ 系 $\overrightarrow{v},\widehat{\overline{a}}$；$K'$ 系 $\widehat{v'},\widehat{a'}$。

$K'$ 相对于 $K$ 平动 $\overrightarrow{v}_{0},\widehat{\overrightarrow{a}_{0}}$。

\[
\overrightarrow{v} = \overrightarrow{v}_{0} + \overrightarrow{v}',\quad \frac{d\overrightarrow{v}}{dt} = \frac{d\overrightarrow{v}_{0}}{dt} + \frac{d\overrightarrow{v}'}{dt}
\]

\begin{center}
\includegraphics[max width=0.4\textwidth]{images/4_1202_1248_538_468_0.jpg}
\end{center}

\[
\overrightarrow{a} = \overrightarrow{a}_{0} + \overrightarrow{a}'
\]

\textbf{2. 法向加速度和切向加速度}

\[
\Delta \overrightarrow{v} = \Delta \overrightarrow{v}_{n} + \Delta \overrightarrow{v}_{t},\quad \frac{d\overrightarrow{v}}{dt} = \frac{d\overrightarrow{v}_{n}}{dt} + \frac{d\overrightarrow{v}_{t}}{dt}
\]

\[
\overrightarrow{a} = \overrightarrow{a}_{n} + \overrightarrow{a}_{t}
\]

$a_{n}$：法向加速度，反映速度方向的时间改变率。

\begin{center}
\includegraphics[max width=0.3\textwidth]{images/4_1271_1849_494_477_0.jpg}
\end{center}

$a_{t}$：切向加速度，反映速度大小的时间改变率。

\[
a_{t} = \frac{dv_{t}}{dt} = \frac{d^{2}s}{dt^{2}}
\]

\[
a_{n} = \frac{dV_{n}}{dt} = \frac{V}{\rho}\frac{dS}{dt} = \frac{V}{\rho}V = \frac{V^{2}}{\rho}
\]

\section{1.5 运动学的正问题和逆问题}

正问题：$\overrightarrow{r}(t) \rightarrow \overrightarrow{v}(t) = \dfrac{d\overrightarrow{r}(t)}{dt} \rightarrow \overrightarrow{a}(t) = \dfrac{d\overrightarrow{v}(t)}{dt} = \dfrac{d^{2}\overrightarrow{r}}{dt}$ 微分过程。

逆问题：$\overline{a}(t) \rightarrow \overline{v}(t) \rightarrow \overline{r}(t)$ 积分过程。

\section{1.6 位矢、速度、加速度在直角坐标系中的表示}

$\overrightarrow{i},\overrightarrow{j},\overrightarrow{k}$ 坐标轴方向的单位矢量，基础矢量。

\[
\frac{d\overrightarrow{i}}{dt} = \frac{d\overrightarrow{j}}{dt} = \frac{d\overrightarrow{k}}{dt} = 0
\]

位矢：$\overrightarrow{r}(t) = x(t)\overrightarrow{i} + y(t)\overrightarrow{j} + z(t)\overrightarrow{k}$

速度：$\overrightarrow{v} = \dfrac{d\overrightarrow{r}}{dt} = \dfrac{dx}{dt}\overrightarrow{i} + \dfrac{dy}{dt}\overrightarrow{j} + \dfrac{dz}{dt}\overrightarrow{k}$

\[
\overrightarrow{v} = v_{x}\overrightarrow{i} + v_{y}\overrightarrow{j} + v_{z}\overrightarrow{k}
\]

\[
v = |\overrightarrow{v}| = \sqrt{\left(\frac{dx}{dt}\right)^{2} + \left(\frac{dy}{dt}\right)^{2} + \left(\frac{dz}{dt}\right)^{2}}
\]

加速度：$\overrightarrow{a} = a_{x}\overrightarrow{i} + a_{y}\overrightarrow{j} + a_{z}\overrightarrow{k}$

\[
\overrightarrow{a} = \frac{d\overrightarrow{v}}{dt} = \frac{dv_{x}}{dt}\overrightarrow{i} + \frac{dv_{y}}{dt}\overrightarrow{j} + \frac{dv_{z}}{dt}\overrightarrow{k}
\]

\textbf{例1.} 匀加速直线运动，已知加速度 $a$，$t = 0,\;v_{0},\;x_{0}$，求 $\overrightarrow{v}(t),\;\overrightarrow{r}(t)$。

\[
\frac{dv}{dt} = a
\]
\[
\int_{v_{0}}^{v} dv = \int_{0}^{t} a\,dt,\quad v - v_{0} = at,\quad v = v_{0} + at
\]

\[
v = \frac{dx}{dt}
\]
\[
\int_{x_{0}}^{x} dx = \int_{0}^{t} v\,dt = \int_{0}^{t} (v_{0} + at)\,dt
\]
\[
x - x_{0} = v_{0}t + \frac{1}{2}at^{2},\quad x = x_{0} + v_{0}t + \frac{1}{2}at^{2}
\]

\begin{center}
\includegraphics[max width=0.4\textwidth]{images/5_1207_1565_505_409_0.jpg}
