\section{6.3 质心角动量定理}

\textbf{1. 质点组}

$\overrightarrow{r}_{i} = \overrightarrow{r}_{c} + \overrightarrow{r}_{ic}$，$\overrightarrow{v}_{i} = \overrightarrow{v}_{c} + \overrightarrow{v}_{ic}$。

\[
\overrightarrow{L} = \sum_{i=1}^{N}\bigl(\overrightarrow{r}_{i} \times m_{i}\overrightarrow{v}_{i}\bigr) = \overrightarrow{r}_{c} \times M\overrightarrow{V}_{c} + \sum_{i=1}^{n}(\overrightarrow{r}_{ic} \times m_{i}\overrightarrow{V}_{ic})
\]
\[
\overrightarrow{L} = \overrightarrow{L}_{c} + \overrightarrow{L}_{IC}
\]

\textbf{2. 质心角动量变化定理}

$\dfrac{d\overrightarrow{L}_{c}}{dt} = \overrightarrow{M}_{c}$，$\overrightarrow{M}_{c} = \overrightarrow{r}_{c} \times \sum\overrightarrow{F}_{i}^{\text{外}}$。

\textbf{3. 相对质心角动量变化定理}

