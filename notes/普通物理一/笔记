\[
\widehat{\Phi}_{e} = \oiint_{S}\overline{E}\cdot d\overline{S} = \frac{1}{\varepsilon_{0}}\sum_{S(内)}q_{i} = \frac{1}{\varepsilon_{0}}\iiint_{V}\rho\,dV
