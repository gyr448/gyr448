\chapter{质心动能与角动量定理}

\section{6.2 质心动能定理/科尼希定理}

\textbf{1. 质点组的总动能等于质心动能与质点组相对质心动能之和}

\[
\widehat{r}_{i} = \widehat{r}_{c} + \widehat{r}_{ic} \;\Rightarrow\; \widehat{v}_{i} = \widehat{v}_{c} + \widehat{v}_{ic},\quad E_{K} = \sum\left(\frac{1}{2}m_{i}v_{i}^{2}\right)
\]

\begin{center}
\includegraphics[max width=0.2\textwidth]{images/31_1341_1820_302_283_0.jpg}
\end{center}

\[
V_{i}^{2} = (\overrightarrow{V}_{c} + \overrightarrow{V}_{ic}) \cdot (\overrightarrow{V}_{c} + \overrightarrow{V}_{ic}) = V_{c}^{2} + V_{ic}^{2} + 2\overrightarrow{V}_{c} \cdot \overrightarrow{V}_{ic}
\]
\[
\frac{1}{2}\sum m_{i}\,2\overrightarrow{V}_{c} \cdot \overrightarrow{V}_{ic} = \overrightarrow{V}_{c} \cdot \left(\sum m_{i}\overrightarrow{V}_{ic}\right) = 0
\]
\[
E_{k} = \frac{1}{2}MV_{c}^{2} + \sum\left(\frac{1}{2}m_{i}V_{ic}^{2}\right) = E_{C} + E_{IC}
\]

在质心系中 $E_{C} = 0$。

\begin{center}
\includegraphics[max width=0.3\textwidth]{images/32_1224_379_452_318_0.jpg}
\end{center}

\textbf{2. 两体相对于质心动能公式}

相对于质心的速度：$\overrightarrow{V}_{1c} = \dfrac{d\overline{l}_{1}}{dt}$，$\overrightarrow{V}_{2c} = \dfrac{d\overline{l}_{2}}{dt}$。

利用 $m_{1}l_{1} = m_{2}l_{2}$ 及 $l_{1} + l_{2} = l$ 得：
\[
\overrightarrow{l}_{1} = \frac{m_{2}}{m_{1} + m_{2}}\overrightarrow{l},\quad \overrightarrow{l}_{2} = \frac{m_{1}}{m_{1} + m_{2}}\overrightarrow{l}
\]
\[
E_{IC} = \frac{1}{2}\frac{m_{1}m_{2}}{m_{1} + m_{2}}\left|\frac{d\overrightarrow{l}}{dt}\right|^{2}
\]

令 $\mu = \dfrac{m_{1}m_{2}}{m_{1} + m_{2}}$ 折合质量。$m_{1}$ 相对于 $m_{2}$ 的速度 $\overrightarrow{v}_{r} = \dfrac{d\overrightarrow{l}}{dt}$。

$E_{IC} = \dfrac{1}{2}\mu v_{r}^{2}$。两体相对于质心的动能与参考系的选择无关。

\textbf{3. 导出两体碰撞动能亏损公式}

设碰撞前 $E_{k} = E_{c} + E_{IC}$，碰撞后 $E_{k}' = E_{c}' + E_{IC}'$。在质心系中 $E_{c}' = E_{c} = 0$。

\[
\Delta E_{k} = E_{IC}' - E_{IC} = \frac{1}{2}\mu v_{r}'^{2} - \frac{1}{2}\mu v_{r}^{2},\quad \frac{v_{r}'}{v_{r}} = e
\]
\[
\Delta E_{K} = \frac{1}{2}\mu(e^{2} - 1)v_{r}^{2} = -\frac{1}{2}\mu(1 - e^{2})v_{r}^{2}
\]

\textbf{重力势能和质心势能}

重力场中，质点组的重力势能：$\displaystyle\sum m_{i}gh_{i} = g\sum m_{i}h_{i} = Mgh_{c}$。

重力场中，势能中心与质心重合。一般引力场不适用。

