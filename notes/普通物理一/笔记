\section{4.1 质点动能变化定理}

\textbf{1. 力作功和运动物体动能}

\[
\overrightarrow{F} = m\frac{d\overrightarrow{v}}{dt},\quad \overrightarrow{F}\,d\overrightarrow{r} = m\frac{d\overrightarrow{v}}{dt}\,d\overrightarrow{r} = m\,d\overrightarrow{v}\,\frac{d\overrightarrow{r}}{dt} = m\overrightarrow{v}\,d\overrightarrow{v}
\]
\[
\overrightarrow{v} \cdot d\overrightarrow{v} = d\!\left(\frac{1}{2}\overrightarrow{v} \cdot \overrightarrow{v}\right) = d\!\left(\frac{1}{2}v^{2}\right)
\]

\begin{center}
\includegraphics[max width=0.4\textwidth]{images/17_1189_111_572_419_0.jpg}
\end{center}

\[
\overrightarrow{v} \cdot d\overrightarrow{v} = v\cos\theta\,|d\overrightarrow{v}| = v\,dv
\]

沿运动轨迹从 $A \rightarrow B$ 积分，得：
\[
\int_{l}\overrightarrow{F}\,d\overrightarrow{r} = \int_{A}^{B} d\!\left(\frac{1}{2}mv^{2}\right) = \frac{1}{2}mv_{B}^{2} - \frac{1}{2}mv_{A}^{2}
\]

力做功与坐标系的选择有关。

瞬时功率：单位时间内力所作的功，反映力作功的快慢。
\[
dA = \overline{F} \cdot d\overline{r}
\]
\[
P = \frac{dA}{dt} = \overline{F}\,\frac{d\overline{r}}{dt} = \overline{F} \cdot \overline{v}
\]

\textbf{2. 一对作用力和反作用力做功的代数和}

\[
P = \overrightarrow{f}_{1} \cdot \overrightarrow{v}_{1} + \overrightarrow{f}_{2} \cdot \overrightarrow{v}_{2} = \overrightarrow{f}_{1} \cdot \overrightarrow{v}_{1} - \overrightarrow{f}_{1} \cdot \overrightarrow{v}_{2} = \overrightarrow{f}_{1} \cdot (\overrightarrow{v}_{1} - \overrightarrow{v}_{2}) = \overrightarrow{f}_{1} \cdot \overrightarrow{v}_{\text{相对}}
\]

一对内力的功与参考系的选择无关。

