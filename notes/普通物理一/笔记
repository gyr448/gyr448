\section*{麦克斯韦方程组与电磁波}

位移电流 $I_{D} = \dfrac{d\Phi_{D}}{dt} = \iint\dfrac{\partial\overrightarrow{D}}{\partial t}\cdot d\overrightarrow{S}$。

\textbf{麦克斯韦方程组（积分形式）}

\[
\oiint\overrightarrow{D}\cdot d\overrightarrow{S} = \sum q_{0},\quad \oint\overrightarrow{E}\cdot d\overrightarrow{l} = -\iint\frac{\partial\overrightarrow{B}}{\partial t}\cdot d\overrightarrow{S}
\]
\[
\oiint\overrightarrow{B}\cdot d\overrightarrow{S} = 0,\quad \oint\overrightarrow{H}\cdot d\overrightarrow{l} = I_{0} + \iint\frac{\partial\overrightarrow{D}}{\partial t}\cdot d\overrightarrow{S}
\]

\textbf{微分形式}

\[
\nabla\cdot\overrightarrow{D} = \rho,\quad \nabla\times\overrightarrow{E} = -\frac{\partial\overrightarrow{B}}{\partial t},\quad \nabla\cdot\overrightarrow{B} = 0,\quad \nabla\times\overrightarrow{H} = \overrightarrow{j} + \frac{\partial\overrightarrow{D}}{\partial t}
\]

边界条件：$\overrightarrow{D}$ 法向连续，$\overrightarrow{E}$ 切向连续。$\overrightarrow{B}$ 法向连续，$\overrightarrow{H}$ 切向连续。

\textbf{电磁波}：$\overrightarrow{E} = \overrightarrow{E}_{0}\cos(\omega t - \overrightarrow{k}\cdot\overrightarrow{r})$。横波，$\overrightarrow{E}_{0} \perp \overrightarrow{k}$，$\overrightarrow{H}_{0} \perp \overrightarrow{k}$，$\overrightarrow{E}_{0} \perp \overrightarrow{H}_{0}$。

电磁场能量密度 $w = \dfrac{1}{2}(\overrightarrow{D}\cdot\overrightarrow{E} + \overrightarrow{B}\cdot\overrightarrow{H})$。能流密度矢量 $\overrightarrow{S} = \overrightarrow{E}\times\overrightarrow{H}$。

电磁波动量密度 $\overrightarrow{g} = \dfrac{1}{c^{2}}\overrightarrow{S}$。

