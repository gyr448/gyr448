\section{一、三大微分中值定理回顾}

\begin{enumerate}
\item \textbf{Rolle 定理：}\(f \in C[a,b]\)，在 \((a,b)\) 可导，\(f(a)=f(b)\) \(\Rightarrow\) \(\exists \xi \in (a,b)\)，\(f'(\xi)=0\)。
\item \textbf{Lagrange 中值定理：}\(f \in C[a,b]\)，在 \((a,b)\) 可导 \(\Rightarrow\) \(\exists \xi \in (a,b)\)，\(f'(\xi) = \frac{f(b)-f(a)}{b-a}\)。
\item \textbf{Cauchy 中值定理：}\(f,g \in C[a,b]\)，在 \((a,b)\) 可导，\(g' \neq 0\) \(\Rightarrow\) \(\exists \xi \in (a,b)\)，\(\frac{f'(\xi)}{g'(\xi)} = \frac{f(b)-f(a)}{g(b)-g(a)}\)。
\end{enumerate}

\section{二、思考题}

\begin{enumerate}

\item 求证 \(f(x) = \sqrt{x}\ln x\) 在 \((0, +\infty)\) 上一致连续。

\begin{proof}
\(f'(x) = \frac{\ln x + 2}{2\sqrt{x}}\)，\(f''(x) = \frac{-\ln x}{4x\sqrt{x}}\)。

在 \((0,1)\) 上：\(\lim_{x \to 0^+} f(x) = \lim_{x \to 0^+} \frac{\ln x}{x^{-1/2}} = 0\)（L'H\^opital），延拓 \(f(0)=0\) 后 \(f \in C[0,1]\)，由 Cantor 定理一致连续。

在 \((\frac12, +\infty)\) 上：\(f'(x) \to 0\)（\(x \to +\infty\)）\(\Rightarrow\) \(f'\) 有界 \(\Rightarrow\) \(f\) Lipschitz 连续 \(\Rightarrow\) 一致连续。

两区间重叠，故 \(f\) 在 \((0,+\infty)\) 一致连续。
\end{proof}

\item 求 \(y = \dfrac{1}{1-x^2}\) 的 \(n\) 阶导数。

\textbf{方法一（分解）：}\(y = \frac12\!\left(\frac{1}{1-x} + \frac{1}{1+x}\right)\)。
\[
\left(\frac{1}{1-x}\right)^{(n)} = \frac{n!}{(1-x)^{n+1}},\qquad
\left(\frac{1}{1+x}\right)^{(n)} = \frac{(-1)^n n!}{(1+x)^{n+1}}
\]
\[
y^{(n)} = \frac{n!}{2}\left(\frac{1}{(1-x)^{n+1}} + \frac{(-1)^n}{(1+x)^{n+1}}\right)
\]

\textbf{方法二（递推）：}由 \((1-x^2)y = 1\)，Leibniz 求 \(n\) 阶导：\(\left(1-x^2\right)y^{(n)} = 2nx\,y^{(n-1)} + n(n-1)y^{(n-2)}\)。设 \(a_n = y^{(n)}/n!\) 得二阶递推，可用特征方程求解。
\end{enumerate}

