\chapter{12.2 习题课}

\section{一、凸函数复习总结}

\begin{enumerate}
\item \textbf{定义：}\(f(\lambda x_1 + (1-\lambda)x_2) \leq \lambda f(x_1) + (1-\lambda)f(x_2)\)，\(\lambda \in (0,1)\)。几何：弦在函数上方。

\item \textbf{三点形式：}\(\forall x_1 < x < x_2\)，\(\frac{f(x)-f(x_1)}{x-x_1} \leq \frac{f(x_2)-f(x_1)}{x_2-x_1} \leq \frac{f(x_2)-f(x)}{x_2-x}\)。

\item \textbf{中点凸性：}若 \(f \in C(I)\)，下凸 \(\Leftrightarrow\) \(f(\frac{x_1+x_2}{2}) \leq \frac{f(x_1)+f(x_2)}{2}\)。

\item \textbf{分析性质：}(1) 凸函数在内部连续；(2) 内部处处存在左右导数；(3) \(f'\!\uparrow\) \(\Leftrightarrow\) 下凸；\(f'' \geq 0\) \(\Leftrightarrow\) 下凸。

\item \textbf{支撑线：}凸函数 \(\forall x_0\) 在内部，\(\exists k\)，s.t. \(f(x) \geq f(x_0) + k(x-x_0)\)（可导时 \(k = f'(x_0)\)）。

\item \textbf{经典不等式：}
\begin{itemize}
\item Jensen：\(f(\sum \lambda_i x_i) \leq \sum \lambda_i f(x_i)\)
\item 均值不等式：\(\sqrt[n]{a_1\cdots a_n} \leq \frac{a_1+\cdots+a_n}{n}\)（取 \(f=-\ln x\)）
\item Hermite--Hadamard：\(f(\frac{a+b}{2}) \leq \frac{1}{b-a}\int_a^b f(x)\,dx \leq \frac{f(a)+f(b)}{2}\)
\end{itemize}

\item \textbf{极值：}下凸函数局部极小值 \(\Rightarrow\) 全局最小值。
\end{enumerate}

\section{二、习题}

\begin{enumerate}

\item 设 \(f(x)\) 在 \((a,b)\) 上取正值，已知 \(-f(x)\) 是凸函数，求证 \(\frac{1}{f(x)}\) 也是凸函数。

\begin{proof}
\(\varphi(t) = 1/t\)（\(t > 0\)），\(\varphi''(t) = 2/t^3 > 0\)，故 \(\varphi\) 下凸。

由 \(-f\) 凸 \(\Rightarrow\) \(f(\lambda x_1 + (1-\lambda)x_2) \geq \lambda f(x_1) + (1-\lambda)f(x_2)\)。

\(\frac{1}{f(\lambda x_1 + (1-\lambda)x_2)} \leq \frac{1}{\lambda f(x_1) + (1-\lambda)f(x_2)} \leq \frac{\lambda}{f(x_1)} + \frac{1-\lambda}{f(x_2)}\)（后一不等号由 \(\varphi\) 下凸）。
\end{proof}

\item 设 \(f(x)\) 在 \([a,b]\) 上 \(n(>2)\) 次可微，\(\exists x_0 \in (a,b)\) 使 \(f'(x_0) = \cdots = f^{(n-1)}(x_0) = 0\)，且 \(\forall x\)，\(f^{(n)}(x) > 0\)。求证：
\begin{enumerate}
\item \(n\) 为奇数时，\(f(x)\) 在 \((a,b)\) 上严格单调上升；
\item \(n\) 为偶数时，\(f(x)\) 在 \((a,b)\) 上为严格凸函数。
\end{enumerate}

\begin{proof}
(1) 将 \(f'(x)\) 在 \(x_0\) 处 Taylor 展开至 \(n-1\) 阶：\(f'(x) = \frac{f^{(n)}(\xi)}{(n-1)!}(x-x_0)^{n-1}\)。\(n\) 为奇数 \(\Rightarrow\) \(n-1\) 为偶数，\((x-x_0)^{n-1} > 0\)（\(x \neq x_0\)），又 \(f^{(n)} > 0\)，故 \(f'(x) > 0\) \(\Rightarrow\) 严格单调上升。

(2) 将 \(f''(x)\) 展开：\(f''(x) = \frac{f^{(n)}(\xi)}{(n-2)!}(x-x_0)^{n-2}\)。\(n\) 为偶数 \(\Rightarrow\) \(n-2\) 为偶数，同理 \(f''(x) > 0\) \(\Rightarrow\) 严格凸。
\end{proof}

\item 设 \(f(x)\) 在 \([0,a]\) 上二次可导，\(f(0)=0\)，\(f''(x) < 0\)。求证 \(\frac{f(x)}{x}\) 严格单调下降。

\begin{proof}
令 \(g(x) = f(x)/x\)，延拓 \(g(0) = f'(0)\)。\(g'(x) = \frac{xf'(x) - f(x)}{x^2}\)。令 \(h(x) = xf'(x) - f(x)\)，\(h(0)=0\)，\(h'(x) = xf''(x) < 0\)，故 \(h(x) < 0\)，\(g'(x) < 0\) \(\Rightarrow\) \(g\) 严格单调下降。
\end{proof}

\item 设 \(f(x)\) 在 \((0,+\infty)\) 上可导。证明 \(f'(x)\) 单调上升 \(\Leftrightarrow\) \(f(x) - xf'(x)\) 单调下降。

\begin{proof}
令 \(g(x) = f(x) - xf'(x)\)。\(g'(x) = -xf''(x)\)。\(f'\!\uparrow\) \(\Leftrightarrow\) \(f'' \geq 0\) \(\Leftrightarrow\) \(g' \leq 0\) \(\Leftrightarrow\) \(g \downarrow\)。
\end{proof}

\end{enumerate}

