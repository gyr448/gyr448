\chapter{12.23 定积分的应用}

\section{一、平面图形的面积}

\subsection{1. 直角坐标}

\(S = \int_a^b [f(x) - g(x)]\,dx\)（上减下），或 \(S = \int_c^d [\psi(y) - \varphi(y)]\,dy\)（右减左）。

\subsection{2. 极坐标}

\(S = \int_\alpha^\beta \frac12 r^2(\theta)\,d\theta\)。

\begin{example}
\begin{enumerate}
\item 心形线 \(r = a(1+\cos\theta)\)（\(a > 0\)）的面积：\(S = \frac{a^2}{2}\int_0^{2\pi}(1+\cos\theta)^2\,d\theta = \frac{3}{2}\pi a^2\)。
\item 双纽线 \(r^2 = a^2\cos 2\theta\) 的面积：\(S = 2\int_{-\pi/4}^{\pi/4} \frac12 a^2\cos 2\theta\,d\theta = a^2\)。
\end{enumerate}
\end{example}

\section{二、旋转体的体积}

曲线 \(y = f(x)\)（\(x \in [a,b]\)）绕 \(x\) 轴旋转：\(V = \int_a^b \pi [f(x)]^2\,dx\)。

\section{三、曲线的弧长}

\(f \in C^1[a,b]\)：弧微分 \(ds = \sqrt{1 + [f'(x)]^2}\,dx\)。
\[
L = \int_a^b \sqrt{1 + [f'(x)]^2}\,dx
\]

\section{四、旋转体的表面积}

绕 \(x\) 轴旋转：\(S = 2\pi \int_a^b f(x)\sqrt{1 + [f'(x)]^2}\,dx\)。

\section{五、物理应用}

变力做功：\(W = \int_a^b F(x)\,dx\)。

\textbf{弹簧：}\(F = kx\)，\(W = \int_0^L kx\,dx = \frac12 kL^2\)。

\textbf{万有引力：}\(F = G\frac{Mm}{r^2}\)，\(W = \int_R^{R'} G\frac{Mm}{r^2}\,dr = GMm(\frac1R - \frac1{R'})\)。\(R' \to +\infty\) 时 \(W_0 = \frac{GM}{R}m\)（逃逸功）。

\textbf{液体压强：}\(p = \rho gx\)，总压力 \(P = \int_a^b \rho gx\,f(x)\,dx\)。

\section{六、定积分的分部积分}

\(\int_a^b f(x)g'(x)\,dx = f(x)g(x)\big|_a^b - \int_a^b f'(x)g(x)\,dx\)。

\begin{example}
Wallis 公式：\(I_n = \int_0^{\pi/2} \sin^n x\,dx = \int_0^{\pi/2} \cos^n x\,dx\)。

\(I_0 = \frac{\pi}{2}\)，\(I_1 = 1\)。分部积分得 \(I_n = \frac{n-1}{n}I_{n-2}\)。

\[
I_{2k} = \frac{(2k-1)!!}{(2k)!!}\frac{\pi}{2},\qquad
I_{2k+1} = \frac{(2k)!!}{(2k+1)!!}
\]

由 \(I_{n+1} \leq I_n \leq I_{n-1}\) 得 \(\displaystyle \lim_{n\to+\infty} \frac{1}{2n+1}\!\left[\frac{(2n)!!}{(2n-1)!!}\right]^2 = \frac{\pi}{2}\)（Wallis 乘积）。
\end{example}

