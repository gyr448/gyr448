\chapter{10.21 习题课}

\section{思考题}

\begin{enumerate}

\item 设 \(f(x)\) 在 \([0, +\infty)\) 上连续，且满足 \(f(x^2) = f(x)\)。求证：\(f(x)\) 为常数。

\begin{proof}
对 \(x > 0\)：\(f(x) = f(x^{\frac{1}{2}}) = f(x^{\frac{1}{4}}) = \cdots = f(x^{\frac{1}{2^n}})\)。

由连续性：\(\displaystyle f(x) = \lim_{n \to \infty} f(x^{\frac{1}{2^n}}) = f\!\left(\lim_{n \to \infty} x^{\frac{1}{2^n}}\right) = f(1)\)。

\(f(0) = \lim_{x \to 0^+} f(x) = f(1)\)。\(\therefore f(x) \equiv f(1)\)（常数）。
\end{proof}

\item 设 \(f(x)\) 在 \([0, +\infty)\) 上连续，且 \(0 \leq f(x) \leq x\)（\(x \geq 0\)）。若 \(a_1 \geq 0\)，\(a_{n+1} = f(a_n)\)（\(n = 1,2,\ldots\)）。求证：
\begin{enumerate}
\item \(\displaystyle \lim_{n \to +\infty} a_n\) 存在；
\item 设极限为 \(l\)，则 \(f(l) = l\)；
\item 若条件改为 \(0 \leq f(x) < x\;(x > 0)\)，则 \(l = 0\)。
\end{enumerate}

\begin{proof}
(1) \(a_{n+1} = f(a_n) \leq a_n\)，又 \(a_n \geq 0\)，故 \(\{a_n\}\) 单调递减有下界 \(\Rightarrow\) 极限存在。

(2) 由连续性：\(l = \lim a_{n+1} = \lim f(a_n) = f(\lim a_n) = f(l)\)。

(3) 若 \(l > 0\)，则 \(f(l) = l\)，与 \(f(x) < x\;(x > 0)\) 矛盾。\(\therefore l = 0\)。
\end{proof}

\item 设 \(f(x)\) 在 \((a,b)\) 上只有第一类间断点，且对 \(\forall x,y \in (a,b)\)，有 \(f\!\left(\frac{x+y}{2}\right) \leq \frac{f(x) + f(y)}{2}\)（中点凸性）。求证：\(f(x)\) 在 \((a,b)\) 上连续。

\begin{proof}
（反证）假设 \(\exists x_0\) 为间断点，由于只有第一类间断点，\(f(x_0^-) \neq f(x_0^+)\)。

取 \(\varepsilon > 0\) 充分小，由中点凸性迭代可得：
\[
f\!\left(x_0 \pm \frac{\varepsilon}{2}\right) \leq \frac{1}{2}\left(f(x_0 \pm \varepsilon) + f(x_0)\right)
\]
反复应用可导出 \(f(x_0^+) \leq f(x_0^-)\) 且 \(f(x_0^-) \leq f(x_0^+)\)，故 \(f(x_0^+) = f(x_0^-)\)，矛盾。

\(\therefore f(x)\) 在 \((a,b)\) 连续。
\end{proof}

\item 求证：\(x^3 + px + q = 0\)（\(p,q \in \mathbb{R}\)）至少有一个实根。

\begin{proof}
令 \(f(x) = x^3 + px + q\)，则 \(f \in C(\mathbb{R})\)。\(\displaystyle \lim_{x \to -\infty} f(x) = -\infty\)，\(\displaystyle \lim_{x \to +\infty} f(x) = +\infty\)。由介值定理，\(\exists \xi\)，s.t. \(f(\xi) = 0\)。
\end{proof}

\item 设 \(f(x) \in C(-\infty, +\infty)\)，且 \(\forall x,y\)，\(|f(x) - f(y)| \leq k|x - y|\)（\(0 \leq k < 1\)，Lipschitz 条件）。求证：
\begin{enumerate}
\item \(g(x) = kx - f(x)\) 单调上升；
\item \(\exists \xi \in (-\infty, +\infty)\)，s.t. \(f(\xi) = \xi\)（不动点）。
\end{enumerate}

\begin{proof}
(1) 设 \(x < y\)：\(g(y) - g(x) = k(y-x) - (f(y) - f(x)) \geq k|y-x| - k|y-x| = 0\)。\(\therefore g \uparrow\)。

(2) 任取 \(x_0\)，定义 \(x_{n+1} = f(x_n)\)。可证 \(\{x_n\}\) 为 Cauchy 列（压缩映射），极限 \(\xi\) 满足 \(f(\xi) = \xi\)。
\end{proof}

\end{enumerate}

