\chapter{11.4 隐函数与高阶导数}

\section{一、上节课回顾}

\begin{itemize}
\item \textbf{反函数求导：}若 \(f'(x_0) \neq 0\) 且 \(f\) 在邻域严格单调连续，则 \(\varphi'(y_0) = \frac{1}{f'(x_0)}\)。
\item \textbf{链式法则：}\(F'(x) = f'(g(x)) \cdot g'(x)\)，\(\frac{dy}{dx} = \frac{dy}{du}\frac{du}{dx}\)。
\item \textbf{参数求导：}\(\frac{dy}{dx} = \frac{y'(t)}{x'(t)}\)。
\end{itemize}

\section{二、隐函数求导}

方程 \(F(x,y) = 0\)，若给定 \(x\) 可唯一解出 \(y\)，则 \(y\) 是由方程确定的\textbf{隐函数}。

\begin{example}
上半圆周 \(x^2 + y^2 = 1\)（\(y > 0\)），求 \(y'(x)\)。

两边对 \(x\) 求导：\(2x + 2y \cdot y' = 0\)，\(\therefore y' = -\frac{x}{y} = -\frac{x}{\sqrt{1-x^2}}\)。
\end{example}

\begin{example}
\(x = y - \varepsilon \sin y\)（\(\varepsilon \in (0,1)\)），判断隐函数存在性并求导。

\textbf{存在性：}令 \(\varphi(y) = y - \varepsilon \sin y\)，\(\varphi'(y) = 1 - \varepsilon \cos y > 0\)，故 \(\varphi\) 严格单调上升。又 \(\lim_{y\to\pm\infty} \varphi(y) = \pm\infty\)，由介值定理 \(\forall x \in \mathbb{R}\)，\(\exists! y\)，s.t. \(x = \varphi(y)\)。\(\therefore\) 确定隐函数 \(y(x)\)。

\textbf{求导：}由 \(\Delta x = \Delta y - \varepsilon[\sin(y+\Delta y) - \sin y] = (1 - \varepsilon\cos y)\Delta y + o(\Delta y)\)，
\[
\frac{dy}{dx} = \lim_{\Delta x \to 0} \frac{\Delta y}{\Delta x} = \frac{1}{1 - \varepsilon\cos y}
\]

\textbf{简便方法：}直接对 \(x = y - \varepsilon\sin y\) 两边求导：\(1 = y' - \varepsilon\cos y \cdot y'\)，\(\therefore y' = \frac{1}{1 - \varepsilon\cos y}\)。
\end{example}

\subsection{对数求导法则}

对形如 \(y = u(x)^{v(x)}\)（\(u > 0\)）的幂指函数，取对数再求导：
\[
\ln y = v(x)\ln u(x) \;\Longrightarrow\; \frac{y'}{y} = v'\ln u + \frac{v}{u}u' \;\Longrightarrow\; y' = u^v\left(v'\ln u + \frac{v}{u}u'\right)
\]

\begin{example}
\(y = \sqrt{\frac{x^3}{x-a}}\)，求 \(y'\)。

\(\ln y = \frac{3}{2}\ln x - \frac{1}{2}\ln(x-a)\)，\(\frac{y'}{y} = \frac{3}{2x} - \frac{1}{2(x-a)}\)，\(\therefore y' = \frac{1}{2}\sqrt{\frac{x^3}{x-a}}\left(\frac{3}{x} - \frac{1}{x-a}\right)\)。
\end{example}

\section{三、高阶导数}

\textbf{定义：}\(f''(x) = (f')'(x)\) 为二阶导数，记作 \(f^{(2)}(x)\) 或 \(\frac{d^2f}{dx^2}\)。归纳定义 \(n\) 阶导数：\(f^{(n)}(x) := (f^{(n-1)}(x))'\)。

\textbf{物理意义：}位移 \(s(t)\)：\(s'(t) = v(t)\)（速度），\(s''(t) = a(t)\)（加速度），\(a'(t) = j(t)\)（加加速度/jerk）。

\textbf{例（弹簧振子）：}由 \(m x''(t) = -kx\)，假设解 \(x(t) = A\cos(\omega t + \varphi)\)，求导得 \(x'' = -A\omega^2\cos(\omega t + \varphi)\)，代入得 \(\omega = \sqrt{k/m}\)。

\subsection{常见函数的高阶导数}

\begin{enumerate}
\item \(y = x^\alpha\)：\(y^{(n)} = \alpha(\alpha-1)\cdots(\alpha-n+1)x^{\alpha-n}\)。

特例：\(\alpha = n \in \mathbb{N}\) 时 \((x^n)^{(n)} = n!\)，\((x^n)^{(m)} = 0\)（\(m > n\)）。

\item \(y = \sin x\)：\(y' = \cos x = \sin(x + \frac{\pi}{2})\)，归纳得 \(y^{(n)} = \sin(x + \frac{n\pi}{2})\)。

\(y = \cos x\)：\(y^{(n)} = \cos(x + \frac{n\pi}{2})\)。

\item \((e^x)^{(n)} = e^x\)，\((a^x)^{(n)} = a^x(\ln a)^n\)。

\item \([(1+x)^\alpha]^{(n)} = \alpha(\alpha-1)\cdots(\alpha-n+1)(1+x)^{\alpha-n}\)。

特例：\([\ln(1+x)]^{(n)} = \left(\frac{1}{1+x}\right)^{(n-1)} = (-1)^{n-1}(n-1)!(1+x)^{-n}\)。
\end{enumerate}

\subsection{Leibniz 公式（乘法的高阶导数）}

\[
(uv)^{(n)} = \sum_{k=0}^{n} C_n^k \, u^{(k)} v^{(n-k)}
\]
（与二项式定理形式相同。）

\begin{proof}
（归纳法）\(n=1\) 时 \((uv)' = u'v + uv'\) 成立。假设 \(n\) 成立，则
\begin{align*}
(uv)^{(n+1)} &= \left[\sum_{k=0}^{n} C_n^k u^{(k)} v^{(n-k)}\right]' \\
&= \sum_{k=0}^{n} C_n^k \left[u^{(k+1)}v^{(n-k)} + u^{(k)}v^{(n-k+1)}\right] \\
&= \sum_{j=1}^{n+1} C_n^{j-1} u^{(j)}v^{(n+1-j)} + \sum_{j=0}^{n} C_n^j u^{(j)}v^{(n+1-j)} \\
&= \sum_{j=0}^{n+1} (C_n^{j-1} + C_n^j) u^{(j)}v^{(n+1-j)} = \sum_{j=0}^{n+1} C_{n+1}^j u^{(j)}v^{(n+1-j)}
\end{align*}
\end{proof}

\subsection{参数形式的二阶导数}

\[
\frac{d^2y}{dx^2} = \frac{d}{dx}\left(\frac{dy}{dx}\right) = \frac{d}{dt}\left(\frac{y'(t)}{x'(t)}\right) \cdot \frac{dt}{dx}
= \frac{y''(t)x'(t) - y'(t)x''(t)}{[x'(t)]^3}
\]

\subsection{复合函数的高阶导数}

\(h(x) = f(g(x))\)：\(h'(x) = f'(g(x)) \cdot g'(x)\)，
\[
h''(x) = f''(g(x))[g'(x)]^2 + f'(g(x))g''(x)
\]
即 \(\frac{d^2f}{dx^2} = \frac{d^2f}{dg^2}\left(\frac{dg}{dx}\right)^2 + \frac{df}{dg}\frac{d^2g}{dx^2}\)。

\begin{remark}
一阶微分具有形式不变性（\(df = f'(u)du\) 无论 \(u\) 是自变量还是中间变量），但\textbf{高阶微分不满足}形式不变性。
\end{remark}

