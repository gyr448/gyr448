\chapter{9.23习题课}

\section{求序列极限的方法}

\subsection{(1) 直接代入法}

适用于多项式、有理函数等。例：\(\displaystyle \lim_{n \to \infty} \frac{1}{n} = 0\)。

\subsection{(2) 夹逼原理（迫敛性）}

利用放缩，用的最多。若 \(\exists N\)，s.t. \(\forall n > N\)，有 \(a_n \leq x_n \leq b_n\)，且 \(\displaystyle \lim_{n \to \infty} a_n = \lim_{n \to \infty} b_n = A\)，则 \(\displaystyle \lim_{n \to \infty} x_n = A\)。

\begin{example}
\(\displaystyle \lim_{n \to \infty} \frac{\sin n}{n}\)

\textbf{解法一：}\(-\frac{1}{n} \leq \frac{\sin n}{n} \leq \frac{1}{n}\)，两边趋于 \(0\)，故原式 \(= 0\)。

\textbf{解法二：}\(0 \leq \left|\frac{\sin n}{n}\right| \leq \frac{|\sin n|}{|n|} \leq \frac{1}{n} \to 0\)（绝对收敛）。
\end{example}

\subsection{(3) 单调有界定理}

证明存在性，便于求解。若 \(\{a_n\} \uparrow\) 有上界或 \(\{a_n\} \downarrow\) 有下界，则极限存在。

\begin{example}
\(a_n = 1 - \frac{1}{n}\)，求 \(\displaystyle \lim_{n \to \infty} a_n\)。

单调递增，上界是 \(1\) \(\Rightarrow\) 极限存在，极限为 \(1\)。
\end{example}

\begin{example}
\(a_1 = 1\)，\(a_{n+1} = \sqrt{2 + a_n}\)，求 \(\displaystyle \lim_{n \to +\infty} a_n\)。

设 \(\displaystyle \lim_{n \to \infty} a_n = A\)，则 \(\displaystyle \lim_{n \to \infty} a_{n+1} = A > 0\)。

取 \(n \to \infty\)：\(A = \sqrt{2 + A}\)，\(A^2 - A - 2 = 0\)，\(A = 2\) 或 \(-1\)（舍）。
\end{example}

\subsection{(4) 利用已知极限}

\[
\lim_{n \to \infty} \sqrt[n]{n} = 1,\quad \sqrt[n]{n^2} = \sqrt[n]{n} \cdot \sqrt[n]{n} \to 1
\]

\[
\sqrt[n]{n!} \to \infty \quad (\text{Stirling公式}),\qquad \left(1 + \frac{1}{n}\right)^n \to e
\]

\subsection{(5) L'H\^opital 定理}

适用于函数极限，可求序列极限。当 \(\frac{f(x)}{g(x)}\) 为 \(\frac{0}{0}\) 或 \(\frac{\infty}{\infty}\) 型时，\(= \frac{f'(x)}{g'(x)}\)。求序列极限时，一些情况下可转化为函数极限。

\subsection{(6) 变换序列法}

通过代数变换（如取对数、变量替换）简化。

\[
\lim_{n \to \infty} \left(1 + \frac{1}{n}\right)^{2n} = e^2,\qquad
\lim_{n \to \infty} \left(1 - \frac{1}{n}\right)^n = \frac{1}{e}
\]

