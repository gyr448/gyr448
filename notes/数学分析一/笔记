\section{一、高阶导数补充}

\subsection{反函数的高阶导数}

\(y = f(x)\)，\(x = \varphi(y)\)：
\[
\varphi'(y) = \frac{1}{f'(x)},\qquad
\varphi''(y) = -\frac{f''(x)}{[f'(x)]^3}
\]

\begin{example}
\(y = \arctan x\)。可归纳证明
\[
y^{(n)}(x) = (n-1)! \cdot \cos^n y \cdot \sin\!\left[n\!\left(y + \frac{\pi}{2}\right)\right]
\]
\end{example}

\begin{example}
\(y = \arcsin x\)，求 \(y^{(n)}(0)\)。

由 \(y'\sqrt{1-x^2} = 1\) 求导得 \((1-x^2)y'' = xy'\)。Leibniz 公式代入 \(x=0\) 得 \(y^{(n+2)}(0) = n^2 y^{(n)}(0)\)。结合 \(y(0)=0, y'(0)=1\)：
\[
y^{(2k)}(0) = 0,\qquad y^{(2k+1)}(0) = [(2k-1)!!]^2
\]
\end{example}

\section{二、中值定理}

\subsection{1. Fermat（费马）定理}

\textbf{极值：}设 \(f(x)\) 在 \(O(x_0)\) 有定义。若 \(\forall x \in O(x_0)\)，\(f(x) \geq f(x_0)\)，称 \(f(x_0)\) 为极小值；\(\forall x \in O^-(x_0)\)，\(f(x) > f(x_0)\) 为严格极小值。类似定义极大值。极值是局部性质。

\textbf{Fermat 定理：}若 \(f(x)\) 在 \(x_0\) 可导且取极值，则 \(f'(x_0) = 0\)。

\begin{proof}
不妨设 \(f(x_0)\) 为极大值。\(\forall h \neq 0\)，\(f(x_0+h)-f(x_0) \leq 0\)。
\[
f'(x_0) = \lim_{h \to 0^+} \frac{f(x_0+h)-f(x_0)}{h} \leq 0,\quad
f'(x_0) = \lim_{h \to 0^-} \frac{f(x_0+h)-f(x_0)}{h} \geq 0 \;\Longrightarrow\; f'(x_0)=0
\]
\end{proof}

\begin{remark}
\(f'(x_0)=0\) 是极值的必要不充分条件（反例 \(f(x)=x^3\)）。
\end{remark}

\subsection{2. Rolle 中值定理}

若 \(f \in C[a,b]\)，在 \((a,b)\) 可导，且 \(f(a)=f(b)\)，则 \(\exists \xi \in (a,b)\)，s.t. \(f'(\xi)=0\)。

\begin{proof}
\(f \in C[a,b]\) \(\Rightarrow\) 取到最大/最小值 \(M,m\)。若 \(M=m\) 则 \(f\) 为常数。否则 \(M,m\) 至少有一个在内部取到 \(\Rightarrow\) 极值点，由 Fermat 定理导数为 \(0\)。
\end{proof}

\subsection{3. Lagrange 中值定理}

若 \(f \in C[a,b]\)，在 \((a,b)\) 可导，则 \(\exists \xi \in (a,b)\)，s.t.
\[
f'(\xi) = \frac{f(b)-f(a)}{b-a}
\]

\begin{proof}
构造 \(F(x) = f(x) - \frac{f(b)-f(a)}{b-a}(x-a)\)，\(F(a)=F(b)=f(a)\)。由 Rolle 定理 \(\exists \xi\)，s.t. \(F'(\xi)=0\)。
\end{proof}

\subsection{4. Cauchy 中值定理}

若 \(f,g \in C[a,b]\)，在 \((a,b)\) 可导且 \(g'(x) \neq 0\)，则 \(\exists \xi \in (a,b)\)，s.t.
\[
\frac{f'(\xi)}{g'(\xi)} = \frac{f(b)-f(a)}{g(b)-g(a)}
\]

\begin{proof}
构造 \(F(x) = f(x) - \frac{f(b)-f(a)}{g(b)-g(a)}[g(x)-g(a)]\)。\(F(a)=F(b)\)，由 Rolle 定理即得。
\end{proof}

\subsection{中值定理的推论}

\begin{enumerate}
\item 若 \(f'(x) \equiv 0\)，则 \(f(x) \equiv C\)（由 Lagrange）。
\item 若 \(f' = g'\)，则 \(g = f + C\)。
\item 若 \(f'' \equiv 0\)，则 \(f(x) = C_0 + C_1 x\)。
\item 若 \(f^{(n+1)} \equiv 0\)，则 \(f(x) = C_0 + C_1 x + \cdots + C_n x^n\)（归纳法）。
\end{enumerate}

\section{三、导数与函数的单调性}

\textbf{定理1：}设 \(f \in C[a,b]\)，在 \((a,b)\) 可导。\(f \uparrow\) \(\Leftrightarrow\) \(f' \geq 0\)；\(f \downarrow\) \(\Leftrightarrow\) \(f' \leq 0\)。

\textbf{定理2（严格单调）：}\(f \uparrow\uparrow\) \(\Leftrightarrow\) \(f' \geq 0\) 且 \(f'\) 不在任一开子区间恒为零。

\section{四、极值的充分条件}

\textbf{定理3（一阶判别法）：}设 \(f\) 在 \(O(x_0)\) 连续，在 \(O^-(x_0)\) 可导。若 \(f'(x)(x-x_0) > 0\)（左负右正），则 \(f(x_0)\) 为严格极小值；反之 \(< 0\) 为严格极大值。不要求 \(f\) 在 \(x_0\) 可导。

\textbf{定理4（二阶判别法）：}设 \(f'(x_0) = 0\) 且 \(f''(x_0)\) 存在。\(f''(x_0) > 0 \Rightarrow\) 严格极小；\(f''(x_0) < 0 \Rightarrow\) 严格极大。

\begin{proof}
\(f''(x_0) = \lim_{x \to x_0} \frac{f'(x)}{x-x_0} > 0\) \(\Rightarrow\) \(\exists \eta\)，s.t. \(f'(x)(x-x_0) > 0\)，由定理3得证。
\end{proof}

