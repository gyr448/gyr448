\chapter{12.16 可积性理论}

\section{一、Darboux 和}

设 \(f\) 在 \([a,b]\) 上有界，对分割 \(\Delta\)：\(m_k = \inf_{[x_{k-1},x_k]} f\)，\(M_k = \sup_{[x_{k-1},x_k]} f\)。

\textbf{Darboux 下和：}\(s(f,\Delta) = \sum m_k \Delta x_k\)。\textbf{Darboux 上和：}\(S(f,\Delta) = \sum M_k \Delta x_k\)。

\textbf{性质：}增加分点，下和不减，上和不增。\(s(f,\Delta) \leq \sigma(f,\Delta,\xi) \leq S(f,\Delta)\)。

设 \(w = \sup f - \inf f\)，增加一个分点使下和增加 \(\leq w\|\Delta\|\)。

\textbf{引理：}若 \(f\) 有界，则 \(\displaystyle \lim_{\|\Delta\| \to 0} s(f,\Delta)\) 和 \(\displaystyle \lim_{\|\Delta\| \to 0} S(f,\Delta)\) 均存在，且
\[
\lim_{\|\Delta\| \to 0} s(f,\Delta) = \sup_{\Delta} s(f,\Delta) =: \underline{I} \quad (\text{下积分}),\qquad
\lim_{\|\Delta\| \to 0} S(f,\Delta) = \inf_{\Delta} S(f,\Delta) =: \overline{I} \quad (\text{上积分})
\]

\section{二、可积的充要条件}

\textbf{定理（三个等价条件）：}\(f \in R[a,b]\) \(\Leftrightarrow\) \(\underline{I} = \overline{I}\)。

记振幅 \(w_k = M_k - m_k = \sup_{[x_{k-1},x_k]} |f(x') - f(x'')|\)，则等价于：
\[
\lim_{\|\Delta\| \to 0} \sum_{k=1}^{n} w_k \Delta x_k = 0
\]

几何意义：曲线可以被总面积 \(\to 0\) 的小矩形盖住。

\textbf{等价条件三：}\(\forall \varepsilon > 0, \eta > 0\)，\(\exists \delta > 0\)，s.t. \(\forall \Delta\) 满足 \(\|\Delta\| < \delta\)，振幅 \(w_k \geq \varepsilon\) 的小区间总长度 \(< \eta\)。

\begin{example}
\begin{enumerate}
\item Dirichlet 函数 \(D(x) = \begin{cases} 1, & x \in \mathbb{Q} \\ 0, & x \notin \mathbb{Q} \end{cases}\) 在任何区间上 \(w_k = 1\)，\(\sum w_k\Delta x_k = b-a \nrightarrow 0\)，不可积。
\item Riemann 函数 \(f(x) = \begin{cases} 1/q, & x = p/q \\ 0, & x \notin \mathbb{Q} \end{cases}\) 在 \([0,1]\) 可积（\(\forall \varepsilon > 0\)，\(1/q \geq \varepsilon\) 的有理数仅有有限个）。
\end{enumerate}
\end{example}

\section{三、可积的充分条件}

\begin{enumerate}
\item \textbf{闭区间上的连续函数必可积。}（由一致连续性，\(\forall \varepsilon > 0\)，\(\exists \delta\) 使 \(w_k < \varepsilon\)，\(\sum w_k\Delta x_k < \varepsilon(b-a)\)。）\(\therefore C[a,b] \subseteq R[a,b]\)。

\item \textbf{有界且至多有有限个间断点的函数必可积。}（间断点可被总长度 \(\to 0\) 的小区间覆盖。）

\item \textbf{闭区间上的单调函数必可积。}（\(\sum w_k \leq |f(b)-f(a)|\)，\(\sum w_k\Delta x_k \leq |f(b)-f(a)|\|\Delta\| \to 0\)。）
\end{enumerate}

\textbf{推论（有界变差函数）：}若 \(\sup_{\Delta} \sum_{k=1}^{n} w_k < +\infty\)（对所有分割一致有界），则 \(f\) 为有界变差函数，必 Riemann 可积。

\section{四、可积函数的性质}

\begin{enumerate}
\item \textbf{线性性：}\(R[a,b]\) 是线性空间，\(\int (c_1f_1 + c_2f_2) = c_1\int f_1 + c_2\int f_2\)。
\item \textbf{乘法封闭：}若 \(f_1,f_2 \in R[a,b]\)，则 \(f_1 \cdot f_2 \in R[a,b]\)。
\end{enumerate}

