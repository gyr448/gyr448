\chapter{12.12 定积分}

\section{一、定积分的概念}

\textbf{问题：}求 \(y = x^2\)（\(x \in [0,1]\)）与 \(x\) 轴围成的面积。将 \([0,1]\) \(n\) 等分：
\[
\sum_{i=1}^{n}\frac1n\!\left(\frac{i-1}{n}\right)^2 \leq S \leq \sum_{i=1}^{n}\frac1n\!\left(\frac{i}{n}\right)^2
\]
两边极限均为 \(\frac13\)，故 \(S = \frac13\)（夹逼）。

\subsection{Riemann 积分的定义}

设 \(f(x)\) 在 \([a,b]\) 上有定义。对分割 \(\Delta: a = x_0 < x_1 < \cdots < x_n = b\)，记 \(\Delta x_i = x_i - x_{i-1}\)，模 \(\|\Delta\| = \max_i \Delta x_i\)。

任取 \(\xi_i \in [x_{i-1}, x_i]\)，\textbf{Riemann 和}：\(\sigma(f,\Delta,\xi) = \sum_{i=1}^{n} f(\xi_i)\Delta x_i\)。

若 \(\forall\) 分割 \(\Delta\) 和 \(\forall\) 取点 \(\xi\)，只要 \(\|\Delta\| \to 0\)，\(\sigma(f,\Delta,\xi)\) 的极限存在且唯一，则称 \(f\) 在 \([a,b]\) 上\textbf{Riemann 可积}（\(f \in R[a,b]\)），极限值称为定积分：\(\displaystyle \int_a^b f(x)\,dx\)。

\textbf{\(\varepsilon\text{-}\delta\) 表述：}\(\forall \varepsilon > 0\)，\(\exists \delta > 0\)，s.t. \(\forall\) 分割 \(\Delta\) 满足 \(\|\Delta\| < \delta\)，\(\forall\) 取点 \(\xi\)：\(|\sigma(f,\Delta,\xi) - I| < \varepsilon\)。

\begin{remark}
定积分与不定积分本质不同：不定积分是原函数（局部性质），定积分是 Riemann 和的极限（整体性质）。
\end{remark}

\subsection{可积的必要条件}

\textbf{定理：}若 \(f \in R[a,b]\)，则 \(f\) 在 \([a,b]\) 上有界。

\begin{proof}
（反证）假设无界。对任意分割，\(\exists [x_{k-1},x_k]\) 上 \(f\) 无界。取 \(\xi_k\) 使 \(|f(\xi_k)|\) 任意大，则 Riemann 和无界，不可能有极限。
\end{proof}

\section{二、微积分学基本定理（Newton-Leibniz 公式）}

\textbf{定理：}若 \(f \in N[a,b] \cap R[a,b]\)（即 \(f\) 有原函数且 Riemann 可积），则
\[
(R)\int_a^b f(x)\,dx = (N)\int_a^b f(x)\,dx = F(b) - F(a)
\]
其中 \(F'(x) = f(x)\)。

\begin{proof}
对分割 \(\Delta\)：\(F(b)-F(a) = \sum_{k=1}^{n}[F(x_k)-F(x_{k-1})]\)。由 Lagrange 中值定理 \(\exists \eta_k \in [x_{k-1},x_k]\)，s.t. \(F(x_k)-F(x_{k-1}) = f(\eta_k)\Delta x_k\)。

\(\therefore F(b)-F(a) = \sum f(\eta_k)\Delta x_k = \sigma(f,\Delta,\eta)\)。令 \(\|\Delta\| \to 0\)，由 Riemann 可积性即得。
\end{proof}

\begin{remark}
\(N[a,b]\) 与 \(R[a,b]\) 不存在包含关系。例：\(f(x) = \operatorname{sgn}(x)\) 在 \([-1,1]\) Riemann 可积但无原函数（有第一类间断点）。反之，\(F(x) = x^2\sin\frac{1}{x^2}\)（补 \(F(0)=0\)）的导函数无界 \(\Rightarrow\) 非 Riemann 可积但有原函数。
\end{remark}

