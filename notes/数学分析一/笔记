\(f \in C[0,+\infty)\)，在 \((0,+\infty)\) 可导，\(f(0)=0\)，\(|f(x) + \sqrt{x}f'(x)| \leq M\sqrt{x}|f(x)|\)（\(x > 0\)）。求所有满足条件的 \(f\)。

\begin{proof}
令 \(F(x) = e^{2\sqrt{x}}f(x)\)，则 \(f(x) = e^{-2\sqrt{x}}F(x)\)。

\(F'(x) = e^{2\sqrt{x}}[f'(x) + \frac{1}{\sqrt{x}}f(x)] = \frac{e^{2\sqrt{x}}}{\sqrt{x}}[f(x) + \sqrt{x}f'(x)]\)。

\(\therefore |F'(x)| \leq M|F(x)|\)。令 \(H(x) = F(x)^2\)，\(|H'(x)| \leq 2M H(x)\)。

令 \(\varphi(x) = e^{-2Mx}H(x)\)，\(\varphi'(x) \leq 0\) 且 \(\varphi(0)=0\)，\(\therefore \varphi \equiv 0 \Rightarrow H \equiv 0 \Rightarrow F \equiv 0 \Rightarrow f \equiv 0\)。
\end{proof}
\end{example}

\textbf{Gronwall 不等式：}若 \(u,g \in C[t_0,t_1]\)，\(u,g > 0\)，\(\exists c,k \geq 0\)，s.t. \(u(t) \leq c + \int_{t_0}^{t}(g(s)u(s) + k)\,ds\)，则 \(u(t) \leq [c + k(t-t_0)]\exp\!\left(\int_{t_0}^{t} g(s)\,ds\right)\)。

\section{二、往年题选}

\begin{enumerate}
\item \(\displaystyle y = \int_0^{x^2} t\sin x\,dt = \sin x \cdot \frac{x^4}{2}\)，\(y' = 2x^3\sin x + \frac12 x^4\cos x\)。
（一般公式：\(\frac{d}{dx}\int_a^{g(x)} f(t)\,dt = f(g(x))\,g'(x)\)。）

\item \(\displaystyle \lim_{x \to +\infty} \int_2^x \frac{dt}{t^4-1}\) 收敛（部分分式可求精确值）。

\item \(\displaystyle \lim_{n \to +\infty} \sum_{k=1}^{n} \frac{n+k}{(n+k)^2+n^2} = \int_0^1 \frac{1+x}{(1+x)^2+1}\,dx = \int_1^2 \frac{u\,du}{1+u^2}\)。

\item 严格凸函数的最小值唯一。\(f\) 在 \((a,b)\) 严格凸 \(\Rightarrow\) 在 \([\alpha,\beta] \subset (a,b)\) 上 Lipschitz 连续。

\item \(f\) 在 \(\mathbb{R}\) 三阶可导，\(f'''\) 有界：
\begin{enumerate}
\item \(f(x) = O(x^3)\)（\(x \to +\infty\)）；
\item 若 \(f\) 有界，则 \(f',f''\) 也有界（用 Lagrange 余项差分估计）。
\end{enumerate}
\end{enumerate}

\section{三、函数空间与内积}

\(C[0,\pi]\) 上定义内积 \(\langle f,g \rangle = \int_0^{\pi} f(x)g(x)\,dx\)，范数 \(\|f\| = \sqrt{\langle f,f \rangle}\)。

\begin{enumerate}
\item 勾股定理：若 \(\langle f,g \rangle = 0\)，则 \(\|f\|^2 + \|g\|^2 = \|f+g\|^2\)。
\item \(\{\sin x, \cos x, \sin 2x, \cos 2x, \ldots, \sin nx, \cos nx\}\) 线性无关。
\item 投影：求 \(f(x) = e^x\) 在 \(W = \operatorname{span}\{\sin x,\cos x,\sin 2x,\cos 2x\}\) 中的投影 \(Pf = \sum a_k v_k\)。

由 \(\langle f - Pf, v_k \rangle = 0\) 得正规方程 \(\sum_i \langle v_k, v_i \rangle a_i = \langle f, v_k \rangle\)，即 Gram 矩阵方程 \(G\mathbf{a} = \mathbf{b}\)，其中 \(G_{ij} = \langle v_i, v_j \rangle\)，\(b_i = \langle f, v_i \rangle\)。
\end{enumerate}

