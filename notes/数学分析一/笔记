\chapter{10.17 连续函数}

\section{一、连续与间断}

\subsection{定义}

设 \(f(x)\) 在 \(O(x_0)\) 上有定义。若
\[
\lim_{x \to x_0} f(x) = f(x_0)
\]
则称 \(f(x)\) 在 \(x_0\) 点处\textbf{连续}，\(x_0\) 称为连续点。否则称 \(f(x)\) 在 \(x_0\) 点处\textbf{间断}，\(x_0\) 称为间断点。

\textbf{\(\varepsilon\text{-}\delta\) 语言：}\(\forall \varepsilon > 0\)，\(\exists \delta > 0\)，s.t. \(\forall x \in O(x_0, \delta)\)，\(|f(x) - f(x_0)| < \varepsilon\)。

\subsection{区间上的连续性}

\begin{itemize}
\item \textbf{开区间：}若 \(\forall x_0 \in (a,b)\)，\(f(x)\) 在 \(x_0\) 处连续，则称 \(f(x)\) 在 \((a,b)\) 上连续，记作 \(f(x) \in C(a,b)\)。
\item \textbf{左右连续：}若 \(\displaystyle \lim_{x \to x_0^-} f(x) = f(x_0)\)，称左连续；若 \(\displaystyle \lim_{x \to x_0^+} f(x) = f(x_0)\)，称右连续。
\item \textbf{闭区间：}若 \(f(x)\) 在 \((a,b)\) 连续，且在 \(a\) 处右连续、\(b\) 处左连续，则称 \(f(x)\) 在 \([a,b]\) 上连续，记作 \(f(x) \in C[a,b]\)。
\end{itemize}

\textbf{核心：}\(\displaystyle \lim_{x \to x_0} f(x) = f(x_0) = f\!\left(\lim_{x \to x_0} x\right)\)——对连续函数，极限运算和 \(f\) 可交换次序。

\textbf{数列形式（Heine）：}若 \(f \in C[a,b]\)，则对任意 \(\{x_n\} \subseteq [a,b]\) 且 \(x_n \to x_0\)，\(\displaystyle \lim_{n \to \infty} f(x_n) = f\!\left(\lim_{n \to \infty} x_n\right)\)。

\subsection{例题}

\begin{example}
Dirichlet 型函数 \(f(x) = \begin{cases} x, & x \in \mathbb{Q} \\ 0, & x \notin \mathbb{Q} \end{cases}\)。\(x=0\) 处连续（\(\lim_{x\to 0} f(x) = 0 = f(0)\)），其余点均间断。
\end{example}

\begin{example}
Riemann 函数 \(f(x) = \begin{cases} \frac{1}{q}, & x = \frac{p}{q}\text{（既约）} \\ 0, & x \notin \mathbb{Q} \end{cases}\)。\(\forall x_0 \in \mathbb{R}\)，\(\displaystyle \lim_{x \to x_0} f(x) = 0\)。\(f(x)\) 在 \(0\) 和无理数点连续，在非零有理数点间断。

\begin{proof}
设 \(x_0 \in (k-1, k+1)\)（\(k\) 为最近整数）。\(\forall \varepsilon > 0\)，取 \(N\) 使 \(\frac{1}{N} < \varepsilon\)。

\((k-1, k+1)\) 中满足 \(1 \leq q \leq N\) 的有理数 \(\frac{p}{q}\) 仅有有限个。取其中距 \(x_0\) 最近者 \(x^* \neq x_0\)，令 \(\delta = |x^* - x_0|\)。

当 \(0 < |x - x_0| < \delta\) 时，\(|f(x)| < \frac{1}{N} < \varepsilon\)（有理数分母 \(> N\)，或为无理数取 \(0\)）。\(\therefore \lim_{x \to x_0} f(x) = 0\)。
\end{proof}
\end{example}

\subsection{间断点的分类}

\begin{enumerate}
\item \textbf{可去间断点：}\(\displaystyle \lim_{x \to x_0} f(x)\) 存在，但 \(\neq f(x_0)\)（或 \(f(x_0)\) 未定义）。可通过重定义 \(f(x_0)\) 使其连续。
\item \textbf{第一类间断点：}左右极限均存在但不相等（跳跃间断点）。
\item \textbf{第二类间断点：}左右极限至少有一个不存在（如振荡间断）。
\end{enumerate}

\begin{example}
\begin{enumerate}
\item \(f(x) = \sin\frac{1}{x}\)，\(x=0\)：\(\lim_{x\to 0} \sin\frac{1}{x}\) 不存在，第二类间断点。
\item \(f(x) = x \sin\frac{1}{x}\)，\(x=0\)：\(\lim_{x\to 0} x\sin\frac{1}{x} = 0\)，可去间断点（补充定义 \(f(0)=0\) 即连续）。
\item \(f(x) = [x]\)，\(x=n\)：左右极限分别为 \(n-1\) 和 \(n\)，第一类间断点。
\end{enumerate}
\end{example}

\textbf{定理（单调函数的间断）：}单调函数不存在第二类间断点，仅有连续点或第一类间断点。

若 \(f \uparrow\)，则 \(\displaystyle \lim_{x \to x_0^-} f(x) =: f(x_0^-) \leq f(x_0) \leq f(x_0^+) := \lim_{x \to x_0^+} f(x)\)（记号表示极限值，非函数值）。

\section{二、连续函数的运算}

\begin{enumerate}
\item \textbf{四则运算：}连续函数的加减乘除（除数非零）仍连续。
\item \textbf{复合：}若 \(g(x)\) 在 \(x_0\) 连续，\(f(t)\) 在 \(t_0 = g(x_0)\) 连续，则 \(f \circ g(x)\) 在 \(x_0\) 连续。

\begin{proof}
由极限运算性质：\(\displaystyle \lim_{x \to x_0} f(g(x)) = f\!\left(\lim_{x \to x_0} g(x)\right) = f(g(x_0))\)。
\end{proof}
\end{enumerate}

\section{三、介值定理（零点存在定理）}

\textbf{引理（零点存在定理）：}若 \(f(x) \in C[a,b]\)，且 \(f(a) \cdot f(b) < 0\)，则 \(\exists \xi \in (a,b)\)，s.t. \(f(\xi) = 0\)。

\begin{center}
\includegraphics[width=0.5\textwidth]{images/46_1079_899_689_471_0.jpg}
\end{center}

\begin{proof}
不妨设 \(f(a) < 0\)，\(f(b) > 0\)。用二分法（闭区间套）：

记 \([a_1, b_1] = [a, b]\)，令 \(x_1 = \frac{a_1 + b_1}{2}\)。
\begin{itemize}
\item 若 \(f(x_1) = 0\)，取 \(\xi = x_1\)，证毕。
\item 若 \(f(x_1) > 0\)，令 \([a_2, b_2] = [a_1, x_1]\)；
\item 若 \(f(x_1) < 0\)，令 \([a_2, b_2] = [x_1, b_1]\)。
\end{itemize}
重复操作。若某步找到零点则止；否则构造出闭区间套 \(\{[a_n, b_n]\}\)：
\[
b_n - a_n = \frac{b-a}{2^{n-1}} \to 0,\qquad f(a_n) < 0,\; f(b_n) > 0
\]
设 \(\displaystyle \lim a_n = \lim b_n = \xi\)。由连续性：
\[
0 \geq \lim_{n \to +\infty} f(a_n) = f(\xi) = \lim_{n \to +\infty} f(b_n) \geq 0 \;\Longrightarrow\; f(\xi) = 0
\]
\end{proof}

\textbf{介值定理：}若 \(f(x) \in C[a,b]\)，则 \(f(x)\) 在 \([a,b]\) 上可取到 \(f(a)\) 与 \(f(b)\) 之间的任意值。

\begin{proof}
\(\forall \eta \in [f(a), f(b)]\)（或 \([f(b), f(a)]\)），令 \(g(x) = f(x) - \eta\)。则 \(g \in C[a,b]\) 且 \(g(a) \cdot g(b) = (f(a)-\eta)(f(b)-\eta) < 0\)（若 \(\eta\) 严格在之间）。由零点定理，\(\exists \xi\)，s.t. \(g(\xi) = 0 \Rightarrow f(\xi) = \eta\)。
\end{proof}

\section{四、闭区间上连续函数的性质}

\subsection{1. 有界性}

\textbf{定理：}若 \(f(x) \in C[a,b]\)，则 \(f(x)\) 在 \([a,b]\) 上有界。

\begin{proof}
（三种证法：有限覆盖 / B-W 反证 / 区间套反证。此处用有限覆盖。）

先向左右延拓：令 \(\widetilde{f}(x) = f(a)\)（\(x < a\)），\(\widetilde{f}(x) = f(b)\)（\(x > b\)），使 \(\widetilde{f}\) 在 \((a-\eta, b+\eta)\) 上连续。

\(\forall x_0 \in (a-\eta, b+\eta)\)，由连续性 \(\exists \delta_{x_0} > 0\)，s.t. \(\forall x \in O(x_0, \delta_{x_0})\)，\(|\widetilde{f}(x) - \widetilde{f}(x_0)| < 1\)，即 \(|\widetilde{f}(x)| < 1 + |\widetilde{f}(x_0)|\)。

\(\{O(x_0, \delta_{x_0}) \mid x_0 \in (a-\eta, b+\eta)\}\) 是 \([a,b]\) 的开覆盖。由有限覆盖定理，存在有限子覆盖覆盖 \([a,b]\)。

取 \(M = \max_{1 \leq i \leq n} (1 + |\widetilde{f}(x_0^{(i)})|)\)，则 \(\forall x \in [a,b]\)，\(|f(x)| < M\)。
\end{proof}

\subsection{2. 最大最小值}

\textbf{定理：}闭区间上的连续函数可以取到最大最小值（即上确界和下确界也是函数值）。

\begin{proof}
（反证法）设 \(M = \sup_{x \in [a,b]} f(x)\)。假设 \(\forall x \in [a,b]\)，\(f(x) < M\)。

令 \(\varphi(x) = \dfrac{1}{M - f(x)}\)。由连续函数四则运算，\(\varphi(x) \in C[a,b]\)，故 \(\varphi(x)\) 有界：\(\exists \mu > 0\)，s.t. \(\varphi(x) \leq \mu\)。

即 \(\dfrac{1}{M - f(x)} \leq \mu \Rightarrow f(x) \leq M - \dfrac{1}{\mu} < M\)，与 \(M = \sup f\) 矛盾。

\(\therefore \exists x^* \in [a,b]\)，s.t. \(f(x^*) = M\)。同理可证最小值。
\end{proof}

\subsection{3. 一致连续性（Cantor 定理）}

\textbf{定义：}设 \(f(x)\) 在 \(X\) 上有定义。若 \(\forall \varepsilon > 0\)，\(\exists \delta = \delta(\varepsilon) > 0\)，s.t. \(\forall x', x'' \in X\) 且 \(|x' - x''| < \delta\)，有 \(|f(x') - f(x'')| < \varepsilon\)，则称 \(f(x)\) 在 \(X\) 上\textbf{一致连续}。

\begin{remark}
区别于普通连续：普通连续的 \(\delta\) 依赖于 \(\varepsilon\) 和点 \(x_0\)；一致连续的 \(\delta\) 仅依赖于 \(\varepsilon\)（对整个 \(X\) 统一）。
\end{remark}

\begin{example}
\begin{enumerate}
\item \(f(x) = \sqrt{x}\) 在 \([0, +\infty)\) 上一致连续。\(\forall \varepsilon > 0\)，取 \(\delta = \varepsilon^2\)。
\item \(f(x) = \frac{1}{x}\) 在 \((0, +\infty)\) 上不一致连续。取 \(\varepsilon_0 = 1\)，\(\forall \delta > 0\)，取 \(x_1 = \frac{\delta}{2}\)，\(x_2 = \delta\)，则 \(|f(x_1) - f(x_2)| = \frac{1}{\delta} \geq 1\)。
\item \(f(x) = x^2\) 在 \(\mathbb{R}\) 上不一致连续，但在 \([0,1]\) 上一致连续（是否一致连续与区间选取有关！）。
\end{enumerate}
\end{example}

\textbf{Cantor 定理：}闭区间上连续函数必一致连续。

\begin{proof}
（反证法 + B-W 定理）假设 \(f(x)\) 在 \([a,b]\) 上不一致连续，则
\[
\exists \varepsilon_0 > 0,\; \forall \delta > 0,\; \exists x', x'' \in [a,b] \text{ 且 } |x' - x''| < \delta,\; |f(x') - f(x'')| \geq \varepsilon_0
\]
取 \(\delta = 1\)：\(\exists \alpha_1, \beta_1\)，\(|\alpha_1 - \beta_1| < 1\)，\(|f(\alpha_1) - f(\beta_1)| \geq \varepsilon_0\)。

取 \(\delta = \frac{1}{2}\)：\(\exists \alpha_2, \beta_2\)，\(|\alpha_2 - \beta_2| < \frac{1}{2}\)，\(|f(\alpha_2) - f(\beta_2)| \geq \varepsilon_0\)。

一般地，取 \(\delta = \frac{1}{n}\)：\(\exists \alpha_n, \beta_n \in [a,b]\)，\(|\alpha_n - \beta_n| < \frac{1}{n}\)，\(|f(\alpha_n) - f(\beta_n)| \geq \varepsilon_0\)。

\(\{\alpha_n\} \subseteq [a,b]\) 有界，由 B-W 定理有收敛子列 \(\{\alpha_{n_k}\}\)：\(\displaystyle \lim_{k \to +\infty} \alpha_{n_k} = x^* \in [a,b]\)。

由 \(|\alpha_n - \beta_n| < \frac{1}{n}\)，\(\displaystyle \lim_{k \to +\infty} \beta_{n_k} = x^*\) 亦然。

由连续性：\(\displaystyle \lim_{k \to +\infty} |f(\alpha_{n_k}) - f(\beta_{n_k})| = |f(x^*) - f(x^*)| = 0\)。

但这与构造中 \(|f(\alpha_n) - f(\beta_n)| \geq \varepsilon_0\)（\(\forall n\)）矛盾。
\end{proof}

\begin{center}
\includegraphics[width=0.4\textwidth]{images/51_1182_1583_552_166_0.jpg}
\end{center}

（另一种证法：有限覆盖定理，与有界性证明类似，利用局部连续性 + 有限覆盖得到全局一致连续性。）

