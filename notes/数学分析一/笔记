\section{三、导数与微分}

\subsection{导数的定义}

设 \(f(x)\) 在 \(O(x_0)\) 有定义。若
\[
\lim_{\Delta x \to 0} \frac{f(x_0 + \Delta x) - f(x_0)}{\Delta x}
\]
存在（有限），称 \(f(x)\) 在 \(x_0\) 处\textbf{可导}，极限值称为 \(f(x)\) 在 \(x_0\) 处的\textbf{导数}，记作 \(f'(x_0)\) 或 \(\left.\frac{df}{dx}\right|_{x=x_0}\)。

\textbf{几何意义：}曲线 \(y = f(x)\) 在 \(x_0\) 处的切线斜率。

\textbf{物理意义：}\(s = s(t)\) 为位移，\(s'(t_0) = \displaystyle \lim_{h \to 0} \frac{s(t_0+h) - s(t_0)}{h}\) 为 \(t_0\) 时刻的瞬时速度。\(v'(t_0)\) 为瞬时加速度。

\subsection{区间上的可导性}

\begin{itemize}
\item \textbf{开区间：}若 \(\forall x \in (a,b)\)，\(f\) 在 \(x\) 处可导，称 \(f\) 在 \((a,b)\) 上可导。
\item \textbf{闭区间：}若 \(f\) 在 \((a,b)\) 可导，且在 \(a\) 处右导数存在、\(b\) 处左导数存在，称 \(f\) 在 \([a,b]\) 上可导。
\end{itemize}

导数是一种由极限定义的运算：\(x \mapsto f'(x)\)，由此定义\textbf{导函数} \(f'(x)\)。\(f(x)\) 称为 \(f'(x)\) 的\textbf{原函数}。

\subsection{基本初等函数的导数}

\begin{enumerate}
\item \(f(x) \equiv C\)（常数）：\(f'(x) = \displaystyle \lim_{h \to 0} \frac{C - C}{h} = 0\)。

\item \(f(x) = x^n\)（\(n \in \mathbb{N}\)）：
\[
f'(x) = \lim_{h \to 0} \frac{(x+h)^n - x^n}{h} = \lim_{h \to 0} \frac{nx^{n-1}h + \cdots}{h} = nx^{n-1}
\]

\item \(f(x) = \sin x\)：\(f'(x) = \displaystyle \lim_{h \to 0} \frac{\sin(x+h) - \sin x}{h} = \cos x\)。

\item \(f(x) = \cos x\)：\(f'(x) = \displaystyle \lim_{h \to 0} \frac{\cos(x+h) - \cos x}{h} = -\sin x\)。

\item \(f(x) = e^x\)：\(f'(x) = \displaystyle \lim_{h \to 0} \frac{e^{x+h} - e^x}{h} = e^x \lim_{h \to 0} \frac{e^h - 1}{h} = e^x\)。

\textbf{推广：}\(f(x) = e^{\lambda x}\)：\(f'(x) = \lambda e^{\lambda x}\)。即若 \(f'(x) = \lambda f(x)\)，\(f\) 为指数函数（微分方程）。

\item \(f(x) = a^x\)（\(a > 0\)）：
\[
f'(x) = \lim_{h \to 0} \frac{a^{x+h} - a^x}{h} = a^x \lim_{h \to 0} \frac{a^h - 1}{h} = a^x \ln a
\]

\item \(f(x) = \ln x\)：
\[
f'(x) = \lim_{h \to 0} \frac{\ln(x+h) - \ln x}{h} = \lim_{h \to 0} \frac{\ln(1 + \frac{h}{x})}{h} = \frac{1}{x}
\]

\textbf{推广：}\(f(x) = \log_a x = \frac{\ln x}{\ln a}\)：\(f'(x) = \dfrac{1}{x \ln a}\)。

\item \(f(x) = x^{\alpha}\)（\(\alpha \in \mathbb{R}\)，\(x > 0\)）：
\[
f'(x) = \lim_{h \to 0} \frac{(x+h)^{\alpha} - x^{\alpha}}{h}
= x^{\alpha} \lim_{h \to 0} \frac{(1 + \frac{h}{x})^{\alpha} - 1}{h} = \alpha x^{\alpha - 1}
\]

\textbf{例：}\((\sqrt{x})' = \frac{1}{2}x^{-1/2} = \frac{1}{2\sqrt{x}}\)，\((\frac{1}{\sqrt{x}})' = -\frac{1}{2}x^{-3/2}\)。
\end{enumerate}

\subsection{求导法则}

\textbf{线性性：}若 \(f, g\) 在 \(x_0\) 处可导，则
\[
(cf)' = c f',\qquad (f \pm g)' = f' \pm g'
\]

\textbf{定理（可导 \(\Rightarrow\) 连续）：}若 \(f(x)\) 在 \(x_0\) 处可导，则 \(f(x)\) 在 \(x_0\) 处连续。逆不成立（如 \(|x|\) 在 \(x=0\)）。

\begin{proof}
\(f(x_0 + \Delta x) = f(x_0) + \frac{f(x_0 + \Delta x) - f(x_0)}{\Delta x} \cdot \Delta x\)。

令 \(\Delta x \to 0\)：\(\lim f(x_0 + \Delta x) = f(x_0) + f'(x_0) \cdot 0 = f(x_0)\)。
\end{proof}

\subsection{单侧导数}

\textbf{左导数：}\(\displaystyle f_-'(x_0) = \lim_{h \to 0^-} \frac{f(x_0 + h) - f(x_0)}{h}\)。

\textbf{右导数：}\(\displaystyle f_+'(x_0) = \lim_{h \to 0^+} \frac{f(x_0 + h) - f(x_0)}{h}\)。

\(f\) 在 \(x_0\) 可导 \(\Leftrightarrow\) \(f_-'(x_0), f_+'(x_0)\) 存在且相等。

\begin{example}
\(f(x) = \begin{cases} x\sin\frac{1}{x}, & x \neq 0 \\ 0, & x = 0 \end{cases}\) 在 \(x=0\) 处连续，但 \(\lim_{h \to 0} \frac{h\sin\frac{1}{h}}{h} = \lim_{h \to 0} \sin\frac{1}{h}\) 不存在，故不可导。
\end{example}

\subsection{微分}

\textbf{定义（可微性）：}若 \(\exists A \in \mathbb{R}\)，s.t.
\[
f(x) - f(x_0) = A(x - x_0) + o(x - x_0) \quad (x \to x_0)
\]
则称 \(f\) 在 \(x_0\) 处\textbf{可微}。线性主部 \(A(x-x_0)\) 称为 \(f\) 在 \(x_0\) 处的\textbf{微分}，记作 \(dy = A\,dx\)。

\textbf{定理：}对一元函数，\(f\) 在 \(x_0\) 处可微 \(\Leftrightarrow\) \(f\) 在 \(x_0\) 处可导，且 \(A = f'(x_0)\)。

\begin{proof}
\(\Rightarrow\)：\(\frac{f(x) - f(x_0)}{x - x_0} = A + \frac{o(x-x_0)}{x-x_0} \to A\)，故 \(f'(x_0) = A\)。

\(\Leftarrow\)：由 \(f'(x_0) = \lim \frac{f(x)-f(x_0)}{x-x_0}\) 得 \(\frac{f(x)-f(x_0)}{x-x_0} - f'(x_0) \to 0\)，即 \(f(x)-f(x_0) - f'(x_0)(x-x_0) = o(x-x_0)\)。
\end{proof}

