\section{一、聚点回顾与扩充}

回顾：有界无穷点集必有聚点。

聚点定义：设 \(E \subseteq \mathbb{R}\) 为无穷点集，若 \(x_0 \in \mathbb{R}\) 满足
\[
\forall \varepsilon > 0,\; \exists x \in E,\; 0 < |x - x_0| < \varepsilon
\]
则称 \(x_0\) 为 \(E\) 的聚点。

\textbf{扩充定义（\(\infty\) 为聚点）：}设 \(E \subseteq \mathbb{R}\)，若 \(\forall M > 0\)，\(\exists x \in E\)，s.t. \(|x| > M\)，则称 \(\infty\) 为 \(E\) 的聚点。这等价于 \(E\) 是无界的（无界点集一定是无穷点集）。

\textbf{小结：}任意无穷点集必有聚点——
\begin{enumerate}
\item 有界 \(\Rightarrow\) 有常规聚点；
\item 无界 \(\Rightarrow\) \(\infty\) 为聚点。
\end{enumerate}

\textbf{闭包：}\(\overline{E} = E \cup \{E\text{ 的聚点}\}\)。闭包的聚点仍在 \(\overline{E}\) 中（即闭包是闭集）。

\begin{proof}
（反证法）若不然，设 \(x_1^*, x_2^*, \ldots\) 为 \(E\) 的聚点，\(x^{**}\) 为 \(\{x_i^*\}\) 的聚点，且 \(x^{**} \notin E\)，\(x^{**}\) 不是 \(E\) 的聚点。

则 \(\exists \varepsilon_0 > 0\)，s.t. \(O(x^{**}, \varepsilon_0) \cap E = \varnothing\)。

但 \(x^{**}\) 是 \(\{x_i^*\}\) 的聚点 \(\Rightarrow\) 对于 \(\varepsilon_1 = \frac{1}{3}\varepsilon_0\)，\(\exists x_m^*\)，s.t. \(0 < |x^{**} - x_m^*| < \varepsilon_1\)。

又 \(x_m^*\) 是 \(E\) 的聚点 \(\Rightarrow\) 对于 \(\varepsilon_2 = \frac{1}{3}\varepsilon_0\)，\(\exists x \in E\)，s.t. \(0 < |x_m^* - x| < \varepsilon_2\)。

于是 \(|x^{**} - x| \leq |x^{**} - x_m^*| + |x_m^* - x| < \frac{2}{3}\varepsilon_0 < \varepsilon_0\)，即 \(x \in O(x^{**}, \varepsilon_0) \cap E\)，矛盾。
\end{proof}

\section{二、子数列与 Bolzano--Weierstrass 定理}

\subsection{子数列}

\textbf{定义：}设 \(\{x_n\}\) 为数列，\(\{n_k\}\) 是严格递增的正整数列，则 \(\{x_{n_k}\}\) 称为 \(\{x_n\}\) 的一个\textbf{子数列}（保留原次序，去掉某些项）。

例：\(x_1, x_3, \ldots, x_{2n+1}, \ldots\)（奇子列）；\(x_2, x_4, \ldots, x_{2n}, \ldots\)（偶子列）。

\textbf{性质：}
\begin{enumerate}
\item \(n_k \geq k\)，且 \(n_k \to +\infty\)（当 \(k \to +\infty\) 时）。
\item 若 \(\displaystyle \lim_{n \to +\infty} x_n = a\)，则 \(\displaystyle \lim_{k \to +\infty} x_{n_k} = a\)（收敛数列的任意子列收敛于同一极限）。
\end{enumerate}

\subsection{Bolzano--Weierstrass 定理（列紧性）}

\textbf{定理：}任意有界数列必有收敛子列。

\begin{proof}
\begin{enumerate}
\item 若数列中有无穷项相同，则结论显然成立（取该常数子列）。
\item 若不存在无穷项相同，记 \(E = \{x_n \mid n \in \mathbb{N}\}\)（去掉重复项后 \(E\) 仍为无穷集）。

则 \(E\) 为有界无穷点集，由聚点原理，\(\exists x^* \in \mathbb{R}\) 为 \(E\) 的聚点。

由聚点定义构造收敛子列：
\begin{itemize}
\item 取 \(\varepsilon_1 = 1\)，\(\exists x_{n_1} \in E\)，s.t. \(0 < |x_{n_1} - x^*| < \varepsilon_1\)。
\item 取 \(\varepsilon_2 = \min\{\frac{1}{2}, \min_{k \leq n_1} |x_k - x^*|\}\)，\(\exists x_{n_2} \in E\)，s.t. \(0 < |x_{n_2} - x^*| < \varepsilon_2\)，且 \(n_2 > n_1\)。
\item 一般地，取 \(\varepsilon_l = \min\{\frac{1}{l}, \min_{k \leq n_{l-1}} |x_k - x^*|\}\)，\(\exists x_{n_l} \in E\)，s.t. \(0 < |x_{n_l} - x^*| < \varepsilon_l\)。
\end{itemize}
如此构造的子列 \(\{x_{n_l}\}\) 满足 \(|x_{n_l} - x^*| < \frac{1}{l} \to 0\)，故收敛于 \(x^*\)。
\end{enumerate}
\end{proof}

\textbf{扩充：}无界数列必有子列趋于 \(\infty\)（仿前证明）。综上，任意（广义）数列都有收敛子列。

\section{三、Cauchy 收敛准则（完备性定理）}

\subsection{Cauchy 列的定义}

若 \(\forall \varepsilon > 0\)，\(\exists N \in \mathbb{N}\)，s.t. \(\forall n, m > N\)，\(|x_n - x_m| < \varepsilon\)，则称 \(\{x_n\}\) 为\textbf{基本列}（Cauchy 列）。

等价定义：\(\forall \varepsilon > 0\)，\(\exists N \in \mathbb{N}\)，s.t. \(\forall n > N\)，\(\forall p \in \mathbb{N}\)，\(|x_{n+p} - x_n| < \varepsilon\)。

\subsection{Cauchy 收敛定理}

\textbf{定理：}实数列 \(\{x_n\}\) 收敛 \(\Leftrightarrow\) \(\{x_n\}\) 是 Cauchy 列。

\begin{proof}
\(\Rightarrow\)：由极限定义易证。

\(\Leftarrow\)：

\textbf{Step 1.} 证明 \(\{x_n\}\) 有界：取 \(\varepsilon = 1\)，\(\exists N_0 \in \mathbb{N}\)，s.t. \(\forall n, m > N_0\)，\(|x_n - x_m| < 1\)。

则 \(\forall n \geq N_0+1\)，\(|x_n| \leq |x_n - x_{N_0+1}| + |x_{N_0+1}| < 1 + |x_{N_0+1}|\)。

取 \(M = \max\{|x_1|, \ldots, |x_{N_0}|, 1+|x_{N_0+1}|\}\)，则 \(\forall n\)，\(|x_n| \leq M\)。

\textbf{Step 2.} 由 B-W 定理，\(\{x_n\}\) 有收敛子列 \(\{x_{n_k}\}\)，设 \(\displaystyle \lim_{k \to \infty} x_{n_k} = a\)。

\(\forall \varepsilon > 0\)：
\begin{itemize}
\item 由子列收敛，\(\exists K \in \mathbb{N}\)，s.t. \(\forall k > K\)，\(|x_{n_k} - a| < \frac{\varepsilon}{2}\)。
\item 由 Cauchy 条件，\(\exists N' \in \mathbb{N}\)，s.t. \(\forall n, m > N'\)，\(|x_n - x_m| < \frac{\varepsilon}{2}\)。
\end{itemize}

取 \(N = \max\{K, N'\}\)，选 \(k > N\)（此时 \(n_k \geq k > N\)）。对 \(\forall n > N\)：
\[
|x_n - a| \leq |x_n - x_{n_k}| + |x_{n_k} - a| < \frac{\varepsilon}{2} + \frac{\varepsilon}{2} = \varepsilon
\]
由极限定义，\(\displaystyle \lim_{n \to +\infty} x_n = a\)。
\end{proof}

\textbf{逆否命题：}\(\{x_n\}\) 不是 Cauchy 列 \(\Leftrightarrow\) \(\exists \varepsilon_0 > 0\)，s.t. \(\forall N \in \mathbb{N}\)，\(\exists n, m > N\)，\(|x_n - x_m| \geq \varepsilon_0\)。

\begin{example}
\(x_n = 1 + \frac{1}{2} + \cdots + \frac{1}{n} = \sum_{k=1}^{n} \frac{1}{k}\)（调和级数部分和）不是 Cauchy 列。

取 \(\varepsilon = \frac{1}{2}\)，无论 \(N\) 多大，取 \(n > N\)：
\[
|x_{2n} - x_n| = \frac{1}{n+1} + \frac{1}{n+2} + \cdots + \frac{1}{2n} > \frac{1}{2n} \cdot n = \frac{1}{2} = \varepsilon
\]
\(\therefore \{x_n\}\) 不是 Cauchy 列，故不收敛。
\end{example}

\begin{example}
\(x_n = 1 + \frac{1}{2^2} + \frac{1}{3^2} + \cdots + \frac{1}{n^2} = \sum_{k=1}^{n} \frac{1}{k^2}\) 是 Cauchy 列。

\begin{align*}
|x_{n+p} - x_n| &= \frac{1}{(n+1)^2} + \cdots + \frac{1}{(n+p)^2} \\
&< \frac{1}{n(n+1)} + \cdots + \frac{1}{(n+p-1)(n+p)} \\
&= \left(\frac{1}{n} - \frac{1}{n+1}\right) + \cdots + \left(\frac{1}{n+p-1} - \frac{1}{n+p}\right) \\
&= \frac{1}{n} - \frac{1}{n+p} < \frac{1}{n}
\end{align*}

\(\forall \varepsilon > 0\)，取 \(N = [\frac{1}{\varepsilon}]+1\)，则 \(\forall n > N\)，\(\forall p\)，\(|x_{n+p} - x_n| < \varepsilon\)。

\(\therefore \{x_n\}\) 收敛。事实上 \(\displaystyle \sum_{k=1}^{\infty} \frac{1}{k^2} = \frac{\pi^2}{6}\)（数分中将证明）。

\textbf{趣闻：}任意两个自然数互质的概率 \(= \left(\sum_{n=1}^{\infty} \frac{1}{n^2}\right)^{-1} = \frac{6}{\pi^2} \approx 60.8\%\)。
\end{example}

\subsection{实数完备性定理小结}

以下八个定理在实数系中等价：
\begin{enumerate}
\item 闭区间套定理
\item 确界定理
\item 单调有界数列必有极限
\item 有限开覆盖定理（Heine--Borel）
\item 聚点原理
\item Bolzano--Weierstrass 定理
\item Cauchy 收敛准则（完备性定理）
\item 戴德金分割定理
\end{enumerate}

\begin{proof}
（用 Cauchy 收敛准则证明闭区间套定理——演示等价性）

设 \(\{[a_n, b_n]\}\) 为闭区间套：\([a_{n+1}, b_{n+1}] \subseteq [a_n, b_n]\)，且 \(b_n - a_n \to 0\)。

\(\forall \varepsilon > 0\)，\(\exists N \in \mathbb{N}\)，s.t. \(\forall n > N\)，\(0 \leq b_n - a_n < \varepsilon\)。

\(\forall n > N\)，\(\forall p \in \mathbb{N}\)：由区间套性质，\(a_N \leq a_n \leq a_{n+p} \leq b_{n+p} \leq b_n \leq b_N\)，

故 \(|a_{n+p} - a_n| \leq b_n - a_n < \varepsilon\)，同理 \(|b_{n+p} - b_n| < \varepsilon\)。

\(\therefore \{a_n\}, \{b_n\}\) 均为 Cauchy 列，由 Cauchy 收敛准则，\(\exists \lim a_n = \lim b_n =: c\)。

固定 \(n\)，\(\forall p\)：\(a_n \leq a_{n+p} \leq b_{n+p} \leq b_n\)。令 \(p \to +\infty\) 取极限：\(a_n \leq c \leq b_n\)，\(\forall n\)。

\(\therefore c \in \bigcap_{n=1}^{\infty} [a_n, b_n]\)（存在性）。唯一性由 \(b_n - a_n \to 0\) 得证。
\end{proof}

\section{四、Stolz 定理（离散 L'H\^opital）}

\textbf{定理（Stolz）：}设 \(\{x_n\}\) 严格单调且无界，\(\{y_n\}\) 为实数列。若
\[
\lim_{n \to +\infty} \frac{y_{n+1} - y_n}{x_{n+1} - x_n} = a \quad (\text{有限值或 }\pm\infty)
\]
则 \(\displaystyle \lim_{n \to +\infty} \frac{y_n}{x_n} = a\)。

\begin{proof}
（仅证 \(a\) 为有限值的情形）令 \(x_0 = 0\)，\(y_0 = 0\)。则
\[
\frac{y_n}{x_n} = \frac{1}{x_n} \sum_{k=1}^{n} (y_k - y_{k-1})
= \sum_{k=1}^{n} \frac{x_k - x_{k-1}}{x_n} \cdot \frac{y_k - y_{k-1}}{x_k - x_{k-1}}
\]
\[
\frac{y_n}{x_n} - a = \sum_{k=1}^{n} \frac{x_k - x_{k-1}}{x_n}\left(\frac{y_k - y_{k-1}}{x_k - x_{k-1}} - a\right)
\]
记 \(\alpha_k = \dfrac{y_k - y_{k-1}}{x_k - x_{k-1}} - a\)，\(\beta_{k,n} = \dfrac{x_k - x_{k-1}}{x_n}\)，则
\[
\frac{y_n}{x_n} - a = \sum_{k=1}^{n} \beta_{k,n} \, \alpha_k
\]

由条件 \(\alpha_k \to 0\)，\(\forall \varepsilon > 0\)，\(\exists N_0 \in \mathbb{N}\)，s.t. \(\forall k > N_0\)，\(|\alpha_k| < \frac{\varepsilon}{2}\)。

又 \(\forall k\)，\(\displaystyle \lim_{n \to +\infty} \beta_{k,n} = \lim_{n \to +\infty} \frac{x_k - x_{k-1}}{x_n} = 0\)（因 \(x_n \to \infty\)），故 \(\exists N_k\)，s.t. \(\forall n > N_k\)，\(|\beta_{k,n}| < \frac{\varepsilon}{2M N_0}\)（其中 \(M = \sup |\alpha_k|\)）。

取 \(N = \max\{N_0, N_1, \ldots, N_{N_0}\}\)，则 \(\forall n > N\)：
\begin{align*}
\left|\frac{y_n}{x_n} - a\right|
&= \left|\sum_{k=1}^{N_0} \beta_{k,n} \alpha_k + \sum_{k=N_0+1}^{n} \beta_{k,n} \alpha_k\right| \\
&\leq \sum_{k=1}^{N_0} |\beta_{k,n}| \cdot |\alpha_k| + \sum_{k=N_0+1}^{n} \beta_{k,n} \cdot \frac{\varepsilon}{2} \\
&< N_0 \cdot \frac{\varepsilon}{2M N_0} \cdot M + \frac{\varepsilon}{2} \cdot \sum_{k=N_0+1}^{n} \beta_{k,n} \\
&= \frac{\varepsilon}{2} + \frac{\varepsilon}{2} = \varepsilon
\end{align*}

\(\therefore \displaystyle \lim_{n \to +\infty} \frac{y_n}{x_n} = a\)。
\end{proof}

\textbf{注：}Stolz 定理是数列极限的 L'H\^opital 法则，对 \(\frac{0}{0}\) 型和 \(\frac{*}{\infty}\) 型均适用（严格单调无界的 \(x_n\) 保证分母趋于 \(\infty\)）。

