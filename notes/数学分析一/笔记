\chapter{12.9 习题课}

\section{一、基本积分公式表}

\[
\begin{aligned}
\int k\,dx &= kx + C &
\int x^n\,dx &= \frac{x^{n+1}}{n+1} + C \;(n \neq -1) \\
\int \frac{dx}{x} &= \ln|x| + C &
\int a^x\,dx &= \frac{a^x}{\ln a} + C \\
\int e^x\,dx &= e^x + C &
\int \sin x\,dx &= -\cos x + C \\
\int \cos x\,dx &= \sin x + C &
\int \sec^2 x\,dx &= \tan x + C \\
\int \csc^2 x\,dx &= -\cot x + C &
\int \sec x\tan x\,dx &= \sec x + C \\
\int \csc x\cot x\,dx &= -\csc x + C &
\int \frac{dx}{\sqrt{1-x^2}} &= \arcsin x + C \\
\int \frac{dx}{1+x^2} &= \arctan x + C &
\int \frac{dx}{a^2+x^2} &= \frac1a\arctan\frac{x}{a} + C \\
\int \frac{dx}{\sqrt{a^2-x^2}} &= \arcsin\frac{x}{a} + C &
\int \frac{dx}{x^2-a^2} &= \frac1{2a}\ln\left|\frac{x-a}{x+a}\right| + C \\
\int \frac{dx}{\sqrt{x^2 \pm a^2}} &= \ln|x + \sqrt{x^2\pm a^2}| + C
\end{aligned}
\]

\section{二、常用进阶积分}

\[
\begin{aligned}
\int \tan x\,dx &= -\ln|\cos x| + C &
\int \cot x\,dx &= \ln|\sin x| + C \\
\int \sec x\,dx &= \ln|\sec x + \tan x| + C &
\int \csc x\,dx &= \ln|\csc x - \cot x| + C \\
\int \sqrt{a^2-x^2}\,dx &= \frac{x}{2}\sqrt{a^2-x^2} + \frac{a^2}{2}\arcsin\frac{x}{a} + C \\
\int \sqrt{x^2\pm a^2}\,dx &= \frac{x}{2}\sqrt{x^2\pm a^2} \pm \frac{a^2}{2}\ln|x+\sqrt{x^2\pm a^2}| + C
\end{aligned}
\]

\section{三、积分方法总结}

\subsection{1. 凑微分法}

\(\int f[\varphi(x)]\,\varphi'(x)\,dx = \int f[\varphi(x)]\,d\varphi(x)\)。

常见凑微分：\(f(ax+b)dx = \frac1a f(ax+b)d(ax+b)\)、\(f(\ln x)\frac{dx}{x} = f(\ln x)d\ln x\)、\(f(\sin x)\cos x\,dx = f(\sin x)d\sin x\)。

\subsection{2. 变量代换法（换元法）}

\begin{itemize}
\item 三角代换：\(\sqrt{1-x^2}\) 令 \(x = \cos t\)；\(\sqrt{x^2\pm a^2}\) 令 \(x = a\tan t\) 或 \(a\sec t\)。
\item 根式代换：\(\sqrt[n]{ax+b} = t\)。
\item 倒代换：\(t = 1/x\)。
\end{itemize}

\subsection{3. 分部积分法}

\(\int u\,dv = uv - \int v\,du\)。口诀："反对幂指三"（按此顺序优先选 \(u\)）。

\subsection{4. 检验方法}

求导验证结果是否正确。注意积分常数和定义区间。

\section{四、思考题}

\begin{enumerate}
\setcounter{enumi}{1}
\item 利用几何意义求下列积分：
\begin{enumerate}
\item \(\int_a^b x\,dx = \frac{(a+b)(b-a)}{2}\)（梯形面积）。
\item \(\int_a^b \sqrt{(x-a)(b-x)}\,dx = \frac{\pi}{2}\!\left(\frac{b-a}{2}\right)^2\)（上半圆面积，半径 \(\frac{b-a}{2}\)）。
\item \(\int_a^b \left|x - \frac{a+b}{2}\right|dx = \frac{(b-a)^2}{4}\)（两个三角形面积之和）。
\end{enumerate}

\item 设 \(f(x)\) 在 \([a,b]\) 上可积且为凸函数，求证：
\[
(b-a)\,f\!\left(\frac{a+b}{2}\right) \leq \int_a^b f(x)\,dx
\]
\begin{proof}
将 \([a,b]\) \(2n\) 等分，分点 \(a = x_0 < x_1 < \cdots < x_{2n} = b\)，中点 \(x_n = \frac{a+b}{2}\)。

由凸函数的中点凸性：\(f\!\left(\frac{a+b}{2}\right) \leq \frac{1}{2}[f(x_{n+k}) + f(x_{n-k})]\)（\(k = 1,\ldots,n\)）。

平均得 \(f\!\left(\frac{a+b}{2}\right) \leq \frac{1}{2n}\sum_{i=0}^{2n} f(x_i)\)。令 \(n \to \infty\)，右边 \(\to \frac{1}{b-a}\int_a^b f(x)\,dx\)（积分平均值），即得证。
\end{proof}

\item 判断 \(\int \frac{dx}{\sqrt{1-\sin^2 x}}\) 是否可用 Chebyshev 形式积分。

令 \(t = \sin x\)，原式 \(= \int \frac{dt}{\sqrt{1-t^4}} = \int (1-t^4)^{-1/2}\,dt\)。Chebyshev 形式：\(m=0\), \(n=4\), \(p=-\frac12\)。\(\frac{m+1}{n} = \frac14 \notin \mathbb{Z}\)，\(\frac{m+1}{n}+p = -\frac14 \notin \mathbb{Z}\)，\(p \notin \mathbb{Z}\)，故非初等。
\end{enumerate}

