\chapter{习题课：期中考试题解析}

\begin{enumerate}

\item 求 \(\displaystyle \lim_{n \to +\infty} \sin\!\left(\pi\sqrt{n^2+n}\right)\)。

\textbf{解：}\(\sin(\pi\sqrt{n^2+n}) = \sin\!\left[(\sqrt{n^2+n}-n)\pi + n\pi\right]\)。

\(n\) 为奇数（\(n=2k-1\)）：原式 \(= -\sin[(\sqrt{n^2+n}-n)\pi] \to -\sin\frac{\pi}{2} = -1\)。

\(n\) 为偶数（\(n=2k\)）：原式 \(= \sin[(\sqrt{n^2+n}-n)\pi] \to \sin\frac{\pi}{2} = 1\)。

子列极限不同 \(\Rightarrow\) 原极限不存在。

\item 求 \(\displaystyle \lim_{x \to 0} \left(\frac{1+e^x}{2}\right)^{\frac{e}{x}}\)。

\textbf{解：}取对数：\(\displaystyle \lim_{x \to 0} \frac{e\ln\frac{1+e^x}{2}}{x} = e \cdot \lim_{x \to 0} \frac{e^x}{1+e^x} = \frac{e}{2}\)，\(\therefore\) 原式 \(= e^{e/2}\)。

\item 求 \(\displaystyle \lim_{x \to +\infty} \left(\frac{2}{\pi}\arctan x\right)^x\)。

\textbf{解：}取对数后用 L'H\^opital：\(\displaystyle \lim_{x \to +\infty} x\ln\!\left(\frac{2}{\pi}\arctan x\right) = -\frac{2}{\pi}\)，\(\therefore\) 原式 \(= e^{-2/\pi}\)。

\item 若 \(f(x)\) 在有限区间 \((a,b)\) 上一致连续，求证 \(f(a^+), f(b^-)\) 均存在。无穷区间结论是否成立？

\begin{proof}
\(\forall \{x_n\} \to a^+\)。由一致连续：\(\forall \varepsilon > 0\)，\(\exists \delta > 0\)，s.t. \(|x_1-x_2| < \delta \Rightarrow |f(x_1)-f(x_2)| < \varepsilon\)。\(\exists N\)，当 \(m,n > N\) 时 \(x_m,x_n \in (a, a+\delta)\)，故 \(|f(x_m)-f(x_n)| < \varepsilon\)。\(\{f(x_n)\}\) 为 Cauchy 列 \(\Rightarrow\) 收敛。由归结原则 \(f(a^+)\) 存在。同理 \(f(b^-)\) 存在。

无穷区间不成立（反例 \(f(x) = \sin x\) 在 \((-\infty,+\infty)\) 一致连续但无穷远处极限不存在）。
\end{proof}

\item \(x_0 > 1\)，\(x_{n+1} = \frac{2x_n^2}{1+x_n^2}\)。判断 \(\displaystyle \lim_{n \to +\infty} x_n\) 是否存在。

\textbf{解：}\(x_n > 0\)，\(\frac{x_{n+1}}{x_n} = \frac{2x_n}{1+x_n^2} \leq 1\)（均值不等式），故 \(\{x_n\} \downarrow\) 有下界 \(0 \Rightarrow\) 极限存在。设极限为 \(A\)，代入递推得 \(A = \frac{2A^2}{1+A^2} \Rightarrow A=0\) 或 \(A=1\)。由 \(x_0 > 1\) 且单调递减知 \(A = 1\)。

\item 设 \(f(x)\) 是 \(\mathbb{R}\) 上以 \(1\) 为周期的连续函数。求证：\(\forall n \in \mathbb{N}\)，\(\exists c \in [0,1)\)，满足 \(f(c) = f(c + \frac{1}{n})\)。

\begin{proof}
若 \(f\) 为常数则显然。否则在 \([0,1]\) 上取极大值点 \(M\)。令 \(g(x) = f(x) - f(x + \frac{1}{n})\)，\(g\) 连续。\(g(M) = f(M) - f(M+\frac{1}{n}) > 0\)，\(g(M-\frac{1}{n}) = f(M-\frac{1}{n}) - f(M) < 0\)。由介值定理 \(\exists \eta\)，s.t. \(g(\eta) = 0\)。取 \(c = \eta\)（若 \(\eta \geq 0\)）或 \(c = \eta+1\)（若 \(\eta < 0\)）。
\end{proof}

\item 求证心脏线 \(r = a(1-\cos\theta)\) 向径与切线的夹角等于极角的一半。

\textbf{解：}\(\displaystyle \tan\beta = \frac{r(\theta)}{r'(\theta)} = \frac{a(1-\cos\theta)}{a\sin\theta} = \tan\frac{\theta}{2}\)，\(\therefore \beta = \frac{\theta}{2}\)。

\item 设 \(f(x)\) 在 \(x=0\) 处有二阶导数，且 \(\displaystyle \lim_{x \to 0} \frac{f(x)}{x} = 0\)。求证 \(\displaystyle \sum_{k=1}^{\infty} f\!\left(\frac{1}{k}\right)\) 收敛。

\begin{proof}
由条件 \(f(0)=0\)，\(f'(0)=0\)。\(f''(0) = \lim_{h \to 0} \frac{f'(h)}{h}\) 存在 \(\Rightarrow\) \(\exists O^-(0)\)，s.t. \(|f'(x)| \leq A|x|\)。

\(\forall h\) 充分小：\(|f(h)| = |f(h)-f(0)| = |f'(\xi)|\,h \leq A\,\xi\,h \leq A h^2\)（Lagrange 中值定理）。

\(\displaystyle \left|\sum_{k=m+1}^{n} f\!\left(\frac{1}{k}\right)\right| \leq A\sum_{k=m+1}^{n} \frac{1}{k^2}\)，而 \(\sum \frac{1}{k^2}\) 收敛。由 Cauchy 收敛准则，级数收敛。
\end{proof}

\end{enumerate}

