\item 掌握作业题——是考试难度的下界。
\item 二级结论（欧拉常数、Stolz 定理等）可以直接使用。自己整理。
\item 往年题，不要"过拟合"。
\end{enumerate}

\section{二、无穷小量的阶——运算规则}

\begin{itemize}
\item \(f(x) \to 0\)（\(x \to a\)）称无穷小量。
\item \(f(x) = O(g(x))\)：\(f/g\) 有界。
\item \(f(x) = o(g(x))\)：\(f/g \to 0\)（高阶无穷小）。
\item \(f(x) \sim g(x)\)：\(f/g \to 1\)（等价无穷小）。
\end{itemize}

\textbf{运算规则：}
\[
\begin{aligned}
f(x) = O(1) &\;\Longleftrightarrow\; f\text{ 有界}, &
f(x) = o(1) &\;\Longleftrightarrow\; f\text{ 是无穷小}, \\
o(f(x)) &= O(f(x)) \quad (\text{高阶也是同阶有界}), \\
O(f) + O(f) &= O(f), &
o(1) \cdot O(f) &= o(f), \\
\frac{o(f)}{g} &= O\!\left(\frac{f}{g}\right), &
\frac{O(f)}{g} &= O\!\left(\frac{f}{g}\right)
\end{aligned}
\]

\textbf{等价定义：}\(f = \beta \cdot g\)，若 \(\beta\) 有界则 \(f = O(g)\)；\(\beta \to 0\) 则 \(f = o(g)\)；\(\beta \to 1\) 则 \(f \sim g\)。

\section{三、思考题}

\begin{enumerate}
\item 设 \(f(x) \in C(-\infty, +\infty)\)，且 \(\displaystyle \lim_{x \to \pm\infty} f(x) = +\infty\)。证明：\(f(x)\) 在 \((-\infty, +\infty)\) 上取到最小值。

\begin{proof}
任取 \(x^*\)，记 \(M_0 = f(x^*)\)。由 \(\lim_{x\to\pm\infty} f = +\infty\)，\(\exists X > 0\)，s.t. \(\forall |x| > X\)，\(f(x) > M_0 + 1\)。

在闭区间 \([-X, X]\) 上，\(f\) 连续 \(\Rightarrow\) 取到最小值 \(m\)。而 \(m \leq f(x^*) = M_0 < M_0 + 1\)，故 \(m\) 就是全局最小值。
\end{proof}

\item 设 \(f(x) \in C[a,b]\)，\(\forall x \in [a,b]\)，\(\exists y \in [a,b]\)，s.t. \(|f(y)| \leq \frac{1}{2}|f(x)|\)。求证：\(\exists \xi \in [a,b]\)，s.t. \(f(\xi) = 0\)。

\begin{proof}
任取 \(x_0 \in [a,b]\)。反复应用条件构造序列：\(|f(x_n)| \leq \frac{1}{2^n}|f(x_0)|\)。\(\{x_n\} \subseteq [a,b]\) 有界，由 B-W 定理有收敛子列 \(x_{n_k} \to \xi\)。由连续性 \(|f(\xi)| = \lim |f(x_{n_k})| = 0\)，故 \(f(\xi) = 0\)。
\end{proof}

\item 分别用单调性和 Cauchy 收敛原理证明 \(\displaystyle x_n = \sum_{k=1}^{n} \frac{1}{(1+k)^2}\) 收敛。

\begin{proof}
\textbf{单调有界法：}\(x_{n+1} - x_n = \frac{1}{(n+2)^2} > 0\)，\(\{x_n\} \uparrow\)。
\[
x_n = \sum_{k=1}^{n} \frac{1}{(1+k)^2} < \sum_{k=1}^{n} \frac{1}{k(k+1)} = 1 - \frac{1}{n+1} < 1
\]
有上界 \(\Rightarrow\) 收敛。

\textbf{Cauchy 法：}\(\forall m > n\)：
\[
|x_m - x_n| = \sum_{k=n+1}^{m} \frac{1}{(1+k)^2} < \sum_{k=n+1}^{m} \left(\frac{1}{k} - \frac{1}{k+1}\right) = \frac{1}{n+1} - \frac{1}{m+1} < \frac{1}{n+1}
\]
\(\forall \varepsilon > 0\)，取 \(N = [\frac{1}{\varepsilon}]\)，\(\forall m > n > N\)，\(|x_m - x_n| < \varepsilon\)。
\end{proof}
\end{enumerate}

\section{四、计算题}

\begin{enumerate}
\item \(\displaystyle \lim_{n \to +\infty} \frac{n^6 + \sin n}{2002n^6 + \ln^2 n + 28n} = \frac{1}{2002}\)。
\item \(\displaystyle \lim_{n \to +\infty} n\sin\frac{1}{n} = 1\)。
\item \(\displaystyle \lim_{h \to 0} \frac{\cos(x+h) - \cos x}{h} = -\sin x\)（导数定义）。
\item \(\displaystyle \lim_{x \to +\infty} \left(1 + \frac{1}{\sin x}\right)^x\) 不存在（取 \(x_n = \frac{\pi}{2} + 2n\pi\) 和 \(x_n = -\frac{\pi}{2} + 2n\pi\) 得不同极限）。
\item \(\displaystyle \lim_{x \to 10} \frac{e^x - e^{10}}{\sin(x-10) + \ln(x^2 - 20x + 101)}\)：令 \(t = x - 10 \to 0\)，
\[
= \lim_{t \to 0} \frac{e^{10}(e^t - 1)}{\sin t + \ln(t^2 + 1)}
= e^{10} \lim_{t \to 0} \frac{t + o(t)}{t + o(t) + t^2 + o(t^2)} = e^{10}
\]
\end{enumerate}

\textbf{常见等价无穷小（\(x \to 0\)）补充：}
\[
\sin x \sim \tan x \sim \arctan x \sim \arcsin x \sim \ln(1+x) \sim e^x - 1 \sim x
\]
\[
(1+x)^\alpha - 1 \sim \alpha x,\qquad 1 - \cos x \sim \frac{x^2}{2}
\]

\section{五、求导法则}

\subsection{1. 乘法与除法}

\[
(uv)' = u'v + uv',\qquad \left(\frac{u}{v}\right)' = \frac{u'v - uv'}{v^2}\;(v \neq 0)
\]

\begin{proof}
（乘法）\(\displaystyle (uv)' = \lim_{\Delta x \to 0} \frac{u(x+\Delta)v(x+\Delta) - u(x)v(x+\Delta) + u(x)v(x+\Delta) - u(x)v(x)}{\Delta x} = u'v + uv'\)。

（除法）先证 \((1/v)' = -v'/v^2\)：\(\displaystyle \lim_{\Delta x \to 0} \frac{1}{\Delta x}\left[\frac{1}{v(x+\Delta)} - \frac{1}{v(x)}\right] = -\frac{v'}{v^2}\)。再用乘法。
\end{proof}

\subsection{2. 反函数求导}

\textbf{定理：}若 \(f(x)\) 在 \(O(x_0)\) 上严格单调连续，在 \(x_0\) 处可导且 \(f'(x_0) \neq 0\)，则 \(y = f(x)\) 在 \(O(x_0)\) 中存在反函数 \(x = \varphi(y)\)，且
\[
\varphi'(y_0) = \frac{1}{f'(x_0)},\qquad y_0 = f(x_0)
\]
即 \(\displaystyle \frac{dx}{dy} = 1/\frac{dy}{dx}\)。

\begin{proof}
\(\displaystyle \varphi'(y_0) = \lim_{y \to y_0} \frac{\varphi(y) - \varphi(y_0)}{y - y_0} = \lim_{x \to x_0} \frac{x - x_0}{f(x) - f(x_0)} = \frac{1}{f'(x_0)}\)。
\end{proof}

\begin{center}
\includegraphics[width=0.4\textwidth]{images/67_1_2048_609_284_0.jpg}
\end{center}

\begin{example}
\begin{align*}
(\arcsin x)' &\overset{x=\sin y}{=} \frac{1}{(\sin y)'} = \frac{1}{\cos y} = \frac{1}{\sqrt{1-x^2}} \\
(\arccos x)' &\overset{x=\cos y}{=} \frac{1}{(\cos y)'} = -\frac{1}{\sin y} = -\frac{1}{\sqrt{1-x^2}} \\
(\arctan x)' &\overset{x=\tan y}{=} \frac{1}{(\tan y)'} = \cos^2 y = \frac{1}{1+x^2} \\
(e^x)' &\overset{x=\ln y}{=} \frac{1}{(\ln y)'} = y = e^x
\end{align*}
\end{example}

\begin{center}
\includegraphics[width=0.4\textwidth]{images/68_0_0_591_298_0.jpg}
\end{center}

\textbf{注意：}(1) 严格单调不能保证 \(f'(x_0) \neq 0\)（反例 \(f(x) = x^3\) 在 \(x=0\)）；(2) 邻域连续条件不能去掉。

\subsection{3. 复合函数求导（链式法则）}

\textbf{定理：}若 \(u = g(x)\) 在 \(x_0\) 可导，\(y = f(u)\) 在 \(u_0 = g(x_0)\) 可导，且 \(f(g(x))\) 在 \(O(x_0)\) 有定义，则 \(F(x) = f(g(x))\) 在 \(x_0\) 可导，且
\[
F'(x_0) = f'(u_0) \cdot g'(x_0)
\]
即 \(\displaystyle \frac{dy}{dx} = \frac{dy}{du} \cdot \frac{du}{dx}\)。

\begin{proof}
（构造连续函数法）定义 \(H(u) = \begin{cases} \frac{f(u)-f(u_0)}{u-u_0}, & u \neq u_0 \\ f'(u_0), & u = u_0 \end{cases}\)，则 \(H(u)\) 在 \(u_0\) 连续。

\(f(u) - f(u_0) = H(u)(u - u_0)\)。令 \(u = g(x)\)：
\[
\frac{F(x) - F(x_0)}{x - x_0} = H(g(x)) \cdot \frac{g(x) - g(x_0)}{x - x_0} \to f'(u_0) \cdot g'(x_0)
\]
\end{proof}

\textbf{一阶微分形式不变性：}无论 \(u\) 是自变量还是中间变量，\(dy = f'(u)\,du\) 始终成立。

\begin{example}
\begin{align*}
(e^{cx})' &= e^{cx} \cdot c = c e^{cx} \\
(\sin x^2)' &= \cos(x^2) \cdot 2x \\
\left[\ln\left(x + \sqrt{x^2 + a^2}\right)\right]' &= \frac{1}{\sqrt{x^2 + a^2}} \\
(u(x)^{v(x)})' &= \left(e^{v\ln u}\right)' = u^v\left(v'\ln u + \frac{v}{u}u'\right) \quad (u>0)
\end{align*}
\end{example}

\subsection{4. 参数方程求导}

\textbf{定理：}若 \(x(t), y(t)\) 可导且 \(x'(t) \neq 0\)（从而 \(x(t)\) 严格单调），则
\[
\frac{dy}{dx} = \frac{dy/dt}{dx/dt} = \frac{y'(t)}{x'(t)}
\]

\textbf{极坐标应用：}\(r = r(\theta)\)，\(x = r\cos\theta\)，\(y = r\sin\theta\)，
\[
\frac{dy}{dx} = \frac{r'\sin\theta + r\cos\theta}{r'\cos\theta - r\sin\theta}
\]

