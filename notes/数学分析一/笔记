\[
O^-(x_0, h) = (x_0 - h, x_0) \cup (x_0, x_0 + h)
\]
简记作 \(O^-(x_0)\)。

\subsection{函数极限的 \(\varepsilon\text{-}\delta\) 定义}

若 \(x\) 足够"接近" \(x_0\)（\(x \neq x_0\)），可使 \(f(x)\) 与 \(A\) 的差任意小。

\textbf{定义：}设 \(f(x)\) 在 \(O^-(x_0)\) 上有定义。若
\[
\forall \varepsilon > 0,\; \exists \delta > 0,\; \text{s.t. } \forall x \in O^-(x_0, \delta),\; |f(x) - A| < \varepsilon
\]
则称 \(f(x)\) 在 \(x_0\) 处有极限 \(A\)，记作 \(\displaystyle \lim_{x \to x_0} f(x) = A\)。

\textbf{等价写法：}
\[
x \in O^-(x_0, \delta) \;\Leftrightarrow\; 0 < |x - x_0| < \delta
\]
\[
|f(x) - A| < \varepsilon \;\Leftrightarrow\; f(x) \in O(A, \varepsilon)
\]

\begin{remark}
\(f(x)\) 可以在 \(x_0\) 处没有定义。取极限过程中 \(x \neq x_0\)，极限存在与否与是否有定义无关！
\end{remark}

\subsection{例题}

\begin{example}
求证：\(\displaystyle \lim_{x \to a} \sqrt{x} = \sqrt{a}\;(a > 0)\)。

\begin{proof}
\(\forall \varepsilon > 0\)，取 \(\delta = \varepsilon \sqrt{a}\)。当 \(0 < |x - a| < \delta\) 时：
\[
|\sqrt{x} - \sqrt{a}| = \frac{|x - a|}{\sqrt{x} + \sqrt{a}} \leq \frac{|x - a|}{\sqrt{a}} < \frac{\delta}{\sqrt{a}} = \varepsilon
\]
由定义知 \(\displaystyle \lim_{x \to a} \sqrt{x} = \sqrt{a}\)。
\end{proof}
\end{example}

\begin{example}
求证：\(\displaystyle \lim_{x \to 0} \frac{\sin x}{x} = 1\)。

\begin{proof}
（几何法）对 \(x \in (0, \frac{\pi}{2})\)，由单位圆面积比较：
\[
\frac{1}{2}\sin x < \frac{1}{2}x < \frac{1}{2}\tan x \;\Longrightarrow\; \sin x < x < \tan x
\]
\[
\cos x < \frac{\sin x}{x} < 1
\]
又 \(\cos x = 1 - 2\sin^2\frac{x}{2} > 1 - 2\left(\frac{x}{2}\right)^2 = 1 - \frac{x^2}{2}\)，故
\[
0 < 1 - \frac{\sin x}{x} < 1 - \cos x < \frac{x^2}{2}
\]

\begin{center}
\includegraphics[width=0.4\textwidth]{images/31_68_974_503_280_0.jpg}
\end{center}

\(\forall \varepsilon > 0\)，取 \(\delta = \sqrt{2\varepsilon}\)。当 \(0 < |x| < \delta\) 时：
\[
\left|\frac{\sin x}{x} - 1\right| = 1 - \frac{\sin x}{x} < \frac{x^2}{2} < \frac{\delta^2}{2} = \varepsilon
\]
（\(x < 0\) 同理，\(\frac{\sin x}{x}\) 是偶函数）

由定义知 \(\displaystyle \lim_{x \to 0} \frac{\sin x}{x} = 1\)。
\end{proof}
\end{example}

\begin{example}
\(\displaystyle \lim_{x \to 0} x \sin\frac{1}{x} = 0\)。

\begin{proof}
\(\left|x \sin\frac{1}{x}\right| \leq |x|\)。\(\forall \varepsilon > 0\)，取 \(\delta = \varepsilon\)，当 \(0 < |x| < \delta\) 时：
\[
\left|x\sin\frac{1}{x} - 0\right| \leq |x| < \delta = \varepsilon
\]
\end{proof}
\end{example}

\begin{example}
\(\displaystyle \lim_{x \to a} \sin x = \sin a\)。

\begin{proof}
\[
|\sin x - \sin a| = \left|2\cos\frac{x+a}{2}\sin\frac{x-a}{2}\right|
\leq 2\left|\sin\frac{x-a}{2}\right| \leq |x - a|
\]
\(\forall \varepsilon > 0\)，取 \(\delta = \varepsilon\)。当 \(0 < |x - a| < \delta\) 时，\(|\sin x - \sin a| \leq |x-a| < \varepsilon\)。
\end{proof}
\end{example}

\section{三、函数极限的性质}

\subsection{(1) 唯一性}

若 \(\displaystyle \lim_{x \to x_0} f(x)\) 存在，则极限值必唯一。

\begin{proof}
（反证）若不然，设 \(a < b\) 均为极限。取 \(\varepsilon = \frac{b-a}{2}\)。

\(a\) 是极限 \(\Rightarrow\) \(\exists \delta_1 > 0\)，s.t. 当 \(0 < |x - x_0| < \delta_1\) 时，\(|f(x) - a| < \varepsilon\)。

\(b\) 是极限 \(\Rightarrow\) \(\exists \delta_2 > 0\)，s.t. 当 \(0 < |x - x_0| < \delta_2\) 时，\(|f(x) - b| < \varepsilon\)。

取 \(\delta = \min\{\delta_1, \delta_2\}\)，则对 \(0 < |x - x_0| < \delta\)，以上两式均成立：
\[
|a - b| = |a - f(x) + f(x) - b| \leq |f(x) - a| + |f(x) - b| < 2\varepsilon = b - a
\]
矛盾。
\end{proof}

\subsection{(2) 局部有界性}

若 \(\displaystyle \lim_{x \to x_0} f(x)\) 存在，则 \(\exists \delta > 0\)，s.t. \(f(x)\) 在 \(O^-(x_0, \delta)\) 上有界。

\begin{proof}
设 \(\displaystyle \lim_{x \to x_0} f(x) = A\)。取 \(\varepsilon = 1\)，\(\exists \delta > 0\)，s.t. \(\forall x \in O^-(x_0, \delta)\)，\(|f(x) - A| < 1\)。

\(\Rightarrow |f(x)| < 1 + |A|\)（常数），\(\therefore f(x)\) 有界。
\end{proof}

\begin{remark}
与数列极限不同，函数在 \(x_0\) 处极限存在并不能推出函数在整个定义域有界，因此称为"局部有界性"。
\end{remark}

\subsection{(3) 四则运算}

若 \(\displaystyle \lim_{x \to x_0} f(x) = A\)，\(\displaystyle \lim_{x \to x_0} g(x) = B\)，则：
\begin{enumerate}
\item \(\displaystyle \lim_{x \to x_0} (f(x) \pm g(x)) = A \pm B\)
\item \(\displaystyle \lim_{x \to x_0} f(x) \cdot g(x) = A \cdot B\)
\item 若 \(B \neq 0\)，\(\displaystyle \lim_{x \to x_0} \frac{f(x)}{g(x)} = \frac{A}{B}\)
\end{enumerate}

（证明与数列四则运算相似，也可由函数极限的数列定义法证明。）

\subsection{(4) 比较原则（夹逼定理）}

\textbf{1)} 若 \(\displaystyle \lim_{x \to x_0} f(x) = A\)，\(\displaystyle \lim_{x \to x_0} g(x) = B\)，且 \(A < B\)，则 \(\exists \delta > 0\)，s.t. \(\forall x \in O^-(x_0, \delta)\)，\(f(x) < g(x)\)。

\begin{proof}
取 \(\varepsilon = \frac{B-A}{2}\)。\(\exists \delta_1 > 0\)，s.t. \(f(x) < A + \varepsilon = \frac{A+B}{2}\)。

\(\exists \delta_2 > 0\)，s.t. \(g(x) > B - \varepsilon = \frac{A+B}{2}\)。

取 \(\delta = \min\{\delta_1, \delta_2\}\)，则 \(f(x) < \frac{A+B}{2} < g(x)\)。
\end{proof}

\textbf{2)} 若 \(\forall x \in O^-(x_0)\)，\(f(x) \leq g(x)\)，且两者极限存在，则 \(\displaystyle \lim_{x \to x_0} f(x) \leq \lim_{x \to x_0} g(x)\)。

\textbf{3) 夹逼定理：}若 \(\forall x \in O^-(x_0)\)，\(f(x) \leq g(x) \leq h(x)\)，且 \(\displaystyle \lim_{x \to x_0} f(x) = \lim_{x \to x_0} h(x) = A\)，则 \(\displaystyle \lim_{x \to x_0} g(x) = A\)。

\section{四、数列极限与函数极限的联系（Heine 定理）}

\textbf{定理：}\(\displaystyle \lim_{x \to x_0} f(x) = A\)
\[
\Leftrightarrow \forall \{x_n\} \subseteq O^-(x_0) \text{ 且 } \lim_{n \to +\infty} x_n = x_0,\; \text{均有 } \lim_{n \to +\infty} f(x_n) = A
\]

\begin{proof}
\(\Rightarrow\)：由 \(\displaystyle \lim_{x \to x_0} f(x) = A\)，\(\forall \varepsilon > 0\)，\(\exists \delta > 0\)，s.t. \(\forall x \in O^-(x_0, \delta)\)，\(|f(x) - A| < \varepsilon\)。

对取定的 \(\delta\)，由 \(x_n \to x_0\)，\(\exists N \in \mathbb{N}\)，s.t. \(\forall n > N\)，\(0 < |x_n - x_0| < \delta\)。

从而 \(|f(x_n) - A| < \varepsilon\)，由数列极限定义知 \(f(x_n) \to A\)。

\(\Leftarrow\)：（反证法）假设 \(\displaystyle \lim_{x \to x_0} f(x) \neq A\)，即
\[
\exists \varepsilon_0 > 0,\; \forall \delta > 0,\; \exists x \in O^-(x_0, \delta),\; |f(x) - A| \geq \varepsilon_0
\]

取 \(\delta_1 = 1\)，\(\exists x_1 \in O^-(x_0, 1)\)，s.t. \(|f(x_1) - A| \geq \varepsilon_0\)。

取 \(\delta_2 = \min\{\frac{1}{2}, |x_1 - x_0|\}\)，\(\exists x_2 \in O^-(x_0, \delta_2)\)，s.t. \(|f(x_2) - A| \geq \varepsilon_0\)（\(x_2 \neq x_1\)）。

一般地，取 \(\delta_n = \min\{\frac{1}{n}, |x_{n-1} - x_0|\}\)，\(\exists x_n \in O^-(x_0, \delta_n)\)，s.t. \(|f(x_n) - A| \geq \varepsilon_0\)。

构造的 \(\{x_n\}\) 互异，\(x_n \neq x_0\)，且 \(|x_n - x_0| < \frac{1}{n} \to 0\)，故 \(x_n \to x_0\)。

由条件应有 \(f(x_n) \to A\)，但构造保证 \(|f(x_n) - A| \geq \varepsilon_0\)，矛盾。
\end{proof}

\begin{remark}
Heine 定理将函数极限转化为数列极限，是连接两者的桥梁。特别地，若要证明 \(\displaystyle \lim_{x \to x_0} f(x)\) 不存在，只需找到两个趋于 \(x_0\) 的数列 \(\{x_n^{(1)}\}, \{x_n^{(2)}\}\) 使得 \(f(x_n^{(1)})\) 和 \(f(x_n^{(2)})\) 的极限不同即可。
\end{remark}

