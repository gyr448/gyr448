\chapter{10.28}

\section{一、重要极限的推论}

由 \(\displaystyle \lim_{x \to 0} (1+x)^{\frac{1}{x}} = e\)，取对数：
\[
\lim_{x \to 0} \frac{\ln(1+x)}{x} = 1
\]

对其他底数：\(\displaystyle \lim_{x \to 0} \frac{\log_b(1+x)}{x} = \frac{1}{\ln b}\)。

令 \(\beta = \ln(1+\alpha)\)，则 \(\alpha \to 0\) 时 \(\beta \to 0\)，\(e^{\beta} = 1+\alpha\)，得：
\[
\lim_{\alpha \to 0} \frac{e^{\alpha} - 1}{\alpha} = 1
\]

对其他底数：\(\displaystyle \lim_{x \to 0} \frac{b^x - 1}{x} = \ln b\)。

推广到幂函数：
\[
\lim_{\alpha \to 0} \frac{(1+\alpha)^{\mu} - 1}{\alpha}
= \lim_{\alpha \to 0} \frac{e^{\mu\ln(1+\alpha)} - 1}{\mu\ln(1+\alpha)} \cdot \frac{\mu\ln(1+\alpha)}{\alpha} = \mu
\]

\textbf{总结——三个基本极限：}
\[
\boxed{\lim_{x \to 0} \frac{\ln(1+x)}{x} = 1},\qquad
\boxed{\lim_{x \to 0} \frac{e^x - 1}{x} = 1},\qquad
\boxed{\lim_{x \to 0} \frac{(1+x)^{\mu} - 1}{x} = \mu}
\]

\section{二、变量的阶（无穷小比较）}

设 \(f(x), g(x) \to 0\)（\(x \to x_0\)）。

\begin{itemize}
\item \textbf{等价无穷小：}若 \(\displaystyle \lim_{x \to x_0} \frac{f(x)}{g(x)} = 1\)，记作 \(f(x) \sim g(x)\)（\(x \to x_0\)）。
\item \textbf{同阶无穷小：}若极限为 \(A \neq 0\)，记作 \(f(x) \sim A \cdot g(x)\)。
\item \textbf{高阶无穷小：}若极限为 \(0\)，记作 \(f(x) = o(g(x))\)。
\end{itemize}

\textbf{常见等价无穷小（\(x \to 0\)）：}
\[
\begin{aligned}
\sin x &\sim x, &
\tan x &\sim x, \\
1 - \cos x &\sim \frac{x^2}{2}, &
\ln(1+x) &\sim x, \\
e^x - 1 &\sim x, &
(1+x)^{\mu} - 1 &\sim \mu x
\end{aligned}
\]

更精确的估计：
\[
\begin{aligned}
\sin x &= x + o(x), &
\tan x &= x + o(x), \\
\cos x &= 1 - \frac{x^2}{2} + o(x^2), &
e^x &= 1 + x + o(x), \\
\ln(1+x) &= x + o(x), &
(1+x)^{\mu} &= 1 + \mu x + o(x)
\end{aligned}
\]

\textbf{无穷小量的四则运算：}若 \(f(x) \to 0\)，\(g(x) \to 0\)，则 \(f \pm g, f \cdot g\) 仍是无穷小。等价无穷小可在乘除极限中替换，但加减运算中需谨慎（除非是高阶无穷小加减）。

\begin{example}
\(\displaystyle \lim_{x \to 0} \frac{\cos[(1+x)^{\mu} - 1] - 1}{x^2}\)：

\((1+x)^{\mu} - 1 \sim \mu x \to 0\)，故 \(\cos[(1+x)^{\mu} - 1] = 1 - \frac{1}{2}[(1+x)^{\mu} - 1]^2 + o(((1+x)^{\mu} - 1)^2)\)。

\((1+x)^{\mu} - 1 = \mu x + o(x)\)，故 \([(1+x)^{\mu} - 1]^2 = \mu^2 x^2 + o(x^2)\)。

\(\cos[(1+x)^{\mu} - 1] - 1 = -\frac{1}{2}\mu^2 x^2 + o(x^2)\)。\(\therefore\) 原式 \(= -\frac{1}{2}\mu^2\)。
\end{example}

