\chapter{12.5 不定积分}

\section{一、第一类换元法（续）}

\begin{example}
\begin{enumerate}
\setcounter{enumi}{8}
\item \(I_n = \int \tan^n x\,dx\)：\begin{align*}
I_n &= \int \tan^{n-2}x(\sec^2 x - 1)\,dx = \int \tan^{n-2}x\,d(\tan x) - I_{n-2} \\
&= \frac{1}{n-1}\tan^{n-1}x - I_{n-2} + C
\end{align*}
\(I_1 = -\ln|\cos x| + C\)，\(I_2 = \tan x - x + C\)。

\item \(\int \frac{dx}{1+\cos^2 x} = \int \frac{\sec^2 x}{\sec^2 x + 1}\,dx = \int \frac{d(\tan x)}{\tan^2 x + 2} = \frac{1}{\sqrt{2}}\arctan\!\left(\frac{\tan x}{\sqrt{2}}\right) + C\)。

\item \(\int \frac{dx}{\cos x} = \int \frac{d\sin x}{1-\sin^2 x} = \frac12\ln\left|\frac{1+\sin x}{1-\sin x}\right| + C = \ln\left|\frac{1+\sin x}{\cos x}\right| + C\)。

\item \(\int \frac{dx}{1+x^3}\) 与 \(\int \frac{x\,dx}{1+x^3}\)（对偶法）：令 \(F = \int\frac{dx}{1+x^3}\)，\(G = \int\frac{x\,dx}{1+x^3}\)。
\[
F+G = \int\frac{1+x}{1+x^3}dx = \int\frac{dx}{x^2-x+1} = \frac{2}{\sqrt{3}}\arctan\!\left(\frac{2x-1}{\sqrt{3}}\right) + C
\]
\[
F-G = \int\frac{1-x}{1+x^3}dx = \cdots
\]
解得 \(F,G\)（略）。

\item \(\int \frac{dx}{1+x^4}\) 与 \(\int \frac{x^2\,dx}{1+x^4}\)（同法）：令 \(F+G = \int\frac{1+x^2}{1+x^4}dx\)，\(F-G = \int\frac{1-x^2}{1+x^4}dx\)。
\[
F+G = \frac{1}{\sqrt{2}}\arctan\!\left(\frac{x^2-1}{\sqrt{2}\,x}\right) + C
\]
\[
F-G = \frac{1}{2\sqrt{2}}\ln\left|\frac{x^2+\sqrt{2}x+1}{x^2-\sqrt{2}x+1}\right| + C
\]
\end{enumerate}
\end{example}

\section{二、第二类换元法}

\textbf{定理：}令 \(x = x(t)\)（\(x'(t) \neq 0\)），若 \(\int f(x(t))\,x'(t)\,dt = G(t) + C\)，则 \(\int f(x)\,dx = G(t) + C\)（代回 \(t = x^{-1}(x)\)）。

\begin{example}
\begin{enumerate}
\item \(\int \sqrt{a^2 - x^2}\,dx\)：令 \(x = a\sin t\)，\(dx = a\cos t\,dt\)，\(t \in [-\frac{\pi}{2},\frac{\pi}{2}]\)。
\[
= \int a^2\cos^2 t\,dt = \frac{a^2}{2}t + \frac{a^2}{4}\sin 2t + C = \frac{a^2}{2}\arcsin\frac{x}{a} + \frac12 x\sqrt{a^2-x^2} + C
\]

\item \(\int \frac{dx}{\sqrt{x^2 - a^2}}\)（\(a > 0\)，\(|x| > a\)）：令 \(x = a\sec t\)，\(= \ln|x + \sqrt{x^2-a^2}| + C\)。

\item \(\int \frac{dx}{\sqrt{x^2 + a^2}}\)：令 \(x = a\tan t\)，\(= \ln|x + \sqrt{x^2+a^2}| + C\)。

\item \(\int \frac{dx}{\sqrt{x} + \sqrt[3]{x}}\)：令 \(x = t^6\)，\(dx = 6t^5\,dt\)，\(= 2x^{1/2} - 3x^{1/3} + 6x^{1/6} - 6\ln|x^{1/6}+1| + C\)。
\end{enumerate}
\end{example}

\section{三、分部积分法}

\textbf{定理：}\(\int u\,dv = uv - \int v\,du\)，即 \(\int u(x)v'(x)\,dx = u(x)v(x) - \int u'(x)v(x)\,dx\)。

\begin{example}
\begin{enumerate}
\item \(\int xe^{-x}\,dx = -xe^{-x} + \int e^{-x}\,dx = -xe^{-x} - e^{-x} + C\)。
\item \(\int x^2\sin x\,dx = -x^2\cos x + 2x\sin x + 2\cos x + C\)（分部两次）。
\item \(\int \ln x\,dx = x\ln x - x + C\)。
\item \(\int \sqrt{x^2-1}\,dx = \frac12 x\sqrt{x^2-1} - \frac12\ln|x+\sqrt{x^2-1}| + C\)（分部 + 回代）。
\item \(\int e^{ax}\cos bx\,dx\) 与 \(\int e^{ax}\sin bx\,dx\)：解方程组。
\[
aI_1 - bI_2 = e^{ax}\cos bx,\qquad bI_1 + aI_2 = e^{ax}\sin bx
\]
\(\Rightarrow I_1 = \frac{e^{ax}(a\cos bx + b\sin bx)}{a^2+b^2} + C\)，\(I_2 = \frac{e^{ax}(a\sin bx - b\cos bx)}{a^2+b^2} + C\)。
\end{enumerate}
\end{example}

