\subsection{思考题}

1. 证明:\(\left| a + b \right|^p \leq 2^p \max \left( \left| a \right|^p, \left| b \right|^p \right) \quad (p > 0)\)

\paragraph*{证明:} \(\left| a + b \right| \leq 2 \max \{ \left| a \right|, \left| b \right| \}\)

\(\Rightarrow \left| a + b \right|^p \leq 2^p \left( \max \{ \left| a \right|, \left| b \right| \} \right)^p\)

\(= 2^p \max \left\{ \left| a \right|^p, \left| b \right|^p \right\}\)

2.证明：\[
\frac{1}{4n} < 
\left( \frac{1\cdot 3\cdot 5\cdots (2n-1)}{2\cdot 4\cdot 6\cdots (2n)} \right)^2
< \frac{1}{2n}
\]

\paragraph*{证明:}设
\[
A_n = \frac{1\cdot 3\cdot 5\cdots (2n-1)}{2\cdot 4\cdot 6\cdots (2n)}
= \prod_{k=1}^{n} \frac{2k-1}{2k}.
\]
下面证明 \(\displaystyle \frac{1}{4n} < A_n^2 < \frac{1}{2n}\),进而由夹逼定理得 \(A_n \to 0\)。

\paragraph*{方法一（不等式放缩）}
对任意 \(k\ge 1\),有
\[
\frac{2k-1}{2k} < \frac{2k}{2k+1}, \qquad 
\frac{2k-1}{2k} > \frac{2k-2}{2k-1}\ (k\ge 2).
\]
由第一个不等式累乘得
\[
A_n < B_n := \prod_{k=1}^{n} \frac{2k}{2k+1},
\]
于是
\[
A_n^2 < A_n B_n = \prod_{k=1}^{n} \frac{2k-1}{2k+1} = \frac{1}{2n+1} < \frac{1}{2n}. \tag{1}
\]
由第二个不等式累乘（从 \(k=2\) 到 \(n\)）得
\[
\prod_{k=2}^{n} \frac{2k-1}{2k} > \prod_{k=2}^{n} \frac{2k-2}{2k-1}.
\]
而
\[
A_n = \frac12 \prod_{k=2}^{n} \frac{2k-1}{2k},
\]
且
\[
A_n \cdot \prod_{k=2}^{n} \frac{2k-2}{2k-1} = \frac{1}{2n}.
\]
故
\[
A_n^2 > \frac12 \cdot \frac{1}{2n} = \frac{1}{4n}. \tag{2}
\]
综合 (1)(2) 得 \(\displaystyle \frac{1}{4n} < A_n^2 < \frac{1}{2n}\)。

\paragraph*{方法二（乘积错位相消）}
直接观察：
\[
A_n^2 = \frac{1^2\cdot 3^2\cdot 5^2\cdots (2n-1)^2}{2^2\cdot 4^2\cdot 6^2\cdots (2n)^2}.
\]
将分子分母错位配对,可写成
\[
A_n^2 = \frac{1\cdot 3}{2\cdot 2}
\cdot \frac{3\cdot 5}{4\cdot 4}
\cdots
\frac{(2n-3)(2n-1)}{(2n-2)^2}
\cdot \frac{(2n-1)^2}{(2n)^2}.
\]
对 \(k=2,\dots,n-1\),一般的因子为 \(\frac{(2k-3)(2k-1)}{(2k-2)^2}\),而最后单独留下 \(\frac{(2n-1)^2}{(2n)^2}\)。由于
\[
\frac{(2k-3)(2k-1)}{(2k-2)^2} = 1 - \frac{1}{(2k-2)^2} < 1,
\qquad
\frac{(2n-1)^2}{(2n)^2} < 1,
\]
立即得到 \(A_n^2 < 1\),但这样估计过于粗糙。为得到更精确的上界,将乘积重新组合：
\[
A_n^2 = \frac{1}{2n} \prod_{k=1}^{n-1} \frac{(2k-1)(2k+1)}{(2k)^2} \cdot \frac{2n-1}{2n}.
\]
因为对每个 \(k\) 都有 \(\frac{(2k-1)(2k+1)}{(2k)^2} < 1\) 且 \(\frac{2n-1}{2n} < 1\),故得
\[
A_n^2 < \frac{1}{2n},\quad \text{即}\quad A_n < \frac{1}{\sqrt{2n}}.
\]
这就通过乘积错位相消获得了所需的上界。
至于下界,可尝试类似的错位缩放。

综上,
\[
\frac{1}{2\sqrt{n}} < A_n < \frac{1}{\sqrt{2n}}.
\]
令 \(n\to\infty\),由夹逼定理得 \(\displaystyle \lim_{n\to\infty} A_n = 0\)。

