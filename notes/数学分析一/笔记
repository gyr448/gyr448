\section{一、凸函数的定义}

\textbf{定义：}设 \(f(x)\) 在 \([a,b]\) 上有定义。若 \(\forall x_1,x_2 \in [a,b]\)，\(\forall t \in (0,1)\)，有
\[
f(tx_1 + (1-t)x_2) \leq tf(x_1) + (1-t)f(x_2)
\]
则称 \(f\) 为 \([a,b]\) 上的\textbf{凸函数}（下凸）。不等号反向则为凹函数（上凸）。严格不等号为严格凸。

\begin{center}
\includegraphics[width=0.5\textwidth]{images/110_1045_382_661_428_0.jpg}
\end{center}

\textbf{等价定义（割线斜率）：}\(f\) 是凸函数 \(\Leftrightarrow\) \(\forall x_1 < x_2 < x_3\)，
\[
\frac{f(x_2) - f(x_1)}{x_2 - x_1} \leq \frac{f(x_3) - f(x_2)}{x_3 - x_2}
\]
（割线斜率单调递增。）

\begin{center}
\includegraphics[width=0.3\textwidth]{images/110_0_1676_405_328_0.jpg}
\end{center}

\textbf{行列式等价：}\(\begin{vmatrix} 1 & x_1 & f(x_1) \\ 1 & x_2 & f(x_2) \\ 1 & x_3 & f(x_3) \end{vmatrix} \geq 0\)（三点逆时针排列）。

\section{二、凸函数的性质}

\subsection{1. 单侧可导性}

\textbf{定理：}凸函数在内部点处左右导数均存在。

\begin{proof}
由割线斜率单调性，固定 \(x_0\)，当 \(h \to 0^+\) 时 \(\frac{f(x_0-h)-f(x_0)}{-h}\) 单调上升且有上界（被 \(\frac{f(x_1)-f(x_0)}{x_1-x_0}\) 控制，\(x_1 > x_0\)），故左导数存在。右导数同理。
\end{proof}

\textbf{推论：}凸函数在开区间上连续。

\subsection{2. 凸性与一阶导数}

\textbf{定理：}设 \(f\) 在 \((a,b)\) 可导，则 \(f\) 是凸函数 \(\Leftrightarrow\) \(f'(x)\) 单调递增。

\begin{proof}
\(\Rightarrow\)：\(\forall x_1 < x_2\)，由割线斜率单调性和 Lagrange 定理，\(\exists \xi_1,\xi_2\)，s.t. \(f'(\xi_1) \leq f'(\xi_2)\)。

\(\Leftarrow\)：由 \(f'\) 单调，用 Lagrange 定理可导出割线斜率单调 \(\Rightarrow\) 凸。
\end{proof}

\textbf{切线刻画：}\(f\) 是凸函数 \(\Leftrightarrow\) \(\forall x_0\)，\(f(x) \geq f(x_0) + f'(x_0)(x-x_0)\)（曲线在切线上方）。

\subsection{3. 凸性与二阶导数}

\textbf{定理：}设 \(f \in C[a,b]\)，在 \((a,b)\) 二阶可导。\(f\) 凸 \(\Leftrightarrow\) \(f''(x) \geq 0\)。严格凸 \(\Leftrightarrow\) \(f'' \geq 0\) 且不在任一开子区间恒为零。

\section{三、Jensen 不等式}

设 \(f\) 在 \([a,b]\) 上为凸函数，\(x_i \in [a,b]\)，\(t_i > 0\)，\(\sum_{i=1}^{n} t_i = 1\)，则
\[
f\!\left(\sum_{i=1}^{n} t_i x_i\right) \leq \sum_{i=1}^{n} t_i f(x_i)
\]

\begin{proof}
（归纳法）\(n=2\) 即凸函数定义。假设 \(n=k\) 成立，证 \(n=k+1\)。

令 \(\lambda_i = \frac{t_i}{1-t_{k+1}}\)（\(i=1,\ldots,k\)），则 \(\sum \lambda_i = 1\)。
\[
f\!\left(\sum_{i=1}^{k+1} t_i x_i\right) = f\!\left((1-t_{k+1})\sum_{i=1}^{k} \lambda_i x_i + t_{k+1}x_{k+1}\right) \\
\leq (1-t_{k+1})f\!\left(\sum \lambda_i x_i\right) + t_{k+1}f(x_{k+1}) \leq \sum_{i=1}^{k+1} t_i f(x_i)
\]
\end{proof}

\begin{example}
\begin{enumerate}
\item \(f(x) = \ln x\) 是凹函数（\(f'' < 0\)）。取 \(t_i = 1/n\) 得 \(\frac{x_1+\cdots+x_n}{n} \geq \sqrt[n]{x_1\cdots x_n}\)（均值不等式）。
\item \(f(x) = x\ln x\)（\(f'' = 1/x > 0\)，凸函数）\(\Rightarrow\) \(\frac{1}{n}\sum a_i^x \ln a_i^x \geq \left(\frac{1}{n}\sum a_i^x\right)\ln\!\left(\frac{1}{n}\sum a_i^x\right)\)。
\end{enumerate}
\end{example}


