\section{单调有界数列例题（续）}

回顾：单调有界数列必有极限。

\begin{example}
\(x_1 = 2\)，\(x_{n+1} = \dfrac{1}{2}\left(x_n + \dfrac{a}{x_n}\right)\)，\(a > 0\)。求 \(\displaystyle \lim_{n \to +\infty} x_n\)。

\textbf{分析：}这是牛顿迭代法求 \(\sqrt{a}\)。

先证 \(x_n\) 单调有界。当 \(a \geq 1\) 时分类讨论：
\[
x_{n+1} - x_n = \frac{a - x_n^2}{2x_n}
\]
对 \(x_{n+1} = \frac{1}{2}\left(x_n + \frac{a}{x_n}\right)\) 两边取极限，设极限为 \(A\)：
\[
A = \frac{1}{2}\left(A + \frac{a}{A}\right) \;\Longrightarrow\; A = \sqrt{a}
\]
\end{example}

\begin{example}
证明 \(e := \displaystyle \lim_{n \to +\infty} \left(1 + \frac{1}{n}\right)^n\) 存在。（此极限定义为 \(e\)。）

\begin{proof}
\textbf{Bernoulli 不等式：}\((1+x)^n \geq 1 + nx\) 对 \(x \geq -1\) 成立（归纳证明）。

\textbf{(1) 令 \(x_n = \left(1 + \frac{1}{n}\right)^n\)，证单调递增：}
\[
\frac{x_{n+1}}{x_n} = \frac{\left(\frac{n+2}{n+1}\right)^{n+1}}{\left(\frac{n+1}{n}\right)^n}
= \frac{n+2}{n+1}\left[\frac{n(n+2)}{(n+1)^2}\right]^n
= \frac{n+2}{n+1}\left[1 - \frac{1}{(n+1)^2}\right]^n
\]
由 Bernoulli 不等式：\(\left[1 - \frac{1}{(n+1)^2}\right]^n \geq 1 - \frac{n}{(n+1)^2}\)。
\[
\frac{x_{n+1}}{x_n} \geq \frac{n+2}{n+1}\left(1 - \frac{n}{(n+1)^2}\right)
= \frac{n^3 + 3n^2 + 3n + 2}{n^3 + 3n^2 + 3n + 1} > 1
\]
\textbf{(2) 令 \(y_n = \left(1 + \frac{1}{n}\right)^{n+1}\)，证单调递减：}
\[
\frac{y_{n+1}}{y_n} = \frac{n+2}{n+1}\left[\frac{n(n+2)}{(n+1)^2}\right]^{n+1}
= \frac{n+2}{n+1}\left[\frac{(n+1)^2}{n(n+2)}\right]^{-(n+1)}
= \frac{n+2}{n+1}\left[1 + \frac{1}{n(n+2)}\right]^{-(n+1)}
\]
由 Bernoulli 不等式：\(\left[1 + \frac{1}{n(n+2)}\right]^{n+1} \geq 1 + \frac{n+1}{n(n+2)}\)，故
\[
\frac{y_{n+1}}{y_n} \leq \frac{n+2}{n+1} \cdot \frac{1}{1 + \frac{n+1}{n(n+2)}} < 1
\]

\textbf{(3) \(x_n < y_n\) 且 \(x_n \uparrow\)，\(y_n \downarrow\)：}
\[
x_n \leq \lim_{n \to \infty} x_n = \lim_{n \to \infty} y_n \leq y_n
\]
由 \(x_n \cdot \left(1+\frac{1}{n}\right) = y_n\)，取极限得 \(\displaystyle \lim_{n \to +\infty} x_n = \lim_{n \to +\infty} y_n = e\)。
\end{proof}
\end{example}

