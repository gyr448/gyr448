\section{一、函数极限的 Cauchy 收敛准则}

\textbf{定理：}\(\displaystyle \lim_{x \to x_0} f(x) = A\)
\[
\Leftrightarrow \forall \varepsilon > 0,\; \exists \delta > 0,\; \text{s.t. } \forall x', x'' \in O^-(x_0, \delta),\; |f(x') - f(x'')| < \varepsilon
\]

\begin{proof}
\(\Rightarrow\)：由极限定义易证。

\(\Leftarrow\)：只需证 \(\forall \{x_n\} \subseteq O^-(x_0)\) 且 \(x_n \to x_0\)，\(\{f(x_n)\}\) 收敛。

由 \(x_n \to x_0\)，\(\forall \delta > 0\)，\(\exists N \in \mathbb{N}\)，s.t. \(\forall n > N\)，\(0 < |x_n - x_0| < \delta\)。

当 \(n, m > N\) 时，\(x_n, x_m \in O^-(x_0, \delta)\)，由条件：\(|f(x_n) - f(x_m)| < \varepsilon\)。

\(\therefore \{f(x_n)\}\) 为 Cauchy 列 \(\Rightarrow\) 收敛。由 Heine 定理，\(\displaystyle \lim_{x \to x_0} f(x)\) 存在。
\end{proof}

\section{二、函数极限的推广}

\subsection{1. 无穷大极限（\(x \to a,\; f(x) \to \infty\)）}

\textbf{\(\varepsilon\text{-}\delta\) 定义：}\(\forall M > 0\)，\(\exists \delta > 0\)，s.t. \(\forall x \in O^-(a, \delta)\)，\(|f(x)| > M\)（或 \(f(x) > M\) 为 \(+\infty\)，\(f(x) < -M\) 为 \(-\infty\)）。

\textbf{序列定义：}\(\forall \{x_n\} \subseteq O^-(x_0)\) 且 \(x_n \to x_0\)，有 \(f(x_n) \to \infty\)。

\subsection{2. 自变量趋于无穷（\(x \to \infty\)）}

\(f(x)\) 在 \(|x| > M\) 上有定义。

\textbf{\(\varepsilon\text{-}\delta\) 定义：}\(\forall \varepsilon > 0\)，\(\exists X > 0\)，s.t. \(\forall |x| > X\)，\(|f(x) - A| < \varepsilon\)。记作 \(\displaystyle \lim_{x \to \infty} f(x) = A\)。

\textbf{序列定义：}\(\forall \{x_n\}\) 且 \(x_n \to \infty\)，有 \(f(x_n) \to A\)。

也可有 \(\lim_{x \to \infty} f(x) = \infty\)、\(\lim_{x \to +\infty}\)、\(\lim_{x \to -\infty}\) 等变体。

\subsection{3. 单侧极限}

对 \(x\) 接近 \(x_0\) 的方式加以限制：

\begin{center}
\includegraphics[width=0.2\textwidth]{images/35_91_1684_369_165_0.jpg}
\end{center}

\textbf{左/右邻域：}
\begin{itemize}
\item 右邻域：\([x_0, x_0 + h)\)，记作 \(O_+(x_0, h)\)
\item 右去心邻域：\((x_0, x_0 + h)\)，记作 \(O_+^-(x_0, h)\)
\item 左邻域：\((x_0 - h, x_0]\)，记作 \(O_-(x_0, h)\)
\item 左去心邻域：\((x_0 - h, x_0)\)，记作 \(O_-^-(x_0, h)\)
\end{itemize}

\begin{center}
\includegraphics[width=0.3\textwidth]{images/35_590_1676_392_168_0.jpg}
\end{center}

\textbf{右极限定义：}若 \(\forall \varepsilon > 0\)，\(\exists \delta > 0\)，s.t. \(\forall x \in O_+^-(x_0, \delta)\)，\(|f(x) - A| < \varepsilon\)，称 \(A\) 为 \(f(x)\) 在 \(x \to x_0^+\) 的右极限，记作 \(\displaystyle \lim_{x \to x_0^+} f(x) = A\)。

同理定义左极限 \(\displaystyle \lim_{x \to x_0^-} f(x) = A\)。

\begin{example}
\begin{enumerate}
\item \(\displaystyle \lim_{x \to 0^+} \arctan\frac{1}{x} = \frac{\pi}{2}\)，\(\displaystyle \lim_{x \to 0^-} \arctan\frac{1}{x} = -\frac{\pi}{2}\)（利用单调性），故 \(\displaystyle \lim_{x \to 0} \arctan\frac{1}{x}\) 不存在。
\item 取整函数 \(y = [x]\)：\(\displaystyle \lim_{x \to n^+} [x] = n\)，\(\displaystyle \lim_{x \to n^-} [x] = n-1\)。
\end{enumerate}
\end{example}

\begin{center}
\includegraphics[width=0.6\textwidth]{images/36_5_1224_791_466_0.jpg}
\end{center}

\section{三、单侧极限与极限的关系}

\textbf{定理：}设 \(f(x)\) 在 \(O^-(x_0)\) 有定义，则
\[
\lim_{x \to x_0} f(x) = A \;\Leftrightarrow\; \lim_{x \to x_0^+} f(x) = \lim_{x \to x_0^-} f(x) = A
\]

\begin{proof}
\(\Rightarrow\)：显然（去心邻域同时包含左右两侧）。

\(\Leftarrow\)：由左极限 \(\exists \delta_1 > 0\)，s.t. \(x_0 - \delta_1 < x < x_0\) 时 \(|f(x)-A| < \varepsilon\)；由右极限 \(\exists \delta_2 > 0\)，s.t. \(x_0 < x < x_0 + \delta_2\) 时 \(|f(x)-A| < \varepsilon\)。取 \(\delta = \min\{\delta_1, \delta_2\}\) 即可。
\end{proof}

\section{四、单调函数的单侧极限}

\textbf{定理：}若 \(f(x)\) 在 \(O_-^-(x_0, h)\) 上有定义且单调，则 \(\displaystyle \lim_{x \to x_0^-} f(x)\) 存在（有限或 \(\pm\infty\)），且等于 \(\displaystyle \sup_{x \in O_-^-(x_0,h)} f(x)\)（单调增）或 \(\inf\)（单调减）。

\begin{proof}
（以单调增为例）记 \(F = \{f(x) \mid x \in O_-^-(x_0, h)\}\)，设 \(A = \sup F\)。

\textbf{情形1：}\(A\) 有限（即 \(F\) 有上界）。由上确界定义，\(\forall \varepsilon > 0\)，\(\exists x' \in O_-^-(x_0, h)\)，s.t. \(f(x') > A - \varepsilon\)。

取 \(\delta = x_0 - x'\)，当 \(x \in O_-^-(x_0, \delta)\) 时，\(x > x'\)。由单调性 \(f(x) \geq f(x')\)，故
\[
A - \varepsilon < f(x') \leq f(x) \leq A < A + \varepsilon
\]
即 \(|f(x) - A| < \varepsilon\)，\(\therefore \lim_{x \to x_0^-} f(x) = A\)。

\textbf{情形2：}\(A = +\infty\)（即 \(F\) 无上界）。\(\forall M > 0\)，\(\exists x' \in O_-^-(x_0, h)\)，s.t. \(f(x') > M\)。同理，当 \(x \in O_-^-(x_0, x_0 - x')\) 时 \(f(x) \geq f(x') > M\)，故 \(\lim f(x) = +\infty\)。
\end{proof}

\begin{center}
\includegraphics[width=0.8\textwidth]{images/37_9_1922_1071_387_0.jpg}
\end{center}

\textbf{单侧极限的性质：}(1)唯一性 (2)局部有界性 (3)不等式性质 (4)Cauchy 收敛原理（均与双侧极限类似）。

\section{五、复合函数求极限}

\textbf{定理：}设 \(f(t)\) 在 \(O^-(t_0)\) 上有定义且 \(\displaystyle \lim_{t \to t_0} f(t) = A\)；\(t = g(x)\) 在 \(O^-(x_0)\) 上有定义，\(\forall x \in O^-(x_0)\)，\(g(x) \in O^-(t_0)\)，且 \(\displaystyle \lim_{x \to x_0} g(x) = t_0\)。则
\[
\lim_{x \to x_0} f(g(x)) = A
\]

\begin{proof}
\(\forall \varepsilon > 0\)，\(\exists \delta' > 0\)，s.t. \(\forall 0 < |t - t_0| < \delta'\)，\(|f(t) - A| < \varepsilon\)。

对取定的 \(\delta'\)，\(\exists \delta > 0\)，s.t. \(\forall 0 < |x - x_0| < \delta\)，\(|g(x) - t_0| < \delta'\)。

由条件 \(g(x) \in O^-(t_0)\)，故 \(g(x) \neq t_0\)。从而 \(|f(g(x)) - A| < \varepsilon\)。
\end{proof}

\begin{example}
\begin{enumerate}
\item \(\displaystyle \lim_{x \to 0} \frac{\sin(\sin x)}{\sin x}\)：令 \(y = \sin x\)，\(x \to 0\) 时 \(y \to 0\)，\(= \lim_{y \to 0} \frac{\sin y}{y} = 1\)。
\item \(\displaystyle \lim_{x \to 0} \frac{1 - \cos x}{x^2} = \lim_{x \to 0} \frac{2\sin^2\frac{x}{2}}{x^2} = \frac{1}{2} \lim_{x \to 0} \left(\frac{\sin\frac{x}{2}}{\frac{x}{2}}\right)^2 = \frac{1}{2}\)。
\item \(\displaystyle \lim_{x \to 0} \frac{\tan x - \sin x}{x^3} = \lim_{x \to 0} \frac{\sin x}{x} \cdot \frac{1}{\cos x} \cdot \frac{1 - \cos x}{x^2} = 1 \cdot 1 \cdot \frac{1}{2} = \frac{1}{2}\)。
\end{enumerate}
\end{example}

\section{六、两个重要极限}

\[
\boxed{\lim_{x \to 0} \frac{\sin x}{x} = 1},\qquad
\boxed{\lim_{x \to \infty} \left(1 + \frac{1}{x}\right)^x = e}
\]

\begin{proof}
\textbf{(2) 的证明（从数列推广到函数）：}

\textbf{\(x \to +\infty\)：}利用 \([x] \leq x < [x] + 1\)：
\[
\left(1 + \frac{1}{[x]+1}\right)^{[x]} \leq \left(1 + \frac{1}{x}\right)^x \leq \left(1 + \frac{1}{[x]}\right)^{[x]+1}
\]
两边取极限（利用数列极限 \(\lim_{n\to\infty}(1+\frac1n)^n = e\)），由夹逼定理得 \(\displaystyle \lim_{x \to +\infty} \left(1 + \frac{1}{x}\right)^x = e\)。

\textbf{\(x \to -\infty\)：}令 \(y = -x \to +\infty\)：
\[
\left(1 + \frac{1}{x}\right)^x = \left(1 - \frac{1}{y}\right)^{-y}
= \left(\frac{y}{y-1}\right)^y
= \left(1 + \frac{1}{y-1}\right)^y \to e
\]
综上 \(\displaystyle \lim_{x \to \infty} \left(1 + \frac{1}{x}\right)^x = e\)。
\end{proof}

\textbf{等价形式：}\(\displaystyle \lim_{\alpha \to 0} (1 + \alpha)^{\frac{1}{\alpha}} = e\)。

\section{七、无穷小量的比较（变量的阶）}

设 \(f(x), g(x)\) 在 \(O^-(x_0)\) 上有定义，当 \(x \to x_0\) 时 \(f(x) \to 0\)，\(g(x) \to 0\)。

\begin{enumerate}
\item \textbf{同阶无穷小：}若 \(\displaystyle \lim_{x \to x_0} \frac{f(x)}{g(x)} = A \neq 0\)（有限），称 \(f(x)\) 与 \(g(x)\) 为同阶无穷小量，记作 \(f(x) \sim A \cdot g(x)\)。
\item \textbf{高阶无穷小：}若 \(\displaystyle \lim_{x \to x_0} \frac{f(x)}{g(x)} = 0\)，称 \(f(x)\) 为 \(g(x)\) 的高阶无穷小量，记作 \(f(x) = o(g(x))\)。
\item \textbf{有界量记号：}若 \(\exists M > 0\)，s.t. 在 \(O^-(x_0)\) 上 \(|f(x)| \leq M|g(x)|\)，记作 \(f(x) = O(g(x))\)（此时 \(f/g\) 可以没有极限）。
\end{enumerate}

特别地，若 \(g(x) = x^a\) 且 \(f(x) \sim C x^a\)（\(C \neq 0\)），称 \(a\) 为 \(f(x)\) 的\textbf{阶}。

\section{八、渐近线}

若点 \((x, f(x))\) 到直线 \(y = kx + b\) 的距离趋于 \(0\)（\(x \to +\infty\) 或 \(x \to -\infty\)），称该直线为 \(f(x)\) 的\textbf{渐近线}。

\[
\text{距离} = \frac{|f(x) - (kx + b)|}{\sqrt{1 + k^2}} \to 0 \;\Longleftrightarrow\; \lim_{x \to \infty} [f(x) - (kx + b)] = 0
\]

\textbf{求法：}
\[
k = \lim_{x \to +\infty} \frac{f(x)}{x},\qquad
b = \lim_{x \to +\infty} (f(x) - kx)
\]
（先求 \(k\)，再求 \(b\)。）

\begin{example}
\(y = \sqrt{1 + x^2}\)，求 \(x \to \pm\infty\) 的渐近线。

\textbf{\(x \to +\infty\)：}
\[
k = \lim_{x \to +\infty} \frac{\sqrt{1+x^2}}{x} = \lim_{x \to +\infty} \sqrt{1 + \frac{1}{x^2}} = 1
\]
\[
b = \lim_{x \to +\infty} \left(\sqrt{1+x^2} - x\right)
= \lim_{x \to +\infty} \frac{1}{\sqrt{1+x^2} + x} = 0
\]
渐近线：\(y = x\)。

\textbf{\(x \to -\infty\)：}\(k = -1\)，\(b = 0\)，渐近线：\(y = -x\)。
\end{example}

