\chapter{9.23 数列极限}

\subsection{回顾上节课}

极限的性质： (1) 唯一性 \quad (2) 有界性 \quad (3) 保号性

\begin{center}
\includegraphics[width=0.4\textwidth]{images/9_1100_106_556_141_0.jpg}
\end{center}

\(O(a,\varepsilon)\) 外只有有限项。

\subsection{一、保序性（续）}

\textbf{定理：}若 \(\displaystyle \lim_{n \to +\infty} x_n = a\)，\(\displaystyle \lim_{n \to +\infty} y_n = b\)，且 \(a > b\)，则 \(\exists N \in \mathbb{N}\)，\(\forall n > N\)，有 \(x_n > y_n\)。

\begin{proof}
取 \(\varepsilon = \dfrac{a-b}{2}\)。\(\exists N_1 \in \mathbb{N}\)，s.t. \(\forall n > N_1\)，\(|x_n - a| < \dfrac{a-b}{2}\)，即 \(x_n > \dfrac{a+b}{2}\)；

\(\exists N_2 \in \mathbb{N}\)，s.t. \(\forall n > N_2\)，\(|y_n - b| < \dfrac{a-b}{2}\)，即 \(y_n < \dfrac{a+b}{2}\)。

取 \(N = \max\{N_1, N_2\}\)，则 \(\forall n > N\)，\(x_n > \dfrac{a+b}{2} > y_n\)。
\end{proof}

\textbf{推论1：}若 \(\forall n \in \mathbb{N}\)，\(x_n \leq y_n\)，且 \(\displaystyle \lim_{n \to +\infty} x_n\) 及 \(\displaystyle \lim_{n \to +\infty} y_n\) 存在，则 \(\displaystyle \lim_{n \to \infty} x_n \leq \lim_{n \to \infty} y_n\)。

这里即使条件加强为严格不等号，结论仍为 \(\leq\)。

\textbf{推论2：}若 \(\displaystyle \lim_{n \to \infty} x_n = a > b\)，则 \(\exists N \in \mathbb{N}\)，\(\forall n > N\)，\(x_n > b\)。

\textbf{推论3：}若 \(\displaystyle \lim_{n \to +\infty} x_n = a > 0\)，则 \(\exists N \in \mathbb{N}\)，\(\forall n > N\)，\(x_n > 0\)。

\subsection{二、两边夹定理（迫敛性）}

设 \(x_n \leq y_n \leq z_n\)。若 \(\displaystyle \lim_{n \to \infty} x_n = \lim_{n \to \infty} z_n = a\)，则 \(\{y_n\}\) 有极限，且 \(\displaystyle \lim_{n \to +\infty} y_n = a\)。

\begin{proof}
\(\forall \varepsilon > 0\)，\(\exists N_1 \in \mathbb{N}\)，s.t. \(\forall n > N_1\)，\(a - \varepsilon < x_n < a + \varepsilon\)；

\(\exists N_2 \in \mathbb{N}\)，s.t. \(\forall n > N_2\)，\(a - \varepsilon < z_n < a + \varepsilon\)。

取 \(N = \max\{N_1, N_2\}\)，\(\forall n > N\)，
\[
a - \varepsilon < x_n \leq y_n \leq z_n < a + \varepsilon
\]
则 \(\displaystyle \lim_{n \to \infty} y_n = a\)。
\end{proof}

\subsection{三、极限的四则运算}

设 \(\displaystyle \lim_{n \to +\infty} x_n = a\)，\(\displaystyle \lim_{n \to \infty} y_n = b\)。

\subsubsection{(1) 加减法}

\(\displaystyle \lim_{n \to +\infty} (x_n \pm y_n) = a \pm b\)

\begin{proof}
\(\forall \varepsilon > 0\)，\(\exists N_1 \in \mathbb{N}\)，s.t. \(\forall n > N_1\)，\(|x_n - a| < \dfrac{\varepsilon}{2}\)；

\(\exists N_2 \in \mathbb{N}\)，s.t. \(\forall n > N_2\)，\(|y_n - b| < \dfrac{\varepsilon}{2}\)。

取 \(N = \max\{N_1, N_2\}\)，\(\forall n > N\)，
\[
|(x_n \pm y_n) - (a \pm b)| \leq |x_n - a| + |y_n - b| < \varepsilon
\]
\(\therefore \displaystyle \lim_{n \to +\infty} (x_n + y_n) = a + b\)。
\end{proof}

\subsubsection{(2) 乘法}

\(\displaystyle \lim_{n \to +\infty} x_n y_n = ab\)

\begin{proof}
若 \(a = 0\) 或 \(b = 0\)，则变为无穷小数列乘以有界数列，由之前结论成立。

假设 \(a \neq 0, b \neq 0\)：
\[
|x_n y_n - ab| = |x_n y_n - a y_n + a y_n - ab| \leq |x_n - a| \cdot |y_n| + |a| \cdot |y_n - b|
\]
由 \(\{y_n\}\) 有极限，故有界，即 \(\exists M > 0\)，s.t. \(|y_n| \leq M\)。

\(\forall \varepsilon > 0\)，\(\exists N_1 \in \mathbb{N}\)，s.t. \(\forall n > N_1\)，\(|x_n - a| < \dfrac{\varepsilon}{2M}\)；

\(\exists N_2 \in \mathbb{N}\)，s.t. \(\forall n > N_2\)，\(|y_n - b| < \dfrac{\varepsilon}{2|a|}\)。

取 \(N = \max\{N_1, N_2\}\)，\(\forall n > N\)，
\[
|x_n y_n - ab| < \frac{\varepsilon}{2M} \cdot M + |a| \cdot \frac{\varepsilon}{2|a|} = \varepsilon
\]
\end{proof}

\subsubsection{(3) 除法}

若 \(b \neq 0\)，则 \(\displaystyle \lim_{n \to \infty} \frac{x_n}{y_n} = \frac{a}{b}\)

\begin{proof}
由保号性质，\(\exists N_0 \in \mathbb{N}\)，s.t. \(\forall n > N_0\)，\(y_n\) 与 \(b\) 同号，且 \(|y_n| > \dfrac{|b|}{2}\)。

由乘法法则，仅需证明：\(\displaystyle \lim_{n \to +\infty} \frac{1}{y_n} = \frac{1}{b}\)。

\(\forall n > N_0\)：
\[
\left| \frac{1}{y_n} - \frac{1}{b} \right| = \frac{|y_n - b|}{|y_n| \cdot |b|} \leq \frac{2}{b^2} |y_n - b|
\]
\(\forall \varepsilon > 0\)，\(\exists N_1 \in \mathbb{N}\)，s.t. \(\forall n > N_1\)，\(|y_n - b| < \dfrac{b^2}{2} \varepsilon\)。

取 \(N = \max\{N_0, N_1\}\)，则 \(\forall n > N\)，\(\left| \dfrac{1}{y_n} - \dfrac{1}{b} \right| < \varepsilon\)。
\end{proof}

极限运算与四则运算可交换次序。

\subsection{四、例题}

\begin{example}
求 \(\displaystyle \lim_{n \to +\infty} \frac{n^2 - n + 2}{3n^2 + 2n + 4}\)。

\textbf{解：}分子分母同除以 \(n^2\)：
\[
\lim_{n \to +\infty} \frac{1 - \frac{1}{n} + \frac{2}{n^2}}{3 + \frac{2}{n} + \frac{4}{n^2}} = \frac{1 - 0 + 0}{3 + 0 + 0} = \frac{1}{3}
\]
\end{example}

\begin{example}
设 \(a > 1\)，求证 \(\displaystyle \lim_{n \to \infty} \sqrt[n]{a} = 1\)。

\begin{proof}
设 \(a_n = \sqrt[n]{a} - 1\)，则 \(a_n > 0\)，且
\[
a = (a_n + 1)^n = 1 + n a_n + \frac{n(n-1)}{2} a_n^2 + \cdots > 1 + n a_n
\]
\(\therefore 0 < a_n < \dfrac{a-1}{n}\)。两边取极限，由夹逼定理：
\[
\lim_{n \to \infty} a_n = 0 \;\Longrightarrow\; \lim_{n \to \infty} \sqrt[n]{a} = 1
\]
\end{proof}
\end{example}

\begin{example}
求证：\(\displaystyle \lim_{n \to \infty} \sqrt[n]{n} = 1\)。

\begin{proof}
设 \(a_n = \sqrt[n]{n} - 1 \geq 0\)，则
\[
n = (1 + a_n)^n = 1 + n a_n + \frac{n(n-1)}{2} a_n^2 + \cdots > \frac{n(n-1)}{2} a_n^2
\]
\[
\therefore 0 \leq a_n < \sqrt{\frac{2}{n-1}}
\]
\(\forall \varepsilon > 0\)，取 \(N = \left[\dfrac{2}{\varepsilon^2}\right] + 1\)，则 \(\forall n > N\)，\(a_n < \varepsilon\)。

由夹逼定理，\(\displaystyle \lim_{n \to \infty} \sqrt[n]{n} = 1\)。
\end{proof}
\end{example}

\textbf{推广：}\(\forall \alpha \in \mathbb{R}\)，\(\displaystyle \lim_{n \to \infty} \sqrt[n]{n^\alpha} = 1\)。

\begin{enumerate}
\item \(\alpha\) 为正整数：\(\displaystyle \lim_{n \to +\infty} \sqrt[n]{n^k} = \left(\lim_{n \to +\infty} \sqrt[n]{n}\right)^k = 1^k = 1\)
\item \(\alpha > 0\) 非整数：设 \(k = [\alpha]\)，则
\[
\lim_{n \to \infty} \sqrt[n]{n^k} < \lim_{n \to \infty} \sqrt[n]{n^\alpha} < \lim_{n \to \infty} \sqrt[n]{n^{k+1}}
\]
两边均为 \(1\)，由夹逼定理得 \(\displaystyle \lim_{n \to \infty} \sqrt[n]{n^\alpha} = 1\)。
\item \(\alpha < 0\)：\(\displaystyle \lim_{n \to \infty} \sqrt[n]{n^\alpha} = \frac{1}{\lim_{n \to \infty} \sqrt[n]{n^{-\alpha}}} = 1\)
\end{enumerate}

\begin{example}
求 \(\displaystyle \lim_{n \to +\infty} \left(\sqrt{n^2 + n} - n\right)\)。

\textbf{解：}有理化：
\begin{align*}
\lim_{n \to +\infty} \left(\sqrt{n^2 + n} - n\right)
&= \lim_{n \to +\infty} \frac{(n^2 + n) - n^2}{\sqrt{n^2 + n} + n}
= \lim_{n \to +\infty} \frac{n}{\sqrt{n^2 + n} + n} \\
&= \lim_{n \to +\infty} \frac{1}{\sqrt{1 + \frac{1}{n}} + 1} = \frac{1}{2}
\end{align*}
\end{example}

\begin{example}
设 \(c > 0\)，求 \(\displaystyle \lim_{n \to \infty} \sqrt[n]{c + \frac{1}{n}}\)。

\begin{proof}
当 \(n \geq 1\) 时，\(c < c + \frac{1}{n} < c + 1\)，故
\[
\lim_{n \to +\infty} \sqrt[n]{c} \leq \lim_{n \to +\infty} \sqrt[n]{c + \tfrac{1}{n}} \leq \lim_{n \to +\infty} \sqrt[n]{c + 1}
\]
由 \(\displaystyle \lim_{n \to +\infty} \sqrt[n]{c} = \lim_{n \to +\infty} \sqrt[n]{c+1} = 1\)，夹逼得原式 \(= 1\)。
\end{proof}
\end{example}

\begin{example}
设 \(|q| < 1\)，求 \(\displaystyle \lim_{n \to +\infty} \sum_{k=1}^{n} q^{k-1}\)。

\textbf{解：}
\[
\lim_{n \to +\infty} \sum_{k=1}^{n} q^{k-1} = \lim_{n \to +\infty} \frac{1 - q^n}{1 - q} = \frac{1}{1 - q}
\]
记作 \(\displaystyle \sum_{k=1}^{\infty} q^{k-1} = \frac{1}{1 - q}\)。
\end{example}

\begin{example}
设 \(\displaystyle \lim_{n \to +\infty} x_n = a\)，\(\displaystyle \lim_{n \to +\infty} y_n = b\)，\(z_n = \dfrac{1}{n}\displaystyle\sum_{k=1}^{n} x_k y_k\)。

求证：\(\displaystyle \lim_{n \to +\infty} z_n = a \cdot b\)（柯西平均值定理）。

\begin{proof}
令 \(\alpha_n = x_n - a\)，\(\beta_n = y_n - b\)，则 \(\alpha_n \to 0\)，\(\beta_n \to 0\)。

\begin{align*}
z_n &= \frac{1}{n} \sum_{k=1}^{n} (a + \alpha_k)(b + \beta_k) \\
&= ab + a \cdot \frac{1}{n}\sum_{k=1}^{n} \beta_k + b \cdot \frac{1}{n}\sum_{k=1}^{n} \alpha_k + \frac{1}{n}\sum_{k=1}^{n} \alpha_k \beta_k
\end{align*}

由 \(\{\beta_n\}\) 有界，\(\exists M > 0\)，s.t. \(|\beta_n| \leq M\)，故
\[
\left|\frac{1}{n}\sum_{k=1}^{n} \alpha_k \beta_k\right| \leq M \cdot \frac{1}{n}\sum_{k=1}^{n} |\alpha_k|
\]

由无穷小数列前 \(n\) 项平均值也是无穷小（见引理），\(\frac{1}{n}\sum_{k=1}^{n} |\alpha_k| \to 0\)，\(\frac{1}{n}\sum_{k=1}^{n} \beta_k \to 0\)。

故 \(\displaystyle \lim_{n \to +\infty} z_n = ab\)。
\end{proof}

\textbf{特例（\(y_n \equiv 1\)）：}若 \(\displaystyle \lim_{n \to +\infty} x_n = a\)，则 \(\displaystyle \lim_{n \to +\infty} \frac{x_1 + x_2 + \cdots + x_n}{n} = a\)。
\end{example}

\begin{example}
设 \(\displaystyle \lim_{n \to +\infty} a_n = A\)，且 \(a_n > 0\)。求证 \(\displaystyle \lim_{n \to +\infty} \sqrt[n]{a_1 a_2 \cdots a_n} = A\)。

\begin{proof}
由均值不等式：
\[
\frac{n}{\frac{1}{a_1} + \cdots + \frac{1}{a_n}} \leq \sqrt[n]{a_1 \cdots a_n} \leq \frac{a_1 + \cdots + a_n}{n}
\]
由特例，右边 \(\to A\)。对 \(\frac{1}{a_n}\) 同理得左边 \(\to A\)。夹逼得结论。
\end{proof}
\end{example}

\subsection{五、单调有界数列}

\textbf{定义：}若 \(\forall n \in \mathbb{N}\)，\(x_n \leq x_{n+1}\)，称 \(\{x_n\}\) 为单调上升（递增）数列；若 \(x_n \geq x_{n+1}\)，称下降（递减）数列。严格上升/下降无等号。

\textbf{定理：}单调有界数列必有极限。

\begin{proof}
设 \(\{x_n\}\) 单调上升有上界。记 \(E = \{x_n \mid n \in \mathbb{N}\}\)。

由确界定理，\(E\) 存在上确界，记作 \(a = \sup E\)。

由上确界定义：\(\forall \varepsilon > 0\)，\(\exists x_{n_0} \in E\)，s.t. \(x_{n_0} > a - \varepsilon\)。

令 \(N = n_0\)，\(\forall n > N\)，由单调性：\(x_n \geq x_{n_0} > a - \varepsilon\)。

另一方面，\(a = \sup E\) 是上界，故 \(x_n \leq a < a + \varepsilon\)。

\(\therefore |x_n - a| < \varepsilon\)，即 \(\displaystyle \lim_{n \to \infty} x_n = a\)。
\end{proof}

