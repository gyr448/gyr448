\chapter{12.9 有理函数与特殊函数积分}

\section{一、有理函数的积分}

有理函数 \(R(x) = \frac{P_n(x)}{Q_m(x)}\) 的原函数均为初等函数。

\textbf{步骤：}长除法化为多项式 + 真分式 → 分母因式分解 → 部分分式分解 → 逐项积分。

\subsection{部分分式分解（待定系数法）}

\begin{example}
\(\displaystyle \frac{x+3}{(x+2)(x^2-1)} = \frac{A}{x+2} + \frac{B}{x+1} + \frac{C}{x-1}\)。

\textbf{方法一（通分比较系数）：}解得 \(A = \frac13, B = -1, C = \frac23\)。

\textbf{方法二（极限法）：}同乘 \(x+2\) 令 \(x \to -2\)：\(A = \frac13\)。同乘 \(x+1\) 令 \(x \to -1\)：\(B = -1\)。同理 \(C = \frac23\)。
\end{example}

\begin{example}
重根情形：\(\displaystyle \frac{x+3}{(x+1)(x-2)^2} = \frac{A}{x+1} + \frac{B}{x-2} + \frac{C}{(x-2)^2}\)。

\(A = \lim_{x\to-1}\frac{x+3}{(x-2)^2} = \frac{2}{9}\)，\(C = \lim_{x\to2}\frac{x+3}{x+1} = \frac{5}{3}\)。\(B\) 通过求导：\(B = \lim_{x\to2}\frac{d}{dx}\!\left(\frac{x+3}{x+1}\right) = -\frac{2}{9}\)。
\end{example}

\begin{example}
复根重根：\(\displaystyle \frac{2(x+1)}{(x-1)(x^2+1)^2} = \frac{A}{x-1} + \frac{Bx+C}{x^2+1} + \frac{Dx+E}{(x^2+1)^2}\)。

\(A = \lim_{x\to1}\frac{2(x+1)}{(x^2+1)^2} = 1\)。令 \(x \to i\)：\(Di+E = -2i \Rightarrow D=-2, E=0\)。令 \(x\to\infty\)：\(A+B=0 \Rightarrow B=-1\)。\(x=0\)：\(C=-1\)。
\end{example}

\section{二、三角有理函数的积分}

\(\int R(\sin x, \cos x)\,dx\)，万能代换 \(t = \tan\frac{x}{2}\)：
\[
\sin x = \frac{2t}{1+t^2},\; \cos x = \frac{1-t^2}{1+t^2},\; dx = \frac{2}{1+t^2}\,dt
\]
化为 \(t\) 的有理函数积分。

\textbf{简化代换（根据对称性）：}
\begin{enumerate}
\item 若 \(R(-u,v) = -R(u,v)\)（关于 \(\sin\) 奇）：令 \(t = \cos x\)。
\item 若 \(R(u,-v) = -R(u,v)\)（关于 \(\cos\) 奇）：令 \(t = \sin x\)。
\item 若 \(R(-u,-v) = R(u,v)\)（偶函数）：令 \(t = \tan x\)。
\end{enumerate}

\section{三、可积无理函数}

\subsection{1. 线性分式的根式}

\(\int R\!\left(\sqrt[m]{\frac{ax+b}{cx+d}},\,x\right)dx\)（\(ad \neq bc\)），令 \(t = \sqrt[m]{\frac{ax+b}{cx+d}}\) 化为有理函数。

\begin{example}
\(\int \frac{1-\sqrt{t}}{1+\sqrt[3]{t}}\,dt\)：令 \(s = \sqrt[6]{t}\)。
\end{example}

\subsection{2. 二次根式 \(\sqrt{ax^2+bx+c}\)}

\begin{itemize}
\item 有实根：化为 \(\sqrt{\frac{x-\beta}{x-\alpha}}\) 线性分式根式。
\item 无实根（\(a>0\)）：Euler 代换 \(\sqrt{ax^2+bx+c} = \sqrt{a}\,x + t\) 或 \(= xt + \sqrt{c}\)。
\end{itemize}

\subsection{3. Chebyshev 积分}

\(\int x^m(a+bx^n)^p\,dx\)（\(m,n,p \in \mathbb{Q}\)）。令 \(t = x^n\) 化为 \(\frac1n\int (a+bt)^p t^{\frac{m+1}{n}-1}\,dt\)。可积的三种情形：
\begin{enumerate}
\item \(p \in \mathbb{Z}\)：二项展开。
\item \(\frac{m+1}{n} \in \mathbb{Z}\)：令 \(s = a+bt\)。
\item \(\frac{m+1}{n} + p \in \mathbb{Z}\)：令 \(s = \frac{a+bt}{t}\)。
\end{enumerate}
除此三种情形外，原函数非初等（群论可证）。

