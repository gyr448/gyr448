\section{一、Legendre 多项式}

\[
P_n(x) = C_n \frac{d^n}{dx^n}\!\left[(x^2-1)^n\right],\qquad C_n = \frac{\sqrt{n+\frac12}}{2^n \cdot n!}
\]

\textbf{正交性：}\(\displaystyle \int_{-1}^{1} P_m(x)P_n(x)\,dx = \delta_{mn} = \begin{cases} 1, & m = n \\ 0, & m \neq n \end{cases}\)。

\begin{proof}
（分部积分法）\(I(m,n) = \int_{-1}^{1} \frac{d^m}{dx^m}[(x^2-1)^m] \cdot \frac{d^n}{dx^n}[(x^2-1)^n]\,dx\)。

不断分部积分：\(I(m,n) = -I(m+1,n-1) = \cdots = (-1)^n I(m+n,0)\)。

设 \(m \geq n\)，若 \(m > n\) 则 \((x^2-1)^m\) 求 \(m+n > 2m\) 阶导数为 \(0\) \(\Rightarrow\) \(I(m,n)=0\)。若 \(m=n\)，
\[
I(n,n) = (-1)^n (2n)! \int_{-1}^{1} (1-x^2)^n\,dx = \frac{2^{2n}(n!)^2}{n+\frac12}
\]
乘以 \(C_n^2\) 即得 \(1\)。
\end{proof}

\section{二、带积分余项的 Taylor 展开}

\textbf{引理：}若 \(f \in C^{n+1}[0,1]\)，则
\[
f(1) = \sum_{k=0}^{n} \frac{f^{(k)}(0)}{k!} + \frac{1}{n!}\int_0^1 f^{(n+1)}(t)(1-t)^n\,dt
\]
\begin{proof}
反复分部积分：\(f(1)-f(0) = \int_0^1 f'(t)\,dt = -\int_0^1 f'(t)\,d(1-t) = f'(0) + \int_0^1 (1-t)f''(t)\,dt = \cdots\)。
\end{proof}

\textbf{一般形式：}令 \(g(t) = f(a + t(x-a))\)，代入引理即得带积分余项的 Taylor 公式。

\section{三、Stirling 公式}

\[
n! \sim \sqrt{2\pi n}\left(\frac{n}{e}\right)^n \quad (n \to +\infty)
\]

更精确的形式：\(n! = \sqrt{2\pi n}\left(\frac{n}{e}\right)^n e^{\frac{\theta_n}{12n}}\)，\(\theta_n \in (0,1)\)。

\textbf{证明思路：}令 \(a_n = \frac{n!}{\sqrt{n}(n/e)^n}\)。证 \(\{a_n\}\) 单调有界 \(\Rightarrow\) \(\lim a_n = a\) 存在。用 Wallis 公式确定 \(a = \sqrt{2\pi}\)。

