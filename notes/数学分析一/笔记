\chapter{12.19 定积分性质与计算}

\section{一、定积分的基本性质}

\subsection{1. 区间可加性}

\(f \in R[a,c]\) \(\Leftrightarrow\) \(f \in R[a,b]\) 且 \(f \in R[b,c]\)（\(a < b < c\)），且
\[
\int_a^c f(x)\,dx = \int_a^b f(x)\,dx + \int_b^c f(x)\,dx
\]
规定：\(\int_a^b f = -\int_b^a f\)，\(\int_a^a f = 0\)，则上述公式对任意次序的 \(a,b,c\) 成立。

\subsection{2. 不等式性质}

\begin{enumerate}
\item 若 \(f \geq 0\)，\(b > a\)，则 \(\int_a^b f \geq 0\)。推论：\(f \geq g\) \(\Rightarrow\) \(\int f \geq \int g\)。
\item \(|f| \in R[a,b]\)，且 \(\left|\int_a^b f\right| \leq \int_a^b |f|\)。
\end{enumerate}

\subsection{3. 积分第一中值定理}

设 \(f,g \in R[a,b]\)，\(g\) 在 \([a,b]\) 上不变号，则 \(\exists \mu \in [m,M]\)（\(m = \inf f, M = \sup f\)），s.t.
\[
\int_a^b f(x)g(x)\,dx = \mu \int_a^b g(x)\,dx
\]
\textbf{推论：}若 \(f \in C[a,b]\)，则 \(\exists \xi \in [a,b]\)，s.t. \(\int_a^b fg = f(\xi)\int_a^b g\)。

特别地（\(g \equiv 1\)）：\(\exists \xi \in [a,b]\)，\(f(\xi) = \frac{1}{b-a}\int_a^b f(x)\,dx\)（积分平均值）。

\section{二、变上限积分}

设 \(f \in R[a,b]\)，定义变上限积分 \(F(x) = \int_a^x f(t)\,dt\)（\(x \in [a,b]\)）。

\textbf{定理1（连续性）：}\(F(x) \in C[a,b]\)（且 Lipschitz 连续：\(|F(x_1)-F(x_2)| \leq M|x_1-x_2|\)，\(M = \sup|f|\)）。

\textbf{定理2（原函数存在定理）：}若 \(f \in R[a,b]\) 且在 \(x_0\) 处连续，则 \(F(x)\) 在 \(x_0\) 处可导，且 \(F'(x_0) = f(x_0)\)。

\begin{proof}
\(\left|\frac{F(x)-F(x_0)}{x-x_0} - f(x_0)\right| = \left|\frac{1}{x-x_0}\int_{x_0}^{x}[f(t)-f(x_0)]\,dt\right| \leq \sup_{t \in [x_0,x]}|f(t)-f(x_0)| \to 0\)（由连续性）。
\end{proof}

\textbf{推论：}若 \(f \in C[a,b]\)，则 \(F'(x) = f(x)\)（\(\forall x\)），即连续函数必有原函数。\(\therefore C[a,b] \subseteq N[a,b] \cap R[a,b]\)。

\textbf{求导公式：}
\[
\frac{d}{dx}\int_a^x f(t)\,dt = f(x),\quad
\frac{d}{dx}\int_a^{\varphi(x)} f(t)\,dt = f(\varphi(x))\,\varphi'(x)
\]
\[
\frac{d}{dx}\int_{\psi(x)}^{\varphi(x)} f(t)\,dt = f(\varphi(x))\varphi'(x) - f(\psi(x))\psi'(x)
\]

\section{三、定积分的计算}

\subsection{1. Newton-Leibniz 公式}

\(f \in C[a,b]\)，\(F\) 为其原函数，则 \(\int_a^b f(x)\,dx = F(b) - F(a) = F(x)\big|_a^b\)。

\begin{example}
\begin{enumerate}
\item \(\int_a^b e^x\,dx = e^b - e^a\)
\item \(\int_a^b \frac{dx}{x} = \ln\frac{b}{a}\)（\(b > a > 0\)）
\item \(\int_0^\pi \sin x\,dx = 2\)，\(\int_0^\pi \cos x\,dx = 0\)
\end{enumerate}
\end{example}

\subsection{2. 用 Riemann 和求极限}

\[
\lim_{n\to+\infty}\frac{1}{n}\sum_{k=1}^{n} f\!\left(\frac{k}{n}\right) = \int_0^1 f(x)\,dx
\]

\begin{example}
\begin{enumerate}
\item \(\displaystyle \lim_{n\to+\infty}\left(\frac{1}{n+1}+\cdots+\frac{1}{2n}\right) = \int_0^1\frac{dx}{1+x} = \ln 2\)
\item \(\displaystyle \lim_{n\to+\infty}\sum_{k=1}^{n}\frac{n}{n^2+k^2} = \int_0^1\frac{dx}{1+x^2} = \frac{\pi}{4}\)
\item \(\displaystyle \lim_{n\to+\infty}\frac{1^p+\cdots+n^p}{n^{p+1}} = \int_0^1 x^p\,dx = \frac{1}{p+1}\)（\(p > -1\)）
\end{enumerate}
\end{example}

\subsection{3. 定积分换元法}

\(f \in C[a,b]\)，\(x = \varphi(t)\) 在 \([\alpha,\beta]\) 可导且 \(\varphi' \in R[\alpha,\beta]\)，\(\varphi(\alpha)=a, \varphi(\beta)=b\)，则
\[
\int_a^b f(x)\,dx = \int_\alpha^\beta f(\varphi(t))\,\varphi'(t)\,dt
\]

\begin{example}
椭圆 \(\frac{x^2}{a^2}+\frac{y^2}{b^2}=1\) 面积：\(S = 4\int_0^a b\sqrt{1-\frac{x^2}{a^2}}\,dx\)，令 \(x = a\cos t\)，\(= 4ab\int_0^{\pi/2}\sin^2 t\,dt = \pi ab\)。
\end{example}

