\chapter{10.14 习题课}

\section{一、Stolz 定理（\(\frac{\infty}{\infty}\) 型）回顾}

条件：分母序列 \(\{x_n\}\) 严格单调递增且 \(x_n \to +\infty\)，极限 \(\displaystyle \lim_{n \to \infty} \frac{y_n - y_{n-1}}{x_n - x_{n-1}}\) 存在（有限或 \(\pm\infty\)）。结论：\(\displaystyle \lim_{n \to \infty} \frac{y_n}{x_n} = \lim_{n \to \infty} \frac{y_n - y_{n-1}}{x_n - x_{n-1}}\)。

\begin{example}
\(\displaystyle \lim_{n \to \infty} \frac{1 + \sqrt{2} + \cdots + \sqrt{n}}{\frac{2}{3}n^{3/2}}\)

\textbf{解：}令 \(y_n = \sum_{k=1}^{n} \sqrt{k}\)，\(x_n = \frac{2}{3}n^{3/2}\)（严格递增 \(\to +\infty\)）。
\[
\frac{y_n - y_{n-1}}{x_n - x_{n-1}} = \frac{\sqrt{n}}{\frac{2}{3}n^{3/2} - \frac{2}{3}(n-1)^{3/2}}
= \frac{\sqrt{n}}{\frac{2}{3}n^{3/2}\left[1 - \left(1 - \frac{1}{n}\right)^{3/2}\right]}
\]
利用 \((1 - \frac{1}{n})^{3/2} \sim 1 - \frac{3}{2n}\)（\(n \to \infty\)），分母 \(\sim \frac{2}{3}n^{3/2} \cdot \frac{3}{2n} = n^{1/2}\)，故
\[
\lim_{n \to \infty} \frac{y_n - y_{n-1}}{x_n - x_{n-1}} = \lim_{n \to \infty} \frac{\sqrt{n}}{n^{1/2}} = 1
\]
由 Stolz 定理，原式 \(= 1\)。
\end{example}

\section{二、函数极限复习}

\textbf{1. 定义：}\(\forall \varepsilon > 0\)，\(\exists \delta > 0\)，s.t. \(\forall 0 < |x - a| < \delta\)，\(|f(x) - A| < \varepsilon\)，则 \(\displaystyle \lim_{x \to a} f(x) = A\)。\(a, A\) 为常数，\(\delta = \delta(\varepsilon)\) 一般与 \(\varepsilon\) 有关。

\begin{example}
用 \(\varepsilon\text{-}\delta\) 证明 \(\displaystyle \lim_{x \to a} x^2 = a^2\)。

\begin{proof}
\(\forall \varepsilon > 0\)，取 \(\delta = \min\left\{\dfrac{\varepsilon}{2|a| + 1},\; 1\right\}\)。

当 \(0 < |x - a| < \delta\) 时，\(|x| < |a| + \delta \leq |a| + 1\)，故
\[
|x^2 - a^2| = |x - a| \cdot |x + a| \leq |x - a| \cdot (|x| + |a|)
< \delta \cdot (|a| + 1 + |a|) < \frac{\varepsilon}{2|a| + 1} \cdot (2|a| + 1) = \varepsilon
\]
\end{proof}
\end{example}

\textbf{2. 归结原则（Heine 定理）：}\(\displaystyle \lim_{x \to a} f(x) = A\)
\(\Leftrightarrow\) 对任一序列 \(\{x_n\} \subseteq O^-(a)\) 且 \(x_n \to a\)，都有 \(f(x_n) \to A\)。

\textbf{应用：}证 \(\displaystyle \lim_{x \to \infty} \sin x\) 不存在。取 \(x_n = \frac{\pi}{2} + 2n\pi\)（\(f = 1\)）和 \(x_n = 2n\pi\)（\(f = 0\)），两子列极限不同。

\textbf{3--6. 极限性质：}唯一性、局部有界性、保号性、四则运算（拆分后需确保极限存在）。

\textbf{7. 线性性：}\(\displaystyle \lim_{x \to a} [\lambda f(x) + \mu g(x)] = \lambda \lim_{x \to a} f(x) + \mu \lim_{x \to a} g(x)\)。

\textbf{有理函数的极限：}\(\displaystyle \lim_{x \to a} \frac{P(x)}{Q(x)} = \frac{P(a)}{Q(a)}\)（若 \(Q(a) \neq 0\)），极限与函数运算可交换次序。

\section{三、渐近线}

\[
\lim_{x \to \infty} \frac{|kx + b - f(x)|}{\sqrt{1 + k^2}} = 0
\]

\begin{center}
\includegraphics[width=0.3\textwidth]{images/41_0_1838_496_365_0.jpg}
\end{center}

\textbf{分类：}
\begin{enumerate}
\item \textbf{水平渐近线：}若 \(\displaystyle \lim_{x \to \infty} f(x) = b\)，则 \(y = b\) 为水平渐近线。
\item \textbf{垂直渐近线：}若 \(\displaystyle \lim_{x \to a^+} f(x) = \infty\)（或 \(a^-\)），则 \(x = a\) 为垂直渐近线。
\item \textbf{斜渐近线：}\(y = kx + b\)，其中
\[
k = \lim_{x \to +\infty} \frac{f(x)}{x},\qquad b = \lim_{x \to +\infty} [f(x) - kx]
\]
\end{enumerate}

\begin{remark}
\begin{enumerate}
\item 若 \(f(x)\) 在每一点都有定义，则无垂直渐近线。
\item 水平/斜渐近线最多有 2 条（水平 + 斜 \(\leq 2\)）。
\item 垂直渐近线可以有无数条。
\end{enumerate}
\end{remark}

\begin{example}
\(y = \sqrt{x^2 + 1}\) 的渐近线：\(k = \lim_{x \to +\infty} \frac{\sqrt{x^2+1}}{x} = 1\)，\(b = \lim_{x \to +\infty} (\sqrt{x^2+1} - x) = 0\)，\(\therefore y = x\)（\(x \to +\infty\)）；同理 \(x \to -\infty\) 时 \(y = -x\)。
\end{example}

\section{四、思考题}

\begin{enumerate}
\item 求 \(\displaystyle \lim_{x \to +\infty} \left(1 + \frac{2}{x}\right)^{-x} = \lim_{x \to +\infty} \left[\left(1 + \frac{2}{x}\right)^{\frac{x}{2}}\right]^{-2} = e^{-2} = \frac{1}{e^2}\)。

\item 求 \(\displaystyle \lim_{x \to +\infty} \left(\cos\frac{1}{x}\right)^{x^2}\)。

\textbf{解：}令 \(t = \frac{1}{x} \to 0^+\)：
\[
\lim_{t \to 0^+} (\cos t)^{\frac{1}{t^2}} = \lim_{t \to 0^+} \left(1 - \sin^2 t\right)^{\frac{1}{t^2}}
= \lim_{t \to 0^+} \left[\left(1 - \sin^2 t\right)^{-\frac{1}{\sin^2 t}}\right]^{-\frac{\sin^2 t}{t^2}} = e^{-1/2}
\]
（其中 \(\frac{\sin^2 t}{t^2} \to 1\)，\(\left(1 - \sin^2 t\right)^{-\frac{1}{\sin^2 t}} \to e\)，故指数 \(= -\frac{1}{2}\)。）

\item 设 \(f(x)\) 在 \([a, +\infty)\) 上单调递增，\(\{x_n\}\) 满足 \(x_n \to +\infty\) 且 \(\displaystyle \lim_{n \to +\infty} f(x_n) = A\)。
\begin{enumerate}
\item 求证：\(\displaystyle \lim_{x \to +\infty} f(x) = A\)（\(A\) 可为 \(+\infty\)）。
\item 若另有 \(\displaystyle \lim_{n \to +\infty} f(y_n) = \lim_{x \to +\infty} f(x)\)，求证 \(y_n \to +\infty\)。
\end{enumerate}

\begin{proof}
先考虑 \(A\) 有限。先证 \(f(x) < A\)（\(\forall x \in [a, +\infty)\)）：否则 \(\exists x_0\)，s.t. \(f(x_0) \geq A\)。当 \(x_n > x_0\) 时 \(f(x_n) \geq f(x_0) \geq A\)，与 \(f(x_n) \to A\) 矛盾（因 \(f(x_n)\) 还可取 \(>A\) 的值）。

\(\forall \varepsilon > 0\)，\(\exists N\)，s.t. \(n > N\) 时 \(A - f(x_n) < \varepsilon\)。取 \(X = x_{N+1}\)，当 \(x > X\) 时，由单调性 \(A - f(x) \leq A - f(x_{N+1}) < \varepsilon\)。又 \(f(x) < A\)，故 \(|f(x) - A| = A - f(x) < \varepsilon\)。\(\therefore \lim_{x \to +\infty} f(x) = A\)。

\(A = +\infty\) 时类似可证。
\end{proof}
\end{enumerate}

