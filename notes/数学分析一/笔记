\chapter{习题课：期中复习}

\section{一、期中考试复习大纲}

\begin{enumerate}
\item 实数公理（概念 + 等价互推）
\item 序列极限（判断 + 计算）
\item 函数极限与不动点
\item 函数连续及性质（证明）
\item 函数的一致连续（区分）
\item 函数可微与求导（计算）
\end{enumerate}

\section{二、典型例题}

\begin{example}
极限计算：
\begin{enumerate}
\item \(\displaystyle \lim_{n \to +\infty} \sqrt{n}(\sqrt{n+1} - \sqrt{n}) = \frac{1}{2}\)
\item \(\displaystyle \lim_{n \to +\infty} \sum_{k=n}^{n^2} \frac{1}{\sqrt{k}} = 2\)（夹逼：\(\frac{2n+1}{n+1} < \text{原式} < \frac{2n+1}{n}\)）
\item \(\displaystyle \lim_{n \to +\infty} \sum_{k=1}^{n} \frac{k}{2^k} = 2\)（错位相减法：\(S_n = 2 - \frac{1}{2^{n-1}} - \frac{n}{2^n}\)）
\item \(\displaystyle \lim_{n \to +\infty} \left(\frac{1}{n+1} + \cdots + \frac{1}{2n}\right) = \ln 2\)（积分估计：\(\int_{n+k}^{n+k+1}\frac{dx}{x} < \frac{1}{n+k} < \int_{n+k-1}^{n+k}\frac{dx}{x}\)）
\end{enumerate}
\end{example}

\begin{example}
函数极限：
\begin{enumerate}
\item \(\displaystyle \lim_{x \to +\infty} \left(\cos\frac{1}{x} + \sin\frac{1}{x^2}\right)^{x^2} = \sqrt{e}\)（Taylor：\(\cos\frac1x = 1 - \frac{1}{2x^2} + o(\frac1{x^2})\)）
\item \(\displaystyle \lim_{x \to +\infty} \left(1 + \frac{1}{x+2}\right)^{\frac{x^2}{x+2}} = e\)
\item 求 \(a,b,c\) 使 \(\displaystyle \lim_{x \to +\infty} x\left(ax + \sqrt{2 + bx + cx^2}\right) = 2\)。答：\(a = -\frac12, b = 0, c = \frac14\)。
\item \(\displaystyle \lim_{x \to +\infty} x^2\left(\sqrt[7]{\frac{x^3+x}{x^3+1}} - \cos\frac{1}{x}\right) = \frac{1}{2}\)
\end{enumerate}
\end{example}

\begin{example}
\(a_1 = \sqrt{2}\)，\(a_{n+1} = (\sqrt{2})^{a_n}\)。证明 \(\displaystyle \lim_{n \to +\infty} a_n\) 存在并求值。

\begin{proof}
归纳证 \(a_n \uparrow\) 且 \(a_n < 2\)。单增有上界 \(\Rightarrow\) 极限存在。设极限为 \(A\)，由 \(a_{n+1} = (\sqrt{2})^{a_n}\) 取极限：\(A = (\sqrt{2})^A\)，解得 \(A = 2\) 或 \(A = 4\)。由 \(a_n < 2\) 知 \(A = 2\)。
\end{proof}
\end{example}

\begin{example}
已知 \(x \to 0\) 时 \(5^{x^2} - 4^{x^2}\) 与 \(x^p\) 同阶无穷小，求 \(p\)。

\textbf{解：}\(\displaystyle \lim_{x\to 0}\frac{5^{x^2} - 4^{x^2}}{x^p} = \lim_{x\to 0}\frac{x^2(\ln 5 - \ln 4) + o(x^2)}{x^p}\)，故 \(p = 2\)。
\end{example}

\begin{example}
设 \(f(x)\) 在 \(I = [a,b]\) 上满足 \(|f(x) - f(y)| \leq k|x-y|\)（\(k < 1\)）且 \(f(I) \subseteq I\)。
\begin{enumerate}
\item 证明 \(f \in C(I)\) 且 \(\exists! c \in I\)，s.t. \(c = f(c)\)。
\item \(\forall x_0 \in I\)，令 \(x_n = f(x_{n-1})\)，证明 \(x_n \to c\)。
\end{enumerate}

\begin{proof}
(1) \(\forall \varepsilon > 0\)，取 \(\delta = \varepsilon/k\)，则 \(|x-y| < \delta \Rightarrow |f(x)-f(y)| < \varepsilon\)，故 \(f \in C(I)\)（甚至 Lipschitz 连续）。

令 \(g(x) = x - f(x)\)，\(g \in C(I)\)。\(g(a) = a - f(a) \leq 0\)，\(g(b) = b - f(b) \geq 0\)。若等号成立则取端点；否则由介值定理 \(\exists c\)，s.t. \(g(c) = 0 \Rightarrow c = f(c)\)。唯一性：若 \(c_1 \neq c_2\) 均为不动点，则 \(|c_1 - c_2| = |f(c_1) - f(c_2)| \leq k|c_1 - c_2| < |c_1 - c_2|\)，矛盾。

(2) \(|x_n - c| = |f(x_{n-1}) - f(c)| \leq k|x_{n-1} - c| \leq \cdots \leq k^n|x_0 - c| \to 0\)（压缩映射原理）。
\end{proof}
\end{example}

\begin{example}
\begin{enumerate}
\item \(f \in C[a, +\infty)\)，若 \(\displaystyle \lim_{x \to +\infty} f(x) = L\) 存在有限，证明 \(f\) 在 \([a, +\infty)\) 上一致连续。
\item \(f(x)\) 在有界区间 \((a,b)\) 上一致连续，证明 \(f(x)\) 在 \((a,b)\) 上有界。
\end{enumerate}

\begin{proof}
(1) \(\forall \varepsilon > 0\)，由 \(f \to L\)，\(\exists N\)，s.t. \(\forall x > N\)，\(|f(x) - L| < \varepsilon/2\)。在 \([N+1, +\infty)\) 上，\(\forall x_1,x_2 > N+1\)：\(|f(x_1)-f(x_2)| \leq |f(x_1)-L| + |L-f(x_2)| < \varepsilon\)（一致连续）。在 \([a, N+2]\) 上由 Cantor 定理一致连续。取公共 \(\delta\) 即得全局一致连续。

(2) 取 \(a < a' < b' < b\)，在 \([a',b']\) 上有界 \(M_1\)。将 \((a,a')\) 和 \((b',b)\) 用一致连续性分别分为有限段，每段上 \(|f(x) - f(x_i)| < 1\)，故均有界。取三部分上界的最大值为全局界。
\end{proof}
\end{example}


