\chapter{Green公式应用与曲面积分}
\begin{flushright}\small 原 Class 41（6.12，Class 40缺失）\end{flushright}

\section{Green 公式典型例题}

\begin{example}[补路径法求曲线积分]
$C$ 为抛物线 $2x=\pi y^2$ 自 $(0,0)$ 到 $(\frac\pi2,1)$ 的弧段。求
\[
I=\int_C(2xy^3-y^2\cos x)dx+(1-2y\sin x+3x^2y^2)dy.
\]

$\frac{\partial Q}{\partial x}=-2y\cos x+6xy^2$，$\frac{\partial P}{\partial y}=6xy^2-2y\cos x$。$\frac{\partial Q}{\partial x}-\frac{\partial P}{\partial y}=0$，积分与路径无关！补上从 $(\frac\pi2,1)$ 沿 $x=\frac\pi2$ 到 $(\frac\pi2,0)$ 再沿 $y=0$ 回到 $(0,0)$ 的直线段形成闭路。闭路积分为 $0$。$I=$ 沿 $x=\frac\pi2$ 从 $y=1$ 到 $0$：$\int_0^1(1-2y+\frac{3\pi^2}{4}y^2)dy=[y-y^2+\frac{\pi^2}{4}y^3]_0^1=\frac{\pi^2}{4}$。

\begin{center}\includegraphics[width=0.2\textwidth]{images/130_173_1699_353_218_0.jpg}\end{center}
\end{example}

\begin{example}[原点是奇点的闭路积分]
\[
I=\oint_C\frac{e^y}{x^2+y^2}\bigl[(x\sin x+y\cos x)dx+(y\sin x-x\cos x)dy\bigr],
\]
$C:x^2+y^2=1$ 逆时针，$(0,0)$ 无定义。

\begin{center}\includegraphics[width=0.2\textwidth]{images/131_189_372_320_248_0.jpg}\end{center}

在环形区域 $D_\varepsilon=\{x^2+y^2\ge\varepsilon^2\}\cap\{x^2+y^2\le1\}$ 上 Green 公式适用，且 $\frac{\partial Q}{\partial x}-\frac{\partial P}{\partial y}=0$。$\oint_C=\oint_{C_\varepsilon}$（$C_\varepsilon:x^2+y^2=\varepsilon^2$）。在 $C_\varepsilon$ 上 $x^2+y^2=\varepsilon^2$，提出 $1/\varepsilon^2$：
\[
I=\frac1{\varepsilon^2}\oint_{C_\varepsilon}e^y[(x\sin x+y\cos x)dx+(y\sin x-x\cos x)dy].
\]
在 $C_\varepsilon$ 内用 Green：被积函数记 $P_1,Q_1$。$\frac{\partial Q_1}{\partial x}-\frac{\partial P_1}{\partial y}=-2e^y\cos x$。由二重积分中值定理：
\[
I=\frac1{\varepsilon^2}\iint_{x^2+y^2\le\varepsilon^2}(-2e^y\cos x)dxdy
\approx\frac1{\varepsilon^2}(-2e^0\cos0)\cdot\pi\varepsilon^2=-2\pi\quad(\varepsilon\to0).
\]
\end{example}

\begin{example}[外法向导数的闭路积分]
$u=x^2+y^2$，$C$ 为 $(x-3)^2+y^2=3^2$，$\overrightarrow{n}$ 为外法向。求 $\oint_C\frac{\partial u}{\partial n}ds$。

\begin{center}\includegraphics[width=0.2\textwidth]{images/131_178_1781_377_244_0.jpg}\end{center}

法一：$\nabla u=(2x,2y)$。$C$ 的参数 $x=3+3\cos\theta,y=3\sin\theta$，外法向 $\overrightarrow{n}=(\cos\theta,\sin\theta)$。$ds=3d\theta$。$\frac{\partial u}{\partial n}=\nabla u\cdot\overrightarrow{n}=2x\cos\theta+2y\sin\theta$。代入积分得 $36\pi$。

法二（Green）：$\overrightarrow{n}ds=(dy,-dx)$（外法向 $=$ 切向量右转 $90^\circ$）。$\oint_C\frac{\partial u}{\partial n}ds=\oint_C\frac{\partial u}{\partial x}dy-\frac{\partial u}{\partial y}dx=\oint_C 2xdy-2ydx$。由 Green $=\iint_D(2+2)dxdy=4\cdot\pi\cdot3^2=36\pi$。

\begin{center}\includegraphics[width=0.3\textwidth]{images/132_1008_918_420_384_0.jpg}\includegraphics[width=0.2\textwidth]{images/132_205_928_358_300_0.jpg}\end{center}

\textbf{记忆：}右手边外侧，左手边内侧。$ds\,\overrightarrow{t}=(dx,dy)$；外侧 $ds\,\overrightarrow{n}=(dy,-dx)$；内侧 $ds\,\overrightarrow{n}=(-dy,dx)$。
\end{example}

\begin{example}[椭圆区域奇点的曲线积分]
$L:x^2+4y^2=1$ 逆时针。求 $\oint_L\frac{(x-y)dx+(x+4y)dy}{x^2+4y^2}$。

$(0,0)$ 无定义。$C_\varepsilon:x^2+4y^2=\varepsilon^2$。在环形区域 $\frac{\partial Q}{\partial x}-\frac{\partial P}{\partial y}=0$。$\oint_L=\oint_{C_\varepsilon}$。在 $C_\varepsilon$ 上提出 $1/\varepsilon^2$：
\[
I=\frac1{\varepsilon^2}\oint_{C_\varepsilon}(x-y)dx+(x+4y)dy
=\frac1{\varepsilon^2}\iint_{x^2+4y^2\le\varepsilon^2}(1-(-1))dxdy
=\frac1{\varepsilon^2}\cdot2\cdot\pi\cdot\frac{\varepsilon^2}{2}=\pi.
\]
\end{example}

\section{散度定理（Gauss 公式）应用}

\begin{example}[球面积分——原点为奇点]
\[
I=\iint_S\frac{xdydz+ydzdx+zdxdy}{(ax^2+by^2+cz^2)^{3/2}},
\]
$S:x^2+y^2+z^2=1$ 取外侧，$a,b,c>0$。$(0,0,0)$ 无定义。

$P=\frac{x}{(ax^2+by^2+cz^2)^{3/2}}$ 等。计算 $\frac{\partial P}{\partial x}+\frac{\partial Q}{\partial y}+\frac{\partial R}{\partial z}=0$（在非原点处）。作小球面 $S_\varepsilon:ax^2+by^2+cz^2=\varepsilon$。$I=\iint_{S_\varepsilon}$。在 $S_\varepsilon$ 上 $ax^2+by^2+cz^2=\varepsilon$，提出 $1/\varepsilon^{3/2}$：
\[
I=\frac1{\varepsilon^{3/2}}\iint_{S_\varepsilon}xdydz+ydzdx+zdxdy
=\frac1{\varepsilon^{3/2}}\iiint_{ax^2+by^2+cz^2\le\varepsilon}3\,dxdydz.
\]
椭球体积 $=\frac{4\pi}{3}\frac{\varepsilon^{3/2}}{\sqrt{abc}}$。故 $I=\frac{4\pi}{\sqrt{abc}}$。
\end{example}

\begin{example}[锥体体积公式 $V=\frac13SH$]
锥面 $\Sigma$ 以原点为顶点，与平面 $\Pi:Ax+By+Cz=D$ 围成锥体。证 $V=\frac13SH$（$S$ 为底面积，$H$ 为原点到 $\Pi$ 的距离）。

\begin{center}\includegraphics[width=0.2\textwidth]{images/134_195_155_356_192_0.jpg}\end{center}

法一（坐标变换）：$z'=\overrightarrow{n}\cdot\overrightarrow{r}$，$\overrightarrow{n}$ 为 $\Pi$ 的单位法向量。Jacobi $=1$。$V=\int_0^H dz'\iint_{截面}dx'dy'$。

法二（散度定理）：$V=\iiint_\Omega dxdydz=\frac13\iint_{\partial\Omega}(xdydz+ydzdx+zdxdy)=\frac13\iint_{\partial\Omega}\overrightarrow{r}\cdot\overrightarrow{n}dS$。锥面上 $\overrightarrow{n}\perp\overrightarrow{r}$，贡献为 $0$。底面上 $\overrightarrow{r}\cdot\overrightarrow{n}=\frac{Ax+By+Cz}{\sqrt{A^2+B^2+C^2}}=\frac{D}{\sqrt{A^2+B^2+C^2}}=H$。故 $V=\frac13 H\iint_{\Pi}dS=\frac13 SH$。
\end{example}

\section{Stokes 公式}

\begin{example}[球面与柱面交线上的曲线积分]
$C$ 为 $x^2+y^2+z^2=2Rx$ 与 $x^2+y^2=2rx$ 的交线（$0<r<R,z>0$）。求
\[
I=\oint_C(y^2+z^2)dx+(z^2+x^2)dy+(x^2+y^2)dz.
\]

$(x-R)^2+y^2+z^2=R^2$。由 Stokes，$I=\iint_S\operatorname{rot}\overrightarrow{F}\cdot d\overrightarrow{S}$。$\operatorname{rot}\overrightarrow{F}=(2y-2z,2z-2x,2x-2y)$。选球冠面 $S$ 为积分曲面，法向量 $\overrightarrow{n}=\frac1R(x-R,y,z)$。化简得 $I=\iint_S 2(z-y)dS$。由对称性 $\iint y dS=0$，只需 $\iint 2z dS$。$z/R$ 为 $\cos(\overrightarrow{n},\overrightarrow{k})$。$I=\iint 2R\cdot\frac{z}{R}dS=2R\iint_{D_{xy}}dxdy=2R\pi r^2$（$D_{xy}$ 为 $x^2+y^2\le2rx$ 的投影）。
\end{example}

\begin{example}[立体角 / Gauss 积分]
$\Sigma$ 光滑闭曲面，$\Omega$ 为其内部，$\overrightarrow{n}$ 为单位外法向。$(x_0,y_0,z_0)$ 为定点，$\overrightarrow{r}=(x-x_0,y-y_0,z-z_0)$。证
\[
\oiint_\Sigma\frac{\cos(\overrightarrow{n},\overrightarrow{r})}{|\overrightarrow{r}|^2}dS
=\iiint_\Omega\frac{2}{|\overrightarrow{r}|}dxdydz.
\]

$\cos(\overrightarrow{n},\overrightarrow{r})=\frac{\overrightarrow{n}\cdot\overrightarrow{r}}{|\overrightarrow{r}|}$。化为一型 $=$ 二型：
\[
\oiint_\Sigma\frac{(x-x_0)dydz+(y-y_0)dzdx+(z-z_0)dxdy}{|\overrightarrow{r}|^3}.
\]
由散度定理（注意 $|\overrightarrow{r}|^{-3}$ 的散度 $=\frac{2}{|\overrightarrow{r}|}$）即得。
\end{example}

\section{正交曲线坐标系}
$\frac{\partial\overrightarrow{r}}{\partial q_i}=h_i\widehat{e_i}$（$h_i=|\frac{\partial\overrightarrow{r}}{\partial q_i}|$，$\widehat{e_i}$ 为单位向量）。正交条件：$\widehat{e_i}\cdot\widehat{e_j}=\delta_{ij}$。

\begin{center}\includegraphics[width=0.2\textwidth]{images/135_175_882_340_271_0.jpg}\includegraphics[width=0.2\textwidth]{images/135_562_888_367_274_0.jpg}\includegraphics[width=0.3\textwidth]{images/135_978_835_424_309_0.jpg}\end{center}

弧长微元 $ds^2=h_1^2 dq_1^2+h_2^2 dq_2^2+h_3^2 dq_3^2$。体积微元 $dV=h_1h_2h_3 dq_1dq_2dq_3$。梯度 $(\nabla f)_i=\frac1{h_i}\frac{\partial f}{\partial q_i}$。散度 $\nabla\cdot\overrightarrow{F}=\frac1{h_1h_2h_3}\bigl[\frac{\partial}{\partial q_1}(h_2h_3F_1)+\frac{\partial}{\partial q_2}(h_3h_1F_2)+\frac{\partial}{\partial q_3}(h_1h_2F_3)\bigr]$。

常见正交系：直角 $(1,1,1)$、柱 $(1,r,1)$、球 $(1,r,r\sin\theta)$。

