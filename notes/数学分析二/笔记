% === 第一章  Class 1（3.4） ===
\chapter{定积分复习与中值定理}
\begin{flushright}\small 日期：3月4日\quad 原 Class 1\end{flushright}

\section{课程说明与定积分回顾}
\textbf{成绩构成：}平时作业 $20\%$ + 期中考试 $40\%$ + 期末考试 $40\%$。

\subsection{定积分回顾}
划分 $P: a=x_0<\cdots<x_n=b$，$\Delta x_i=x_i-x_{i-1}$，$\|P\|=\max\Delta x_i$。介点 $\xi_i$，Riemann 和 $\sigma(f,P,\xi)=\sum f(\xi_i)\Delta x_i$。若 $\lim_{\|P\|\to0}\sigma$ 存在，称 $f\in R[a,b]$，$\int_a^b f=\lim\sigma$。

\begin{center}\includegraphics[width=0.3\textwidth]{images/0_171_461_519_404_0.jpg}\end{center}

\subsection{Darboux 上下和}
$M_i=\sup_{[x_{i-1},x_i]}f$，$m_i=\inf_{[x_{i-1},x_i]}f$。$U(f,P)=\sum M_i\Delta x_i$，$L(f,P)=\sum m_i\Delta x_i$。可积充要：$\lim_{\|P\|\to0}(U-L)=0\iff\forall\varepsilon>0,\sum\omega_i\Delta x_i<\varepsilon$。

\subsection{可积函数运算}
$f,g\in R[a,b]\Rightarrow f\pm g,fg\in R$；若 $|g|>c>0$，$f/g\in R$。极限与加法可交换。

\subsection{Newton-Leibniz 公式}
$\int_a^b f=F(b)-F(a)$（$F'=f$）。变上限：$\frac{d}{dx}\int_{u(x)}^{v(x)}f(t)dt=f(v)v'-f(u)u'$。

\section{旋转体侧面积}
\begin{center}\includegraphics[width=0.3\textwidth]{images/0_172_1531_480_336_0.jpg}\end{center}
$ds=\sqrt{dx^2+dy^2}$，$dA=2\pi y\,ds=2\pi y\sqrt{1+(y')^2}dx$。

\section{积分中值定理}
\subsection{第一中值定理}
$f\in C[a,b],m\le f\le M\Rightarrow m(b-a)\le\int_a^b f\le M(b-a)$。$\exists c,f(c)=\frac{1}{b-a}\int_a^b f$。推广（带权）：$g>0$ 时 $\exists c,f(c)=\frac{\int fg}{\int g}$。

\subsection{第二中值定理}
\begin{theorem}设 $f>0,f'<0$（$f$ 递减），$g\in R[a,b]$。则 $\exists c\in[a,b],\int_a^b fg=f(a)\int_a^c g$。\end{theorem}
\begin{center}\includegraphics[width=0.3\textwidth]{images/1_169_893_463_370_0.jpg}\end{center}
注：条件可弱化为 $f$ 单调递减。取 $g\equiv1$：$\int_a^b f=f(a)(c-a)=f(c)(b-a)$。
\begin{proof}令 $G(x)=\int_a^x g$，则 $G\in C[a,b]$。分部积分：$\int_a^b fg=\int_a^b f\,dG=f(b)G(b)-\int_a^b Gf'=f(b)G(b)+\int_a^b G(-f')$。由 $-f'\ge0$ 放缩：$\ge f(b)G(b)+\min G\int_a^b(-f')=f(a)\min G$。同理 $\le f(a)\max G$。由 $G$ 连续及介值定理 $\exists c$ 使 $G(c)=\frac{1}{f(a)}\int fg$。\end{proof}

\section{Abel 变换与分部积分}
离散：$\sum\alpha_{i-1}(\beta_i-\beta_{i-1})=\sum(\alpha_{i-1}-\alpha_i)\beta_i+\alpha_n\beta_n-\alpha_0\beta_0$。连续即 $\int ydx+\int xdy=xy\big|$。Riemann-Stieltjes 形式用于证明第二中值定理：对 $P$，$\sum f(x_{i-1})\int_{x_{i-1}}^{x_i}g\xrightarrow{\text{Abel}}-\sum G(x_i)(f(x_i)-f(x_{i-1}))+G(b)f(b)$。

\begin{flushright}\small $\square$ 第一章完\end{flushright}

% === 第二章  Class 2（3.6） ===
\chapter{第二中值定理续与定积分近似计算}
\begin{flushright}\small 日期：3月6日\quad 原 Class 2\end{flushright}

\section{第二中值定理的 Abel 变换证明（续）}
\begin{theorem}[完整形式]设 $f\ge0$ 单调递减，$g\in R[a,b]$。则 $\exists c\in[a,b],\int_a^b fg=f(a)\int_a^c g$。\end{theorem}
\begin{center}\includegraphics[width=0.2\textwidth]{images/2_175_806_390_314_0.jpg}\end{center}
\begin{proof}对划分 $P$，$S(P)=\sum f(x_{i-1})\int_{x_{i-1}}^{x_i}g$。令 $G(x)=\int_a^x g$，由 Abel 变换放缩得 $f(a)\min G\le S(P)\le f(a)\max G$。误差 $|S(P)-\int fg|\le\sum\int|f(x_{i-1})-f(x)|\cdot|g|$。由 $g$ 有界 $|g|<L$，误差 $\le L\sum\omega_i(f)\Delta x_i$。由 $f\in R[a,b]$，$\|P\|\to0$ 时 $\to0$。取极限并用 $G$ 的介值性即得。\end{proof}

\section{定积分的近似计算}
\subsection{Taylor 展开预备}
$\varphi(h)=\int_{-h}^h f$。$\varphi'=f(h)+f(-h)$，$\varphi''=f'(h)-f'(-h)$，$\varphi'''=f''(h)+f''(-h)$。$\varphi'(0)=2f(0),\varphi''(0)=0,\varphi'''(0)=2f''(0)$。Taylor：$\varphi(h)=2hf(0)+\frac{h^3}{3}f''(0)+\cdots$。目标：找 $\varphi(h)\approx\sum c_i h\varphi'(p_i)$。

\subsection{矩形公式}$p_1=0$：$\varphi(h)\approx h\varphi'(0)=2hf(0)$，误差 $O(h^3)$。

\subsection{梯形公式}$p_1=h$：$\varphi(h)\approx h\varphi'(h)=h(f(h)+f(-h))$。$h\varphi'(h)=h\varphi'(0)+\frac{h^3}{2}\varphi'''(0)+\cdots$，误差 $O(h^3)$。等分推广：$\int_a^b f\approx\sum\frac{f(x_{i-1})+f(x_i)}{2}\Delta x$。误差 $\le\frac{1}{12}\max|f''|\frac{(b-a)^3}{N^2}$。

\subsection{Simpson 公式}
设 $\varphi(h)\approx c_1h\varphi'(p_1)+c_2h\varphi'(p_2)$。用 $\varphi'(p)=\varphi'(0)+\frac12p^2\varphi'''(0)+\cdots$ 比对系数得 $\begin{cases}c_1+c_2=1\\c_1p_1^2+c_2p_2^2=h^2/3\end{cases}$。选 $p_1=0,p_2=h$ 得 $c_1=2/3,c_2=1/3$。故 $\varphi(h)\approx\frac{h}{3}(f(-h)+4f(0)+f(h))$。几何解释：等价于用二次抛物线逼近被积函数，对三次多项式精确。

\begin{flushright}\small $\square$ 第二章完\end{flushright}

% === 第三章  Class 3（3.11） ===
\chapter{广义积分（反常积分）}
\begin{flushright}\small 日期：3月11日\quad 原 Class 3\end{flushright}

Riemann 积分要求区间有限且被积函数有界。本节推广到无限区间和无界函数。

\section{无穷限积分}
\begin{definition}$\forall A>a,f\in R[a,A]$。若 $\lim_{A\to+\infty}\int_a^A f$ 存在，记 $\int_a^{+\infty}f=\lim_{A\to+\infty}\int_a^A f$。\end{definition}
引例：第一宇宙速度 $W=\int_R^{+\infty}\frac{GMm}{r^2}dr$。

\begin{example}[$\int_1^{+\infty}r^{-p}dr$]$p>1$ 收敛于 $\frac1{p-1}$；$p\le1$ 发散。\end{example}
\begin{example}[$\int_1^{+\infty}e^{-x}dx=1/e$]$\int_1^{+\infty}\sin xdx$ 发散（$\cos1-\cos A$ 无极限）。\end{example}

\subsection{双边无穷限与 Cauchy 主值}
$\int_{-\infty}^{+\infty}f=\lim_{a\to-\infty}\int_a^c f+\lim_{A\to+\infty}\int_c^A f$。$\text{V.P.}\int_{-\infty}^{+\infty}f=\lim_{H\to+\infty}\int_{-H}^H f$。Cauchy 主值存在不代表广义积分收敛（例：$\text{V.P.}\int_{-\infty}^{+\infty}\sin x=0$）。Cauchy 主值受换元影响，非积分不变量。广义 N-L：$\int_a^{+\infty}f=\lim_{b\to+\infty}F(b)-F(a)$。

\section{瑕积分}
$b$ 为瑕点：$\lim_{\eta\to0^+}\int_a^{b-\eta}f$ 存在。$\int_0^1 x^{-p}dx$：$p<1$ 收敛于 $\frac1{1-p}$；$p\ge1$ 发散。对比 $\int_1^{+\infty}x^{-p}$（$p>1$ 收敛），二者在 $p=1$ 均发散——$1/x$ 的特殊地位。
\begin{center}\includegraphics[width=0.4\textwidth]{images/6_1080_161_598_324_0.jpg}\end{center}
内部瑕点 $c\in(a,b)$：$\int_a^b f=\lim_{\eta\to0^+}\int_a^{c-\eta}f+\lim_{\varepsilon\to0^+}\int_{c+\varepsilon}^b f$。Cauchy 主值（有限区间）：$\text{V.P.}\int_a^b f=\lim_{\eta\to0^+}(\int_a^{c-\eta}f+\int_{c+\eta}^b f)$。

\section{运算性质}线性、分部积分、换元积分（均需积分收敛）。

\section{综合例题}
\begin{example}[$\int_0^{+\infty}\frac{\ln x}{1+x^2}dx$]令 $x=1/s$ 得原式 $=-\int_0^{+\infty}\frac{\ln s}{1+s^2}ds$，故 $=0$。收敛验证：$x\to\infty$ 时 $<x^{-3/2}$ 收敛；$x\to0^+$ 时 $\sim\ln x$ 而 $\int_0^1\ln xdx=-1$ 收敛。\end{example}
\begin{example}[$\int_0^1 x^{-1}dx=+\infty$ 发散]\end{example}
\begin{flushright}\small $\square$ 第三章完\end{flushright}

