\chapter{Green公式}
\begin{flushright}\small 日期：6月5日\quad 原 Class 39\end{flushright}

\section{Green 公式}
\begin{theorem}[Green]
设 $D\subset\mathbb{R}^2$ 为初等区域（$x$ 型和 $y$ 型），$\partial D$ 为分段光滑正向闭曲线。$P,Q\in C^1(\overline{D})$。则
\[
\oint_{\partial D}Pdx+Qdy=\iint_D\Bigl(\frac{\partial Q}{\partial x}-\frac{\partial P}{\partial y}\Bigr)dxdy.
\]
\end{theorem}

\begin{proof}[$y$ 型区域的证明]
$D=\{(x,y):a\le x\le b,y_1(x)\le y\le y_2(x)\}$。对 $\iint_D\frac{\partial P}{\partial y}dxdy=\int_a^b\int_{y_1(x)}^{y_2(x)}\frac{\partial P}{\partial y}dy dx=\int_a^b[P(x,y_2(x))-P(x,y_1(x))]dx$。右边恰为 $-\oint_{\partial D}Pdx$（上边界正向为右到左，故 $-\int_a^b P(x,y_2)dx$，下边界为 $\int_a^b P(x,y_1)dx$）。对称处理 $x$ 型得 $Q$ 项。
\end{proof}

\section{应用}
\begin{itemize}
\item 面积：$A=\frac12\oint_{\partial D}(xdy-ydx)=\iint_D dxdy$。
\item 体积（三维）：$V=\frac13\iint_{\partial E}\overrightarrow{x}\cdot d\overrightarrow{S}$（散度定理特例）。
\end{itemize}

\begin{example}[单位圆盘面积验证]
$\partial D:x=\cos t,y=\sin t$。$A=\frac12\int_0^{2\pi}(\cos^2 t+\sin^2 t)dt=\pi$。
\end{example}

\begin{flushright}\small $\square$ 第三十五章完\end{flushright}

