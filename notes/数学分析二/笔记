\chapter{带状区域与零测度}
\begin{flushright}\small 日期：5月20日\quad 原 Class 31\end{flushright}

\section{一般区域上的重积分}

\subsection{带状区域}
设 $D=\{(x,y):x\in[a,b],\varphi(x)\le y\le\psi(x)\}$，$\varphi,\psi\in C[a,b]$，$\varphi\le\psi$。$Q=[a,b]\times[c,d]$ 为包含 $D$ 的方块。

对 $Q$ 作分割 $P$，小方块 $Q_J$ 分三类：
\begin{itemize}
\item $J_1$：$Q_J\subset D$（全部在内部）；
\item $J_2$：$Q_J\cap D\neq\varnothing$ 且 $Q_J\cap(Q\setminus D)\neq\varnothing$（跨边界）；
\item $J_3$：$Q_J\cap D=\varnothing$（全部在外部）。
\end{itemize}

Riemann 和 $\sigma(f,P,\xi)=\sum_J f(\xi_J)\operatorname{Vol}(Q_J)$（$\xi_J\in Q_J\cap D$，若 $J_3$ 项取 0）。

\subsection{连续曲线为零面积}
\begin{lemma}[曲线是零测集]
$\varphi\in C[a,b]$ 的图像 $\{(x,\varphi(x)):x\in[a,b]\}$ 在 $\mathbb{R}^2$ 中是零面积集（零测集）。
\end{lemma}

\begin{proof}
$\varphi$ 在 $[a,b]$ 上一致连续：$\forall\eta>0,\exists\delta>0,|x_1-x_2|<\delta\Rightarrow|\varphi(x_1)-\varphi(x_2)|<\eta$。取 $P_x$ 满足 $\|P_x\|<\delta$。对每个 $[x_{i-1},x_i]$，最多有两个 $Q_J$ 与 $\varphi$ 图像相交（$\varphi$ 在该区间上振幅 $<\eta$，用高为 $\eta$ 的矩形即可覆盖）。总体积 $\sum_{Q_J\cap\varphi\neq\varnothing}\operatorname{Vol}(Q_J)<\sum_i 2\eta\Delta x_i=2(b-a)\eta$。取 $\eta\to0$ 即得。
\end{proof}

\begin{center}\includegraphics[width=0.3\textwidth]{images/99_1132_291_481_239_0.jpg}\end{center}

\begin{theorem}[带状区域上的积分]
若 $f\in C(D)$，则
\[
\iint_D f(x,y)dxdy = \int_a^b\left(\int_{\varphi(x)}^{\psi(x)}f(x,y)dy\right)dx.
\]
\end{theorem}

\begin{proof}
(1) 重积分存在：将 $f$ 零延拓到 $Q$ 上。$\Omega(f,P)=\Omega_1+\Omega_2+\Omega_3$。$f\in C(D)$ 在紧集 $Q$ 上一致连续（延拓后可能有间断，但仅在 $\partial D$ 上）。$\Omega_1$ 由内部方块贡献 $<\varepsilon\operatorname{Vol}(Q)$。$\Omega_2$ 涉边界，因 $\partial D$ 为零面积，可使其总体积 $<\varepsilon$，且 $f$ 有界（$|f|<L$），贡献 $<L\varepsilon$。$\Omega_3=0$。故 $f\in R(Q)$，进而在 $D$ 上可积。

(2) $\forall x\in[a,b]$，$f(x,\cdot)$ 在 $[\varphi(x),\psi(x)]$ 上至多有两个间断点（边界处延拓造成），故内层积分存在。用 Fubini 定理即得累次积分公式。
\end{proof}

\subsection{单形体 $V_m(x)$}
$V_m(x)=\{(t_0,\dots,t_{m-1}):0\le t_0\le\cdots\le t_{m-1}\le x\}$。

$V_2(x)$（三角形）：$\operatorname{Vol}(V_2)=\int_0^x dt_1\int_0^{t_1}dt_0=\frac{x^2}{2}$。另一种顺序 $\int_0^x dt_0\int_{t_0}^x dt_1=\frac{x^2}{2}$（一致）。

一般 $V_m$：
\begin{align*}
\int_{V_m}f(t_0)d\overrightarrow{t}
&=\int_0^x f(t_0)dt_0\int_{t_0}^x dt_1\int_{t_1}^x dt_2\cdots\int_{t_{m-2}}^x dt_{m-1}\\
&=\int_0^x\frac{f(t_0)}{(m-1)!}(x-t_0)^{m-1}dt_0.
\end{align*}
当 $f\equiv1$ 时 $\operatorname{Vol}(V_m(x))=x^m/m!$。

\begin{center}\includegraphics[width=0.2\textwidth]{images/100_171_452_368_286_0.jpg}\end{center}

\section{零测度集与 Lebesgue 可积准则}

\begin{definition}[零测度集]
$A\subset\mathbb{R}^m$ 为零测度集，若 $\forall\varepsilon>0$，存在方块列 $\{Q_k\}$ 覆盖 $A$ 且 $\sum\operatorname{Vol}(Q_k)<\varepsilon$。
\end{definition}

例：$\Lambda=\{x\in[0,1]\}$ 在 $\mathbb{R}$ 中不是零测集（$\operatorname{Vol}(\Lambda)=1$）。$\Lambda=\{(x,0):x\in[0,1]\}$ 在 $\mathbb{R}^2$ 中是零测集（可用 $n$ 个 $1/n\times\varepsilon$ 矩形覆盖，总面积 $\varepsilon$）。

\begin{theorem}[Lebesgue 可积准则]
有界函数 $f:Q\to\mathbb{R}$ 在 $Q$ 上 Riemann 可积 $\iff$ $f$ 的不连续点集为零测度集。
\end{theorem}

\textbf{推论1：}若 $f$ 仅在零测集上非零，则 $\int f=0$。\\
\textbf{推论2：}$f,g\in R(Q)$，若 $f=g$ 几乎处处（相差零测集），则 $\int f=\int g$。

\subsection{Jordan 可测集}
$E\subset\mathbb{R}^m$ 有界。若 $\partial E$ 为零测度集，则称 $E$ 为 \textbf{Jordan 可测集}。此时可定义 $f$ 在 $E$ 上的积分：$\int_E f=\int_Q f\cdot\chi_E$（$\chi_E$ 为 $E$ 的示性函数）。

\subsection{Hilbert 空间填充曲线}
存在连续满射 $[0,1]\to[0,1]^2$（Peano 曲线），说明"一维"的连续像可填满"二维"区域。这揭示了维数在连续映射下不保持——Jordan 曲线定理的复杂性即源于此。

