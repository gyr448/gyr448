\chapter{范数等价与完备性习题}
\begin{flushright}\small 原 Class 10（习题课）\end{flushright}

\section{线性空间与赋范空间回顾}
加法公理、数乘公理。范数 $\to$ 距离 $\to$ 收敛/连续。

\section{$\mathbb{R}^m$ 中范数的等价性}
等价范数：$\exists a,A>0$，$aM(x)\le N(x)\le AM(x)$。满足自反、对称、传递。

\begin{theorem}[$\mathbb{R}^m$ 上任意范数等价]
只需证 $N(x)$ 与 $\|x\|_2$ 等价。

(1) $N(x)$ 关于 $\|\cdot\|_2$ 连续。基 $\{e_i\}$，$x=\sum x^i e_i$：
\[
|N(x)-N(x_0)|\le N(x-x_0)=N(\sum\Delta x^i e_i)\le\sum|\Delta x^i|N(e_i)\le\sqrt{\sum(\Delta x^i)^2}\cdot\sqrt{\sum N(e_i)^2}.
\]
当 $\|x-x_0\|_2\to0$ 时 $\to0$。

(2) $K=\{x:\|x\|_2=1\}$ 有界闭（紧集）。$N$ 在 $K$ 上连续，可取最值 $0<b\le N(x)\le B$（$b>0$ 因 $x\neq0$ 时 $N(x)>0$）。对任意 $x\neq0$，$\frac{x}{\|x\|_2}\in K$，故 $b\le N(\frac{x}{\|x\|_2})\le B\Rightarrow b\|x\|_2\le N(x)\le B\|x\|_2$。
\end{theorem}

推论：$\mathbb{R}^m$ 上任意范数等价 $\Rightarrow$ 收敛性与范数选取无关。

\section{有限维与无穷维的区别}
有限维：所有范数等价 $\Rightarrow$ 完备性相同、拓扑相同。无穷维不成立！

\begin{example}[{$C[0,1]$} 上 $\|\cdot\|_2$ 不完备]
$X=C[0,1]$。$\|f\|_2=\sqrt{\int_0^1 f^2}$，$\|f\|_\infty=\sup|f|$。构造分段线性阶梯函数：
\[
f_n(x)=\begin{cases}-1,&0\le x\le\frac12-\frac1{2n},\\2nx-n,&\frac12-\frac1{2n}<x<\frac12+\frac1{2n},\\1,&x\ge\frac12+\frac1{2n}.\end{cases}
\]
\begin{center}\includegraphics[width=0.3\textwidth]{images/31_1172_1128_408_377_0.jpg}\end{center}
$n>m$ 时 $\|f_n-f_m\|_2^2\le\frac2m\to0$，故 $\{f_n\}$ 在 $\|\cdot\|_2$ 下为 Cauchy 列。但逐点极限是符号函数（在 $1/2$ 处间断），不属 $X$。$\therefore(X,\|\cdot\|_2)$ 不完备。

在 $\|\cdot\|_\infty$ 下：$\|f_n-f_m\|_\infty=1-\frac{m}{n}\not\to0$（非 Cauchy 列）。可证 $(C[0,1],\|\cdot\|_\infty)$ 完备。
\end{example}

\section{$\mathbb{R}^m$ 中的收敛与连续性}
$\lim x_n=a\iff\lim x_n^i=a^i$（按分量收敛）。遗传定理：极限存在 $\Rightarrow$ 有界；线性与 $\lim$ 可交换；Cauchy 收敛原理。

多元函数极限的两种定义（Heine / $\varepsilon$-$\delta$）等价。经典反例：$\frac{xy}{x^2+y^2}$（路径依赖）、$\frac{x^2y}{x^4+y^2}$（沿直线趋近不够）。

累次极限与重极限无必然关系。例：$(x+y)\sin\frac1x\sin\frac1y$ 累次不存在，重极限存在。

\section{多元函数极限习题}
\begin{example}[$\frac{x^3+y^3}{x^2+y^2}$，$(x,y)\to(0,0)$]极坐标 $x=r\cos\theta,y=r\sin\theta$，原式 $=r(\cos^3\theta+\sin^3\theta)\le2r\to0$。\end{example}
\begin{example}[$(x^2+y^2)^{xy}$，$(x,y)\to(0,0)$]取对数 $|xy\ln(x^2+y^2)|\le\frac{x^2+y^2}{2}|\ln(x^2+y^2)|=\frac{r^2}{2}|\ln r^2|\to0$。原极限 $=e^0=1$。\end{example}
\begin{example}[$f(x,y)=\frac{\ln(1+xy)}{x}$（$x\neq0$），$f(0,y)=y$]定义域 $xy>-1$。在 $(0,0)$：$x\neq0$ 时 $f=y\cdot\frac{\ln(1+xy)}{xy}\to0\cdot1=0=f(0,0)$。在 $(0,y_0)$（$y_0\neq0$）：$|f(x,y)-f(0,y_0)|=|y\ln(1+xy)^{1/xy}-y_0|\le|y||\ln(1+xy)^{1/xy}-1|+|y-y_0|\to0$。$f$ 在全定义域连续。\end{example}
\begin{center}\includegraphics[width=0.2\textwidth]{images/33_173_156_361_322_0.jpg}\end{center}
