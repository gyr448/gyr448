\chapter{完备性与多元函数极限}
\begin{flushright}\small 日期：3月20日\quad 原 Class 8\end{flushright}

\section{完备度量空间与 Banach 不动点定理}

\subsection{Cauchy 列与完备性}
$\{x_n\}$ 为 Cauchy 列：$\forall\varepsilon>0,\exists N,\forall n>N,\forall p\in\mathbb{N}:d(x_n,x_{n+p})<\varepsilon$。收敛 $\Rightarrow$ Cauchy：$d(x_n,x_{n+p})\le d(x_n,x^*)+d(x_{n+p},x^*)<2\varepsilon$。反之不成立：如 $\mathbb{Q}$ 中逼近 $\sqrt{2}$ 的有理数列是 Cauchy 列但不收敛于 $\mathbb{Q}$ 中。

若空间上每个 Cauchy 列均收敛于该空间内，称该空间\textbf{完备}。

\subsection{Banach 不动点定理}
\begin{theorem}[Banach 不动点定理]
设 $(X,d)$ 完备，$\varphi:X\to X$ 为压缩映射，即 $\exists\alpha\in[0,1),d(\varphi(x),\varphi(y))\le\alpha d(x,y),\forall x,y\in X$。则 $\varphi$ 在 $X$ 中存在\textbf{唯一不动点} $x^*$：$\varphi(x^*)=x^*$。
\end{theorem}

\begin{center}\includegraphics[width=0.2\textwidth]{images/23_222_895_285_157_0.jpg}\end{center}

\begin{proof}
\textbf{存在性：}任取 $x_0\in X$，构造迭代 $x_{n+1}=\varphi(x_n)$。则 $d(x_{n+1},x_n)=d(\varphi(x_n),\varphi(x_{n-1}))\le\alpha d(x_n,x_{n-1})\le\cdots\le\alpha^n d(x_1,x_0)$。对任意 $n,p$：
\begin{align*}
d(x_{n+p},x_n)&\le\sum_{k=0}^{p-1}d(x_{n+k+1},x_{n+k})\le\sum_{k=0}^{p-1}\alpha^{n+k}d(x_1,x_0)\\
&=\alpha^n\frac{1-\alpha^p}{1-\alpha}d(x_1,x_0)<\frac{\alpha^n}{1-\alpha}d(x_1,x_0)\to0\quad(n\to\infty).
\end{align*}
故 $\{x_n\}$ 为 Cauchy 列。由完备性 $\exists x^*$ 使 $x_n\to x^*$。证 $\varphi(x^*)=x^*$：
\begin{align*}
d(\varphi(x^*),x^*)&\le d(\varphi(x^*),\varphi(x_n))+d(\varphi(x_n),x^*)\\
&\le\alpha d(x^*,x_n)+d(x_{n+1},x^*)\to0\quad(n\to\infty).
\end{align*}
故 $d(\varphi(x^*),x^*)=0$，$\varphi(x^*)=x^*$。

\textbf{唯一性：}若 $x^*\neq y^*$ 均为不动点，则 $d(x^*,y^*)=d(\varphi(x^*),\varphi(y^*))\le\alpha d(x^*,y^*)$。由 $\alpha<1$ 得 $d=0$，矛盾。
\end{proof}

\section{$\mathbb{R}^m$ 中的收敛与连续性}

\subsection{点列收敛的分量刻画}
在 $\mathbb{R}^m$ 中，$x_n=(x_n^1,\dots,x_n^m)$。$\lim x_n=a\iff\lim x_n^i=a^i$（$i=1,\dots,m$）。$\mathbb{R}^m$ 完备（Cauchy 列按分量收敛）。由于有限维空间上所有范数等价，可选 Euclid 范数：$\|x-a\|_2=\sqrt{\sum(x^i-a^i)^2}$。

\textbf{"遗传"性质：}一维空间的许多性质通过分量推广到多维——极限存在 $\Rightarrow$ 有界、极限的线性运算、Cauchy 收敛原理等。

\subsection{多元函数的极限}
设 $D\subset\mathbb{R}^m$，$a$ 为 $D$ 的聚点，$f:D\to\mathbb{R}$。

\begin{definition}[Heine 归结原则]
$\lim_{x\to a}f(x)=A\iff$ 对任意 $D\setminus\{a\}$ 中点列 $x_n\to a$，都有 $\lim f(x_n)=A$。
\end{definition}

\begin{definition}[$\varepsilon$-$\delta$ 定义]
$\forall\varepsilon>0,\exists\delta>0,\forall x\in D:0<\|x-a\|<\delta\Rightarrow|f(x)-A|<\varepsilon$。
\end{definition}

\subsection{经典反例——路径依赖}

\begin{example}[$f(x,y)=\frac{xy}{x^2+y^2}$]
沿直线 $y=\alpha x$：$f(x,\alpha x)=\frac{\alpha x^2}{x^2+\alpha^2x^2}=\frac{\alpha}{1+\alpha^2}$。该值与 $\alpha$ 有关，故 $\lim_{(x,y)\to(0,0)}f$ 不存在。
\end{example}

\begin{example}[$f(x,y)=\frac{x^2y}{x^4+y^2}$]
沿直线 $y=\alpha x$：$f=\frac{\alpha x}{x^2+\alpha^2}\to0$（$x\to0$）。但沿抛物线 $y=\beta x^2$：$f(x,\beta x^2)=\frac{\beta x^4}{x^4+\beta^2x^4}=\frac{\beta}{1+\beta^2}$，依赖 $\beta$，故极限不存在。此例说明仅沿直线逼近不够！
\end{example}

\begin{example}[$f(x,y)=\frac{x^2y^2}{x^2+y^2}$]
$|f|=\frac{x^2y^2}{x^2+y^2}\le x^2$（因 $\frac{y^2}{x^2+y^2}\le1$），$x^2\to0$，夹逼得极限存在为 $0$。
\end{example}

\subsection{累次极限与重极限}
$\lim_{(x,y)\to(a,b)}f(x,y)$（重极限）与 $\lim_{x\to a}\lim_{y\to b}f$ 或 $\lim_{y\to b}\lim_{x\to a}f$（累次极限）之间\textbf{无必然蕴含关系}。

\begin{example}[$f=x+y\sin(1/x)$，$x\neq0$；$f(0,y)=0$]
$|f|\le|x|+|y|\to0$，重极限存在为 $0$。但 $\lim_{x\to0}f$ 因 $\sin(1/x)$ 振荡而不存在，故累次极限 $\lim_{y\to0}\lim_{x\to0}f$ 不存在。
\end{example}

\begin{example}[$f(x,y)=(x+y)\sin\frac1x\sin\frac1y$]
累次极限不存在（$\sin\frac1x$ 振荡），但重极限存在为 $0$（被 $|x+y|$ 控制）。
\end{example}

\subsection{连续性与开映射刻画}
$f$ 在 $a$ 处连续：(1) Heine：$\forall\{x_n\}\to a$，$f(x_n)\to f(a)$；(2) $\varepsilon$-$\delta$。分量刻画：$f=(f^1,\dots,f^n)$ 连续 $\iff$ 每个 $f^i$ 连续。

\begin{theorem}[开映射原理]
设 $\Omega\subset\mathbb{R}^m$ 为开集，$f:\Omega\to\mathbb{R}^n$。则 $f\in C(\Omega)\iff$ 任意开集 $H\subset\mathbb{R}^n$ 的原像 $f^{-1}(H)$ 是开集。
\end{theorem}

\begin{center}\includegraphics[width=0.2\textwidth]{images/26_1270_1638_350_228_0.jpg}\end{center}

\begin{proof}($\Rightarrow$) 设 $H$ 开，$a\in f^{-1}(H)$。$f(a)\in H$，$\exists\varepsilon>0$ 使 $U(f(a),\varepsilon)\subset H$。由 $f$ 连续，$\exists\delta>0$ 使 $f(U(a,\delta))\subset U(f(a),\varepsilon)\subset H$，故 $U(a,\delta)\subset f^{-1}(H)$。($\Leftarrow$) $\forall a,\forall\varepsilon$，$U(f(a),\varepsilon)$ 是开集，$f^{-1}(U(f(a),\varepsilon))$ 开，$\exists\delta$ 使 $U(a,\delta)\subset f^{-1}(U(f(a),\varepsilon))$，即得连续性。\end{proof}

\begin{flushright}\small $\square$ 第八章完\end{flushright}

