\chapter{有限增量估计与ODE续}
\begin{flushright}\small 原 Class 20（OCRed as Class 2，4.22习题课）\end{flushright}

\section{期中考试讲解}
(1) 开集在连续函数下的像未必开（反例 $y=\sin x,(0,4\pi)\to[-1,1]$），原像必开。偏导连续 $\Rightarrow$ 可微。(2) 1-范数弧长计算。(3) 热力学 $dU=TdS-PdV,dA=-PdV-SdT$。

\section{有限增量估计}
$f:G\subset\mathbb{R}^m\to\mathbb{R}^n,f\in C^{(1)}(G)$。$\forall a,b\in G,\exists c\in[a,b]$ 使 $\|f(b)-f(a)\|\le\|Df(c)\|\cdot\|b-a\|$，其中 $\|A\|=\max_{\|x\|=1}\|Ax\|$（算子范数，$=\sqrt{\lambda_{\max}(A^T A)}$）。

证明：$\|f(b)-f(a)\|^2=\sum_i(f^i(b)-f^i(a))^2=\varphi(b)-\varphi(a)$，$\varphi(x)=\sum(f^i(b)-f^i(a))f^i(x)$。中值定理 $\varphi(b)-\varphi(a)=(b-a)\cdot\nabla\varphi(c)$。Schwartz 不等式得 $\|f(b)-f(a)\|^2\le\|b-a\|\cdot\|Df(c)^T(f(b)-f(a))\|\le\|b-a\|\cdot\|Df(c)\|\cdot\|f(b)-f(a)\|$。$\|Df\|$ 有界 $\Rightarrow f$ Lipschitz。

\section{ODE 系统续}
\subsection{可对角化情形}
$A_{n\times n}=PDP^{-1}$。$y=P^{-1}x$，$y'=Dy$（解耦）。$y_i=c_i e^{\lambda_i t}$，$x=Py=\sum c_i e^{\lambda_i t}p_i$。

\subsection{矩阵指数}
$e^{At}=P\operatorname{diag}(e^{\lambda_i t})P^{-1}$。非齐次：$x'=Ax+b$。$e^{-At}(x'-Ax)=e^{-At}b$。$(e^{-At}x)'=e^{-At}b$。$x=e^{At}x_0+e^{At}\int_0^t e^{-A\tau}b d\tau$。注：$e^A e^B\neq e^{A+B}$。

$e^A e^B=(I+A+\frac12 A^2+\cdots)(I+B+\frac12 B^2+\cdots)=I+A+B+AB+\frac12 A^2+\frac12 B^2+\cdots$。$e^{A+B}=I+A+B+\frac12(A^2+AB+BA+B^2)+\cdots$。$AB\neq BA$ 时不等。

\subsection{重特征值（续）}
$(A-\lambda I)p_2=p_1$。通解 $x=c_1 e^{\lambda t}p_1+c_2 e^{\lambda t}(tp_1+p_2)$。验证 $\widetilde{x}'=p_1 e^{\lambda t}+\lambda(tp_1+p_2)e^{\lambda t}=(A-\lambda I)p_2 e^{\lambda t}+(\lambda tp_1+\lambda p_2)e^{\lambda t}=A\widetilde{x}$。

例：$A=\begin{pmatrix}6&4\\-1&2\end{pmatrix}$，$\lambda=4$（重根）。$p_1=(2,-1)^T$。求 $p_2$：$\begin{pmatrix}2&4\\-1&-2\end{pmatrix}p_2=\binom{2}{-1}$。通解 $x=c_1 e^{4t}\binom{2}{-1}+c_2 e^{4t}(t\binom{2}{-1}+p_2)$。
\begin{flushright}\small $\square$ 第十八章完\end{flushright}

