\chapter{隐函数与极值习题}
\begin{flushright}\small 原 Class 24（OCRed as Class 2，4.29习题课）\end{flushright}

\section{隐函数方程组}

\subsection{二元二方程情形}
$\begin{cases}F(x,y,u,v)=0\\G(x,y,u,v)=0\end{cases}$，确定 $u=u(x,y),v=v(x,y)$。对 $x$ 求偏导：
\[
\begin{cases}
F_1+F_3 u_x+F_4 v_x=0,\\
G_1+G_3 u_x+G_4 v_x=0.
\end{cases}
\]
（其中 $F_1=F_x,F_2=F_y,F_3=F_u,F_4=F_v$，$G$ 同。）解出 $u_x,v_x$ 的条件是 $\bigl|\begin{smallmatrix}F_3&F_4\\G_3&G_4\end{smallmatrix}\bigr|=\frac{\partial(F,G)}{\partial(u,v)}\neq0$。对 $y$ 求偏导对称地处理。

\begin{example}[嵌套隐函数]
$u=f(x,y,z,t)$，$g(y,z,t)=0$，$h(z,t)=0$。问 $u$ 何时能表为 $x,y$ 的函数？

先解后两个方程：$h(z,t)=0\Rightarrow t=t(z)$，代入 $g(y,z,t(z))=0\Rightarrow z=z(y)$，进而 $t=t(z(y))$。最终 $u=f(x,y,z(y),t(z(y)))$ 为 $x,y$ 的函数。条件是每次求解的 Jacobi 行列式非零：
\[
\bigl|\begin{smallmatrix}g_z&g_t\\h_z&h_t\end{smallmatrix}\bigr|\neq0,\quad
\bigl|\begin{smallmatrix}g_z&g_t&g_u\\h_z&h_t&h_u\end{smallmatrix}\bigr|\neq0.
\]
\end{example}

\section{向量值函数的中值定理}

一元：$f(x_2)-f(x_1)=f'(x_1+\theta(x_2-x_1))(x_2-x_1)$。多元标量：$f(\vec{x}_2)-f(\vec{x}_1)=\nabla f(\vec{x}_1+\theta\vec{h})\cdot\vec{h}$。多元向量值：没有等式形式的 Lagrange 中值定理，只有不等式估计：
\[
\|f(\vec{x}_2)-f(\vec{x}_1)\|\le\|Df(\vec{x}_1+\theta\vec{h})\|\cdot\|\vec{h}\|,
\]
其中 $\vec{h}=\vec{x}_2-\vec{x}_1$，$\theta\in(0,1)$。这已在第十八章作为有限增量估计证明。

\section{单调算子与单射性}

\begin{problem}
设 $\Omega\subset\mathbb{R}^n$ 为凸域，$f\in C^1(\Omega,\mathbb{R}^n)$。若 $Df(x)$ 在 $\Omega$ 上处处正定，求证 $f$ 是单射（一一映射）。
\end{problem}

\begin{proof}
对任意 $\vec{x}_1,\vec{x}_2\in\Omega$，令 $\vec{h}=\vec{x}_2-\vec{x}_1$。构造 $F(t)=(\vec{x}_2-\vec{x}_1)^\top\bigl[f(\vec{x}_1+t\vec{h})-f(\vec{x}_1)\bigr]$，$t\in[0,1]$。则 $F(0)=0$，$F(1)=\vec{h}^\top[f(\vec{x}_2)-f(\vec{x}_1)]$。

求导：$F'(t)=\vec{h}^\top Df(\vec{x}_1+t\vec{h})\vec{h}$。由 $Df$ 正定，当 $\vec{h}\neq0$ 时 $F'(t)>0$（$\forall t$）。故 $F$ 严格递增，$F(1)>F(0)=0$。因此 $\vec{h}\neq0\Rightarrow f(\vec{x}_2)\neq f(\vec{x}_1)$，即 $f$ 为单射。
\end{proof}

\section{满射性——从 $\det(Df)\neq0$ 和强制性出发}

\begin{problem}
设 $f\in C^1(\mathbb{R}^n,\mathbb{R}^n)$，$\forall x,\det Df(x)\neq0$，且 $\|x\|\to\infty$ 时 $\|f(x)\|\to\infty$（强制性）。求证 $f(\mathbb{R}^n)=\mathbb{R}^n$（$f$ 为满射）。
\end{problem}

\begin{proof}
任取 $\vec{y}\in\mathbb{R}^n$，需证 $\exists\vec{x}^*$ 使 $f(\vec{x}^*)=\vec{y}$。考虑 $g(\vec{x})=\|f(\vec{x})-\vec{y}\|^2$。由强制性，当 $\|\vec{x}\|\to\infty$ 时 $g(\vec{x})\to\infty$，故 $g$ 在某点 $\vec{x}_0$ 取全局最小值。在极小点处 $\nabla g(\vec{x}_0)=0$，即
\[
2Df(\vec{x}_0)^\top(f(\vec{x}_0)-\vec{y})=0.
\]
由 $\det Df(\vec{x}_0)\neq0$，$Df(\vec{x}_0)$ 可逆，故 $f(\vec{x}_0)-\vec{y}=0$，即 $f(\vec{x}_0)=\vec{y}$。$\therefore f$ 为满射。
\end{proof}

\section{椭圆型方程极值原理}

\begin{problem}
$u(x,y)$ 在闭圆盘 $x^2+y^2\le1$ 上连续，在开圆盘内满足 $u_{xx}+u_{yy}=u$，且在边界 $x^2+y^2=1$ 上 $u(x,y)>0$。证明在内部恒有 $u(x,y)\ge0$（进而 $>0$）。
\end{problem}

\begin{proof}
\textbf{先证 $u\ge0$。}假设 $\exists(x_0,y_0)$ 使 $u(x_0,y_0)<0$（内部点）。由连续性，$u$ 在闭圆盘上取最小值，设为 $(x^*,y^*)$ 处。由 $u(x_0,y_0)<0$ 且边界上 $u>0$，最小值必在内部达到。故 $(x^*,y^*)$ 为内点，有 $u_x=u_y=0$。

在极小值点处，由二阶 Taylor 展开：
\[
u(x^*+\Delta x,y^*)-u(x^*,y^*)=\frac12 u_{xx}(x^*,y^*)\Delta x^2+O(\Delta x^2).
\]
若 $u_{xx}(x^*,y^*)<0$，则沿 $x$ 方向移动会使 $u$ 更小，与极小性矛盾！故 $u_{xx}\ge0$。同理 $u_{yy}\ge0$。于是 $u_{xx}+u_{yy}\ge0$，但由方程 $u_{xx}+u_{yy}=u(x^*,y^*)<0$，矛盾。因此不存在 $u<0$ 的点，即 $u\ge0$。

\textbf{再证 $u>0$。}取 $c<\min_{\partial\Omega}u/\max e^x$，令 $v=u-ce^x$。则 $v_{xx}+v_{yy}=u-ce^x=v$，且边界上 $v>0$。由前证 $v\ge0$，故 $u\ge ce^x>0$。此即椭圆型方程的\textbf{比较原理}：$L(u)=L(v)=0$（$L=\Delta-I$），边界 $u>v\Rightarrow$ 内部 $u>v$。
\end{proof}

\section{条件极值——椭球截面椭圆面积}

\begin{problem}
求椭球面 $\frac{x^2}{3}+y^2+\frac{z^2}{2}=1$ 被平面 $2x+y+z=0$ 截出的椭圆面积。
\end{problem}

\begin{proof}
截线椭圆上的点到原点距离的平方 $r^2=x^2+y^2+z^2$ 取极值即得椭圆半轴长。用 Lagrange 乘子法：
\[
L=x^2+y^2+z^2+\lambda\Bigl(\frac{x^2}{3}+y^2+\frac{z^2}{2}-1\Bigr)+\mu(2x+y+z).
\]
求偏导：
\[
\begin{cases}
2x+\frac{2}{3}\lambda x+2\mu=0,\quad
2y+2\lambda y+\mu=0,\quad
2z+\lambda z+\mu=0,\\
\frac{x^2}{3}+y^2+\frac{z^2}{2}=1,\quad 2x+y+z=0.
\end{cases}
\]
将前三式分别乘 $x,y,z$ 并相加，利用约束得 $2r^2+\lambda\bigl(\frac{2}{3}x^2+2y^2+z^2\bigr)=0$。由前两约束可推 $2r^2+\lambda\bigl(2-\frac{4}{3}x^2-y^2-\frac12 z^2\bigr)=0$，最终得 $\lambda=-r^2$。回代求解，得到特征方程 $15r^4-49r^2+36=0$，解得 $r_1^2=\frac{36}{15}=\frac{12}{5}$，$r_2^2=1$。半轴分别为 $a=\sqrt{\frac{12}{5}}$，$b=1$。椭圆面积 $S=\pi ab=\pi\sqrt{\frac{12}{5}}=\frac{2\sqrt{15}}{5}\pi$。

注：此法仅当椭圆中心在原点时有效（由约束 $2x+y+z=0$ 知截面过原点，成立）。
\end{proof}

\begin{flushright}\small $\square$ 第二十一章完\end{flushright}

