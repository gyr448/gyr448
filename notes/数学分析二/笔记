\chapter{广义积分习题课}
\begin{flushright}\small 原 Class 7（习题课）\end{flushright}

\section{习题选讲}

\begin{problem}[一致连续 + 积分收敛 $\Rightarrow$ 极限为0]
若 $f(x)$ 在 $[0,+\infty)$ 一致连续，且 $\int_0^{+\infty}f(x)dx$ 收敛，证明 $\lim_{x\to+\infty}f(x)=0$。若仅知道 $f\in C[0,+\infty)$ 且积分收敛，结论是否仍成立？
\end{problem}

\begin{proof}
假设 $\lim f(x)\neq0$，则 $\exists\varepsilon_0>0,\forall M>0,\exists M_1>M$ 使 $|f(M_1)|\ge\varepsilon_0$。不妨设 $f(M_1)>0$。由一致连续，对 $\varepsilon_0/2$，$\exists\delta>0$ 使 $M_1<x<M_1+\delta$ 时 $|f(x)-f(M_1)|<\varepsilon_0/2$，故 $f(x)>\varepsilon_0/2$。于是 $\int_{M_1}^{M_1+\delta}f(x)dx>\frac{\varepsilon_0}{2}\delta>0$。可找到无穷多这样的区间（每个贡献固定正面积），与 $\int_0^{+\infty}f$ 收敛（Cauchy准则）矛盾。$\therefore\lim f(x)=0$。

若仅连续，结论不成立。反例：在整数 $n$ 处构造高度为1、宽度为 $1/n^2$ 的三角形脉冲——函数连续、积分收敛（总面积 $\sim\sum1/n^2$），但 $\lim f\neq0$。
\end{proof}

\begin{center}\includegraphics[width=0.4\textwidth]{images/20_936_368_658_453_0.jpg}\end{center}

\begin{problem}[与参数无关的积分]
设 $a\ge1$，证明 $\int_0^{+\infty}\frac{dx}{(1+x^2)(1+x^a)}$ 的值与 $a$ 无关。
\end{problem}

\begin{proof}
令 $x=1/t$，则 $I=\int_{+\infty}^0\frac{-dt/t^2}{(1+1/t^2)(1+1/t^a)}=\int_0^{+\infty}\frac{t^a dt}{(1+t^2)(1+t^a)}$。于是 $2I=\int_0^{+\infty}\frac{1+x^a}{(1+x^2)(1+x^a)}dx=\int_0^{+\infty}\frac{dx}{1+x^2}=\frac{\pi}{2}$，故 $I=\pi/4$，与 $a$ 无关。此法类似 $\int_0^{+\infty}\frac{\ln x}{1+x^2}dx=0$。
\end{proof}

\begin{problem}[$\int_0^{+\infty}\frac{\sin x}{x^p}dx$ 的敛散性，$p>0$]
两个可疑点：$0$ 和 $+\infty$。

$x\to0^+$：$\frac{\sin x}{x^p}\sim x^{1-p}$。$1-p>-1$（即 $p<2$）时瑕积分收敛；$p\ge2$ 发散。

$x\to+\infty$：由 Dirichlet 判别法（$1/x^p\downarrow0$，$\int\sin x$ 有界），$p>0$ 时收敛。更精细地用第二中值定理：$|\int_H^{H'}\frac{\sin x}{x^p}dx|\le\frac1{H^p}|\int_H^{H'}\sin xdx|\le\frac2{H^p}\to0$，Cauchy 收敛原理保证收敛。

绝对收敛性：$\int|\frac{\sin x}{x^p}|dx\ge\int\frac{\sin^2 x}{x^p}dx=\frac12\int\frac{1-\cos2x}{x^p}dx$。$\int_1^\infty\frac{dx}{x^p}$ 当 $p>1$ 收敛，故绝对收敛 $\iff p>1$。

总结：$0<p\le1$ 条件收敛（$0$ 处绝对收敛，$+\infty$ 处条件收敛）；$1<p<2$ 绝对收敛；$p\ge2$ 发散。
\end{problem}

\begin{problem}[$\int_0^{+\infty}\frac{\sin x}{x^p+\sin x}dx$ 的敛散性]
$x\to0^+$：$\lim_{x\to0}\frac{\sin x}{x^p+\sin x}=\begin{cases}1,&p>1\\\frac12,&p=1\\0,&p<1\end{cases}$。$0$ 不是瑕点（极限有限）。只需讨论 $\int_1^{+\infty}$。

拆分：$\frac{\sin x}{x^p+\sin x}=\frac{\sin x}{x^p}-\frac{\sin^2 x}{x^p(x^p+\sin x)}$。第一项 $\frac{\sin x}{x^p}$ 当 $p>0$ 条件收敛（Dirichlet）。第二项：$x$ 充分大时 $\frac{\sin^2 x}{x^p(x^p+\sin x)}\ge\frac{\sin^2 x}{x^p(x^p+1)}\sim\frac{\sin^2 x}{x^{2p}}$。$\int^{+\infty}\frac{\sin^2 x}{x^{2p}}dx$ 当 $2p>1$（$p>1/2$）收敛，$p\le1/2$ 发散。

总结：$0<p\le\frac12$ 发散；$\frac12<p\le1$ 条件收敛；$p>1$ 绝对收敛。
\end{problem}

\begin{problem}[$\int_0^{+\infty}\frac{xdx}{1+x^6\sin^2 x}$ 的收敛性]
$f(x)=\frac{x}{1+x^6\sin^2 x}>0$。令 $F(A)=\int_0^A f$。考虑 $F(n\pi)=\sum_{k=1}^n u_k$，$u_k=\int_{(k-1)\pi}^{k\pi}f$。

在 $[0,\pi/2]$ 上 $\sin x\ge\frac{2x}{\pi}$。于是
\begin{align*}
u_k &\le\int_{(k-1)\pi}^{k\pi}\frac{k\pi\,dx}{1+(k-1)^6\pi^6\sin^2 x}
\le 2k\pi\int_0^{\pi/2}\frac{dx}{1+4(k-1)^6\pi^4 x^2}.
\end{align*}
令 $t=2(k-1)^3\pi^2 x$，$u_k\le\frac{k}{\pi(k-1)^3}\int_0^{(k-1)^3\pi^2}\frac{dt}{1+t^2}\le\frac{k}{2(k-1)^3}$。当 $k\to\infty$ 时 $u_k\sim\frac1{2k^2}$，故 $\sum u_k$ 收敛。由 $F(A)$ 单调有界，原积分收敛。进一步 $F(n\pi)<\frac12\sum\frac1{k^2}<1$。
\end{problem}

\begin{problem}[对称换元]
设 $a,b>0$，讨论 $\int_0^{+\infty}f(ax+\frac{b}{x})dx$ 的收敛性。
\end{problem}

\begin{center}\includegraphics[width=0.4\textwidth]{images/22_1123_741_565_412_0.jpg}\end{center}

\begin{proof}
令 $t=ax-\frac{b}{x}$，则 $ax+\frac{b}{x}=\sqrt{t^2+4ab}$。解 $a x^2-\sqrt{t^2+4ab}\,x+b=0$ 得 $x_{1,2}=\frac{\sqrt{t^2+4ab}\pm t}{2a}$。$x_1:0\to\sqrt{b/a}$ 对应 $t:+\infty\to0$；$x_2:\sqrt{b/a}\to+\infty$ 对应 $t:0\to+\infty$。分别换元并相加：
\begin{align*}
\int_0^{\sqrt{b/a}}f(ax+\frac{b}{x})dx&=\int_0^\infty f(\sqrt{t^2+4ab})\Bigl[\frac{dt}{2a}-\frac{t\,dt}{2a\sqrt{t^2+4ab}}\Bigr],\\
\int_{\sqrt{b/a}}^{+\infty}f(ax+\frac{b}{x})dx&=\int_0^\infty f(\sqrt{t^2+4ab})\Bigl[\frac{dt}{2a}+\frac{t\,dt}{2a\sqrt{t^2+4ab}}\Bigr].
\end{align*}
相加得 $\int_0^{+\infty}f(ax+\frac{b}{x})dx=\frac1a\int_0^{+\infty}f(\sqrt{t^2+4ab})dt$。此换元将含参数积分化为规范形式。
\end{proof}

\begin{flushright}\small $\square$ 第七章完\end{flushright}

