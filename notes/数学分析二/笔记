\chapter{连通性与方向导数}
\begin{flushright}\small 日期：4月1日\quad 原 Class 12（Class 11缺失）\end{flushright}

\section{连通性}
\subsection{路径连通}
$E\subset\mathbb{R}^m$ 路径连通：$\forall x,y\in E,\exists\gamma\in C[0,1]$ 使 $\gamma(0)=x,\gamma(1)=y$，$\gamma([0,1])\subset E$。

\begin{theorem}[连通集上连续函数的介值性]
设 $E$ 连通，$f\in C(E)$。$\forall x,y\in E,\forall A$ 介于 $f(x)$ 与 $f(y)$ 之间，$\exists c\in E$ 使 $f(c)=A$。
\end{theorem}
\begin{proof}$\exists\gamma\in C[0,1]$ 连接 $x,y$。$f\circ\gamma$ 为一元连续函数，介值定理给出 $\exists t_0$ 使 $f(\gamma(t_0))=A$。\end{proof}

\subsection{开区域与闭区域}
开区域 = 连通开集。闭区域 = 开区域的闭包。例：$\mathbb{R}^2$ 中 $\{(x,0):x\in(0,1)\}$ 连通非开；$\{(x,y):x\in(0,1),y\in\mathbb{R}\}$ 开区域；$\{(x,0):x\in[0,1]\}$ 连通闭但非闭区域；$[0,1]\subset\mathbb{R}$ 闭区域。

闭区域上的介值性：若 $x,y\in\partial E$，取内部点 $x',y'\in\operatorname{int}E$ 使 $f(x')<C<f(y')$，内部连通 $\Rightarrow\exists z\in\operatorname{int}E$ 使 $f(z)=C$。

\subsection{拓扑应用}球面 $S=\{x:\|x\|=R\}$。若 $\gamma$ 满足 $\|\gamma(0)\|=R_1<R,\|\gamma(1)\|=R_2>R$，则 $\exists t_0,\|\gamma(t_0)\|=R$（$f=\|x\|$ 连续，介值性）。

\section{不动点定理应用：Newton 法}
求 $f(x)=x^2-c$ 的零点。Newton 迭代：$x_{n+1}=x_n-\frac{x_n^2-c}{2x_n}=\frac12(x_n+\frac{c}{x_n})=:\varphi(x_n)$。当 $x,x'>\sqrt{c}$：$|\varphi(x)-\varphi(x')|=\frac12|1-\frac{c}{xx'}|\cdot|x-x'|<\frac12|x-x'|$。$\varphi$ 在 $[\sqrt{c},+\infty)$ 上压缩，收敛于 $\sqrt{c}$。

\section{方向导数与梯度}
\subsection{方向导数}
$\overrightarrow{e}$ 单位向量。$\frac{\partial f}{\partial\overrightarrow{e}}(x_0)=\lim_{t\to0^+}\frac{f(x_0+t\overrightarrow{e})-f(x_0)}{t}=\frac{d}{dt}\big|_{t=0}f(x_0+t\overrightarrow{e})$。$m=1$ 时即普通导数 $\frac{df}{dx}$。

\subsection{偏导数与梯度}
$\frac{\partial f}{\partial x_i}=\frac{\partial f}{\partial\overrightarrow{e_i}}$（沿标准基）。梯度 $\nabla f=(\frac{\partial f}{\partial x_1},\dots,\frac{\partial f}{\partial x_m})$。可微时 $\frac{\partial f}{\partial\overrightarrow{e}}=\nabla f\cdot\overrightarrow{e}$。
\begin{flushright}\small $\square$ 第十一章完\end{flushright}

