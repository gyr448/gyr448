\chapter{极值与PDE习题}
\begin{flushright}\small 原 Class 26（5.6习题课）\end{flushright}

\section{条件极值续}

\begin{example}[椭球面到原点的最大距离]
$a x^2+b y^2+c z^2+2d xy+2e xz+2f yz=1$。求 $x^2+y^2+z^2$ 的最值。$L=x^2+y^2+z^2-\lambda(\cdots-1)$。由 $\nabla L=0$ 得 $\frac{x}{\lambda}=ax+dy+ez$，$\frac{y}{\lambda}=dx+by+fz$，$\frac{z}{\lambda}=ex+fy+cz$。三式分别乘 $x,y,z$ 相加：$\frac{x^2+y^2+z^2}{\lambda}=1$，故 $l=\sqrt{\lambda}$。消去 $x,y,z$ 得特征方程 $|A-t I|=0$（其中 $t=1/\lambda$，$A$ 为二次型矩阵），最大距离为 $\sqrt{\lambda_{\max}}$。
\end{example}

\begin{example}[行列式的极值不等式]
$A=\bigl|\begin{smallmatrix}x_1&x_2&x_3\\y_1&y_2&y_3\\z_1&z_2&z_3\end{smallmatrix}\bigr|$。证 $|A|\le\frac{|x||y||z|}{\sqrt{(\sum x_i^2)(\sum y_i^2)(\sum z_i^2)}}$。用 Lagrange 乘子法，固定 $\|x\|,\|y\|,\|z\|$ 求 $|A|$ 的最大值。$\partial f/\partial x_1=\bigl|\begin{smallmatrix}y_2&y_3\\z_2&z_3\end{smallmatrix}\bigr|+2\lambda_1 x_1=0$，即 $\overrightarrow{x}\parallel(\overrightarrow{y}\times\overrightarrow{z})$。同理 $\overrightarrow{y}\parallel(\overrightarrow{z}\times\overrightarrow{x})$，$\overrightarrow{z}\parallel(\overrightarrow{x}\times\overrightarrow{y})$。故 $\overrightarrow{x},\overrightarrow{y},\overrightarrow{z}$ 两两正交，此时 $|A|=\|x\|\|y\|\|z\|$ 达最大。
\end{example}

\begin{example}[正定阵与极值点的二阶条件]
$A=(a_{ij})$ 正定，$u\in C^{1,2}(\Omega)$，$u$ 在 $\Omega$ 的极小值在 $\vec{x}_0\in\Omega$ 取到。求证 $\sum a_{ij}\frac{\partial^2 u}{\partial x_i\partial x_j}(\vec{x}_0)\ge0$。

在极小点 $\nabla u=0$，Hessian $B=(\partial_{ij}u)$ 半正定。$\sum a_{ij}b_{ji}=\operatorname{tr}(AB)$。$A=PP^\top$，$\operatorname{tr}(AB)=\operatorname{tr}(P^\top BP)$。$P^\top BP$ 半正定（半正定性的合同不变），故其迹 $\ge0$。
\end{example}

\begin{example}[广义 AM-GM 不等式]
$a,b,c,u,v,w>0$。证 $(\frac{u}{a})^a(\frac{v}{b})^b(\frac{w}{c})^c\le(\frac{u+v+w}{a+b+c})^{a+b+c}$。令 $x=\frac{u}{u+v+w}$，$y=\frac{v}{u+v+w}$，$z=\frac{w}{u+v+w}$（$x+y+z=1$）。Lagrange 乘子法求 $x^a y^b z^c$ 在单纯形上的最大值得 $(\frac{a}{a+b+c})^a(\frac{b}{a+b+c})^b(\frac{c}{a+b+c})^c$，乘回即得。
\end{example}

\begin{example}[PDE 化简]
$\frac{1}{(x+y)^2}(z_{xx}+2z_{xy}+z_{yy})-\frac{1}{(x+y)^3}(z_x+z_y)=0$。代换 $u=xy,v=x-y$。注意到 $(x+y)^2=v^2+4u$。计算 $z_x=y f_u+f_v$，$z_y=x f_u-f_v$。$z_x+z_y=(x+y)f_u$。$(\partial_x+\partial_y)^2 z = 2 f_u + (x+y)^2 f_{uu}$。代入原方程化简得 $f_{uu}+\frac{1}{v^2+4u}f_u=0$。
\end{example}

\begin{flushright}\small $\square$ 第二十三章完\end{flushright}

