\chapter{紧致性与多元连续函数性质}
\begin{flushright}\small 日期：3月25日\quad 原 Class 9\end{flushright}

\section{$\mathbb{R}^m$ 中有界闭集上连续函数的性质}
回顾一元：闭区间上连续函数有界、取到最值、一致连续。推广至 $\mathbb{R}^m$。

\subsection{有界集与 Bolzano-Weierstrass 定理}
$E\subset\mathbb{R}^m$ 有界：$\exists L>0,\forall x\in E,\|x\|<L$（等价于每个分量有界）。

\begin{theorem}[B-W 定理]
$\mathbb{R}^m$ 中有界序列必有收敛子序列（$m$ 有限）。
\end{theorem}
\begin{proof}逐分量选取：对第一分量用一维 B-W 得子列收敛于 $a^1$；在子列上对第二分量用 B-W 得 $a^2$；如此 $m$ 次，最终子列所有分量同时收敛。\end{proof}

\subsection{三大性质}
\begin{theorem}设 $E\subset\mathbb{R}^m$ 有界闭，$f\in C(E)$。则：(1)$f$ 有界；(2)$f$ 取到最值；(3)$f$ 一致连续。\end{theorem}
\begin{proof}
(1)若无界，$\forall n,\exists x_n\in E$ 使 $|f(x_n)|>n$。B-W 给出子列 $x_{n_k}\to x^*\in E$，由连续 $f(x_{n_k})\to f(x^*)<\infty$，与 $|f(x_{n_k})|>n_k\to\infty$ 矛盾。

(2)令 $M=\sup_E f$。$\forall n,\exists x_n\in E$ 使 $M-1/n<f(x_n)\le M$。取子列 $x_{n_k}\to x_0\in E$，$f(x_0)=\lim f(x_{n_k})=M$。最小值同理。

(3)反证。若不，$\exists\varepsilon_0>0,\forall n,\exists x_n,x_n'\in E$ 使 $\|x_n-x_n'\|<1/n$ 但 $|f(x_n)-f(x_n')|\ge\varepsilon_0$。取 $\{x_n\}$ 的收敛子列 $x_{n_k}\to x_0\in E$，则 $\|x_{n_k}'-x_0\|\le\|x_{n_k}'-x_{n_k}\|+\|x_{n_k}-x_0\|\to0$。由连续 $|f(x_{n_k})-f(x_{n_k}')|\to0$，与 $\ge\varepsilon_0$ 矛盾。\end{proof}

\section{紧致性}

\subsection{平庸距离的启示}
平庸距离 $d(x,y)=\begin{cases}0,&x=y\\1,&x\neq y\end{cases}$ 下所有集合既开又闭，但 $\{\frac1n\}$ 无收敛子列。此空间不完备。需要更强概念。

\subsection{列紧与紧致}
\begin{definition}[列紧] $E$ 中任意序列有子序列收敛于 $E$ 中点。\end{definition}
\begin{definition}[紧致] $E$ 的任意开覆盖存在有限子覆盖。\end{definition}

\begin{example}[$(0,1)$ 不紧致] 开覆盖 $\{(\frac1n,1):n\in\mathbb{N}\}$ 覆盖 $(0,1)$ 但无有限子覆盖（接近 $0$ 的点无法被有限覆盖）。\end{example}
\begin{example}[{$[0,1]$} 紧致] Heine-Borel 定理的一维情形。\end{example}

\subsection{紧致 $\Rightarrow$ 列紧}
\begin{proof}反证。设 $K$ 紧致但不列紧，$\exists\{x_n\}\subset K$ 无收敛于 $K$ 的子列。则 $\forall x\in K,\exists\delta_x>0$ 使 $U(x,\delta_x)$ 仅含有限项（否则 $x$ 为某子列的极限点）。开覆盖 $\{U(x,\delta_x):x\in K\}$ 有有限子覆盖，但每个只含有限项，矛盾。\end{proof}

在 $\mathbb{R}^m$ 中：\textbf{紧致 $\iff$ 列紧 $\iff$ 有界闭}（Heine-Borel 定理）。

\subsection{Heine-Borel 定理证明}
有界闭 $\Rightarrow$ 紧致。(Step1) 闭方块 $I$ 紧致：若否，二分法得嵌套方块列 $\{I_n\}$，由闭区间套 $\exists!x^*\in\bigcap I_n$。由开覆盖 $\exists V_i\ni x^*$ 开，当 $n$ 大时 $I_n\subset V_i$，矛盾。(Step2) $E\subset I$ 闭：设 $V$ 为 $E$ 的开覆盖，$\tilde V=V\cup\{I\setminus E\}$ 为 $I$ 的开覆盖，取有限子覆盖，去除 $I\setminus E$ 即得。

\subsection{紧致 $\Rightarrow$ 完备}
紧致空间中 Cauchy 列 $\{x_n\}$：列紧性给出子列 $x_{n_k}\to x^*$。$d(x_n,x^*)\le d(x_n,x_{n_k})+d(x_{n_k},x^*)<\varepsilon+\varepsilon\to0$。

\subsection{紧致集上连续函数的性质（一般度量空间）}
紧致集上连续函数有界、取最值、一致连续。一致连续性的证明：$\forall\varepsilon$，$\forall a$ 取 $\delta_a$ 满足 $d(x,a)<\delta_a\Rightarrow|f(x)-f(a)|<\varepsilon$。开覆盖 $\{U(a,\frac12\delta_a)\}$ 有有限子覆盖。取 $\delta=\min\frac12\delta_{a_i}$，则 $d(x,x')<\delta\Rightarrow x,x'\in U(a_j,\delta_{a_j})\Rightarrow|f(x)-f(x')|<2\varepsilon$。

\begin{center}\includegraphics[width=0.7\textwidth]{images/36_292_799_923_238_0.jpg}\end{center}

\section{积分收敛判别技巧总结}
\begin{itemize}
\item 周期函数积分：按周期分段放缩。例：$\int_0^{+\infty}\frac1x e^{\cos x}\sin(\sin x)dx$ 条件收敛。
\item $\int_0^1(\ln x)^n dx=(-1)^n n!$
\item $\int_1^{+\infty}\frac{(\ln x)^n}{x^p}dx$ 收敛 $\iff p>1,n>-1$
\item $\int_0^1\frac{(\ln x)^n}{x^p}dx$ 收敛 $\iff p<1,n>-1$
\item $\int_1^{+\infty}\frac{\sin x}{\sqrt{x}}dx$ 条件收敛（经典）
\item $\int_1^{+\infty}x^p|\sin x|dx$ 收敛 $\iff p<-1$（$\int_{n\pi}^{(n+1)\pi}|\sin x|dx=2$，放缩为 $\sum n^p$）
\end{itemize}
\begin{flushright}\small $\square$ 第九章完\end{flushright}

