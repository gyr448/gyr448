\chapter{Taylor展开与隐函数定理}
\begin{flushright}\small 日期：4月17日\quad 原 Class 19（Class 18缺失）\end{flushright}

\section{Laplace 算子与调和函数}
$\nabla=(\partial_{x^1},\dots,\partial_{x^m})$。散度 $\nabla\cdot g=\sum\partial_{x^i}g^i$。Laplace：$\Delta=\nabla^2=\sum\partial_{x^ix^i}$。$\mathbb{R}^3$：$f=1/r$（$r=\sqrt{x^2+y^2+z^2}$），$\Delta f=0$。$\mathbb{R}^2$：$f=\ln r$，$\Delta f=0$。$\mathbb{R}^m(m>2)$：$f=1/r^{m-2}$，$\Delta f=0$（$\partial_x f=(2-m)x/r^m$，$\partial_{xx}f=(2-m)/r^m-(2-m)mx^2/r^{m+2}$，求和得0）。

\section{方向导数的高阶推广}
$(h\cdot\nabla)=\sum h^i\partial_{x^i}$。$\varphi(t)=f(x_0+th)$，$\frac{d^k\varphi}{dt^k}=(h\cdot\nabla)^k f(x_0+th)$。

\section{多元 Taylor 展开}
$f\in C^{(n+1)}(\Omega)$。$\varphi(\tau)=f(x+\tau\Delta x)$。一元 Taylor：
\[
\varphi(1)=\sum_{k=0}^n\frac1{k!}\varphi^{(k)}(0)+\frac1{n!}\int_0^1(1-s)^n\varphi^{(n+1)}(s)ds.
\]
代入 $\varphi^{(k)}(0)=(\Delta x\cdot\nabla)^k f(x)$：
\[
f(x+\Delta x)=\sum_{k=0}^n\frac1{k!}(\Delta x\cdot\nabla)^k f(x)+\frac1{n!}\int_0^1(1-s)^n(\Delta x\cdot\nabla)^{n+1}f(x+s\Delta x)ds.
\]

$n=1$ 有限增量公式：$f(x+\Delta x)=f(x)+\int_0^1\Delta x\cdot\nabla f(x+s\Delta x)ds$。Lagrange 余项：$f(x+\Delta x)=f(x)+\Delta x\cdot\nabla f(x+\theta\Delta x),\theta\in(0,1)$。

推论：$D$ 开区域，$\nabla f\equiv0\Rightarrow f\equiv\text{const}$（路径连通 + 有限增量）。

\section{隐函数定理}

\subsection{一维隐函数定理}
\begin{theorem}设 $F:\Omega\subset\mathbb{R}^2\to\mathbb{R},F\in C^{(1)}$，$F(x_0,y_0)=0$，$F_y(x_0,y_0)\neq0$。则 $\exists\alpha,\beta>0$ 及唯一 $f:(x_0-\alpha,x_0+\alpha)\to(y_0-\beta,y_0+\beta)$ 使 $F(x,f(x))\equiv0$，$f\in C^{(1)}$，$f'(x)=-\frac{F_x}{F_y}$。\end{theorem}
\begin{proof}不妨 $F_y(x_0,y_0)>0$。由连续，邻域内 $F_y>0$，$F(x_0,\cdot)$ 严格增。$\exists y_0-\beta<y_0<y_0+\beta$ 使 $F(x_0,y_0-\beta)<0<F(x_0,y_0+\beta)$。$F$ 连续 $\Rightarrow\forall x$ 靠近 $x_0$ 同样成立，介值定理 $\exists!y=f(x)$。导数：$F(x,f(x))\equiv0$ 求微分：$F_x dx+F_y dy=0$。\end{proof}

\subsection{一般隐函数定理}
$F:\Omega\subset\mathbb{R}^{m+n}\to\mathbb{R}^n,F\in C^{(1)},F(x_0,y_0)=0$。若 $\det(\frac{\partial F}{\partial y})\neq0$，则 $\exists y=f(x)$ 且 $\frac{\partial y^i}{\partial x^j}=-\sum_p(\frac{\partial F}{\partial y})_{ip}^{-1}\frac{\partial F^p}{\partial x^j}$。全微分形式：$F_x dx+F_y dy=0\Rightarrow dy=-F_y^{-1}F_x dx$。

例：$\begin{cases}x+y+u+v=0\\x^2+y^2+u^2+v^2-1=0\end{cases}$。全微分：$\begin{cases}dx+dy+du+dv=0\\2xdx+2ydy+2udu+2vdv=0\end{cases}$。$v-u\neq0$ 时矩阵可逆：
\[
\begin{pmatrix}du\\dv\end{pmatrix}=-\frac1{v-u}\begin{pmatrix}v&-1\\-u&1\end{pmatrix}\begin{pmatrix}1&1\\x&y\end{pmatrix}\begin{pmatrix}dx\\dy\end{pmatrix}.
\]
二阶微分：$\begin{cases}d^2u+d^2v=0\\dx^2+dy^2+du^2+u d^2u+dv^2+v d^2v=0\end{cases}$。$d^2u=\frac1{u-v}(-dx^2-dy^2-du^2-dv^2)$。

\begin{flushright}\small $\square$ 第十七章完\end{flushright}

