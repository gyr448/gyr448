\chapter{高阶偏导数与Clairaut定理}
\begin{flushright}\small 日期：4月10日\quad 原 Class 17\end{flushright}

\section{高阶偏导数}
$f_{xx}=\partial_x(f_x),f_{xy}=\partial_y(f_x),f_{yx}=\partial_x(f_y),f_{yy}=\partial_y(f_y)$。

例：$f=e^{x\sin y}$，$f_y=x\cos y\cdot e^{x\sin y}$，$f_{xy}=\cos y\cdot e^{x\sin y}+x\cos y\sin y\cdot e^{x\sin y}=f_{yx}$。$f=xy$：$f_x=y,f_{xy}=1;f_y=x,f_{yx}=1$。

\subsection{混合偏导数不相等的反例}
$f(x,y)=\begin{cases}xy\frac{x^2-y^2}{x^2+y^2},&(x,y)\neq(0,0)\\0,&(x,y)=(0,0)\end{cases}$。$f_x(0,y)=-y\,(y\neq0),f_x(0,0)=0$。$f_{xy}(0,0)=-1$。$f_{yx}(0,0)=1$。$f_{xy}\neq f_{yx}$！
\begin{center}\includegraphics[width=0.2\textwidth]{images/54_1256_1589_389_371_0.jpg}\includegraphics[width=0.2\textwidth]{images/55_1307_1072_324_250_0.jpg}\end{center}

\subsection{Clairaut / Schwarz 定理}
\begin{theorem}若 $f_{xy},f_{yx}$ 在 $(x_0,y_0)$ 邻域存在且在 $(x_0,y_0)$ 连续，则 $f_{xy}(x_0,y_0)=f_{yx}(x_0,y_0)$。\end{theorem}
\begin{proof}$F(h,k)=f(x_0+h,y_0+k)-f(x_0+h,y_0)-f(x_0,y_0+k)+f(x_0,y_0)$。$\varphi(x)=f(x,y_0+k)-f(x,y_0)$，$F=\varphi(x_0+h)-\varphi(x_0)=\varphi'(x_0+\theta_1 h)h=f_{xy}(\cdots)hk$。对称地 $F=f_{yx}(\cdots)hk$。令 $(h,k)\to(0,0)$ 得 $f_{xy}=f_{yx}$。\end{proof}
推广：$f\in C^{(k)}(\Omega)$ 则任意 $k$ 阶混合偏导与求导顺序无关（归纳法）。

\subsection{复合函数的高阶导数}
$\frac{\partial^2 y}{\partial t^i\partial t^k}=\sum_{j,l}\frac{\partial^2 y}{\partial x^j\partial x^l}\frac{\partial x^j}{\partial t^i}\frac{\partial x^l}{\partial t^k}+\sum_j\frac{\partial y}{\partial x^j}\frac{\partial^2 x^j}{\partial t^i\partial t^k}$。

二阶微分：$d^2 f=\sum_{i,j}f_{x^i x^j}dx^i dx^j$（当 $x^i$ 为自变量时）。一阶微分形式不变但二阶不保持！
\begin{flushright}\small $\square$ 第十六章完\end{flushright}

