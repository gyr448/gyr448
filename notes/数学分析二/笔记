\chapter{Lagrange乘子续与Frenet标架}
\begin{flushright}\small 日期：5月6日\quad 原 Class 25\end{flushright}

\section{Lagrange 乘子法续}

\begin{example}[$f=x^2-y^2$，约束 $2x-y-3=0$（重温）]
$L=x^2-y^2-\lambda(2x-y-3)$。临界点 $x_0=2,y_0=1,\lambda=2$。$H_L=\bigl(\begin{smallmatrix}2&0\\0&-2\end{smallmatrix}\bigr)$ 不定。在约束切空间 $2\Delta x-\Delta y=0$ 上：$2\Delta x^2-2\Delta y^2=2\Delta x^2-8\Delta x^2=-6\Delta x^2<0$。$\therefore$ 极大值 $f(2,1)=3$。
\end{example}

\begin{example}[二次型在单位球面上的极值]
$f(x)=\sum a_{ij}x^i x^j$（$A$ 对称），约束 $\|x\|^2=1$。$L=\sum a_{ij}x^i x^j-\lambda(\frac12\|x\|^2-1)$。$\frac{\partial L}{\partial x_i}=2\sum a_{ij}x^j-2\lambda x^i=0\Rightarrow Ax=\lambda x$。极值点恰为 $A$ 的特征向量，极值为相应特征值。$\max=\lambda_{\max},\min=\lambda_{\min}$。
\end{example}

\begin{example}[$f=ax^2+by^2+cz^2$（$a>b>c>0$），$\|x\|^2=1$]
$L=ax^2+by^2+cz^2-\lambda(x^2+y^2+z^2-1)$。解：$(\pm1,0,0)$（$\lambda=a$，极大值 $a$），$(0,\pm1,0)$（$\lambda=b$，鞍点），$(0,0,\pm1)$（$\lambda=c$，极小值 $c$）。

二阶判断：$\lambda=a$ 时，约束 $2x_0\Delta x=0$ 给出 $\Delta x=0$（在 $(\pm1,0,0)$ 处）。二阶项 $2(b-a)\Delta y^2+2(c-a)\Delta z^2<0$（因 $b-a<0,c-a<0$），$\therefore$ 极大。$\lambda=c$ 时 $\Delta z=0$，二阶项 $2(a-c)\Delta x^2+2(b-c)\Delta y^2>0$，极小。
\end{example}

\section{$\mathbb{R}^3$ 中曲线的 Frenet 标架}

\subsection{弧长参数化}
曲线 $\overrightarrow{r}(t)=(x(t),y(t),z(t))$。弧长 $s(t)=\int_{t_0}^t\|\overrightarrow{r}'(\tau)\|d\tau$，$\frac{ds}{dt}=\|\overrightarrow{r}'\|$。弧长参数化：$\overrightarrow{r}(s)$ 满足 $\|\dot{\overrightarrow{r}}\|=1$（$\dot{}=d/ds$）。

单位切向量 $\overrightarrow{T}=\dot{\overrightarrow{r}}=\frac{\overrightarrow{r}'}{\|\overrightarrow{r}'\|}$。曲率 $\kappa=\|\dot{\overrightarrow{T}}\|=\frac{\|\overrightarrow{r}'\times\overrightarrow{r}''\|}{\|\overrightarrow{r}'\|^3}$。

\begin{example}[圆 $\overrightarrow{r}=(a\cos t,a\sin t,0)$]
$s=at$，$\overrightarrow{T}=(-\sin(s/a),\cos(s/a))$，$\dot{\overrightarrow{T}}=(-\frac1a\cos(s/a),-\frac1a\sin(s/a))$，$\kappa=1/a$。直线 $\iff\kappa=0$（$\dot{\overrightarrow{T}}=0\Rightarrow\overrightarrow{T}=\vec{e}$ 常向量 $\Rightarrow\overrightarrow{r}=\overrightarrow{r}_0+s\vec{e}$）。
\end{example}

\subsection{主法向量与副法向量}
单位主法向量 $\overrightarrow{N}=\frac{\dot{\overrightarrow{T}}}{\|\dot{\overrightarrow{T}}\|}=\frac{\dot{\overrightarrow{T}}}{\kappa}$。副法向量 $\overrightarrow{B}=\overrightarrow{T}\times\overrightarrow{N}$。$\{\overrightarrow{T},\overrightarrow{N},\overrightarrow{B}\}$ 构成右手单位正交标架（Frenet 标架）。

\begin{center}\includegraphics[width=0.2\textwidth]{images/80_1201_894_394_362_0.jpg}\end{center}

Taylor 展开（弧长参数）：
\[
\overrightarrow{r}(s_0+\Delta s)=\overrightarrow{r}(s_0)+\Delta s\overrightarrow{T}+\frac12\kappa\Delta s^2\overrightarrow{N}+O(\Delta s^2).
\]
此式表明曲线在密切平面（由 $\overrightarrow{T},\overrightarrow{N}$ 张成）内以曲率 $\kappa$ 弯曲。

\subsection{Frenet 公式}
$\{\overrightarrow{T},\overrightarrow{N},\overrightarrow{B}\}$ 为单位正交标架，导数满足反对称关系。设
\[
\begin{pmatrix}\dot{\overrightarrow{T}}\\\dot{\overrightarrow{N}}\\\dot{\overrightarrow{B}}\end{pmatrix}
=\begin{pmatrix}0&\kappa&0\\-\kappa&0&\tau\\0&-\tau&0\end{pmatrix}
\begin{pmatrix}\overrightarrow{T}\\\overrightarrow{N}\\\overrightarrow{B}\end{pmatrix}.
\]
即 $\dot{\overrightarrow{T}}=\kappa\overrightarrow{N}$，$\dot{\overrightarrow{N}}=-\kappa\overrightarrow{T}+\tau\overrightarrow{B}$，$\dot{\overrightarrow{B}}=-\tau\overrightarrow{N}$。$\tau$ 称为\textbf{挠率}。

\textbf{挠率公式（一般参数）：}
\[
\tau=\frac{(\overrightarrow{r}',\overrightarrow{r}'',\overrightarrow{r}''')}{\|\overrightarrow{r}'\times\overrightarrow{r}''\|^2}
=\frac{\overrightarrow{r}'''\cdot(\overrightarrow{r}'\times\overrightarrow{r}'')}{\|\overrightarrow{r}'\times\overrightarrow{r}''\|^2}.
\]
分子为三阶混合积，$\overrightarrow{r}'\times\overrightarrow{r}''=\kappa s'^{\,3}\overrightarrow{B}$。

\textbf{曲率和挠率确定曲线：}给定 $\kappa(s)>0,\tau(s)$，存在唯一空间曲线（不计刚体运动）以它们为曲率和挠率。$\kappa,\tau$ 均为常数 $\iff$ 曲线为圆柱螺线。

\subsection{一般参数下的加速度}
$\overrightarrow{a}=\overrightarrow{r}''(t)=v'\overrightarrow{T}+\kappa v^2\overrightarrow{N}$，其中 $v=\frac{ds}{dt}$。切向加速度 $a_t=v'$，法向加速度 $a_n=\kappa v^2=v^2/\rho$（$\rho=1/\kappa$ 曲率半径）。

\section{二阶 PDE 的分类}

对于 $u_{xx}+a u_{xy}+b u_{yy}=0$，作变换 $\xi=x+\lambda y,\eta=x+\mu y$。代入得
\[
(1+a\lambda+b\lambda^2)u_{\xi\xi}+[2+a(\lambda+\mu)+2b\lambda\mu]u_{\xi\eta}+(1+a\mu+b\mu^2)u_{\eta\eta}=0.
\]
特征方程 $1+ar+br^2=0$ 的判别式 $\Delta=a^2-4b$：
\begin{itemize}
\item $\Delta>0$（双曲型）：$\lambda=r_1,\mu=r_2$，得 $u_{\xi\eta}=0$；
\item $\Delta=0$（抛物型）：$\lambda=r_1,\mu=0$，得 $u_{\eta\eta}=0$；
\item $\Delta<0$（椭圆型）：取 $\lambda+\mu=-a/b$（$A=C$）且 $\lambda\mu=\frac{a^2}{2b^2}-\frac1b$（$B=0$），得 $u_{\xi\xi}+u_{\eta\eta}=0$（Laplace 方程）。
\end{itemize}

