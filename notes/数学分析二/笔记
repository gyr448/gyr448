\chapter{Lagrange乘子与曲线曲面}
\begin{flushright}\small 日期：4月29日\quad 原 Class 23\end{flushright}

\section{Lagrange 乘子法（续）}
\begin{example}[$f=ax^2+by^2+cz^2$（$a>b>c>0$），$\|x\|^2=1$]
$L=ax^2+by^2+cz^2-\lambda(x^2+y^2+z^2-1)$。$\partial_x L=2(a-\lambda)x=0$ 等。解得 $(\pm1,0,0)$ 对应 $\lambda=a$（极大 $a$），$(0,\pm1,0)$ 对应 $\lambda=b$（鞍点），$(0,0,\pm1)$ 对应 $\lambda=c$（极小 $c$）。约束 $x_0\Delta x+y_0\Delta y+z_0\Delta z=0$。$\lambda=a$ 时二阶项 $2(b-a)\Delta y^2+2(c-a)\Delta z^2<0$（极大）。
\end{example}

\section{$\mathbb{R}^3$ 中的曲线}

\subsection{弧长}
$\overrightarrow{r}(t)=(x(t),y(t),z(t))$。$s=\int_{t_0}^t\|\overrightarrow{r}'(\tau)\|d\tau$，$\frac{ds}{dt}=\|\overrightarrow{r}'\|$。单位切向量 $\overrightarrow{T}=d\overrightarrow{r}/ds=\overrightarrow{r}'/\|\overrightarrow{r}'\|$。加速度 $\overrightarrow{a}=v'\overrightarrow{T}+\kappa v^2\overrightarrow{N}=a_t\overrightarrow{T}+\frac{v^2}{\rho}\overrightarrow{N}$。

\subsection{Frenet 标架}
主法向量 $\overrightarrow{N}=\overrightarrow{T}'/\|\overrightarrow{T}'\|$，曲率 $\kappa=\|\overrightarrow{T}'\|=\frac{\|\overrightarrow{r}'\times\overrightarrow{r}''\|}{\|\overrightarrow{r}'\|^3}$。副法向量 $\overrightarrow{B}=\overrightarrow{T}\times\overrightarrow{N}$，挠率 $\tau=\frac{(\overrightarrow{r}',\overrightarrow{r}'',\overrightarrow{r}''')}{\|\overrightarrow{r}'\times\overrightarrow{r}''\|^2}$。Frenet 公式：$\overrightarrow{T}'=\kappa\overrightarrow{N},\overrightarrow{N}'=-\kappa\overrightarrow{T}+\tau\overrightarrow{B},\overrightarrow{B}'=-\tau\overrightarrow{N}$。

例：圆周 $\overrightarrow{r}=(a\cos t,a\sin t,0)$：$\kappa=1/a,\tau=0$。圆柱螺线 $\overrightarrow{r}=(a\cos t,a\sin t,t)$：$\kappa=\frac{a}{a^2+1},\tau=\frac1{a^2+1}$。

\section{曲面}
参数化 $\overrightarrow{r}(u,v)$。法向量 $\overrightarrow{n}=\frac{\overrightarrow{r}_u\times\overrightarrow{r}_v}{\|\overrightarrow{r}_u\times\overrightarrow{r}_v\|}$。切平面 $(\overrightarrow{r}-\overrightarrow{r}_0)\cdot\overrightarrow{n}=0$。

隐式 $F(x,y,z)=0$：$\nabla F$ 为法向量，切平面 $(\overrightarrow{r}-\overrightarrow{r}_0)\cdot\nabla F=0$。两曲面交线的切向量 $\nabla F_1\times\nabla F_2$。

\subsection{第一基本形式}
$I(du,dv)=\|\overrightarrow{r}_u du+\overrightarrow{r}_v dv\|^2=E du^2+2F du dv+G dv^2$。面积元 $\sqrt{EG-F^2}du dv$。
\begin{flushright}\small $\square$ 第二十章完\end{flushright}

