\chapter{第二型曲面积分与定向}
\begin{flushright}\small 日期：6月3日\quad 原 Class 37\end{flushright}

\section{第二型曲面积分（对坐标的积分）}
有向面元 $d\overrightarrow{S}=\overrightarrow{n}d\sigma$（$\overrightarrow{n}$ 为单位法向量）。$\overrightarrow{n}=\frac{\overrightarrow{r}_u\times\overrightarrow{r}_v}{\|\overrightarrow{r}_u\times\overrightarrow{r}_v\|}$，$d\overrightarrow{S}=(\overrightarrow{r}_u\times\overrightarrow{r}_v)du dv$。

$\iint_S\overrightarrow{v}\cdot d\overrightarrow{S}=\iint_D\overrightarrow{v}\cdot(\overrightarrow{r}_u\times\overrightarrow{r}_v)du dv$。分量形式：
\[
\iint_S v^{(x)}dS^{(x)}+v^{(y)}dS^{(y)}+v^{(z)}dS^{(z)}
=\iint_D\Bigl(v^{(x)}\frac{\partial(y,z)}{\partial(u,v)}+v^{(y)}\frac{\partial(z,x)}{\partial(u,v)}+v^{(z)}\frac{\partial(x,y)}{\partial(u,v)}\Bigr)du dv.
\]
楔积记号：$dy\wedge dz,dz\wedge dx,dx\wedge dy$。

\section{曲面定向}
简单正则曲面：$\overrightarrow{r}\in C^1$，$\overrightarrow{r}_u\times\overrightarrow{r}_v\neq\overrightarrow{0}$，单射。法向量连续选取确定定向。

\textbf{不可定向曲面——M\"obius 带：}
$x=(a+v\sin\frac{u}{2})\cos u,y=(a+v\sin\frac{u}{2})\sin u,z=v\cos\frac{u}{2}$。$u\in[0,2\pi],v\in[-\varepsilon,\varepsilon]$。在 $u=0,v=0$：$\overrightarrow{r}_u\times\overrightarrow{r}_v=(a,0,0)$。在 $u=2\pi,v=0$：$\overrightarrow{r}_u\times\overrightarrow{r}_v=(-a,0,0)$（法向量反向！）。M\"obius 带不可定向。

\section{初等区域与定向协调}
初等区域：边界分段连续。初等曲面：定义在初等区域上的正则曲面。拼接条件：(i) 至多两个曲面共边；(ii) $n\ge3$ 个曲面最多交于一点。定向协调：相邻曲面在共同边界处诱导相反定向。

\begin{center}\includegraphics[width=0.9\textwidth]{images/117_195_1878_1197_289_0.jpg}\end{center}

\section{第二型曲面积分计算}
显式 $z=f(x,y)$：以 $x,y$ 为参数，$d\overrightarrow{S}=(-f_x,-f_y,1)dxdy$。$\iint_S\overrightarrow{v}\cdot d\overrightarrow{S}=\iint_D(v^{(z)}-v^{(x)}f_x-v^{(y)}f_y)dxdy$。

\begin{example}[单位立方体表面]
$\iint_{\partial[0,1]^3}\overrightarrow{x}\cdot d\overrightarrow{S}$。以 $x=1$ 面为例：$\overrightarrow{n}=(1,0,0)$，$d\overrightarrow{S}=(1,0,0)dydz$，$\overrightarrow{x}\cdot d\overrightarrow{S}=1\cdot1\cdot dydz$。六面之和 $=8$。或整体用散度定理：$\frac13\iint\overrightarrow{x}\cdot d\overrightarrow{S}=\frac13\iiint\nabla\cdot\overrightarrow{x}=\frac13\cdot3=1$（每面贡献不均匀，但答为 $8$，需注意 $\overrightarrow{x}=(x,y,z)$ 在各面取值不同）。
\end{example}

\begin{example}[椭球面]
$\frac{x^2}{a^2}+\frac{y^2}{b^2}+\frac{z^2}{c^2}=1$。$\iint\overrightarrow{x}\cdot d\overrightarrow{S}$。参数化 $x=a\cos\theta\cos\varphi,y=b\cos\theta\sin\varphi,z=c\sin\theta$。计算各 Jacobi 得 $I=-\frac{4\pi}{3}abc$（负号因参数化法向量指向内部）。
\end{example}

\begin{flushright}\small $\square$ 第三十三章完\end{flushright}

