\chapter{高阶微分与多元函数极值}
\begin{flushright}\small 日期：4月24日\quad 原 Class 22（Class 21缺失）\end{flushright}

\section{二阶微分}
$du=u_x dx+u_y dy$。$d^2u=d(u_x dx+u_y dy)=du_x dx+u_x d^2x+du_y dy+u_y d^2y$。当 $x,y$ 为自变量时 $d^2x=d^2y=0$，$d^2u=u_{xx}dx^2+2u_{xy}dxdy+u_{yy}dy^2$。

\section{一元函数极值回顾}
$f'(x)=0$，$f''(x)>0$ 极小，$f''(x)<0$ 极大。

\section{多元函数极值}
$f:\mathbb{R}^m\to\mathbb{R}$。Taylor：$f(x_0+\Delta x)=f(x_0)+(\Delta x\cdot\nabla)f(x_0)+\frac12(\Delta x\cdot\nabla)^2 f(x_0)+\cdots$。临界点 $\nabla f=0$。二阶项 $\frac12\sum\Delta x^i\Delta x^j f_{x^i x^j}(x_0)$。Hessian $H_f=(\frac{\partial^2 f}{\partial x^i\partial x^j})$。$H_f$ 正定 $\Rightarrow$ 极小；负定 $\Rightarrow$ 极大；不定 $\Rightarrow$ 鞍点；半定 $\Rightarrow$ 需进一步判断。

\section{最小二乘法}
数据 $(x_i,y_i)$，拟合 $f(x)=a_1 f_1(x)+a_2 f_2(x)$。误差 $E(a_1,a_2)=\sum(a_1 f_1(x_i)+a_2 f_2(x_i)-y_i)^2$。$\nabla E=0$ 得正规方程：
\[
\begin{pmatrix}\sum f_1^2&\sum f_1 f_2\\\sum f_1 f_2&\sum f_2^2\end{pmatrix}\begin{pmatrix}a_1\\a_2\end{pmatrix}=\begin{pmatrix}\sum f_1 y_i\\\sum f_2 y_i\end{pmatrix}.
\]
系数矩阵为正定（或半正定），解即为最小二乘估计。

\section{Lagrange 乘子法}
约束 $F(x)=0$（$F:\mathbb{R}^m\to\mathbb{R}^n$）下求 $f$ 极值。$L(x,\lambda)=f(x)+\sum\lambda_i F^i(x)$。必要条件 $\nabla_x L=0$（$\nabla f$ 是 $\nabla F^i$ 的线性组合）。

二阶条件：在约束切空间上 $\sum\frac{\partial^2 L}{\partial x^i\partial x^j}\Delta x^i\Delta x^j$ 正定 $\Rightarrow$ 极小；负定 $\Rightarrow$ 极大。

\begin{example}[$f=x^2-y^2$，$2x-y-3=0$]
$L=x^2-y^2-\lambda(2x-y-3)$。$\begin{cases}L_x=2x-2\lambda=0\\L_y=-2y+\lambda=0\\2x-y-3=0\end{cases}\Rightarrow x_0=2,y_0=1,\lambda=2$。$H_L=\begin{pmatrix}2&0\\0&-2\end{pmatrix}$ 不定。在约束 $2\Delta x-\Delta y=0$ 上：$2\Delta x^2-2\Delta y^2=2\Delta x^2-8\Delta x^2=-6\Delta x^2<0$。极大值 $f(2,1)=3$。
\end{example}

\begin{example}[二次型在单位球面上的极值]
$f(x)=\sum a_{ij}x^i x^j$（$A$ 对称），$\|x\|^2=1$。Lagrange：$Ax=\lambda x$。极值点为 $A$ 的特征向量，极值为特征值：$\max=\lambda_{\max},\min=\lambda_{\min}$。
\end{example}

\begin{flushright}\small $\square$ 第十九章完\end{flushright}

