\chapter{重积分习题}
\begin{flushright}\small 原 Class 35（5.27习题课）\end{flushright}

\begin{example}[双纽线面积]
曲线 $(\frac{x^2}{a^2}+\frac{y^2}{b^2})^2=\frac{x^2}{a^2}-\frac{y^2}{b^2}$。令 $x=a\rho\cos\theta,y=b\rho\sin\theta$。代入得 $\rho^4=\rho^2(\cos^2\theta-\sin^2\theta)\Rightarrow\rho^2=\cos2\theta$。$\cos2\theta\ge0\Rightarrow\theta\in[-\frac\pi4,\frac\pi4]\cup[\frac{3\pi}{4},\frac{5\pi}{4}]$。Jacobi $=ab\rho$。面积 $S=ab\int_{-\pi/4}^{\pi/4}d\theta\int_0^{\sqrt{\cos2\theta}}\rho d\rho=ab\int_{-\pi/4}^{\pi/4}\frac{\cos2\theta}{2}d\theta=ab$。
\end{example}

\begin{center}\includegraphics[width=0.2\textwidth]{images/110_1183_1920_367_253_0.jpg}\end{center}

\begin{example}[广义极坐标]
$\iint_D(\frac{x-c}{a}+\sqrt{\frac{y-c}{b}})dxdy$，$D$ 由 $\frac{x-c}{a}+\sqrt{\frac{y-c}{b}}=1$ 和坐标轴围成。

令 $x=c+a\rho\cos^4\theta,y=c+b\rho\sin^4\theta$。$\sqrt{\rho}=1\Rightarrow\rho=1$。Jacobi $=4ab\rho\sin^3\theta\cos^3\theta$。积分 $=4ab\int_0^{\pi/2}\sin^3\theta\cos^3\theta d\theta\int_0^1\rho\sqrt{\rho}d\rho=\frac{2}{5}ab$。

法二：$u=\sqrt{\frac{x-c}{a}},v=\sqrt{\frac{y-c}{b}}$。$D\to\{u+v\le1,u,v\ge0\}$。
\end{example}

\begin{example}[$y^2=2x,x+y=12$ 围成区域]
交点 $(2,2),(8,4)$。$D=\{(x,y):y^2/2\le x\le12-y,2\le y\le4\}$。$\iint_D(x+y)dxdy=\int_2^4 dy\int_{y^2/2}^{12-y}(x+y)dx=\cdots$。或换元 $u=x+y,v=y$，$|\frac{\partial(x,y)}{\partial(u,v)}|=1$。$y=-\sqrt{1+2u}\le v\le-1+\sqrt{1+2u}$。$I=\int_4^{12}u du\int_{y_1}^{y_2}dv$。
\end{example}

\begin{flushright}\small $\square$ 第三十一章完\end{flushright}

