\chapter{Frenet标架续与曲面论}
\begin{flushright}\small 原 Class 27（5.5，OCRed as S.S）\end{flushright}

\section{Frenet 标架续}

\subsection{一般参数下的曲率和挠率}
$\kappa=\frac{\|\overrightarrow{r}'\times\overrightarrow{r}''\|}{\|\overrightarrow{r}'\|^3}$。$\tau=\frac{(\overrightarrow{r}',\overrightarrow{r}'',\overrightarrow{r}''')}{\|\overrightarrow{r}'\times\overrightarrow{r}''\|^2}$。$\overrightarrow{r}'\times\overrightarrow{r}''=\kappa s'^{\,3}\overrightarrow{B}$。

例：圆周 $\overrightarrow{r}=(a\cos t,a\sin t,0)$：$\overrightarrow{r}'\times\overrightarrow{r}''=(0,0,a^2)$，$\kappa=1/a,\tau=0$。

圆柱螺线 $\overrightarrow{r}=(a\cos t,a\sin t,t)$：$\overrightarrow{r}'=(-a\sin t,a\cos t,1)$，$\overrightarrow{r}''=(-a\cos t,-a\sin t,0)$。$\overrightarrow{r}'\times\overrightarrow{r}''=(a\sin t,-a\cos t,a^2)$。$\kappa=\frac{\sqrt{a^2+a^4}}{(a^2+1)^{3/2}}$，$\tau=\frac{a^2}{a^4+a^2}$。

\section{$\mathbb{R}^3$ 中曲面的基本形式}

\subsection{曲面参数化}
$\overrightarrow{r}(u,v):\mathbb{R}^2\to\mathbb{R}^3$。曲面上曲线 $\overrightarrow{r}(u(t),v(t))$ 的切向量 $\overrightarrow{r}'=\overrightarrow{r}_u u'+\overrightarrow{r}_v v'$。

\subsection{第一基本形式（度量）}
$I(du,dv)=\|\overrightarrow{r}_u du+\overrightarrow{r}_v dv\|^2=E du^2+2F du dv+G dv^2$，其中 $E=\|\overrightarrow{r}_u\|^2$，$F=\overrightarrow{r}_u\cdot\overrightarrow{r}_v$，$G=\|\overrightarrow{r}_v\|^2$。

弧长 $L=\int\sqrt{I(u',v')}dt$。面积微元 $dA=\|\overrightarrow{r}_u\times\overrightarrow{r}_v\|du dv=\sqrt{EG-F^2}du dv$。

\subsection{第二基本形式与法曲率}
单位法向量 $\overrightarrow{n}=\frac{\overrightarrow{r}_u\times\overrightarrow{r}_v}{\|\overrightarrow{r}_u\times\overrightarrow{r}_v\|}$。

曲面曲线 $\overrightarrow{r}(s)$（弧长参数化）的曲率向量 $\ddot{\overrightarrow{r}}=K\overrightarrow{N}$。$\overrightarrow{n}\cdot\ddot{\overrightarrow{r}}=K\cos\theta=K_n$（法曲率）。$\overrightarrow{n}\cdot\overrightarrow{r}=0$ 求导：$\dot{\overrightarrow{n}}\cdot\dot{\overrightarrow{r}}+\overrightarrow{n}\cdot\ddot{\overrightarrow{r}}=0\Rightarrow\overrightarrow{n}\cdot\ddot{\overrightarrow{r}}=-\dot{\overrightarrow{n}}\cdot\dot{\overrightarrow{r}}$。

第二基本形式 $II(du,dv)=-\overrightarrow{n}\cdot d^2\overrightarrow{r}=L du^2+2M du dv+N dv^2$。法曲率 $K_n=\frac{II}{I}$。

\begin{center}\includegraphics[width=0.3\textwidth]{images/87_1160_185_487_319_0.jpg}\end{center}

\textbf{法截面与法截线：}由 $\overrightarrow{n}$ 和切方向张成的平面截曲面得法截线，其曲率即法曲率 $K_n$。所有方向的法曲率中最大和最小者称为主曲率 $K_1,K_2$。

\begin{flushright}\small $\square$ 第二十四章完\end{flushright}

