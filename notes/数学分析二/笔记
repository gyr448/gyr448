\chapter{曲线曲面习题}
\begin{flushright}\small 原 Class 29（5.13习题课，Class 28缺失）\end{flushright}

\section{习题选讲}

\begin{problem}[切线与坐标平面的夹角]
$z=f(x,y)$ 上过 $M_0(x_0,y_0,z_0)$ 的曲线 $\frac{x-x_0}{\cos\alpha}=\frac{y-y_0}{\sin\alpha}$ 在 $M_0$ 的切线与 $xOy$ 平面所成角 $\theta$ 的正切。
\end{problem}
\begin{proof}曲线参数 $t$：$dx=\cos\alpha\,dt,dy=\sin\alpha\,dt$。$dz=f_x dx+f_y dy=(f_x\cos\alpha+f_y\sin\alpha)dt$。切线方向 $(\cos\alpha,\sin\alpha,f_x\cos\alpha+f_y\sin\alpha)$。$\tan\theta=\frac{|dz|}{\sqrt{dx^2+dy^2}}=|f_x\cos\alpha+f_y\sin\alpha|$。\end{proof}

\begin{problem}[球面斜驶线]
球面参数化：$x=r\cos\psi\cos\varphi,y=r\cos\psi\sin\varphi,z=r\sin\psi$（$\varphi$ 经度，$\psi$ 纬度）。斜驶线 $\tan(\frac\pi4+\frac\psi2)=e^{k\varphi}$。证它与每条子午线（经线）交成定角。

$\overrightarrow{r}_\varphi=(-r\cos\psi\sin\varphi,r\cos\psi\cos\varphi,0)$，$\overrightarrow{r}_\psi=(-r\sin\psi\cos\varphi,-r\sin\psi\sin\varphi,r\cos\psi)$。$\overrightarrow{r}_\varphi\cdot\overrightarrow{r}_\psi=0$，$\|\overrightarrow{r}_\varphi\|=r\cos\psi$，$\|\overrightarrow{r}_\psi\|=r$。

斜驶线微分：$d\psi=\frac{2k e^{k\varphi}}{1+e^{2k\varphi}}d\varphi$。$d\overrightarrow{r}=\overrightarrow{r}_\varphi d\varphi+\overrightarrow{r}_\psi d\psi$。子午线 $d\varphi=0$，切向量 $\overrightarrow{r}_\psi$。计算 $\cos\theta=\frac{d\overrightarrow{r}\cdot\overrightarrow{r}_\psi}{\|d\overrightarrow{r}\|\|\overrightarrow{r}_\psi\|}$，利用恒等式 $\frac{2e^{k\varphi}}{1+e^{2k\varphi}}=\cos\psi$ 可证 $\cos\theta$ 为常数。

\begin{center}\includegraphics[width=0.2\textwidth]{images/91_1197_1631_390_387_0.jpg}\includegraphics[width=0.3\textwidth]{images/92_206_1620_396_387_0.jpg}\includegraphics[width=0.4\textwidth]{images/92_996_1622_641_378_0.jpg}\end{center}
\end{problem}

\begin{problem}[Euler 齐次函数定理]
$f$ 可微且 $x f_x+y f_y=0$。求证 $f$ 恒为常数。

法一：令 $F(t)=f(tx,ty)$。$F'(t)=x f_x(tx,ty)+y f_y(tx,ty)=\frac1t(tx f_x+ty f_y)=0$。$\therefore F(t)\equiv F(0)=f(0,0)$。取 $t=1$ 得 $f(x,y)=f(0,0)$，常数。

法二：$\frac{\partial f}{\partial l_\theta}=f_x\cos\theta+f_y\sin\theta$。条件意味着所有方向导数为零，故 $f$ 为常数。\end{problem}

\begin{problem}[均匀分布方向导数之和为零]
$f$ 在 $P_0$ 可微，$\overrightarrow{l_1},\dots,\overrightarrow{l_n}$（$n\ge2$）为 $n$ 个单位向量，相邻夹角 $2\pi/n$。证 $\sum_{i=1}^n\frac{\partial f}{\partial l_i}(x_0,y_0)=0$。

设 $\theta_i=\frac{2\pi}{n}(i-1)$，$\overrightarrow{l_i}=(\cos\theta_i,\sin\theta_i)$。$\frac{\partial f}{\partial l_i}=f_x\cos\theta_i+f_y\sin\theta_i$。求和 $\sum\cos\theta_i=0$，$\sum\sin\theta_i=0$（单位根之和为零）。故总和为零。

具体：$\sum\cos\theta_i\sin\theta_i=\frac12\sum[\sin(2\theta_i)]=0$（同样利用三角恒等式）。
\end{problem}

\begin{problem}[曲率挠率确定曲线]
$\mathbb{R}^3$ 中两曲线 $\overrightarrow{r}(s)$ 和 $\widetilde{r}(s)$（$s$ 弧长），Frenet 标架分别为 $\{\overrightarrow{T},\overrightarrow{N},\overrightarrow{B}\}$ 和 $\{\widetilde{T},\widetilde{N},\widetilde{B}\}$。若 $\kappa(s)=\widetilde{\kappa}(s)$，$\tau(s)=\widetilde{\tau}(s)$，且在 $s=s_0$ 处标架重合，则两曲线全同（不计位置）。

考虑 $D(s)=\|\overrightarrow{T}-\widetilde{T}\|^2+\|\overrightarrow{N}-\widetilde{N}\|^2+\|\overrightarrow{B}-\widetilde{B}\|^2$。由 Frenet 公式可证 $D'(s)\equiv0$，故 $D(s)\equiv D(s_0)=0$，标架恒等，积分得 $\overrightarrow{r}=\widetilde{r}+\text{const}$。

$\kappa,\tau$ 为常数 $\iff$ 曲线为圆柱螺线（包括圆周 $\tau=0$ 和直线 $\kappa=0$ 为特例）。
\end{problem}

