\chapter{重积分变量替换}
\begin{flushright}\small 日期：5月22日\quad 原 Class 33\end{flushright}

\section{变量替换公式}
一维回顾：$\int_{\varphi(s_1)}^{\varphi(s_2)}f(x)dx=\int_{s_1}^{s_2}f(\varphi(s))\varphi'(s)ds$（$\varphi'$ 为放大率）。

二维推广：$(x,y)=\overrightarrow{\varphi}(u,v)=(\varphi_1(u,v),\varphi_2(u,v))$。小矩形 $[u_0,u_0+\Delta u]\times[v_0,v_0+\Delta v]$ 映为曲边平行四边形，面积近似为
\[
\Delta S\approx\bigl\|\frac{\partial\overrightarrow{\varphi}}{\partial u}\times\frac{\partial\overrightarrow{\varphi}}{\partial v}\bigr\|\Delta u\Delta v
=\bigl|\frac{\partial(\varphi_1,\varphi_2)}{\partial(u,v)}\bigr|\Delta u\Delta v = |\det D\overrightarrow{\varphi}|\Delta u\Delta v.
\]
（因为 $\frac{\partial\overrightarrow{\varphi}}{\partial u}\approx(\varphi_{1u}\Delta u,\varphi_{2u}\Delta u)$，$\frac{\partial\overrightarrow{\varphi}}{\partial v}\approx(\varphi_{1v}\Delta v,\varphi_{2v}\Delta v)$，叉积模长 $=|(\varphi_{1u}\Delta u)(\varphi_{2v}\Delta v)-(\varphi_{1v}\Delta v)(\varphi_{2u}\Delta u)|=|\det D\varphi|\Delta u\Delta v$。）

\begin{center}\includegraphics[width=0.5\textwidth]{images/105_175_653_698_343_0.jpg}\includegraphics[width=0.4\textwidth]{images/105_890_644_570_345_0.jpg}\end{center}

\section{一般变量替换定理}

\begin{theorem}[重积分变量替换]
设 $\overrightarrow{\varphi}\in C^1(\Omega,\mathbb{R}^m)$，$\Omega$ 为开区域。$E$ 为 Jordan 可测集且 $\overline{E}\subset\Omega$。若
\begin{enumerate}
\item[(1)] $\det D\overrightarrow{\varphi}(\vec{u})\neq0$ 在 $\operatorname{int}(E)$ 上；
\item[(2)] $\overrightarrow{\varphi}$ 在 $\operatorname{int}(E)$ 上是单射。
\end{enumerate}
则 $\overrightarrow{\varphi}(E)$ 是 Jordan 可测集，且 $\forall f\in C(\overrightarrow{\varphi}(E))$：
\[
\int_{\overrightarrow{\varphi}(E)}f(\vec{x})d\vec{x}
=\int_E f(\overrightarrow{\varphi}(\vec{u}))\bigl|\det D\overrightarrow{\varphi}(\vec{u})\bigr|d\vec{u}.
\]
其中 $\det D\overrightarrow{\varphi}=\frac{\partial(x^1,\dots,x^m)}{\partial(u^1,\dots,u^m)}$ 称为 \textbf{Jacobi 行列式}。
\end{theorem}

注：$\overrightarrow{\varphi}(\partial E)\neq\partial(\overrightarrow{\varphi}(E))$ 一般成立。

\section{常见坐标变换的 Jacobi 行列式}

\begin{itemize}
\item 极坐标 $(r,\theta)$：$\frac{\partial(x,y)}{\partial(r,\theta)}=\bigl|\begin{smallmatrix}\cos\theta&-r\sin\theta\\\sin\theta&r\cos\theta\end{smallmatrix}\bigr|=r$。
\item 柱坐标 $(r,\theta,z)$：Jacobi $=r$。
\item 球坐标 $(r,\theta,\phi)$：$x=r\sin\phi\cos\theta,y=r\sin\phi\sin\theta,z=r\cos\phi$。Jacobi $=r^2\sin\phi$。
\end{itemize}

\begin{flushright}\small $\square$ 第二十九章完\end{flushright}

