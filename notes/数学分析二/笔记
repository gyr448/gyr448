\chapter{期中复习与ODE系统}
\begin{flushright}\small 原 Class 16（习题课）\end{flushright}

\section{期中要点}
(1) 开集的连续像未必开（$y=\sin x,(0,4\pi)\to[-1,1]$），原像必开。(2) 偏导存在+至少一个连续 $\Rightarrow$ 可微。(3) 1-范数弧长：$x=a(\cos t+t\sin t),y=a(\sin t-t\cos t)$，$s=\int(|dx|+|dy|)=2\pi|a|$。(4) 热力学：$dU=TdS-PdV$，$A=U-TS\Rightarrow dA=-PdV-SdT$，$S=-\frac{\partial A}{\partial T},P=-\frac{\partial A}{\partial V}$。

\section{线性ODE系统}
\subsection{矩阵指数法}
$\overrightarrow{x}'=A\overrightarrow{x}$。解 $\overrightarrow{x}=e^{At}\overrightarrow{c}$。$e^A=I+A+\frac12A^2+\cdots$。若 $A$ 可对角化 $A=PDP^{-1}$：$e^{At}=P\operatorname{diag}(e^{\lambda_i t})P^{-1}$。通解 $\sum c_i e^{\lambda_i t}\overrightarrow{p}_i$。

例：$A=\begin{pmatrix}3&-2\\2&-2\end{pmatrix}$，$\lambda=2,-1$，$\overrightarrow{x}=c_1 e^{2t}\binom21+c_2 e^{-t}\binom12$。$A=\begin{pmatrix}3&1\\1&3\end{pmatrix}$，$\lambda=4,2$，$\overrightarrow{x}=c_1 e^{4t}\binom11+c_2 e^{2t}\binom1{-1}$。

\subsection{重特征值}
$\lambda$ 重根，几何重数不足：$(A-\lambda I)p_2=p_1$。解 $c_1 e^{\lambda t}p_1+c_2 e^{\lambda t}(tp_1+p_2)$。

验证：$\widetilde{x}=(tp_1+p_2)e^{\lambda t}$，$\widetilde{x}'=p_1 e^{\lambda t}+\lambda(tp_1+p_2)e^{\lambda t}=(A-\lambda I)p_2 e^{\lambda t}+(\lambda tp_1+\lambda p_2)e^{\lambda t}=A\widetilde{x}$。

例：$A=\begin{pmatrix}6&4\\-1&2\end{pmatrix}$，$\lambda=4$（重根），$p_1=(2,-1)^T$。

\subsection{非齐次系统}
$\overrightarrow{x}'=A\overrightarrow{x}+\overrightarrow{b}$。通解 $=e^{At}\overrightarrow{x}_0+e^{At}\int_0^t e^{-A\tau}\overrightarrow{b}d\tau$。注：$e^A e^B\neq e^{A+B}$（$AB\neq BA$ 时）。
\begin{flushright}\small $\square$ 第十五章完\end{flushright}

