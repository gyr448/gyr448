\chapter{第一型曲面积分}
\begin{flushright}\small 日期：5月29日\quad 原 Class 36\end{flushright}

\section{第一型曲面积分（对面积的积分）}
曲面参数化 $\overrightarrow{r}(u,v)$。面积微元 $d\sigma=\|\overrightarrow{r}_u\times\overrightarrow{r}_v\|du dv$。$\iint_S f\,d\sigma=\iint_D f(\overrightarrow{r}(u,v))\|\overrightarrow{r}_u\times\overrightarrow{r}_v\|du dv$。

显式 $z=f(x,y)$：$S$ 参数化为 $(x,y,f(x,y))$。$\overrightarrow{r}_x=(1,0,f_x)$，$\overrightarrow{r}_y=(0,1,f_y)$。$\|\overrightarrow{r}_x\times\overrightarrow{r}_y\|=\sqrt{1+f_x^2+f_y^2}$。$\iint_S g\,d\sigma=\iint_D g(x,y,f(x,y))\sqrt{1+f_x^2+f_y^2}dxdy$。

\begin{example}[球面面积]
$x=a\cos\theta\cos\varphi,y=a\cos\theta\sin\varphi,z=a\sin\theta$。$\overrightarrow{r}_\theta=(-a\sin\theta\cos\varphi,-a\sin\theta\sin\varphi,a\cos\theta)$，$\overrightarrow{r}_\varphi=(-a\cos\theta\sin\varphi,a\cos\theta\cos\varphi,0)$。$\|\overrightarrow{r}_\theta\times\overrightarrow{r}_\varphi\|=a^2\cos\theta$。面积 $=\int_{-\pi/2}^{\pi/2}\int_0^{2\pi}a^2\cos\theta d\varphi d\theta=4\pi a^2$。
\end{example}

\begin{example}[锥面 $z=\sqrt{x^2+y^2}$ 被柱面 $x^2+y^2=2ax$ 割下部分的面积]
$z_x=x/\sqrt{x^2+y^2},z_y=y/\sqrt{x^2+y^2}$。$\sqrt{1+z_x^2+z_y^2}=\sqrt{2}$。$D:$ $(x-a)^2+y^2\le a^2$。面积 $=\iint_D\sqrt{2}dxdy=\sqrt{2}\pi a^2$。
\end{example}

\section{第二型曲线积分（对坐标的积分）}
$\int_\Gamma\overrightarrow{F}\cdot d\overrightarrow{r}=\int_\Gamma F^{(x)}dx+F^{(y)}dy+F^{(z)}dz$。$d\overrightarrow{r}=(dx,dy,dz)=\overrightarrow{r}'(t)dt$。计算 $\int_\alpha^\beta(F^{(x)}x'+F^{(y)}y'+F^{(z)}z')dt$。

与第一型关系：$\int_\Gamma\overrightarrow{F}\cdot d\overrightarrow{r}=\int_\Gamma(\overrightarrow{F}\cdot\overrightarrow{T})ds$（$\overrightarrow{T}=d\overrightarrow{r}/ds$ 为单位切向量）。反向路径：$\int_{-\Gamma}=-\int_\Gamma$。

\begin{example}[椭圆面积]
$A=\frac12\oint_{\partial D}(xdy-ydx)$。对 $\frac{x^2}{a^2}+\frac{y^2}{b^2}=1$：$x=a\cos t,y=b\sin t$。$A=\frac12\int_0^{2\pi}(ab\cos^2 t+ab\sin^2 t)dt=\pi ab$。
\end{example}

\begin{example}[圆柱螺线]
$\overrightarrow{r}=(a\cos t,a\sin t,bt),t\in[0,2\pi]$。$\overrightarrow{F}=(x,y,z)$。$\int\overrightarrow{F}\cdot d\overrightarrow{r}=\int_0^{2\pi}(-a^2\cos t\sin t+a^2\sin t\cos t+b^2 t)dt=2\pi^2 b^2$。

法二：$d\overrightarrow{r}=(dx,dy,dz)$，被积 $xdx+ydy+zdz=\frac12 d(x^2+y^2+z^2)$，积分 $=\frac12[(a^2+4\pi^2 b^2)-(a^2)]=2\pi^2 b^2$。
\end{example}

\begin{flushright}\small $\square$ 第三十二章完\end{flushright}

