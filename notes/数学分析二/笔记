\chapter{曲线曲面积分习题}
\begin{flushright}\small 原 Class 38（6.3习题课）\end{flushright}

\begin{example}[球上 $\iiint_{x^2+y^2+z^2\le1}f(ax+by+cz)dxdydz=\pi\int_{-1}^1(1-u^2)f(ku)du$]
$k=\sqrt{a^2+b^2+c^2}$。设 $z'$ 轴沿 $(a,b,c)$ 方向。$ax+by+cz=kz'$。新坐标系下积分 $=\iiint_{x'^2+y'^2+z'^2\le1}f(kz')dx'dy'dz'=\int_{-1}^1\pi(1-z'^2)f(kz')dz'$。
\end{example}

\begin{example}[$\oint_C x^2 ds$，$C$ 为 $x^2+y^2+z^2=R^2,x+y+z=0$]
由对称性 $x,y,z$ 地位等同：$\oint x^2 ds=\oint y^2 ds=\oint z^2 ds$。$\oint(x^2+y^2+z^2)ds=R^2\oint ds=R^2\cdot2\pi R=2\pi R^3$。$\therefore\oint x^2 ds=\frac{2\pi R^3}{3}$。
\end{example}

\begin{example}[$\int_\Gamma y^2dx+z^2dy+x^2dz$，$\Gamma$ 为 $x^2+y^2+z^2=a^2,x^2+y^2=ax(z>0)$]
$r^2=ar\cos\theta$。$z^2=a^2-r^2=a^2\sin^2\theta$。参数化：$x=a\cos^2\theta,y=a\sin\theta\cos\theta,z=a\sin\theta$（$z>0$）。代入计算。
\end{example}

\begin{example}[锥面 $z=\sqrt{x^2+y^2}$ 被柱面 $x^2+y^2=2ax$ 割下部分的曲面积分]
$\iint(x^2y^2+y^2z^2+z^2x^2)dS$。$z_x=x/\sqrt{x^2+y^2},z_y=y/\sqrt{x^2+y^2}$。$\sqrt{1+z_x^2+z_y^2}=\sqrt{2}$。$D:(x-a)^2+y^2\le a^2$。$x^2y^2+(x^2+y^2)^2=x^4+3x^2y^2+y^4$。积分 $=\sqrt{2}\iint_D(x^4+3x^2y^2+y^4)dxdy=\frac{9}{8}\sqrt{2}\pi a^6$。
\end{example}

\begin{flushright}\small $\square$ 第三十四章完\end{flushright}

