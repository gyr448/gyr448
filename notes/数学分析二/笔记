\chapter{变量替换应用与第一型曲线积分}
\begin{flushright}\small 日期：5月27日\quad 原 Class 34\end{flushright}

\section{变量替换典型例题}

\begin{example}[菱形区域上的积分]
$E=\{(x,y):|x|+|y|\le1\}$。令 $u=x+y,v=x-y$，$x=\frac{u+v}{2},y=\frac{u-v}{2}$。$|\frac{\partial(x,y)}{\partial(u,v)}|=\frac12$。$E$ 变为 $[-1,1]\times[-1,1]$。$\iint_E f(x+y)dxdy=\int_{-1}^1 f(u)du\int_{-1}^1\frac12 dv=\int_{-1}^1 f(u)du$。
\end{example}

\begin{example}[双曲线围成的区域面积]
$E$ 由 $xy=a,xy=b$（$0<a<b$）和 $y=px,y=qx$（$0<p<q$）围成。令 $u=xy,v=y/x$。$|\frac{\partial(u,v)}{\partial(x,y)}|=\bigl|\begin{smallmatrix}y&x\\-y/x^2&1/x\end{smallmatrix}\bigr|=2y/x=2v$。$\operatorname{Vol}(E)=\int_a^b du\int_p^q\frac{dv}{2v}=\frac{b-a}{2}\ln\frac{q}{p}$。
\end{example}

\section{Gauss 积分与极坐标}
$I=\int_{-\infty}^{+\infty}e^{-x^2}dx=\sqrt{\pi}$。计算：$I^2=\int_{-\infty}^{+\infty}e^{-x^2}dx\int_{-\infty}^{+\infty}e^{-y^2}dy=\iint_{\mathbb{R}^2}e^{-(x^2+y^2)}dxdy$。极坐标：$=\lim_{a\to\infty}\int_0^a\int_0^{2\pi}e^{-r^2}r\,dr d\theta=2\pi\cdot\frac12=\pi$。$\therefore I=\sqrt{\pi}$。

夹逼：$\iint_{x^2+y^2\le a^2}e^{-r^2}rdrd\theta=\pi(1-e^{-a^2})\le I(a)\le\iint_{x^2+y^2\le2a^2}=\pi(1-e^{-2a^2})\to\pi$。

\begin{center}\includegraphics[width=0.2\textwidth]{images/107_1188_937_379_285_0.jpg}\end{center}

\section{球坐标与 $n$ 维球体积}
球坐标（$\mathbb{R}^3$）：$x=r\cos\theta\cos\varphi,y=r\cos\theta\sin\varphi,z=r\sin\theta$。Jacobi $=r^2\cos\theta$。

\begin{center}\includegraphics[width=0.3\textwidth]{images/107_170_1724_486_331_0.jpg}\end{center}

$n$ 维球 $E_n(a):x_1^2+\cdots+x_n^2\le a^2$。体积 $V_n(a)=C_n a^n$。递推：
\begin{align*}
V_n(a)&=\iint_{x_1^2+x_2^2\le a^2}dx_1dx_2\int_{x_3^2+\cdots+x_n^2\le a^2-x_1^2-x_2^2}dx_3\cdots dx_n\\
&=\iint_{x_1^2+x_2^2\le a^2}C_{n-2}(a^2-x_1^2-x_2^2)^{\frac{n-2}{2}}dx_1dx_2\\
&\stackrel{\text{极坐标}}{=}\int_0^a\int_0^{2\pi}C_{n-2}(a^2-r^2)^{\frac{n-2}{2}}r\,dr d\theta
=\pi C_{n-2}\cdot\frac{2}{n}a^n.
\end{align*}
故 $C_n=\frac{2\pi}{n}C_{n-2}$。$C_1=2,C_2=\pi$。递推：$C_3=\frac{4}{3}\pi,C_4=\frac{\pi^2}{2}$。

\section{第一型曲线积分（对弧长的积分）}

\subsection{可求长曲线}
$\overrightarrow{r}(t),t\in[\alpha,\beta]$。分割 $\pi=\{t_0=\alpha,\dots,t_N=\beta\}$。折线长 $\lambda(r,\pi)=\sum\|\overrightarrow{r}(t_i)-\overrightarrow{r}(t_{i-1})\|$。弧长 $L=\sup_\pi\lambda(r,\pi)$。若 $L<\infty$ 称曲线可求长。

若 $r\in C^1$：$L=\int_\alpha^\beta\|\overrightarrow{r}'(t)\|dt$（$\|\overrightarrow{r}'(t)\|=\frac{ds}{dt}$）。

\subsection{第一型曲线积分}
$f$ 定义在曲线 $\Gamma$ 上。分割 $\pi$，介点 $\xi_i\in[t_{i-1},t_i]$。$\Delta s_i\approx\|\overrightarrow{r}'(t_i)\|\Delta t_i$。
\[
\int_\Gamma f\,ds=\lim_{\|\pi\|\to0}\sum f(\overrightarrow{r}(\xi_i))\|\overrightarrow{r}(t_i)-\overrightarrow{r}(t_{i-1})\|
=\int_\alpha^\beta f(\overrightarrow{r}(t))\|\overrightarrow{r}'(t)\|dt.
\]

\begin{example}[圆柱螺线质量]
$x=a\cos t,y=a\sin t,z=bt$。$\|\overrightarrow{r}'\|=\sqrt{a^2+b^2}$。线密度 $\rho(t)$，总质量 $m=\int_0^T\rho(t)\sqrt{a^2+b^2}dt$。
\end{example}

\section{曲面积分预备：面积元}
曲面 $\overrightarrow{r}(u,v)$。面积微元 $d\sigma=\|\overrightarrow{r}_u\times\overrightarrow{r}_v\|du dv$。$\overrightarrow{r}_u\times\overrightarrow{r}_v=(\frac{\partial(y,z)}{\partial(u,v)},\frac{\partial(z,x)}{\partial(u,v)},\frac{\partial(x,y)}{\partial(u,v)})$。$d\sigma=\sqrt{(\frac{\partial(y,z)}{\partial(u,v)})^2+(\frac{\partial(z,x)}{\partial(u,v)})^2+(\frac{\partial(x,y)}{\partial(u,v)})^2}du dv$。

第一型曲面积分：$\iint_S f\,d\sigma=\iint_D f(\overrightarrow{r}(u,v))\|\overrightarrow{r}_u\times\overrightarrow{r}_v\|du dv$。

\begin{flushright}\small $\square$ 第三十章完\end{flushright}

