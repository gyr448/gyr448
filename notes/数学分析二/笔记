\chapter{链式法则与复合函数微分}
\begin{flushright}\small 原 Class 15\end{flushright}

\section{链式法则}
\subsection{一元复合多元}$\mathbb{R}\xrightarrow{\varphi}\mathbb{R}^m\xrightarrow{f}\mathbb{R}$：$\frac{d}{dt}(f\circ\varphi)=\sum\frac{\partial f}{\partial x^i}\frac{d\varphi^i}{dt}=\nabla f\cdot\varphi'$。若 $\varphi(t)=x_0+t\overrightarrow{e}$：$\frac{d}{dt}(f\circ\varphi)=\overrightarrow{e}\cdot\nabla f$（方向导数）。
\begin{proof}$f(\varphi(t+\Delta t))-f(\varphi(t))=\sum\frac{\partial f}{\partial x^i}(\varphi^i(t+\Delta t)-\varphi^i(t))+o(\|\Delta\varphi\|)$。$\varphi^i(t+\Delta t)-\varphi^i(t)=\frac{d\varphi^i}{dt}\Delta t+o(\Delta t)$。代入得 $(\sum\frac{\partial f}{\partial x^i}\frac{d\varphi^i}{dt})\Delta t+o(\Delta t)$。\end{proof}

\subsection{一般情形——Jacobi 矩阵}
$\mathbb{R}^n\xrightarrow{\varphi}\mathbb{R}^m\xrightarrow{f}\mathbb{R}^p$：$D(f\circ\varphi)=Df\cdot D\varphi$。分量形式 $\frac{\partial y^i}{\partial t^j}=\sum_k\frac{\partial y^i}{\partial x^k}\frac{\partial x^k}{\partial t^j}$。

\section{微分的运算性质}
$df=\sum\frac{\partial f}{\partial x^i}dx^i$。线性：$d(\lambda f+\mu g)=\lambda df+\mu dg$。Leibniz：$d(fg)=f dg+g df$。\textbf{一阶微分形式不变性：}无论 $x^i$ 是自变量还是中间变量，$df$ 形式不变。复合验证：$dx^i=\sum\frac{\partial\varphi^i}{\partial t^j}dt^j$，$dy^i=\sum\frac{\partial f^i}{\partial x^k}dx^k$，代入得 $dy^i=\sum\frac{\partial y^i}{\partial t^j}dt^j$。

\section{极坐标变换}
$\begin{cases}x=r\cos\theta\\y=r\sin\theta\end{cases}$。$\frac{\partial f}{\partial r}=\cos\theta f_x+\sin\theta f_y$，$\frac{\partial f}{\partial\theta}=-r\sin\theta f_x+r\cos\theta f_y$。矩阵：$(\frac{\partial f}{\partial r}\,\frac{\partial f}{\partial\theta})=(f_x\,f_y)\begin{pmatrix}\cos\theta&-r\sin\theta\\\sin\theta&r\cos\theta\end{pmatrix}$。微分形式不变：$df=f_x dx+f_y dy=f_r dr+f_\theta d\theta$。例：$f=x^2+y^2=r^2$，$f_r=2r,f_\theta=0$。
\begin{example}[仿射变换]$\begin{cases}x=p\\y=p+q\end{cases}$。$\frac{\partial f}{\partial p}=f_x+f_y$，$f_q=f_y$。微分验证：$df=f_x dp+f_y(dp+dq)=(f_x+f_y)dp+f_y dq$。\end{example}
\begin{flushright}\small $\square$ 第十四章完\end{flushright}

