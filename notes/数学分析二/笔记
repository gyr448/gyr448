\chapter{曲线与区域习题}
\begin{flushright}\small 原 Class 32（5.20习题课）\end{flushright}

\section{曲率挠率习题}

\begin{problem}[曲率挠率成比例 $\iff$ 切向量与某常向量成定角]
证 $\kappa/\tau=\text{const}\iff\exists$ 常向量 $\vec{a}$ 使 $\vec{a}\cdot\overrightarrow{T}=\text{const}$。
\end{problem}

\begin{proof}
($\Leftarrow$) $\vec{a}\cdot\overrightarrow{r}'=c$。求导：$\vec{a}\cdot\overrightarrow{r}''=0\Rightarrow\vec{a}\cdot\kappa\overrightarrow{N}=0\Rightarrow\vec{a}\perp\overrightarrow{N}$。故 $\vec{a}=\alpha_1\overrightarrow{T}+\alpha_3\overrightarrow{B}$。再求导：$\frac{d\vec{a}}{ds}=(\alpha_1'\overrightarrow{T}+\alpha_1\kappa\overrightarrow{N})+(\alpha_3'\overrightarrow{B}-\alpha_3\tau\overrightarrow{N})=0$。$\overrightarrow{N}$ 分量：$\alpha_1\kappa-\alpha_3\tau=0\Rightarrow\frac{\kappa}{\tau}=\frac{\alpha_3}{\alpha_1}$（常数）。同时 $\alpha_1'=\alpha_3'=0\Rightarrow\alpha_1,\alpha_3$ 常数。

($\Rightarrow$) 若 $\kappa/\tau=a$，取 $\vec{a}=\overrightarrow{T}+a\overrightarrow{B}$。$\frac{d\vec{a}}{ds}=(\kappa\overrightarrow{N})+a(-\tau\overrightarrow{N})=(\kappa-a\tau)\overrightarrow{N}=0$。$\therefore\vec{a}=\text{const}$，且 $\vec{a}\cdot\overrightarrow{T}=1$（定角）。
\end{proof}

\section{区域描述与重积分习题}

\begin{example}[区域的多种描述]
$D=\{(x,y):2y\le x^2+y^2\le4y,x\ge0\}$（两圆之间的月牙形区域）。

$y$ 型：分两段。$D_1=\{0\le y\le2,\sqrt{2y-y^2}\le x\le\sqrt{4y-y^2}\}$，$D_2=\{2\le y\le4,0\le x\le\sqrt{4y-y^2}\}$。

$x$ 型：$0\le x\le1$ 时 $2-\sqrt{4-x^2}\le y\le2+\sqrt{4-x^2}$；$1\le x\le2$ 时 $1+\sqrt{1-x^2}\le y\le2+\sqrt{4-x^2}$。

$\theta$ 型（极坐标）：$x=r\cos\theta,y=r\sin\theta$。$2r\sin\theta\le r^2\le4r\sin\theta\Rightarrow2\sin\theta\le r\le4\sin\theta$，$r\cos\theta\ge0\Rightarrow0\le\theta\le\frac\pi2$。
\end{example}

\begin{center}\includegraphics[width=0.5\textwidth]{images/103_964_721_704_411_0.jpg}\end{center}

\begin{example}[仅在有限个点间断的函数可积]
$f(x,y)=\sin\frac1{(x^2-1)^2+(y^2-1)^2}$ 在 $[-1,1]^2$ 上。仅在 $(\pm1,\pm1)$ 四点处未定义（间断）。定义 $f$ 在那些点任意取值，间断点集为零测集，故 $f\in R(Q)$。

$f(x,y)=\arctan\frac1{y-x^2}$ 在 $[0,1]^2$ 上。仅在抛物线 $y=x^2$ 上无定义。该曲线为零测集（连续函数图像），故 $f\in R(Q)$。重积分 $I_1$ 存在，但累次积分 $I_2$ 不一定存在（沿 $x$ 方向每个 $x$ 处内层积分在 $y=x^2$ 发散）。$f$ 连续时 $I_1=I_2$。
\end{example}

\begin{example}[$\iint_{[0,1]^2}\frac{y\,dxdy}{(1+x^2+y^2)^{3/2}}$]
\begin{align*}
I&=\frac12\int_0^1 dx\int_0^1\frac{d(y^2)}{(1+x^2+y^2)^{3/2}}
=\frac12\int_0^1 dx\Bigl[-2(1+x^2+y^2)^{-1/2}\Bigr]_{y=0}^{y=1}\\
&=-\int_0^1\Bigl(\frac1{\sqrt{2+x^2}}-\frac1{\sqrt{1+x^2}}\Bigr)dx
=\ln\frac{1+\sqrt2}{1}-\ln\frac{1+\sqrt3}{\sqrt2}.
\end{align*}
\end{example}

\section{常用积分公式}
$\int\csc x\,dx=\ln|\csc x-\cot x|+C$。$\int\frac{dx}{a^2+x^2}=\frac1a\arctan\frac{x}{a}+C$。$\int\frac{dx}{\sqrt{a^2-x^2}}=\arcsin\frac{x}{a}+C$。$\int\frac{dx}{x^2-a^2}=\frac1{2a}\ln|\frac{x-a}{x+a}|+C$。$\int\frac{dx}{\sqrt{x^2\pm a^2}}=\ln|x+\sqrt{x^2\pm a^2}|+C$。$\int\sqrt{a^2-x^2}dx=\frac{x}2\sqrt{a^2-x^2}+\frac{a^2}2\arcsin\frac{x}{a}+C$。

\begin{flushright}\small $\square$ 第二十八章完\end{flushright}

