\chapter{多元函数的可微性}
\begin{flushright}\small 日期：4月3日\quad 原 Class 14\end{flushright}

\section{偏导数与方向导数}
\begin{example}[$f(x,y)=x^2+y^2\sin x$]
$\frac{\partial f}{\partial x}=\frac{d}{dt}\big|_{t=0}((x+t)^2+y^2\sin(x+t))=2x+y^2\cos x$（$y$ 视为参数）。$\frac{\partial f}{\partial y}=2y\sin x$。方向导数 $\overrightarrow{e}=(\cos\theta,\sin\theta)$：$\frac{\partial f}{\partial\overrightarrow{e}}=\cos\theta(2x+y^2\cos x)+\sin\theta(2y\sin x)=\nabla f\cdot\overrightarrow{e}$。
\end{example}

\begin{example}[偏导数存在但不可微]
$f(x,y)=\begin{cases}0,&y=0\text{ 或 }x=0\\x,&\text{其他}\end{cases}$。在 $(0,0)$ 处 $f_x=f_y=0$。但对 $\overrightarrow{e}=(\cos\theta,\sin\theta)$，$\frac{\partial f}{\partial\overrightarrow{e}}=\cos\theta\neq\nabla f\cdot\overrightarrow{e}=0$。故不可微。
\end{example}

\section{可微性定义}
\begin{definition}$f:\mathbb{R}^m\to\mathbb{R}$ 在 $x$ 可微：$\exists$ 线性 $L(x):\mathbb{R}^m\to\mathbb{R}$ 使 $f(x+h)=f(x)+L(x)h+o(\|h\|)$。$L(x)h=\sum A^i(x)h^i$。全微分 $Df(x)$ 或 $df(x)$。\end{definition}
关于 $o(\|h\|)$：$\varphi=o(\sqrt{x^2+y^2})$ 可表 $\varepsilon\sqrt{x^2+y^2}$（$\varepsilon\to0$），进一步 $\alpha x+\beta y$（$|\alpha|,|\beta|\le|\varepsilon|\to0$）。高阶小量可写成分量的高阶小量。

\section{可微 $\Rightarrow$ 连续，可方向导，可偏导}
(1) $\lim f(x+h)=f(x)+\lim(Lh+o(\|h\|))=f(x)$。(2) $h=t\overrightarrow{e}$：$\frac{f(x_0+t\overrightarrow{e})-f(x_0)}{t}\to L(x_0)(\overrightarrow{e})$。取 $\overrightarrow{e}=e_i$ 得 $\frac{\partial f}{\partial x_i}=A^i$。(3) 可方向导 $\Rightarrow$ 可偏导。(4) 可偏导 $\nRightarrow$ 连续。

\section{偏导数连续 $\Rightarrow$ 可微}
\begin{theorem}$f$ 在 $x_0$ 邻域偏导数存在且至少一个在 $x_0$ 连续，则 $f$ 在 $x_0$ 可微。\end{theorem}
\begin{proof}[$\mathbb{R}^2$ 情形]
\begin{align*}
f(x_0+h,y_0+k)-f(x_0,y_0)&=[f(x_0+h,y_0+k)-f(x_0+h,y_0)]+[f(x_0+h,y_0)-f(x_0,y_0)]\\
&=f_y(x_0+h,y_0)k+o(k)+f_x(x_0,y_0)h+o(h).
\end{align*}
$f_y$ 在 $(x_0,y_0)$ 连续：$f_y(x_0+h,y_0)=f_y(x_0,y_0)+g(h),\lim g=0$。代入得 $f_x h+f_y k+g(h)k+o(k)+o(h)$，$g(h)k=o(\|(h,k)\|)$。线性部分 $+o$。\end{proof}
若所有偏导数存在且连续，称 $f\in C^1(\Omega)$（连续可微）。

\section{微分的几何意义}
$z=f(x,y)$ 在 $(x_0,y_0,z_0)$ 切平面：$z-z_0=f_x(x_0,y_0)(x-x_0)+f_y(x_0,y_0)(y-y_0)$。法向量 $(f_x,f_y,-1)$。
\begin{flushright}\small $\square$ 第十三章完\quad（期中：至复合函数偏导数、全微分）\end{flushright}

