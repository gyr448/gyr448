\chapter{拓扑习题课}
\begin{flushright}\small 原 Class 13（习题课）\end{flushright}

\section{拓扑概念速查}
邻域 $O_\delta(x)=\{y:\|y-x\|<\delta\}$。内点：$\exists\delta,O_\delta(x)\subset S$。外点：$\exists\delta,O_\delta(x)\cap S=\varnothing$。边界点：$\forall\delta,O_\delta(x)\cap S\neq\varnothing$ 且 $O_\delta(x)\cap S^c\neq\varnothing$。聚点 $S'$：$\forall\delta,\overset{\circ}{O}_\delta(x)\cap S\neq\varnothing$。孤立点：$\exists\delta,O_\delta(x)\cap S=\{x\}$。开集：$\operatorname{int}S=S$。闭集：闭包 $\overline{S}=S\cup S'$。紧集：任意开覆盖有有限子覆盖。$\mathbb{R}^m$ 中紧致 $\iff$ 有界闭。连续函数在紧集上：有界、取最值、一致连续；在连通集上：介值性。

\section{典型例题}

\begin{example}[$\{m+n\sqrt{2}:m,n\in\mathbb{Z}\}=S$ 在 $\mathbb{R}$ 中稠密]
$\{n\sqrt{2}\bmod1\}_{n\in\mathbb{Z}}\subset[0,1)$。$\sqrt{2}$ 无理 $\Rightarrow n_1\neq n_2$ 时 $n_1\sqrt{2}\not\equiv n_2\sqrt{2}\pmod1$。Dirichlet 逼近：$\forall\varepsilon>0,\exists m$ 使 $m\sqrt{2}\bmod1<\varepsilon$。于是在任意 $(a,b)\subset[0,1]$ 内存在 $\{n\sqrt{2}\}$ 的分数部分。故 $\overline{S}=\mathbb{R}$。对比 $\{m+n\sqrt{3}\}=S'$，$S\neq S'$ 但均稠密（$\operatorname{int}S=\varnothing$，$\overline{S}=\mathbb{R}$）。
\end{example}

\begin{example}[$\max$ 函数的连续性]
设 $f\in C([a,b]\times[a,b])$。$\varphi(x)=\max_{a\le\xi\le x}\max_{a\le y\le\xi}f(\xi,y)$。证 $\varphi\in C[a,b]$。
\begin{center}\includegraphics[width=0.3\textwidth]{images/42_1191_427_460_345_0.jpg}\end{center}
法一（直接）：对 $\Delta x>0$，若 max 在 $x\le\xi\le x+\Delta x$ 达到，取 $y(\Delta x)$：$\varphi(x+\Delta x)-\varphi(x)\le f(x+\Delta x,y(\Delta x))-f(x,y(\Delta x))\to0$。
\begin{center}\includegraphics[width=0.2\textwidth]{images/42_1409_777_218_303_0.jpg}\end{center}
法二（一致连续）：$f$ 在紧集上一致连续，可证 $|\varphi(x+\Delta x)-\varphi(x)|<\varepsilon$（$\Delta x$ 充分小）。
\end{example}

\begin{example}[Gram 矩阵与线性相关性]
$f_1,\dots,f_n\in C[0,1]$。Gram 矩阵 $A=(a_{ij})_{n\times n}$，$a_{ij}=\int_0^1 f_i f_j$。$\{f_i\}$ 线性相关 $\iff\det A=0$。
\begin{proof}($\Rightarrow$)$\exists c\neq0,\sum c_j f_j\equiv0$。$\sum_j a_{ij}c_j=\int f_i\sum c_j f_j=0$，$Ac=0$，$\det A=0$。($\Leftarrow$)$\det A=0\Rightarrow\exists c\neq0,Ac=0$。$S_i=\int f_i\sum c_j f_j=0$。$\sum c_i S_i=\int(\sum c_i f_i)^2=0\Rightarrow\sum c_i f_i\equiv0$。\end{proof}
\end{example}

\begin{example}[广义 Rayleigh 商]
$A,B$ 实对称，$B$ 正定。$G(x)=\frac{x^T Ax}{x^T Bx}$ 在 $\mathbb{R}^n\setminus\{0\}$ 上。(1) $G$ 在单位球面上取最值。(2) 最值点为 $B^{-1}A$ 的特征向量。$B=L^T L$，令 $y=Lx$，$G=\frac{y^T(L^{-1})^T AL^{-1}y}{y^T y}$ 化为标准 Rayleigh 商。
\end{example}

\begin{flushright}\small $\square$ 第十二章完\end{flushright}

