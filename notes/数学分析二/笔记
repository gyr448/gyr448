\chapter{广义积分的收敛判别法}
\begin{flushright}\small 日期：3月11日\quad 原 Class 5\end{flushright}

\section{无穷限积分的收敛判别}
\subsection{Cauchy 原理}$\int_a^{+\infty}f$ 收敛 $\iff\forall\varepsilon,\exists\Delta,\forall H_2\ge H_1>\Delta:|\int_{H_1}^{H_2}f|<\varepsilon$。

\subsection{比较判别法}$|f|\le g$ 且 $\int g$ 收敛 $\Rightarrow\int|f|$ 绝对收敛。绝对收敛 $\Rightarrow$ 收敛。条件收敛：$\int f$ 收敛但 $\int|f|$ 不收敛。

\subsection{极限比较} $g>0,\lim\frac{|f|}{g}=B$。$0<B<\infty$ 同敛散；$B=0$ 且 $\int g$ 收敛 $\Rightarrow\int|f|$ 收敛；$B=\infty$ 且 $\int g$ 发散 $\Rightarrow\int|f|$ 发散。

\subsection{$p$-判别法} $\lim x^p|f|=B$。$p>1,B<\infty$ 绝对收敛；$p\le1,B>0$ 不绝对收敛。

例：$\int_1^\infty\frac{\sin x}{x^{3/2}}$ 绝对收敛（$p=3/2$）。$\int_1^\infty x^m e^{-x}$ 绝对收敛（$p=2,B=0$）。$\int_1^\infty\frac{\arctan x}{x^p}$：$p\le1$ 不绝对收敛，$p>1$ 绝对收敛。

\subsection{Dirichlet判别法}$f\downarrow0$，$|\int g|$ 有界 $\Rightarrow\int fg$ 收敛。
\subsection{Abel判别法}$f$ 单调有界，$\int g$ 收敛 $\Rightarrow\int fg$ 收敛。

\begin{example}[$\int_1^\infty\frac{\sin x}{x}dx$ 条件收敛] 收敛（Dirichlet：$1/x\downarrow0,|\int\sin x|\le2$）。不绝对收敛：$|\frac{\sin x}{x}|\ge\frac{\sin^2 x}{x}=\frac1{2x}-\frac{\cos2x}{2x}$，前者发散，后者收敛。\end{example}

\section{瑕积分收敛判别}理论完全平行：Cauchy原理、比较、$p$-判别（$g=1/(x-a)^p$，$p<1$ 收敛）、Dirichlet/Abel。

\section{综合例题}
$\int_0^\infty\frac{\sin x}{x\sqrt{x}}dx$ 绝对收敛（拆分 $\int_0^1+\int_1^\infty$）。$\int_0^1\frac{\ln x}{1-x^2}dx$ 绝对收敛。Beta函数 $B(\alpha,\beta)$ 收敛域 $\alpha,\beta>0$。Gamma函数 $\Gamma(p)$ 收敛域 $p>0$。$\int_0^1\frac{\sin(1/x)}{x^p}dx$：换元 $t=1/x$，$p<1$ 绝对收敛，$1\le p<2$ 条件收敛，$p\ge2$ 发散。
\begin{flushright}\small $\square$ 第五章完\end{flushright}

