\chapter{重积分定义与Fubini定理}
\begin{flushright}\small 日期：5月15日\quad 原 Class 30\end{flushright}

\section{闭方块上的重积分}

\subsection{定义与分割}
$Q=[a^1,b^1]\times\cdots\times[a^m,b^m]\subset\mathbb{R}^m$。分割 $P^i=\{x_0^i=a^i,\dots,x_{n_i}^i=b^i\}$，$P=(P^1,\dots,P^m)$。小方块 $Q_I=\prod_{k=1}^m[x_{i_k-1}^k,x_{i_k}^k]$。体积 $\operatorname{Vol}(Q_I)=\prod_k(x_{i_k}^k-x_{i_k-1}^k)$。$\|P\|=\max_I\operatorname{diam}(Q_I)$。

Riemann和 $\sigma(f,P,\xi)=\sum_I f(\xi_I)\operatorname{Vol}(Q_I)$，$\xi_I\in Q_I$。若 $\lim_{\|P\|\to0}\sigma(f,P,\xi)$ 存在，称 $f$ 在 $Q$ 上 Riemann 可积，记 $f\in R(Q)$，$\int_Q f\,dx=\lim\sigma$。等价写法：$\int_Q f(x^1,\dots,x^m)dx^1\cdots dx^m$。

\subsection{连续函数必可积}
$f\in C(Q)\Rightarrow f$ 在紧集 $Q$ 上一致连续。$\forall\varepsilon>0,\exists\delta>0,\|x_1-x_2\|<\delta\Rightarrow|f(x_1)-f(x_2)|<\varepsilon$。取 $\|P\|<\delta/\sqrt{m}$，每个 $Q_I$ 直径 $<\delta$，振幅 $\omega_I<\varepsilon$。$\Omega=\sum\omega_I\operatorname{Vol}(Q_I)<\varepsilon\operatorname{Vol}(Q)\to0$。$\therefore f\in R(Q)$。

\subsection{零延拓}
$f:Q\to\mathbb{R}$。$\widetilde{f}(x)=\begin{cases}f(x),&x\in Q\\0,&x\in\widetilde{Q}\setminus Q\end{cases}$（$\widetilde{Q}$ 为包含 $Q$ 的方块）。$f\in R(Q)\iff\widetilde{f}\in R(\widetilde{Q})$。

证明思路：$(\Rightarrow)$ $f\in R(Q)\Rightarrow\forall\varepsilon,\exists P$ 使 $\Omega(f,P)<\varepsilon$。将 $P$ 扩充为 $\widetilde{P}$，新增方块上 $\widetilde{f}=0$，$\Omega=0$。总 $\Omega=\Omega(f,P)<\varepsilon$。$(\Leftarrow)$ 类似限制。

\subsection{基本性质}
若 $f\in R(Q)$：(1) $f$ 有界；(2) 线性 $\int_Q(\lambda f+\mu g)=\lambda\int_Q f+\mu\int_Q g$；(3) $f\le g\Rightarrow\int f\le\int g$；(4) 中值：$m\le f\le M\Rightarrow m\operatorname{Vol}(Q)\le\int_Q f\le M\operatorname{Vol}(Q)$。

若 $f\in C(Q)$ 且 $Q$ 连通，由连续性可取到 $m,M$ 且路径连通 $\Rightarrow\exists\xi\in Q,\int_Q f=f(\xi)\operatorname{Vol}(Q)$。

\section{Fubini 定理（化重积分为累次积分）}

\subsection{二维情形}
\begin{theorem}[Fubini]
$f(x,y)\in R([a,b]\times[c,d])$。若 $\forall x\in[a,b]$，$f(x,\cdot)\in R[c,d]$，则
\[
\iint_{[a,b]\times[c,d]}f(x,y)dxdy=\int_a^b dx\int_c^d f(x,y)dy.
\]
\end{theorem}

\begin{proof}对分割 $P_x=\{x_i\},P_y=\{y_j\}$，取介点 $z_i\in[x_{i-1},x_i]$。
\begin{align*}
\sum_i\Bigl(\int_c^d f(z_i,y)dy\Bigr)\Delta x_i
&=\sum_{i,j}\int_{y_{j-1}}^{y_j}f(z_i,y)dy\,\Delta x_i\\
&\stackrel{\text{中值}}{=}\sum_{i,j}\mu_{ij}\Delta y_j\Delta x_i,
\end{align*}
其中 $m_{ij}\le\mu_{ij}\le M_{ij}$。因此和式介于 $L(f,P),U(f,P)$ 之间。由 $f\in R(Q)$，$\lim(U-L)=0$。取 $\|P\|\to0$ 得左端 $\to\int_Q f$，右端（作为 $\|P_x\|\to0$ 的极限）$\to\int_a^b dx\int_c^d f dy$。\end{proof}

\textbf{高维推广：}$Q=V\times W$（$V\subset\mathbb{R}^m,W\subset\mathbb{R}^n$）。若 $\forall x\in V,\exists\int_W f(x,y)dy$，则 $\int_Q f=\int_V dx\int_W f\,dy$。

\subsection{重积分与累次积分未必等价}

\begin{example}[重积分不存在但累次积分存在]
$f(x,y)=\begin{cases}1,&x\in\mathbb{Q}\\2y,&x\notin\mathbb{Q}\end{cases}$ 在 $[0,1]^2$ 上。重积分：$\forall$ 划分 $\Omega\ge\frac12\cdot\frac14=\frac18>0$，$\therefore f\notin R(Q)$。但 $\int_0^1 f(x,y)dy=1$（$\forall x$），$\int_0^1 dx\int_0^1 f dy=1$。另一顺序 $\int_0^1 f(x,y)dx$ 不存在（Dirichlet 函数）。
\end{example}

\begin{example}[两个累次存在且相等，重积分仍不存在]
构造 $f(x,y)=\begin{cases}0,&x,y\in\mathbb{Q}\text{ 或 }x,y\notin\mathbb{Q}\\1,&x\in\mathbb{Q},y\notin\mathbb{Q}\\1,&y\in\mathbb{Q},x\notin\mathbb{Q}\end{cases}$。两个累次积分均存在但不相等（且实际计算 $\int dy\int dx\neq\int dx\int dy$）。重积分不存在。
\end{example}

\begin{flushright}\small $\square$ 第二十六章完\end{flushright}

