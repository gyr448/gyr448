\chapter{Sturm 定理与实根判定}

\section{Sturm 序列的定义}

\begin{definition}
三项式序列 $f_0(x), f_1(x), \ldots, f_m(x) \in \mathbb{R}[x]$ 称为 Sturm 序列，若它们满足以下 4 条性质：
\begin{enumerate}
  \item[(1)] $f_k(x) \; (0 \leq k \leq m)$ 都是非零多项式，且均无重根
  \item[(2)] $f_m(x)$ 是零次多项式，$f_m(x) = p \neq 0$
  \item[(3)] 在 $f_0$ 的实根 $c$ 处，$f_1(c) \neq 0$
  \item[(4)] 在 $f_k(x) \; (0 < k < m)$ 的实根 $c$ 处，$f_{k-1}(c) f_{k+1}(c) < 0$
\end{enumerate}
\end{definition}

\textbf{性质：}实数序列 $f_0(c), \ldots, f_m(c)$ 中没有两个连续的零。

\begin{definition}
设 $f_0(x), \ldots, f_m(x) \in \mathbb{R}[x]$ 为 Sturm 序列，
\begin{enumerate}
  \item[(1)] 若 $f_k(x) f_{k+1}(x) < 0 \; (0 \leq k < m)$，称序列有一个变号
  \item[(2)] 若 $a < b$，且 $f_0(x)$ 在 $[a, b]$ 的两端均不为零，则 $f_0(x)$ 在 $[a, b]$ 内根的个数由变号数之差确定
\end{enumerate}
\end{definition}

\subsection{由无重根的 $f(x)$ 生成 Sturm 序列}

\[
f_0(x) = f(x), \quad f_1(x) = f'(x), \quad f_{k-1}(x) = q_k(x) f_k(x) - f_{k+1}(x)
\]
即做带余除法 $f_{k-1} = q_k f_k + (-f_{k+1})$，将余式取负号作为下一项。

\subsection{次对角线全负的三对角矩阵生成的 Sturm 序列}

\[
\begin{bmatrix}
x - c_1 & b_1 & & \\
a_1 & x - c_2 & \ddots & \\
& \ddots & \ddots & 
\end{bmatrix}
\]

