\chapter{行列式计算技巧}

\section{特殊行列式}

\subsection{箭形行列式}

\[
D_n = \begin{vmatrix}
x_1 & b & b & \cdots & b \\
b & x_2 & b & \cdots & b \\
b & b & x_3 & \cdots & b \\
\vdots & \vdots & \vdots & \ddots & \vdots \\
b & b & b & \cdots & x_n
\end{vmatrix}
\]
每一行减第一行可得递推式。

\subsection{三对角行列式（递推法）}

\[
\begin{vmatrix}
x & b & b & \cdots & b \\
a & x & b & \cdots & b \\
a & a & x & \cdots & b \\
\vdots & \vdots & \vdots & \ddots & \vdots \\
a & a & a & \cdots & x
\end{vmatrix}
\]
可用递推法求解。

\subsection{循环矩阵行列式}

\[
\begin{vmatrix}
a_1 & a_2 & a_3 & \cdots & a_n \\
a_n & a_1 & a_2 & \cdots & a_{n-1} \\
a_{n-1} & a_n & a_1 & \cdots & a_{n-2} \\
\vdots & \vdots & \vdots & \ddots & \vdots \\
a_2 & a_3 & a_4 & \cdots & a_1
\end{vmatrix}
\]
利用 $n$ 次单位根 $+$ Vandermonde 矩阵求解。

\begin{figure}[h]
\centering
\includegraphics[max width=0.4\textwidth]{images/29_32_2190_620_142_0.jpg}
\end{figure}

\section{严格对角占优矩阵}

\begin{definition}
设 $A = (a_{ij}) \in P^{n \times n}$，若 $|a_{ii}| > \sum_{j \neq i}^{n} |a_{ij}| \; (i = 1, 2, \ldots, n)$，则 $\det A \neq 0$。
\end{definition}

\textbf{证明方法：}反证法/数学归纳法。令 $D = \operatorname{diag}(a_{11}, \ldots, a_{nn})$，$A(t)$ 仍严格对角占优。$f(t) = \det A(t)$ 在 $t \in [0, 1]$ 上连续且非零，故同号。

\section{广义 Vandermonde 行列式}

\[
\frac{d(\det A)}{dt} = \det A_1 + \det A_2 + \cdots + \det A_n
\]
其中 $A_i$ 为对 $A$ 的第 $i$ 行求导，其余行不变得到的矩阵。

