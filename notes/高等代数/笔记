\chapter{线性变换与不变子空间}

\section{线性变换的基本概念}

矩阵可对角化条件：$n$ 个线性无关的特征向量；几何重数 $=$ 代数重数。

特征多项式的系数是对应的主子式之和。特征向量非零。相同的特征多项式，两个矩阵不一定相似。

\begin{definition}
设 $A$ 为线性空间 $V/P$ 内的线性变换，$W$ 是 $V$ 的一个子空间。若 $A(W) \subseteq W$，则称 $W$ 为 $V$ 的一个 $A$ 的不变子空间。
\end{definition}

\textbf{对任意线性变换：}$\operatorname{Im}A$，$\ker A$，特征子空间是不变子空间。
\begin{itemize}
  \item $\forall \vec{\alpha} \in V_{\lambda}$，$A\vec{\alpha} = \lambda\vec{\alpha} \in V_{\lambda}$
  \item $\forall \vec{a} \in \ker A$，$A\vec{a} = \vec{0} \in \ker A$
  \item $\forall \vec{a} \in \operatorname{Im}A$，$A\vec{a} \in \operatorname{Im}A$
\end{itemize}

\section{可对角化与不变子空间}

\begin{proposition}
若 $n$ 维线性空间 $V$ 上线性变换 $A$ 的矩阵相似于对角矩阵，$W$ 是 $A$ 的一个不变子空间，则限制线性变换 $A|_W$ 的矩阵相似于对角矩阵。
\end{proposition}

\begin{theorem}[可对角化等价条件]
以下断言等价：
\begin{enumerate}
  \item[(1)] $A$ 在某组基下的矩阵为对角矩阵
  \item[(2)] $\dim V_i = k_i$（几何重数等于代数重数）
  \item[(3)] $V = \bigoplus V_{\lambda_i}$
\end{enumerate}
\end{theorem}

\section{不变子空间的性质}

\begin{itemize}
  \item $A|_W: W \rightarrow W$（限制变换）
  \item $A^k(W) \subseteq W$（$A$-子空间是 $A^k$-子空间，反过来未必）
  \item $f(A)W \subseteq W$
\end{itemize}

\textbf{不变子空间的基扩充：}
设 $\operatorname{span}(\vec{\varepsilon}_1, \ldots, \vec{\varepsilon}_m) = W$，$AW \subseteq W$，扩充到全空间：
\[
\operatorname{span}(\vec{\varepsilon}_1, \ldots, \vec{\varepsilon}_m, \vec{\varepsilon}_{m+1}, \ldots, \vec{\varepsilon}_n) = V
\]
$A$ 在上述基下的矩阵为分块上三角：
\[
A(\vec{\varepsilon}_1, \ldots, \vec{\varepsilon}_n) = (\vec{\varepsilon}_1, \ldots, \vec{\varepsilon}_n) \begin{pmatrix} A_{11} & A_{12} \\ 0 & A_{22} \end{pmatrix}
\]

\textbf{诱导变换：}$\overline{A}: V/W \rightarrow V/W$，$\overline{A}(\overline{\vec{z}}_{m+1}, \ldots, \overline{\vec{z}}_n) = (\overline{\vec{z}}_{m+1}, \ldots, \overline{\vec{z}}_n) A_{22}$。

\subsection{主子式与子式}

\begin{itemize}
  \item \textbf{$k$ 阶主子式：}任选 $k$ 个行指标和相同的 $k$ 个列指标，交叉处元素按原顺序构成的 $k$ 阶子式
  \item \textbf{$k$ 阶顺序主子式：}选前 $k$ 行和前 $k$ 列
  \item \textbf{子式：}取 $k$ 行 $k$ 列交叉处元素组成的行列式
\end{itemize}

