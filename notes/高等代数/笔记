\chapter{商空间与线性映射}

\section{商空间}

\textbf{同余类性质：}
\begin{enumerate}
  \item[(1)] $\vec{a}' - \vec{a} \in W \Leftrightarrow \vec{a}' \in \vec{a} + W$
  \item[(2)] $\vec{a}' \in \vec{a} + W \Leftrightarrow \vec{a}' + W = \vec{a} + W$
  \item[(3)] $\vec{a} + W = \vec{0} + W \Leftrightarrow \vec{a} \in W$
  \item[(4)] 若 $\vec{a}' + W \neq \vec{a} + W$，则 $(\vec{a}' + W) \cap (\vec{a} + W) = \varnothing$
\end{enumerate}

\textbf{注：}$A\vec{x} = \vec{b}$ 有解时的解为特解 $+$ 齐次方程的通解。

\begin{proposition}
设 $V/P$ 是 $n$ 维线性空间，$W$ 是 $V$ 的一个 $m$ 维子空间，$W$ 的一组基为 $\vec{z}_1, \ldots, \vec{z}_m$，$W$ 的补空间 $U$ 的一组基向量为 $\vec{z}_{m+1}, \ldots, \vec{z}_n$，则 $\overline{\vec{z}}_{m+1}, \ldots, \overline{\vec{z}}_n$ 是 $V/W$ 的一组基。
\end{proposition}

\begin{theorem}
$\dim V = \dim W + \dim V/W$
\end{theorem}

\section{线性映射}

\subsection{单射、满射、双射}

\begin{itemize}
  \item \textbf{单射：} $\vec{a}_1 \neq \vec{a}_2 \Rightarrow \varphi(\vec{a}_1) \neq \varphi(\vec{a}_2)$，即 $\varphi(\vec{a}_1) = \varphi(\vec{a}_2) \Rightarrow \vec{a}_1 = \vec{a}_2$
  \item \textbf{满射：} $\forall \vec{\beta} \in B, \exists \vec{a} \in A$ s.t. $\varphi(\vec{a}) = \vec{\beta}$
  \item \textbf{双射：} 既单又满，存在逆映射
\end{itemize}

\textbf{线性映射的性质：}
\begin{itemize}
  \item $\vec{a}_1, \ldots, \vec{a}_m$ 线性相关 $\rightarrow$ $\varphi(\vec{a}_1), \ldots, \varphi(\vec{a}_m)$ 线性相关
  \item $\vec{a}_1, \ldots, \vec{a}_m$ 线性无关 $\xleftarrow{\text{单射}}$ $\varphi(\vec{a}_1), \ldots, \varphi(\vec{a}_m)$ 线性无关
\end{itemize}

\begin{proposition}
设 $\varphi: A \rightarrow B$。若存在 $\psi: B \rightarrow A$，s.t. $\psi \circ \varphi = \mathrm{id}_A$，则 $\varphi$ 是单射，$\psi$ 是满射（前像后单）。
\end{proposition}

\subsection{核与像}

\begin{definition}
$\ker\varphi = \{\vec{a} \in U \mid \varphi(\vec{a}) = 0\} = \varphi^{-1}(\vec{0})$

$\operatorname{im}\varphi = \{\vec{\beta} \in V \mid \exists \vec{\alpha} \in U, \varphi(\vec{\alpha}) = \vec{\beta}\} = \varphi(U)$

$\operatorname{coker}\varphi = V/\operatorname{im}\varphi$（$A\vec{x} = \vec{b}$ 中无解的情况）
\end{definition}

\begin{proposition}
$\dim\ker\varphi + \dim\operatorname{im}\varphi = \dim U$，$\varphi: U \rightarrow V$。
\end{proposition}

\section{同态基本定理与同构定理}

\begin{theorem}[同态基本定理]
设 $\varphi: U \rightarrow V$ 是线性映射，则映射 $C: \vec{d} + \ker\varphi \mapsto \varphi(\vec{d})$ 是 $U/\ker\varphi \rightarrow \operatorname{im}\varphi$ 的同构映射。
\end{theorem}

\begin{theorem}[第二同构定理]
设 $V_1, V_2$ 是线性空间 $V$ 的子空间，则
\[
V_1/(V_1 \cap V_2) \cong (V_1 + V_2)/V_2
\]
\end{theorem}

\begin{proof}
考虑 $\varphi: V_1 \rightarrow (V_1 + V_2)/V_2$，$\varphi(\vec{x}) = \vec{x} + V_2$。满射，$\ker\varphi = V_1 \cap V_2$。
\end{proof}

\begin{theorem}[第一同构定理]
设 $f: U \rightarrow V$ 是线性同态映射，$W$ 是 $V$ 的子空间，则
\[
U/f^{-1}(W) \cong V/W
\]
\end{theorem}

