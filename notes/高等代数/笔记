\chapter{Jordan 标准形与双线性函数初步}

\section{初等因子与 Jordan 块的对应}

每个初等因子对应一个 Jordan 块。

\textbf{Jordan 块的 $\lambda$-矩阵变换示例：}
\[
\begin{pmatrix} 2 & 1 & 1 \\ & 2 & 1 \\ & & 2 \end{pmatrix} \rightarrow
\begin{pmatrix} \lambda-2 & -1 & -1 \\ & \lambda-2 & -1 \\ & & \lambda-2 \end{pmatrix} \rightarrow
\begin{pmatrix} 1 & & \\ & 1 & \\ & & (\lambda-2)^3 \end{pmatrix}
\]
初等因子为 $(\lambda-2)^3$，对应一个 $3$ 阶 Jordan 块。

\[
\begin{pmatrix} (\lambda-1)^4 \\ (\lambda-2)^3 \end{pmatrix} \rightarrow
\begin{pmatrix} 1 & \\ & (\lambda-1)^4(\lambda-2)^3 \end{pmatrix}
\]

\section{Frobenius 有理标准形}

\begin{proposition}
$P^{n \times n}$ 上的 $A$ 与唯一的有理标准形矩阵相似。
\end{proposition}

Frobenius 有理标准形直接按最小多项式逐级分解（第二分解定理），没有前置的"不可约分解"。

有理标准形的每一块对应一个非零次不变因子的友阵：
\[
[E_{n-s}, d_1, d_2, \ldots, d_s] \rightarrow [H_1, H_2, \ldots, H_s]
\]

\section{第六章 双线性函数}

\subsection{对偶空间}

定义一组函数 $l_j: V \rightarrow P \; (j = 1, 2, \ldots, n)$，$l_j(\vec{z}_i) = \delta_{ij}$。任意一个线性映射可由 $l_j$ 表示，$l_j$ 线性无关。全体 $V$ 上的线性函数构成 $n$ 维线性空间，称为 $V$ 的对偶空间，记为 $V^*$。

\subsection{双线性函数}

\begin{definition}
双线性函数 $f: V \times V \rightarrow P$ 满足：
\begin{align*}
f(\vec{\alpha} + \vec{\gamma}, \vec{\beta}) &= f(\vec{\alpha}, \vec{\beta}) + f(\vec{\gamma}, \vec{\beta}) \\
f(k\vec{\alpha}, \vec{\beta}) &= k f(\vec{\alpha}, \vec{\beta}) \\
f(\vec{\alpha}, \vec{\beta} + \vec{\gamma}) &= f(\vec{\alpha}, \vec{\beta}) + f(\vec{\alpha}, \vec{\gamma}) \\
f(\vec{\alpha}, k\vec{\beta}) &= k f(\vec{\alpha}, \vec{\beta})
\end{align*}
\end{definition}

但 $f(\vec{\alpha}, \vec{\beta})$ 与 $f(\vec{\beta}, \vec{\alpha})$ 不一定相等。例如：$f = x_1 y_2 - y_1 x_2$（反对称）。

\textbf{度量矩阵：}$(f(\vec{z}_i, \vec{z}_j))$。取定一组基，双线性函数 $\Leftrightarrow$ 度量矩阵。

基变换下度量矩阵的变换：
\[
f(\alpha, \beta) = \vec{x}' A \vec{y} = (T\vec{x})' A (T\vec{y}) = \vec{x}' {T}' A T \vec{y}
\]
故 $A \rightarrow P^{\top} A P$（\textbf{相合}）。对比：$P^{-1}AP$（相似），$PAQ$（相抵）。

相合保持秩不变。定义 $\operatorname{rank}f = \operatorname{rank}A$。对称/反对称性在相合下不变。

\begin{proposition}
$f: V \times V \rightarrow P$ 是 $n$ 维空间 $V/P$ 上的双线性函数。定义线性映射 $\varphi: \vec{\alpha} \mapsto l^{(\alpha)}$，则 $\varphi$ 是单射 $\Leftrightarrow$ $f$ 非退化。
\end{proposition}

同维线性空间的映射是单射 $\rightarrow$ 是满射。

\begin{theorem}[Riesz 表示定理]
$f: V \times V \rightarrow P$ 为 $V/P$ 上的非退化双线性函数，存在唯一的从 $V^*$ 到 $V$ 的线性映射 $\sigma$，满足 $l(\vec{p}) = f(\sigma(l), \vec{p})$，$\forall \vec{p} \in V$。
\end{theorem}

