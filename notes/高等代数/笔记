\chapter{实正规矩阵与正交矩阵}

\section{实正规矩阵}

$A^H A = A A^H$。实正规矩阵包括：对称、反对称、正交。

正交矩阵特征值模为 $1$。$A^{\top} A \overline{\vec{x}} = \overline{\mu} A^{\top} \vec{x}$，$|\mu| = 1$。

\section{实正交矩阵的标准形}

\[
\operatorname{diag}\left\{ E_p, -E_q, \begin{pmatrix} \cos\theta_1 & \sin\theta_1 \\ -\sin\theta_1 & \cos\theta_1 \end{pmatrix}, \ldots, \begin{pmatrix} \cos\theta_t & \sin\theta_t \\ -\sin\theta_t & \cos\theta_t \end{pmatrix} \right\}
\]

\section{反对称变换}

$\forall \vec{\alpha}, \vec{\beta} \in V$，$(A\vec{\alpha}, \vec{\beta}) = -(\vec{\alpha}, A\vec{\beta})$。

$A$ 是反对称变换 $\Leftrightarrow$ $A$ 在标准正交基下的矩阵反对称。

奇数阶反对称矩阵行列式为 $0$：
\[
A^{\top} = -A, \quad \det A^{\top} = \det(-A) = (-1)^{2m+1} \det A = -\det A, \quad \det A = 0
\]

实反对称矩阵的特征值都是纯虚数或零。

\section{实对称 vs 反对称对比表}

\begin{center}
\begin{tabular}{|c|c|c|}
\hline
& 对称 & 反对称 \\
\hline
变换定义 & $(\mathcal{A}\alpha, \beta) = (\alpha, \mathcal{A}\beta)$ & $(\mathcal{A}\alpha, \beta) = -(\alpha, \mathcal{A}\beta)$ \\
\hline
正交基下的矩阵 & $A^{\top} = A$ & $A^{\top} = -A$ \\
\hline
行列式 & 不定 & 不小于零（奇阶为0） \\
\hline
特征值 & 实 & 纯虚或零 \\
\hline
某组基下最简形式 & $\operatorname{diag}(E_p, -E_q, O)$ & $\operatorname{diag}\left(\begin{pmatrix} 0 & 1 \\ -1 & 0 \end{pmatrix}, \ldots, O\right)$ \\
\hline
正交基下最简形式 & $\operatorname{diag}(\lambda_1, \ldots, \lambda_n)$ & $\operatorname{diag}\left(\begin{pmatrix} 0 & -\lambda_k \\ \lambda_k & 0 \end{pmatrix}, \ldots, O\right)$ \\
\hline
\end{tabular}
\end{center}

\section{正规矩阵的总结}

$N$ 正规 $\Rightarrow$ $N - \lambda E$ 也正规。

$\overline{\vec{u}}^H [(N - \lambda E)(N - \lambda E)^H] \vec{u} = 0 \Leftrightarrow (N - \lambda E)^H \vec{u} = 0$，即 $(N^H - \overline{\lambda}E) \vec{u} = 0$。

