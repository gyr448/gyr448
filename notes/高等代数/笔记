\chapter{一元多项式}

\section{主要结论与算法}

\textbf{主要结论：}
\begin{enumerate}
  \item B\'{e}zout 公式（最大公因式的表示）
  \item 重因式定理（形式微商）
  \item Sturm 定理（区间内实根的个数）
\end{enumerate}

\textbf{主要算法：}
\begin{enumerate}
  \item 辗转相除法求公因式（域无关性）
  \item 同余方程的解法
  \item 区间内实根的算法
\end{enumerate}

\textbf{主要工具：}带余除法。

\section{一元多项式的定义与基本运算}

\begin{definition}
设 $P$ 是一个数域，$n$ 是非负整数，$X$ 是一个符号。下面的形式表达式
\[
f(x) = a_n x^n + \cdots + a_1 x + a_0 = \sum_{k=0}^{n} a_k x^k
\]
称为 $P$ 上关于符号 $X$ 的一元 $n$ 次多项式，如果 $a_n \neq 0$，次数为 $n$，记为 $\partial(f(x))$ 或 $\partial f$。零多项式次数无定义或为 $-\infty$。
\end{definition}

首一多项式：$a_n = 1$；零次多项式：$a_0 \neq 0$；零多项式：$a_0 = a_1 = \cdots = a_n = 0$。

多项式相等：次数相等 $+$ 对应系数相等。

\textbf{加法：}相同幂次的系数相加。
\[
\partial(f + g) \leq \max(\partial f, \partial g)
\]

\textbf{乘法：}合并相同幂次的系数乘积。
\[
\partial(fg) = \partial f + \partial g
\]
非零多项式的积是非零多项式。运算律略。

\textbf{乘法系数计算：}
$(b_1 x + b_0)(q_{n+1} x^{n+1} + q_{n-2} x^{n-2} + \cdots + q_1 x + q_0) + r_0 = f(x)$，计算除式为 $(x - b)$ 的商。

计算乘积示例：
\[
f(x) = 6x^5 - 3x^4 + 3x^3 - 11x^2 + 4x + 7, \quad
q(x) = 2x^4 + 5x^3 - 2x^2 + 4x + 3
\]

\[
\begin{bmatrix} 6 \\ -3 \\ 3 \\ 2 \\ 1 \\ -1 \\ 4 \\ 7 \end{bmatrix}
\begin{bmatrix} \frac{3}{2} \\ 5 \\ 2 \\ -2 \\ 1 \\ 4 \\ 7 \end{bmatrix}
\quad
\begin{bmatrix} 6 \\ -3 \\ 3 \\ 3 \\ -1 \\ 4 \\ 7 \end{bmatrix}
\begin{bmatrix} 3 \\ -2 \\ 5 \\ 2 \end{bmatrix} = -21
\]

