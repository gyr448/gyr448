\chapter{同余与中国剩余定理}

\section{同余的基本概念}

同余在"加、减、乘"运算下保持。同余类可做"加、减、乘"运算。

\begin{example}
$88 \times 1367 \equiv 7 \pmod{3}$，$88 + 1367 \equiv ? \pmod{3}$：
\[
\equiv 1 \times 2 \pmod{3} \equiv 2, \quad 2 + 2 \equiv 0 \pmod{3}
\]
\end{example}

\begin{example}[中国剩余定理——整数]
设 $n \bmod (3,5,7) \equiv (2,3,2)$，求 $n$。
\[
n = 70\alpha + 21\beta + 15\gamma - 105k = 70 \times 2 + 21 \times 3 + 15 \times 2 - 105k = 233 - 105k
\]
因为：
\begin{align*}
70 &\equiv (1,0,0) \pmod{(3,5,7)} \\
21 &\equiv (0,1,0) \pmod{(3,5,7)} \\
15 &\equiv (0,0,1) \pmod{(3,5,7)}
\end{align*}
一般地：$n \equiv (a, b, c) \pmod{(3,5,7)}$。
\end{example}

\begin{proposition}
设 $p_1, \ldots, p_s$ 两两互素，则 $p_k$ 与 $\prod_{i \neq k} p_i$ 互素。
\[
(p_k, \prod_{i \neq k} p_i) = 1, \quad \exists u_k, v_k \text{ s.t. } u_k p_k + v_k \prod_{i \neq k} p_i = 1
\]
令 $h_k = v_k \prod_{i \neq k} p_i$，则
\[
h_k \equiv 1 \pmod{p_k}, \quad h_k \equiv 0 \pmod{p_i} \; (i \neq k)
\]
\end{proposition}

\textbf{整除的同余阶——两种解法：}筛法与同余基础解系法。筛法不能用在多项式上，因为多项式无序。

\section{多项式同余}

\begin{definition}
$m(x) \mid f(x) - g(x)$ 则 $f(x) \equiv g(x) \pmod{m(x)}$。
\end{definition}

\begin{theorem}[多项式中国剩余定理]
设 $p_1(x), \ldots, p_s(x)$ 是 $P[x]$ 中一组两两互素的非零次多项式，任给多项式 $f_1(x), f_2(x), \ldots, f_s(x) \in P[x]$，存在 $F(x) \in P[x]$，使
\[
F(x) \equiv f_j(x) \pmod{p_j(x)} \quad (j = 1, 2, \ldots, s)
\]
若 $\partial F(x) < \sum \partial p_j(x)$，则 $F(x)$ 还是唯一的。
\end{theorem}

\begin{remark}
思考：模的两个数不互素时，什么时候有解？如 $n \equiv ? \pmod{9}$，$n \equiv ? \pmod{27}$。
\end{remark}

\section{中国剩余定理求解多项式同余方程组——通用解题模板}

\subsection{一、问题描述}

已知多项式 $f(x)$ 分别除以两两互素的多项式 $m_1(x), m_2(x), \ldots, m_k(x)$ 的余数为 $r_1, r_2, \ldots, r_k$，即：
\[
f(x) \equiv r_i \pmod{m_i(x)}, \quad i = 1, \ldots, k.
\]
设总模 $M(x) = m_1(x) m_2(x) \cdots m_k(x)$，求 $f(x)$ 除以 $M(x)$ 的余式 $R(x)$，且 $\deg R(x) < \deg M(x)$。

\subsection{二、解题步骤}

\subsubsection{1. 建立同余方程组}

由于余式 $R(x)$ 与 $f(x)$ 模 $M(x)$ 同余，且 $R(x)$ 次数小于 $\deg M$，因此 $R(x)$ 满足：
\[
\begin{cases}
R(x) \equiv r_1 & \pmod{m_1(x)} \\
R(x) \equiv r_2 & \pmod{m_2(x)} \\
\vdots & \\
R(x) \equiv r_k & \pmod{m_k(x)}
\end{cases}
\]

\subsubsection{2. 计算总模与乘子}

\[
M(x) = \prod_{i=1}^{k} m_i(x), \qquad
M_i(x) = \frac{M(x)}{m_i(x)} \quad (i = 1, \ldots, k)
\]

\subsubsection{3. 求乘法逆元 $N_i(x)$}

对每个 $i$，求解多项式 $N_i(x)$，使得：
\[
M_i(x) \cdot N_i(x) \equiv 1 \pmod{m_i(x)}
\]
且 $\deg N_i(x) < \deg m_i(x)$。

\textbf{常用方法：}
\begin{itemize}
  \item 若 $m_i(x)$ 为一次幂 $(x-a)^n$，则作变量代换 $t = x-a$，将 $M_i(x)$ 表示为 $t$ 的多项式，并只保留次数低于 $n$ 的项（即模 $t^n$ 下）。
  \item 设 $N_i(t) = c_{n-1} t^{n-1} + \cdots + c_1 t + c_0$，代入 $M_i(t) N_i(t) \equiv 1 \pmod{t^n}$，比较系数得到线性方程组，解出系数。
  \item 若 $m_i(x)$ 为一般多项式，则使用多项式扩展欧几里得算法求逆。
\end{itemize}

\subsubsection{4. 组合构造余式}

\[
R(x) \equiv \sum_{i=1}^{k} r_i \cdot M_i(x) \cdot N_i(x) \pmod{M(x)}
\]
计算右侧多项式，并化简为次数低于 $\deg M$ 的多项式（直接展开合并同类项）。

\subsubsection{5. 最终结果}

化简后的多项式即为所求的余式 $R(x)$。

