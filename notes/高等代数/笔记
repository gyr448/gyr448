\section{典型例题}

\subsection{例1：带余除法}
$g(x) = x - 1 + 2i$，$f(x) = x^3 - x^2 - x$。$g(x) = x - (1 - 2i)$，商式 $= x^2 - 2ix - 2i - 5$，余式 $= 8i - 9$。

\subsection{例2：最大公因式}
$f(x) = x^3 + (1+t)x^2 + 2x + 2u$，$g(x) = x^3 + tx + u$ 的最大公因式是一个二次多项式，求 $t, u$ 的值。

解：$h(x) = f(x) - g(x) = (1+t)x^2 + (2-t)x + u$，$\therefore h(x) = d(x)$。
\[
h(x) \mid g(x), \quad h(x) = (1+t)\left(x^2 + \frac{2-t}{1+t}x + \frac{u}{1+t}\right)
\]
\[
\begin{cases}
t(1+t)^2 - u(1+t) + (t-3)^2 = 0 \\
u(t^2 + t + 3) = 0
\end{cases}
\]
\begin{enumerate}
  \item[(1)] $u = 0$，$t = -4$ 或 $t = \frac{1 \pm \sqrt{3}i}{2}$
  \item[(2)] $u \neq 0$，$t = \frac{-1 \pm \sqrt{11}i}{2}$，$u = -7 \mp \sqrt{11}i$
\end{enumerate}

\subsection{例3：Bezout公式}
$f(x) = x^4 + 2x^3 - x^2 - 4x - 2$，$g(x) = x^4 + x^3 - x^2 - 2x - 2$，求 $u(x), v(x)$ 使 $u(x)f(x) + v(x)g(x) = (f(x), g(x))$。

解：$h(x) = f(x) - g(x) = x^3 - 2x$，
$g(x) = (x+1)(x^3 - 2x) + x^2 - 2$。
\[
(f(x), g(x)) = r_1(x) = g(x) - q_1(x)h(x) = (x+2)g(x) - (x+1)f(x)
\]
检验：代入特殊值验证。

\subsection{例4：单位根技巧}
证明：若 $x^2 + x + 1 \mid f_1(x^3) + x f_2(x^3)$，那么 $(x-1) \mid f_1(x)$，$(x-1) \mid f_2(x)$。

解：$x^2 + x + 1 = (x - \omega_1)(x - \omega_2)$，$\omega_1, \omega_2$ 是不为 $1$ 的两个三次单位根。代入得：
\[
\begin{cases}
f_1(1) + \omega_1 f_2(1) = 0 \\
f_1(1) + \omega_2 f_2(1) = 0
\end{cases}
\Rightarrow
\begin{cases}
f_1(1) = 0 \\
f_2(1) = 0
\end{cases}
\]
$\therefore (x-1) \mid f_1(x), \; (x-1) \mid f_2(x)$。

\subsection{例5：重根条件}
求 $t$ 的值，使 $f(x) = x^3 - 3x^2 + tx - 1$ 有重根。

充要条件：$f(x)$ 与 $f'(x)$ 有公共根。$f'(x) = 3x^2 - 6x + t$，$x_0^2 = 2x_0 - \frac{t}{3}$。
\[
f(x_0) = \left(\frac{2}{3}t - 2\right) x_0 + \frac{t}{3} - 1 = 0
\]
$(t-3)(2x_0 + 1) = 0$，$t = 3$ 或 $x_0 = -\frac{1}{2}$。当 $x_0 = -\frac{1}{2}$ 时，$t = -\frac{15}{4}$。
$\therefore t = 3$ 或 $t = -\frac{15}{4}$。

\subsection{例6：结式}
(习题1.7.3) $m, p, q$ 满足什么条件时，$x^2 + mx + 1 \mid x^4 + px^2 + q$？

\textbf{法1（秩定理）：}结式矩阵
\[
R(f,g) = \begin{pmatrix}
1 & 0 & 0 & 0 & q & 0 \\
m & 1 & 0 & 0 & 0 & q \\
1 & m & 1 & 0 & p & 0 \\
0 & 1 & m & 1 & 0 & p \\
0 & 0 & 1 & m & 1 & 0 \\
0 & 0 & 0 & 1 & 0 & 1
\end{pmatrix}
\]
$\operatorname{rank}(R(f,g)) + \dim(\operatorname{Nul}(R)) = \partial f(x) + \partial g(x)$。

\textbf{法2：}根据多项式理论中的秩定理：
\[
\partial\gcd(f(x), g(x)) = \partial f(x) + \partial g(x) - \operatorname{rank}(R(f,g))
\]
解得 $\operatorname{rank}(R) = 4$。

\subsection{例7：中国剩余定理+拉格朗日插值}
设 $f(x)$ 除以 $(x-1)^2, (x-2)^2, (x-3)^2$ 的余数分别是 $4, 8, 16$，求除以 $(x-1)^2(x-2)^2(x-3)^2$ 的余式。

总模：$M(x) = (x-1)^2(x-2)^2(x-3)^2$。乘子：$M_i(x) = M(x)/m_i(x)$。

经过计算得：
\[
R(x) = -9x^5 + 88x^4 - 329x^3 + 586x^2 - 492x + 160
\]

\section{第二章 多元多项式}

\subsection{字典排列法}

\begin{definition}
若 $n$ 元有序数组 $(k_1, k_2, \ldots, k_n)$ 与 $(l_1, l_2, \ldots, l_n)$ 满足 $k_1 = l_1, \ldots, k_{i-1} = l_{i-1}, k_i > l_i$，则称 $(k_1, k_2, \ldots, k_n) \succ (l_1, l_2, \ldots, l_n)$。具有传递性。
\end{definition}

\textbf{运算：}加法、数量乘法、乘法。

\begin{theorem}
积的首项是首项的积。
\end{theorem}

\begin{proposition}
任意 $n$ 元多项式可以唯一地表示为一些 $n$ 元齐次多项式之和。
\end{proposition}

\textbf{排序2：}齐次优先排列法。

\subsection{对称多项式}

\begin{definition}
设 $f(x_1, x_2, \ldots, x_n) \in P[x_1, x_2, \ldots, x_n]$，$\tau \in S_n$，定义
$\tau(f(x_1, x_2, \ldots, x_n)) = f(x_{\tau(1)}, \ldots, x_{\tau(n)})$。
如果对 $\forall \tau$，$\tau f = f$，则称 $f(x_1, \ldots, x_n)$ 是对称多项式。
\end{definition}

例如 $f(x, y, z) = x^4 + y^4 + z^4 + x^3 y + x^3 z + y^3 x + y^3 z + z^3 x + z^3 y + \cdots$ 是对称多项式。

对称多项式可以因式分解。

\textbf{韦达定理（初等对称多项式）：}
\[
f = (x - x_1)(x - x_2) \cdots (x - x_n) = x^n - \sigma_1 x^{n-1} + \cdots + (-1)^n \sigma_n
\]
其中
\begin{align*}
\sigma_1 &= x_1 + x_2 + \cdots + x_n \\
\sigma_2 &= x_1 x_2 + x_1 x_3 + \cdots + x_{n-1} x_n \\
&\;\;\vdots \\
\sigma_n &= x_1 x_2 \cdots x_n
\end{align*}
这 $n$ 个多项式称为初等对称多项式。

\subsection{对称多项式基本定理}

\begin{theorem}
对称多项式能唯一地表为初等对称多项式的多项式。
\end{theorem}

\textbf{求解方法：}
\begin{enumerate}
  \item 直接法
  \item 待定系数法
  \item 利用 Newton 恒等式
\end{enumerate}

\subsection{待定系数法}

例如：$N_S(4,3) = \{(4,0,0), (3,1,0), (2,2,0), (2,1,1)\}$。

$f(x_1, x_2, x_3) = x_1^4 + x_2^4 + x_3^4 = \sigma_1^4 + A\sigma_1^2\sigma_2 + B\sigma_2^2 + C\sigma_1\sigma_3$，代入尽量简单的数值求解系数。

\subsection{Newton 恒等式}

\[
S_k = \sigma_1 S_{k-1} - \sigma_2 S_{k-2} + \cdots + (-1)^k \sigma_{k-1} S_1 + (-1)^{k+1} k \sigma_k \quad (1 \leq k \leq n)
\]
\[
S_k = \sigma_1 S_{k-1} + \cdots + (-1)^{k-n+1} \sigma_{k-n} S_n \quad (k > n)
\]

