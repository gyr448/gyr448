\chapter{行列式}

\section{行列式的基本性质}

行列式的性质：
\begin{enumerate}
  \item \textbf{交错性：} $\det(A, a^i \rightleftharpoons a^j) = -\det(A)$（交换两行/列，行列式变号）
  \item \textbf{多线性：} 
  \[
  \det(A, a^i \leftarrow \beta + \gamma) = \det(A, a^i \leftarrow \beta) + \det(A, a^i \leftarrow \gamma)
  \]
  \[
  \det(A, \alpha^i \leftarrow t\alpha^i) = t\det A
  \]
  \item \textbf{归一性：} $\det(I) = 1$
\end{enumerate}

\textbf{其他性质：}
\begin{itemize}
  \item $\det A = \det A^{T}$
  \item $\det A = 0$ 若 $\exists \vec{x} \neq \vec{0}$ s.t. $A\vec{x} = \vec{0}$
  \item 矩阵 $A$ 的行列式是其每一行（列）的线性函数
  \item 上面三条性质唯一确定行列式
\end{itemize}

\section{Laplace 定理}

\subsection{指标集的记号}

设 $I = \{i_1, i_2, \ldots, i_k\}$，$I^{c} = \{i_{k+1}, i_{k+2}, \ldots, i_n\}$，满足
\[
I \cup I^{c} = \{1, 2, \ldots, n\}, \quad I \cap I^{c} = \varnothing
\]

\textbf{$k$ 阶代数余子式：}
\[
\widehat{A}_{IJ} = (-1)^{\sum I + \sum \mu_I} M_{IJ}
\]
$k$ 阶子式的余子式是 $n-k$ 阶子式：$M^{c}_{IJ} = M_{I^{c}J^{c}}$。

\subsection{由解 $n$ 元方程组推导定理}

\[
\begin{cases}
a_{11}x_1 + a_{12}x_2 = b_1 - a_{13}x_3 - a_{14}x_4 \\
a_{21}x_1 + a_{22}x_2 = b_2 - a_{23}x_3 - a_{24}x_4
\end{cases}
\]
求解：
\[
x_1 = \frac{1}{M\!\begin{pmatrix}1 & 2 \\ 1 & 2\end{pmatrix}} \left[ \begin{vmatrix} b_1 & a_{12} \\ b_2 & a_{22} \end{vmatrix} + x_3 M\!\begin{pmatrix}1 & 2 \\ 2 & 3\end{pmatrix} + x_4 M\!\begin{pmatrix}1 & 2 \\ 2 & 4\end{pmatrix} \right]
\]

最后得到：行列式可以按子式展开。

\begin{theorem}[Laplace 展开定理]
\[
\det(A) = \sum_{I \in E} M_{KI} \widehat{A}_{K^{c}I^{c}} = \sum_{I \in \mathcal{I}_k} (-1)^{k+1} M_{KI} M_{K^{c}I^{c}}
\]
\end{theorem}

\section{排列与逆序}

\begin{theorem}
（任意的）对换改变排列的奇偶性。
在 $n!$ 个排列中奇偶排列各占一半（$n > 1$）。
$n$ 级排列，偶排列通过偶数次对换变成 $1, 2, \ldots, n$；奇排列通过奇数次对换。
\end{theorem}

\section{矩阵的秩}

矩阵的秩等于矩阵中最大非零子式的阶数。子式：矩阵中某些行和列组成的行列式。

\section{Binet-Cauchy 定理}

\begin{theorem}[Binet-Cauchy]
若 $A, B \in P^{m \times n}$，$m > n$，则
\[
\det(AB) = \sum_{I \in P_m} \det A^{I} \det B_{I}
= \sum_{J \in Z_m^n} \det(AE^{-1})^{J} \det(EB)_{J}
\]
\end{theorem}

在初等变换对嵌入时，$\delta(A, B)$ 不变。

\subsection{预备例题：分块矩阵行列式}

\begin{example}
设 $A, B, C, D$ 为 $n$ 阶矩阵，$AC$ 可交换，证明：
\[
\det\begin{pmatrix} A & B \\ C & D \end{pmatrix} = \det(AD - CB)
\]
\textbf{证明思路：}
\begin{itemize}
  \item $A$ 可逆时，令分块初等变换消去 $B$：
  \[
  \begin{pmatrix} I & 0 \\ -CA^{-1} & I \end{pmatrix} \begin{pmatrix} A & B \\ C & D \end{pmatrix} = \begin{pmatrix} A & B \\ 0 & D - CA^{-1}B \end{pmatrix}
  \]
  \item $A$ 不可逆时，用多项式证明（或 $\varepsilon$ 足够小，$A + \varepsilon I$ 可逆，再由连续性证明）。
\end{itemize}
\end{example}

\subsection{Binet-Cauchy 公式验证示例}

设 $m = 2, n = 3$（满足 $m \leq n$）。令
\[
A = \begin{bmatrix} 1 & 2 & 3 \\ 4 & 5 & 6 \end{bmatrix}_{2 \times 3}, \quad
B = \begin{bmatrix} 7 & 8 \\ 9 & 10 \\ 11 & 12 \end{bmatrix}_{3 \times 2}.
\]

\textbf{左边：直接计算 $\det(AB)$}
\[
AB = \begin{bmatrix} 1 \cdot 7 + 2 \cdot 9 + 3 \cdot 11 & 1 \cdot 8 + 2 \cdot 10 + 3 \cdot 12 \\ 4 \cdot 7 + 5 \cdot 9 + 6 \cdot 11 & 4 \cdot 8 + 5 \cdot 10 + 6 \cdot 12 \end{bmatrix} = \begin{bmatrix} 58 & 64 \\ 139 & 154 \end{bmatrix}.
\]
\[
\det(AB) = 58 \times 154 - 64 \times 139 = 8932 - 8896 = 36.
\]

\textbf{右边：按公式求和}

对所有 $1 \leq i_1 < i_2 \leq 3$ 求和，共 $\binom{3}{2} = 3$ 项：
\begin{itemize}
  \item 指标 $(1,2)$：$A$ 子式 $\begin{vmatrix} 1 & 2 \\ 4 & 5 \end{vmatrix} = -3$，$B$ 子式 $\begin{vmatrix} 7 & 8 \\ 9 & 10 \end{vmatrix} = -2$，乘积 $= 6$
  \item 指标 $(1,3)$：$A$ 子式 $\begin{vmatrix} 1 & 3 \\ 4 & 6 \end{vmatrix} = -6$，$B$ 子式 $\begin{vmatrix} 7 & 8 \\ 11 & 12 \end{vmatrix} = -4$，乘积 $= 24$
  \item 指标 $(2,3)$：$A$ 子式 $\begin{vmatrix} 2 & 3 \\ 5 & 6 \end{vmatrix} = -3$，$B$ 子式 $\begin{vmatrix} 9 & 10 \\ 11 & 12 \end{vmatrix} = -2$，乘积 $= 6$
\end{itemize}

求和：$6 + 24 + 6 = 36$，与左边一致。

这就直观验证了 Binet-Cauchy 公式：
\[
\det(AB) = \sum_{\text{所有 } m \text{ 列组合}} (\text{对应 } A \text{ 的 } m \text{ 阶子式}) \times (\text{对应 } B \text{ 的 } m \text{ 阶子式}).
\]

