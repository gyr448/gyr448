\chapter{线性空间与子空间}

\section{线性空间的基本概念}

线性空间只有一个零元：
\[
0_2 = 0_1 + 0_2 = 0_2 + 0_1 = 0_1
\]

初等行变换不改变行空间，改变列空间。

线性方程组的系数矩阵，主元所在的列组成极大线性无关组。

\subsection{过渡矩阵}

\[
(\vec{\varepsilon}_1, \vec{\varepsilon}_2, \ldots, \vec{\varepsilon}_n) = (\vec{\eta}_1, \vec{\eta}_2, \ldots, \vec{\eta}_n) T, \quad \vec{x} = T \vec{x}'
\]
注意左右顺序。

\section{子空间的交与和}

任意两个子空间的交集非空（有零向量）。两个子空间的并集不一定是子空间。两个子空间的交集是子空间。

\begin{center}
\includegraphics[max width=0.2\textwidth]{images/23_1209_1908_266_253_0.jpg}
\end{center}

任意有限个真子空间的并不是整个空间。

\begin{definition}
子空间的交：$V_1 \cap V_2 = \{\vec{\alpha} \in V_1 \text{ and } \vec{\alpha} \in V_2\}$。

子空间的和：$V_1 + V_2 = \{\vec{a}_1 + \vec{a}_2 \mid \vec{a}_1 \in V_1, \vec{a}_2 \in V_2\}$。
\end{definition}

注意：$V_1 \cap (V_2 + V_3) = (V_1 \cap V_2) + (V_1 \cap V_3)$ 一般不成立。

行变换改变行的线性相关性，不改变列的线性相关性。

\begin{center}
\includegraphics[max width=0.3\textwidth]{images/24_1283_421_429_267_0.jpg}
\end{center}

\section{维数公式}

\[
\dim(V_1 + V_2) = \dim V_1 + \dim V_2 - \dim(V_1 \cap V_2)
\]

\begin{proof}
设 $\dim V_1 = s$，$\dim V_2 = t$，$\dim(V_1 + V_2) = n$，$\dim(V_1 \cap V_2) = r$。

取 $V_1 \cap V_2$ 的一组基 $\vec{\varepsilon}_1, \ldots, \vec{\varepsilon}_r$（如果 $V_1 \cap V_2 = 0$，则 $r = 0$）。

将此基分别扩充成 $V_1, V_2$ 的基：
\begin{align*}
V_1&: \vec{\varepsilon}_1, \vec{\varepsilon}_2, \ldots, \vec{\varepsilon}_r, \vec{\alpha}_1, \ldots, \vec{\alpha}_{s-r} \\
V_2&: \vec{\varepsilon}_1, \vec{\varepsilon}_2, \ldots, \vec{\varepsilon}_r, \vec{\beta}_1, \ldots, \vec{\beta}_{t-r}
\end{align*}

只需证明 $\vec{\varepsilon}_1, \ldots, \vec{\varepsilon}_r, \vec{\alpha}_1, \ldots, \vec{\alpha}_{s-r}, \vec{\beta}_1, \ldots, \vec{\beta}_{t-r}$ 是 $V_1 + V_2$ 的一组基。

\textbf{张成性：}$\forall \vec{a} \in V_1$，$\vec{a} = \{\vec{\varepsilon}\}\vec{a} + \{\vec{\alpha}\}\vec{b}$；
$\forall \vec{\beta} \in V_2$，$\vec{\beta} = \{\vec{\varepsilon}\}\vec{c} + \{\vec{\beta}\}\vec{d}$。

$\vec{\alpha} + \vec{\beta}$ 是上述向量的线性组合。

\textbf{线性无关性：}反证。若线性相关，存在不全为零的系数使得
\[
0 = \{\vec{\varepsilon}\}\vec{a} + \{\vec{\alpha}\}\vec{b} + \{\vec{\beta}\}\vec{d}
\]
不妨设 $\vec{b} \neq \vec{0}$。则 $\{\vec{\beta}\}\vec{d} = \{\vec{\varepsilon}\}\vec{a} + \{\vec{\alpha}\}\vec{b} \in V_1$，同时属于 $V_2$，故属于 $V_1 \cap V_2$。从而可由 $\{\vec{\varepsilon}\}$ 表示，与扩充基的线性无关性矛盾。
\end{proof}

\section{直和}

\begin{definition}
如果对于 $V_1 + V_2$ 中每个向量的分解式 $\vec{\alpha} = \vec{\alpha}_1 + \vec{\alpha}_2$，$\vec{\alpha}_1 \in V_1, \vec{\alpha}_2 \in V_2$ 唯一，称 $V_1 + V_2$ 为直和，记作 $V_1 \oplus V_2$。
\end{definition}

\begin{theorem}[直和的等价条件]
以下命题等价：
\begin{enumerate}
  \item[(1)] $\sum_{j=1}^{m} V_j$ 是直和
  \item[(2)] $V$ 中有一个向量 $\vec{x}$ 可唯一表示为 $\sum \vec{x}_i, \; \vec{x}_i \in V_i$
  \item[(3)] $V_i \cap \sum_{j \neq i} V_j = \{0\}$ 对所有 $i$ 成立
  \item[(4)] $\dim(\sum V_j) = \sum \dim V_j$
\end{enumerate}
\end{theorem}

\textbf{注：}$A$ 为 $m \times n$ 矩阵，$\operatorname{Col}A + \operatorname{Nul}A = \mathbb{R}^m$，但 $\dim\operatorname{Col}A + \dim\operatorname{Nul}A = m$ 不意味着是直和。

\begin{theorem}
设 $U$ 是有限维线性空间 $V$ 的一个子空间，那么存在 $V$ 的子空间 $W$，使得 $V = U \oplus W$。
\end{theorem}

